# Acceso del personal (NUNCA subas el archivo .env real al repositorio).
# En producción se configuran en Vercel: Project > Settings > Environment Variables.

# URL del backend FastAPI (Render)
FASTAPI_URL=https://san-parrilla-backend.onrender.com

# Clave para firmar las sesiones (mínimo 16 caracteres, aleatoria y larga)
AUTH_SECRET=

# PIN / contraseña del rol Cajero (POS + caja)
CAJERO_PIN=

# PIN / contraseña del rol Administrador (todo, incluye métricas y precios). Debe ser distinto al del cajero.
ADMIN_PIN=

# En desarrollo local (npm run dev) si no defines nada se usan: CAJERO=1111, ADMIN=2222.
# En producción, si falta alguna variable el login queda deshabilitado (no hay valores por defecto).
