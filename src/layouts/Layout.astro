---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
}

const { 
  title = "Restaurante San Parrilla | Menú Digital & Brasas", 
  description = "El mejor sabor a la parrilla, carnes selectas, menú del día y picadas especiales en San Parrilla.",
  showNav = true
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Google Fonts: Outfit & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-parrilla-dark text-parrilla-ivory min-h-screen flex flex-col selection:bg-parrilla-gold selection:text-white">

  {showNav && (
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-parrilla-border no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Brand -->
        <a href="/" class="flex items-center gap-3 group">
          <img src="/logo.png" alt="San Parrilla Logo" class="h-10 w-auto rounded-full ring-2 ring-parrilla-gold/30 group-hover:ring-parrilla-gold transition" />
          <div class="flex flex-col">
            <span class="font-display font-extrabold text-xl tracking-tight leading-none text-parrilla-ivory">
              SAN <span class="text-parrilla-gold">PARRILLA</span>
            </span>
            <span class="text-[10px] tracking-widest text-parrilla-muted uppercase font-medium">Sazón & Fogón</span>
          </div>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-1 bg-slate-100/90 p-1 rounded-full border border-parrilla-border text-sm">
          <a href="/" class="px-4 py-1.5 rounded-full text-parrilla-ivory hover:text-parrilla-gold hover:bg-white transition font-medium">
            🍽️ Menú Carta
          </a>
          <a href="/pos" class="px-4 py-1.5 rounded-full bg-parrilla-gold text-white shadow-sm hover:bg-parrilla-goldLight font-semibold transition">
            ⚡ Punto de Venta (POS)
          </a>
          <a href="/caja" class="px-4 py-1.5 rounded-full text-parrilla-ivory hover:text-parrilla-gold hover:bg-white transition font-medium">
            💵 Cuadre de Caja
          </a>
          <a href="/admin" class="px-4 py-1.5 rounded-full text-parrilla-ivory hover:text-parrilla-gold hover:bg-white transition font-medium">
            📊 Métricas & Menú
          </a>
        </nav>

        <!-- Right Quick Actions -->
        <div class="flex items-center gap-3">
          <a href="https://wa.me/573183821787" target="_blank" rel="noopener noreferrer" 
             class="inline-flex items-center gap-2 bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-bold text-xs sm:text-sm px-3.5 py-2 rounded-lg shadow-sm hover:shadow transition active:scale-95">
            <i data-lucide="phone" class="w-4 h-4"></i>
            <span class="hidden sm:inline">WhatsApp</span>
          </a>
          
          <a href="/pos" class="md:hidden inline-flex items-center justify-center p-2 rounded-lg bg-parrilla-surface border border-parrilla-border text-parrilla-gold">
            <i data-lucide="shopping-bag" class="w-5 h-5"></i>
          </a>
        </div>
      </div>
    </header>
  )}

  <main class="flex-1">
    <slot />
  </main>

  <footer class="bg-parrilla-surface border-t border-parrilla-border py-8 text-center text-xs text-parrilla-muted no-print">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="font-display font-bold text-parrilla-gold text-sm">SAN PARRILLA</span>
        <span>•</span>
        <span>Tradición & Sazón Casero</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="/" class="hover:text-parrilla-gold transition">Menú</a>
        <a href="/pos" class="hover:text-parrilla-gold transition">POS</a>
        <a href="/caja" class="hover:text-parrilla-gold transition">Caja</a>
        <a href="/admin" class="hover:text-parrilla-gold transition">Administración</a>
      </div>
      <p>© {new Date().getFullYear()} San Parrilla. Todos los derechos reservados.</p>
    </div>
  </footer>

  <script>
    // Initialize Lucide icons on page load
    document.addEventListener('DOMContentLoaded', () => {
      // @ts-ignore
      if (window.lucide) {
        // @ts-ignore
        window.lucide.createIcons();
      }
    });
  </script>
</body>
</html>
