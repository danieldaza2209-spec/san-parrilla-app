---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'San Parrilla',
  description = 'El mejor sabor a la parrilla, carnes selectas, menú del día y picadas especiales en San Parrilla.',
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/logo.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}

  <!-- Google Fonts: Outfit & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-parrilla-dark text-parrilla-ivory min-h-screen flex flex-col selection:bg-parrilla-gold selection:text-white">
  <slot />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // @ts-ignore
      if (window.lucide) window.lucide.createIcons();
    });
  </script>
</body>
</html>
