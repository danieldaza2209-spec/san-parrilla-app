---
import BaseLayout from './BaseLayout.astro';
import { getActiveCashRegister } from '../lib/db.js';
import { ROLE_ADMIN, ROLE_LABELS } from '../lib/auth.js';

interface Props {
  title?: string;
}

const { title = 'Personal | San Parrilla' } = Astro.props;

const user = Astro.locals.user;
const isAdmin = user?.role === ROLE_ADMIN;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const cashOpen = Boolean(getActiveCashRegister());

const navItems = [
  { href: '/pos', label: 'Punto de Venta', icon: 'zap', adminOnly: false, cashierOrAdmin: false },
  { href: '/pedidos', label: '📋 Pedidos', icon: 'clipboard-list', adminOnly: false, cashierOrAdmin: false },
  { href: '/caja', label: 'Caja', icon: 'wallet', adminOnly: false, cashierOrAdmin: true },
  { href: '/admin', label: 'Administración', icon: 'bar-chart-3', adminOnly: true, cashierOrAdmin: false },
];
---

<BaseLayout title={title} noindex>
  <script is:inline>
    (function () {
      var STORAGE_KEY = 'sp_staff_session';
      var pathname = window.location.pathname.replace(/\/+$/, '') || '/';
      var session = null;
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          var parsed = JSON.parse(raw);
          if (parsed && parsed.role && parsed.exp > Date.now()) {
            session = parsed;
          } else {
            localStorage.removeItem(STORAGE_KEY);
          }
        }
      } catch (e) {}

      if (!session) {
        window.location.replace('/login?next=' + encodeURIComponent(pathname + window.location.search));
        return;
      }

      // Restricciones estrictas por Rol:
      // Mesero: Solo acceso a /pos y /pedidos. Si intenta entrar a /caja o /admin -> redirige a /pos
      if (session.role === 'mesero') {
        if (
          pathname === '/caja' ||
          pathname.indexOf('/caja/') === 0 ||
          pathname === '/admin' ||
          pathname.indexOf('/admin/') === 0
        ) {
          window.location.replace('/pos');
          return;
        }
      }

      // Cajero: Acceso a /pos, /pedidos y /caja. Si intenta entrar a /admin -> redirige a /pos
      if (pathname === '/admin' || pathname.indexOf('/admin/') === 0) {
        if (session.role !== 'admin') {
          window.location.replace('/pos');
          return;
        }
      }

      window.__SP_STAFF_ROLE__ = session.role;
      window.__SP_STAFF_NAME__ = session.name || (session.role === 'admin' ? 'Administrador' : session.role === 'cajero' ? 'Cajero' : 'Mesero');
    })();
  </script>

  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-parrilla-border no-print">
    <div class="max-w-[1600px] mx-auto px-2 sm:px-4 h-14 flex items-center justify-between gap-1.5 sm:gap-3 w-full">

      <div class="flex items-center gap-1.5 sm:gap-3 min-w-0 shrink">
        <img src="/logo.png" alt="San Parrilla" class="h-8 sm:h-9 w-auto rounded-full ring-2 ring-parrilla-gold/30 shrink-0" />
        <nav class="flex items-center gap-0.5 sm:gap-1 bg-slate-100/90 p-1 rounded-full border border-parrilla-border text-xs sm:text-sm overflow-x-auto scrollbar-none shrink min-w-0">
          {navItems.map((item) => {
            const active = pathname === item.href || pathname.startsWith(`${item.href}/`);
            const navId = item.adminOnly ? 'nav-admin-link' : item.cashierOrAdmin ? 'nav-caja-link' : undefined;
            return (
              <a
                href={item.href}
                id={navId}
                class:list={[
                  'px-2.5 sm:px-4 py-1.5 rounded-full font-semibold transition items-center gap-1 sm:gap-1.5 shrink-0 text-xs sm:text-sm',
                  item.adminOnly && !isAdmin ? 'hidden' : 'inline-flex',
                  active
                    ? 'bg-parrilla-gold text-white shadow-sm'
                    : 'text-parrilla-ivory hover:text-parrilla-gold hover:bg-white',
                ]}
              >
                <i data-lucide={item.icon} class="w-3.5 sm:w-4 h-3.5 sm:h-4"></i>
                <span class="hidden sm:inline">{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>

      <div class="flex items-center gap-1 sm:gap-2.5 shrink-0">
        <span
          id="header-cash-badge"
          class:list={[
            'hidden md:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border',
            cashOpen
              ? 'bg-green-50 text-parrilla-accent border-green-200'
              : 'bg-red-50 text-red-600 border-red-200',
          ]}
        >
          <span class:list={['w-2 h-2 rounded-full', cashOpen ? 'bg-parrilla-accent animate-pulse' : 'bg-red-500']}></span>
          {cashOpen ? 'Caja abierta' : 'Caja cerrada'}
        </span>

        <button
          id="btn-global-print-agent"
          type="button"
          class="inline-flex items-center justify-center gap-1.5 p-2 sm:px-3 sm:py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black shadow-sm transition cursor-pointer shrink-0"
          title="Instalar Agente de Impresión Automática SAT Q22 en Windows"
          aria-label="Instalador Impresor SAT Q22"
        >
          <i data-lucide="printer" class="w-4 h-4 text-white shrink-0"></i>
          <span class="hidden sm:inline">🖨️ Impresor SAT Q22</span>
        </button>

        <button
          id="btn-switch-role-modal"
          type="button"
          class="inline-flex items-center gap-1 px-2 py-1 sm:px-2.5 sm:py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-xs font-semibold transition shrink-0 max-w-[125px] sm:max-w-none"
          title="Cambiar de Colaborador o Rol con PIN"
        >
          <i data-lucide="user-round" class="w-3.5 h-3.5 text-amber-700 shrink-0"></i>
          <span id="staff-role-label-full" class="hidden sm:inline truncate">{user ? `${ROLE_LABELS[user.role]}: ${user.name}` : 'Personal'}</span>
          <span id="staff-role-label-short" class="sm:hidden truncate">{user ? `${user.name.split(' ')[0]}` : 'Personal'}</span>
          <span id="staff-role-label" class="sr-only">{user ? `${ROLE_LABELS[user.role]}: ${user.name}` : 'Personal'}</span>
          <span class="text-[10px] text-amber-700 underline ml-0.5 hidden sm:inline">Cambiar</span>
        </button>

        <button
          id="btn-staff-logout"
          type="button"
          class="inline-flex items-center justify-center gap-1 text-xs font-bold p-2 sm:px-3 sm:py-1.5 rounded-xl bg-slate-100 hover:bg-red-50 text-parrilla-muted hover:text-red-500 border border-parrilla-border transition shrink-0"
          title="Cerrar sesión"
          aria-label="Cerrar sesión"
        >
          <i data-lucide="log-out" class="w-4 h-4 shrink-0"></i>
          <span class="hidden sm:inline">Salir</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Modal Rápido de Cambio de Turno / Rol / Colaborador con PIN de 4 dígitos -->
  <div id="modal-quick-role-switch" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 no-print">
    <div class="bg-white rounded-2xl border border-parrilla-border shadow-2xl w-full max-w-md overflow-hidden">
      <div class="px-5 py-4 bg-slate-900 text-white flex items-center justify-between">
        <div>
          <h3 class="font-display font-black text-base">🔐 Cambiar Turno / Rol Operativo</h3>
          <p class="text-[11px] text-slate-300">Selecciona tu rol, nombre del colaborador y PIN de 4 dígitos.</p>
        </div>
        <button type="button" id="btn-close-role-modal" class="text-slate-400 hover:text-white text-lg font-bold px-2">✕</button>
      </div>
      <form id="quick-role-form" class="p-5 space-y-4" autocomplete="off">
        <div>
          <label class="block text-[11px] font-black text-slate-600 uppercase mb-1.5">1. Rol</label>
          <div class="grid grid-cols-3 gap-2" id="quick-role-buttons">
            <button type="button" data-qrole="mesero" class="qrole-btn py-2 px-2 rounded-xl border-2 border-parrilla-gold bg-amber-50 text-xs font-black text-slate-900">🍽️ Mesero</button>
            <button type="button" data-qrole="cajero" class="qrole-btn py-2 px-2 rounded-xl border border-slate-200 bg-slate-50 text-xs font-black text-slate-700">💰 Cajero</button>
            <button type="button" data-qrole="admin" class="qrole-btn py-2 px-2 rounded-xl border border-slate-200 bg-slate-50 text-xs font-black text-slate-700">🛡️ Admin</button>
          </div>
          <input type="hidden" id="quick-role-val" value="mesero" />
        </div>
        <div>
          <label class="block text-[11px] font-black text-slate-600 uppercase mb-1">2. Nombre del Colaborador</label>
          <input id="quick-staff-name" type="text" required autocomplete="name" placeholder="Escribe tu nombre..." class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm font-bold text-slate-900 focus:border-parrilla-gold outline-none" />
        </div>
        <div>
          <div class="mb-1">
            <label class="block text-[11px] font-black text-slate-600 uppercase">3. PIN DE SEGURIDAD (4 DÍGITOS)</label>
          </div>
          <input id="quick-staff-pin" type="password" inputmode="numeric" maxlength="4" required placeholder="••••" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-center text-xl tracking-[0.5em] font-mono font-black text-slate-900 focus:border-parrilla-gold outline-none" />
        </div>
        <p id="quick-role-error" class="hidden text-xs font-bold text-red-600 bg-red-50 border border-red-200 rounded-lg p-2 text-center"></p>
        <div class="flex items-center justify-end gap-2 pt-1">
          <button type="button" id="btn-cancel-role-modal" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-100">Cancelar</button>
          <button type="submit" class="px-5 py-2 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white text-xs font-black shadow">Validar PIN y Cambiar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de Instalación del Agente de Impresión SAT Q22 -->
  <div id="modal-print-agent-help" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/70 backdrop-blur-sm p-4 no-print">
    <div class="bg-white rounded-2xl border border-parrilla-border shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in duration-150">
      <div class="px-5 py-4 bg-emerald-700 text-white flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl">🖨️</span>
          <div>
            <h3 class="font-display font-black text-base">Instalación Impresora SAT Q22 (80mm)</h3>
            <p class="text-[11px] text-emerald-100">Impresión automática silenciosa para el PC del restaurante</p>
          </div>
        </div>
        <button type="button" id="btn-close-print-modal" class="text-white hover:text-emerald-200 text-xl font-bold px-2 cursor-pointer">✕</button>
      </div>

      <div class="p-5 space-y-4 text-xs text-slate-700">
        <div class="p-3.5 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-950 space-y-1">
          <p class="font-black text-sm text-emerald-900 flex items-center gap-1.5">
            <span>✅</span> ¡Instalación Automática en 1 Paso!
          </p>
          <p class="text-[11px] leading-relaxed">
            Se ha descargado el archivo <strong>Iniciar_Impresor_SAT_Q22.bat</strong> en tu computador.
          </p>
        </div>

        <div class="space-y-3">
          <div class="flex items-start gap-2.5">
            <span class="w-5 h-5 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-[11px] shrink-0">1</span>
            <div>
              <strong class="text-slate-900 block text-xs">Abre el archivo descargado:</strong>
              <span class="text-slate-600 text-[11px]">Dale <strong>Doble Clic</strong> al archivo <code>Iniciar_Impresor_SAT_Q22.bat</code> en la barra inferior de descargas o en la carpeta Descargas.</span>
            </div>
          </div>

          <div class="flex items-start gap-2.5">
            <span class="w-5 h-5 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-[11px] shrink-0">2</span>
            <div>
              <strong class="text-slate-900 block text-xs">Se autoconfigura solo:</strong>
              <span class="text-slate-600 text-[11px]">Se abrirá una ventana negra que conecta la impresora y la deja lista. ¡Déjala abierta en segundo plano!</span>
            </div>
          </div>

          <div class="flex items-start gap-2.5">
            <span class="w-5 h-5 rounded-full bg-emerald-700 text-white flex items-center justify-center font-bold text-[11px] shrink-0">3</span>
            <div>
              <strong class="text-slate-900 block text-xs">¿Toca hacer algo cada vez que se prenda el PC?</strong>
              <div class="p-2.5 mt-1 bg-amber-50 rounded-lg border border-amber-200 text-amber-900 text-[11px] leading-relaxed">
                <strong>¡NO! Solo se hace UNA SOLA VEZ.</strong> El instalador se agrega automáticamente a la carpeta de inicio de Windows (<code>shell:startup</code>). Cuando prendas el computador por la mañana, <strong>se iniciará automáticamente en segundo plano</strong> sin que tengas que tocar nada.
              </div>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-3 border-t border-slate-200 gap-3">
          <button
            type="button"
            id="btn-download-print-agent-again"
            class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition cursor-pointer flex items-center gap-1.5"
          >
            <span>📥 Descargar de nuevo (.bat)</span>
          </button>
          <button
            type="button"
            id="btn-ok-print-modal"
            class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs shadow transition cursor-pointer"
          >
            Entendido, ¡Listo!
          </button>
        </div>
      </div>
    </div>
  </div>

  <main class="flex-1">
    <slot />
  </main>

  <script is:inline>
    (function () {
      var role = window.__SP_STAFF_ROLE__;
      var staffName = window.__SP_STAFF_NAME__ || '';
      var adminLink = document.getElementById('nav-admin-link');
      var cajaLink = document.getElementById('nav-caja-link');
      var cashBadge = document.getElementById('header-cash-badge');
      var roleLabel = document.getElementById('staff-role-label');
      var logoutBtn = document.getElementById('btn-staff-logout');

      // Ocultar /admin si no es admin
      if (role === 'admin' && adminLink) {
        adminLink.classList.remove('hidden');
        adminLink.classList.add('inline-flex');
      } else if (adminLink) {
        adminLink.classList.add('hidden');
        adminLink.classList.remove('inline-flex');
      }

      // Ocultar /caja y badge de caja si es mesero
      if (role === 'mesero') {
        if (cajaLink) {
          cajaLink.classList.add('hidden');
          cajaLink.classList.remove('inline-flex');
        }
        if (cashBadge) {
          cashBadge.classList.add('hidden');
          cashBadge.classList.remove('md:inline-flex');
        }
      }

      var roleLabelFull = document.getElementById('staff-role-label-full');
      var roleLabelShort = document.getElementById('staff-role-label-short');
      var roleIcon = role === 'admin' ? '🛡️' : role === 'cajero' ? '💰' : '🍽️';
      var roleTitle = role === 'admin' ? '🛡️ Admin' : role === 'cajero' ? '💰 Cajero' : '🍽️ Mesero';
      var firstName = staffName ? staffName.trim().split(/\s+/)[0] : '';
      if (roleLabelFull) {
        roleLabelFull.textContent = staffName ? roleTitle + ': ' + staffName : roleTitle;
      }
      if (roleLabelShort) {
        roleLabelShort.textContent = firstName ? roleIcon + ' ' + firstName : roleTitle;
      }
      if (roleLabel) {
        roleLabel.textContent = staffName ? roleTitle + ': ' + staffName : roleTitle;
      }

      // Modal rápido de cambio de turno / rol
      var switchBtn = document.getElementById('btn-switch-role-modal');
      var modal = document.getElementById('modal-quick-role-switch');
      var closeBtn = document.getElementById('btn-close-role-modal');
      var cancelBtn = document.getElementById('btn-cancel-role-modal');
      var qForm = document.getElementById('quick-role-form');
      var qRoleInput = document.getElementById('quick-role-val');
      var qNameInput = document.getElementById('quick-staff-name');
      var qPinInput = document.getElementById('quick-staff-pin');
      var qError = document.getElementById('quick-role-error');

      function setQuickRole(r) {
        if (qRoleInput) qRoleInput.value = r;
        try { localStorage.setItem('sanparrilla_last_role', r); } catch (e) {}
        var btns = document.querySelectorAll('.qrole-btn');
        for (var i = 0; i < btns.length; i++) {
          var b = btns[i];
          if (b.getAttribute('data-qrole') === r) {
            b.className = 'qrole-btn py-2 px-2 rounded-xl border-2 border-parrilla-gold bg-amber-50 text-xs font-black text-slate-900';
          } else {
            b.className = 'qrole-btn py-2 px-2 rounded-xl border border-slate-200 bg-slate-50 text-xs font-black text-slate-700';
          }
        }
      }

      if (switchBtn && modal) {
        switchBtn.addEventListener('click', function () {
          var lastR = localStorage.getItem('sanparrilla_last_role') || window.__SP_STAFF_ROLE__ || 'mesero';
          var lastN = localStorage.getItem('sanparrilla_last_name') || window.__SP_STAFF_NAME__ || '';
          setQuickRole(lastR);
          if (qNameInput) qNameInput.value = lastN;
          if (qPinInput) qPinInput.value = '';
          if (qError) qError.classList.add('hidden');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          if (lastN && qPinInput) {
            setTimeout(function() { qPinInput.focus(); }, 80);
          } else if (qNameInput) {
            setTimeout(function() { qNameInput.focus(); }, 80);
          }
        });
      }
      function closeQuickModal() {
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
      if (closeBtn) closeBtn.addEventListener('click', closeQuickModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeQuickModal);

      var qRoleBtns = document.getElementById('quick-role-buttons');
      if (qRoleBtns) {
        qRoleBtns.addEventListener('click', function (e) {
          var btn = e.target.closest('button[data-qrole]');
          if (!btn) return;
          setQuickRole(btn.getAttribute('data-qrole') || 'mesero');
          if (qNameInput && qNameInput.value.trim() && qPinInput) {
            qPinInput.focus();
          } else if (qNameInput) {
            qNameInput.focus();
          }
        });
      }

      if (qNameInput) {
        qNameInput.addEventListener('input', function () {
          try {
            var val = qNameInput.value.trim();
            if (val) localStorage.setItem('sanparrilla_last_name', val);
          } catch (e) {}
        });
      }

      if (qForm) {
        qForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var r = qRoleInput ? qRoleInput.value : 'mesero';
          var n = qNameInput ? qNameInput.value.trim() : '';
          var p = qPinInput ? qPinInput.value.trim() : '';
          if (!n) {
            if (qError) {
              qError.textContent = 'Escribe tu nombre.';
              qError.classList.remove('hidden');
            }
            if (qNameInput) qNameInput.focus();
            return;
          }
          try {
            localStorage.setItem('sanparrilla_last_role', r);
            localStorage.setItem('sanparrilla_last_name', n);
          } catch (e) {}
          fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pin: p, role: r, name: n, next: window.location.pathname }),
          })
            .then(function (res) {
              return res.json().then(function (data) {
                return { ok: res.ok, data: data };
              });
            })
            .catch(function () {
              var adminPin = localStorage.getItem('sp_admin_pin') || '8989';
              var localOk =
                (r === 'mesero' && (p === '0000' || p === adminPin || p === '8989')) ||
                (r === 'cajero' && (p === '1111' || p === adminPin || p === '8989')) ||
                (r === 'admin' && (p === adminPin || p === '8989'));
              return { ok: localOk, data: { success: localOk, role: r, name: n } };
            })
            .then(function (result) {
              if (!result.ok || !result.data || !result.data.role) {
                if (qError) {
                  qError.textContent = 'PIN de 4 dígitos inválido para el rol seleccionado.';
                  qError.classList.remove('hidden');
                }
                return;
              }
              var newRole = result.data.role;
              var newName = result.data.name || n;
              var sessionData = {
                role: newRole,
                name: newName,
                iat: Date.now(),
                exp: Date.now() + 12 * 60 * 60 * 1000,
              };
              localStorage.setItem('sp_staff_session', JSON.stringify(sessionData));
              document.cookie = 'sp_role=' + newRole + '; path=/; max-age=' + 12 * 3600 + '; SameSite=Lax';
              document.cookie = 'sp_staff_name=' + encodeURIComponent(newName) + '; path=/; max-age=' + 12 * 3600 + '; SameSite=Lax';
              window.location.reload();
            });
        });
      }

      if (logoutBtn) {
        logoutBtn.addEventListener('click', function () {
          try {
            localStorage.removeItem('sp_staff_session');
            document.cookie = 'sp_role=; path=/; max-age=0; SameSite=Lax';
            document.cookie = 'sp_staff_name=; path=/; max-age=0; SameSite=Lax';
          } catch (e) {}
          fetch('/api/auth/logout', { method: 'POST' }).catch(function () {}).finally(function () {
            window.location.replace('/login');
          });
        });
      }

      // Agente de Impresión SAT Q22
      function downloadPrintAgentBat() {
        var origin = window.location.origin;
        var batLines = [
          '@echo off',
          'chcp 65001 >nul',
          'title San Parrilla POS - Agente de Impresion Automatica (SAT Q22)',
          'echo ============================================================',
          'echo      RESTAURANTE SAN PARRILLA - IMPRESION AUTOMATICA',
          'echo ============================================================',
          'echo  Servidor conectado: ' + origin,
          'echo  Impresora configurada: SAT Q22 (80mm)',
          'echo ============================================================',
          'echo.',
          'python --version >nul 2>&1',
          'if %errorlevel% neq 0 (',
          '    echo [ERROR] Python no esta instalado o no esta en el PATH.',
          '    echo Por favor instala Python 3 desde https://www.python.org/downloads/',
          '    echo marcando la casilla "Add Python to PATH".',
          '    pause',
          '    exit /b 1',
          ')',
          'set "DEST=%LOCALAPPDATA%\\SanParrillaImpresor"',
          'if not exist "%DEST%" mkdir "%DEST%"',
          'cd /d "%DEST%"',
          'echo [*] Configurando auto-inicio permanente con Windows (shell:startup)...',
          'set "STARTUP_FOLDER=%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup"',
          'if exist "%STARTUP_FOLDER%" (',
          '    powershell -NoProfile -ExecutionPolicy Bypass -Command "$ws = New-Object -ComObject WScript.Shell; $s = $ws.CreateShortcut(\'%STARTUP_FOLDER%\\SanParrillaImpresor.lnk\'); $s.TargetPath = \'%~f0\'; $s.WorkingDirectory = \'%DEST%\'; $s.Description = \'San Parrilla POS Impresor Automatico\'; $s.Save()" >nul 2>&1',
          '    echo [OK] Auto-inicio configurado: Iniciara automaticamente cada vez que se prenda el PC.',
          ')',
          'echo [*] Verificando librerias necesarias (requests, pywin32)...',
          'python -m pip install --quiet requests pywin32 >nul 2>&1',
          'echo [*] Descargando script print_agent.py actualizado...',
          'curl -s -o print_agent.py "' + origin + '/scripts/print_agent.py" || powershell -Command "Invoke-WebRequest -Uri \'' + origin + '/scripts/print_agent.py\' -OutFile \'print_agent.py\'"',
          'set "SP_API_URL=' + origin + '"',
          'set "SP_PRINTER_NAME=SAT Q22"',
          'echo.',
          'echo ============================================================',
          'echo  LISTO: El agente de impresion ya esta activo y escuchando.',
          'echo  NO TIENES QUE HACER NADA MAS.',
          'echo  Cada vez que se prenda el computador arrancara solo.',
          'echo ============================================================',
          'echo.',
          ':loop',
          'python print_agent.py',
          'echo.',
          'echo [!] El agente se detuvo inesperadamente. Reiniciando en 3 segundos...',
          'timeout /t 3 /nobreak >nul',
          'goto loop'
        ];
        var blob = new Blob([batLines.join('\r\n') + '\r\n'], { type: 'application/octet-stream' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Iniciar_Impresor_SAT_Q22.bat';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      }

      var globalPrintBtn = document.getElementById('btn-global-print-agent');
      var printModal = document.getElementById('modal-print-agent-help');
      var closePrintModalBtn = document.getElementById('btn-close-print-modal');
      var okPrintModalBtn = document.getElementById('btn-ok-print-modal');
      var downloadAgainBtn = document.getElementById('btn-download-print-agent-again');

      function openPrintAgentModal() {
        downloadPrintAgentBat();
        if (printModal) {
          printModal.classList.remove('hidden');
          printModal.classList.add('flex');
        }
      }

      function closePrintAgentModal() {
        if (printModal) {
          printModal.classList.add('hidden');
          printModal.classList.remove('flex');
        }
      }

      if (globalPrintBtn) globalPrintBtn.addEventListener('click', openPrintAgentModal);
      if (closePrintModalBtn) closePrintModalBtn.addEventListener('click', closePrintAgentModal);
      if (okPrintModalBtn) okPrintModalBtn.addEventListener('click', closePrintAgentModal);
      if (downloadAgainBtn) downloadAgainBtn.addEventListener('click', downloadPrintAgentBat);

      window.openPrintAgentModal = openPrintAgentModal;
    })();
  </script>
</BaseLayout>
