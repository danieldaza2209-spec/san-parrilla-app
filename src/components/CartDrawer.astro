---
/**
 * Carrito flotante de la carta del cliente.
 * 100% local (sin backend ni base de datos): el pedido se arma en el navegador
 * y se envía formateado por WhatsApp.
 *
 * Botones que lo alimentan: cualquier elemento con la clase `.btn-add-cart` y los
 * atributos `data-name`, `data-price` y `data-customizable="true|false"`.
 */
interface Props {
  specials: {
    sopa: string;
    principios: string[];
    acompanamientos: string[];
  };
  whatsappNumber?: string;
}

const { specials, whatsappNumber = '573183821787' } = Astro.props;

const fieldClass =
  'w-full min-h-[48px] py-3 px-4 bg-white rounded-xl border border-parrilla-border text-base font-medium text-parrilla-ivory placeholder:text-parrilla-muted focus:border-parrilla-gold focus:ring-2 focus:ring-orange-200 outline-none transition';
const labelClass = 'block text-sm font-semibold text-parrilla-ivory mb-1.5';
---

<!-- Notificación flotante rápida al agregar plato -->
<div
  id="cart-toast"
  class="fixed top-5 left-1/2 -translate-x-1/2 z-[70] bg-slate-900/95 text-white text-xs sm:text-sm font-bold px-4 py-2.5 rounded-full shadow-2xl flex items-center gap-2 transform -translate-y-16 opacity-0 pointer-events-none transition-all duration-300 no-print"
  role="status"
  aria-live="polite"
>
  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
  <span id="cart-toast-msg">Plato agregado al pedido</span>
</div>

<div
  id="cart-drawer"
  class="hidden fixed bottom-0 left-0 right-0 sm:bottom-4 sm:left-1/2 sm:right-auto sm:-translate-x-1/2 sm:w-[92%] sm:max-w-lg z-50 bg-white border-t-2 sm:border border-parrilla-gold rounded-t-2xl sm:rounded-2xl shadow-[0_-8px_30px_rgba(15,23,42,0.14)] sm:shadow-2xl overflow-hidden no-print"
  data-specials={JSON.stringify(specials)}
  data-whatsapp={whatsappNumber}
>
  <!-- Barra resumen -->
  <button
    type="button"
    id="cart-summary-trigger"
    class="w-full flex items-center justify-between gap-3 px-4 sm:px-5 py-4 min-h-[60px] bg-white sm:bg-orange-50 hover:bg-orange-50 sm:hover:bg-orange-100 transition-colors text-left"
    aria-expanded="false"
    aria-controls="cart-details-panel"
  >
    <span class="flex items-center gap-3">
      <i data-lucide="shopping-bag" class="w-5 h-5 text-parrilla-gold"></i>
      <span id="cart-count" class="font-semibold text-sm text-parrilla-ivory">0 platos</span>
      <span class="text-parrilla-muted">|</span>
      <span id="cart-total" class="font-display font-extrabold text-lg text-parrilla-gold">$0</span>
    </span>
    <span class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-parrilla-ivory">
      <span>Ver mi pedido</span>
      <i data-lucide="chevron-up" id="cart-chevron" class="w-4 h-4"></i>
    </span>
  </button>

  <!-- Detalle -->
  <div id="cart-details-panel" class="hidden border-t border-parrilla-border p-5 max-h-[70vh] overflow-y-auto">
    <div class="flex items-center justify-between border-b border-parrilla-border pb-2 mb-4">
      <h3 class="font-display font-bold text-lg text-parrilla-ivory">Tu Pedido</h3>
      <button type="button" id="clear-cart-btn" class="text-xs font-semibold text-parrilla-muted hover:text-red-600 transition px-2 py-2 min-h-[44px]">Vaciar</button>
    </div>

    <!-- Bloque Superior de Empaques en el Carrito (Solo Domicilio / Para Llevar) -->
    <div id="cart-top-packaging-box" class="hidden mb-4 bg-orange-50/80 border border-parrilla-gold/40 rounded-xl p-3.5 space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-extrabold uppercase tracking-wider text-parrilla-gold flex items-center gap-1.5">
          <i data-lucide="package" class="w-4 h-4 text-parrilla-gold"></i>
          <span>Empaques ($1.000 c/u)</span>
        </span>
        <span id="cart-top-packaging-count" class="text-xs font-bold text-parrilla-ivory bg-white border border-parrilla-gold/30 px-2 py-0.5 rounded-md shadow-2xs font-mono">
          0 empaques ($0)
        </span>
      </div>
      <p class="text-[11px] text-parrilla-muted leading-tight">
        Se cobra $1.000 por empaque en cada plato fuerte. Selecciona el empaque preferido para tu pedido:
      </p>
      <div class="grid grid-cols-2 gap-2 pt-0.5">
        <button
          type="button"
          id="btn-cart-pack-icopor"
          class="cart-pack-btn py-2 px-3 rounded-lg border text-xs font-extrabold transition flex items-center justify-center gap-1.5 cursor-pointer bg-parrilla-gold text-white border-parrilla-gold shadow-xs"
          data-type="Icopor"
        >
          <span>🥡 Icopor (Térmico)</span>
        </button>
        <button
          type="button"
          id="btn-cart-pack-caja"
          class="cart-pack-btn py-2 px-3 rounded-lg border text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer bg-white text-parrilla-ivory hover:text-parrilla-gold border-parrilla-border"
          data-type="Caja"
        >
          <span>📦 Caja</span>
        </button>
      </div>
    </div>

    <div id="cart-items-list" class="flex flex-col gap-3 mb-5"></div>

    <!-- Tipo de servicio -->
    <div class="border-t border-parrilla-border pt-4 mb-4">
      <label for="cart-service-type" class={labelClass}>Tipo de Servicio</label>
      <select id="cart-service-type" class={`${fieldClass} cursor-pointer`}>
        <option value="Mesa">Mesa (Comer en restaurante)</option>
        <option value="Domicilio">Domicilio (A casa)</option>
        <option value="Recoger">Recoger (Para llevar)</option>
      </select>
    </div>

    <!-- Datos del cliente / entrega / pago -->
    <div class="flex flex-col gap-3 mb-5">
      <div>
        <label for="cart-customer-name" class={labelClass}>Nombre</label>
        <input type="text" id="cart-customer-name" autocomplete="name" placeholder="Tu nombre" class={fieldClass} />
      </div>
      <div>
        <label for="cart-customer-phone" class={labelClass}>Teléfono</label>
        <input type="tel" id="cart-customer-phone" autocomplete="tel" inputmode="tel" placeholder="Ej: 300 123 4567" class={fieldClass} />
      </div>

      <!-- Solo Mesa -->
      <div id="field-table" class="hidden">
        <label for="cart-table-number" class={labelClass}>Número de mesa</label>
        <input type="text" id="cart-table-number" inputmode="numeric" maxlength="10" placeholder="Ej: 5" class={fieldClass} />
      </div>

      <!-- Solo Domicilio -->
      <div id="field-address" class="hidden">
        <label for="cart-customer-address" class={labelClass}>Dirección completa</label>
        <input type="text" id="cart-customer-address" autocomplete="street-address" placeholder="Calle / Carrera, número, apto o casa" class={fieldClass} />
      </div>
      <div id="field-neighborhood" class="hidden">
        <label for="cart-customer-neighborhood" class={labelClass}>Barrio / Indicaciones de entrega</label>
        <input type="text" id="cart-customer-neighborhood" placeholder="Barrio y referencias para encontrarte" class={fieldClass} />
      </div>
      <div id="field-cutlery" class="hidden">
        <label for="cart-cutlery" class={labelClass}>¿Incluir cubiertos plásticos?</label>
        <select id="cart-cutlery" class={`${fieldClass} cursor-pointer`}>
          <option value="No" selected>No</option>
          <option value="Sí">Sí</option>
        </select>
      </div>

      <!-- Método de pago -->
      <div>
        <label for="cart-payment-method" class={labelClass}>Método de pago</label>
        <select id="cart-payment-method" class={`${fieldClass} cursor-pointer`}>
          <option value="Efectivo">Efectivo</option>
          <option value="Nequi">Nequi</option>
          <option value="Daviplata">Daviplata</option>
          <option value="Bancolombia">Bancolombia</option>
        </select>
      </div>
      <!-- Solo Domicilio + Efectivo -->
      <div id="field-cash-amount" class="hidden">
        <label for="cart-cash-amount" class={labelClass}>¿Con cuánto vas a pagar? <span class="font-normal text-parrilla-muted">(Opcional, para llevar cambio)</span></label>
        <input type="text" id="cart-cash-amount" inputmode="numeric" placeholder="Ej: 50000" class={fieldClass} />
      </div>

      <p id="cart-form-error" class="hidden text-sm font-semibold text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2" role="alert"></p>
    </div>

    <!-- Desglose de precios -->
    <div class="flex flex-col gap-1.5 bg-slate-50 border border-parrilla-border rounded-xl px-4 py-3 mb-4 text-sm text-parrilla-muted">
      <div class="flex items-center justify-between">
        <span>Subtotal:</span>
        <span id="summary-subtotal" class="font-semibold text-parrilla-ivory">$0</span>
      </div>
      <div id="empaque-row" class="hidden items-center justify-between">
        <span id="summary-empaque-label">Empaques ($1.000 c/u):</span>
        <span id="summary-empaque" class="font-semibold text-parrilla-ivory">$0</span>
      </div>
      <div class="flex items-center justify-between border-t border-parrilla-border pt-2 mt-1 font-bold text-parrilla-ivory">
        <span>Total a pagar:</span>
        <span id="summary-total" class="font-display font-extrabold text-xl text-parrilla-gold">$0</span>
      </div>
    </div>

    <button
      type="button"
      id="whatsapp-checkout-btn"
      class="w-full inline-flex items-center justify-center gap-2 min-h-[48px] bg-parrilla-accent hover:bg-green-800 text-white font-display font-extrabold text-base px-4 py-3 rounded-xl shadow-md transition active:scale-95"
    >
      <i data-lucide="send" class="w-5 h-5"></i>
      <span>Enviar pedido por WhatsApp</span>
    </button>
  </div>
</div>

<script>
  // @ts-nocheck
  const drawer = document.getElementById('cart-drawer');
  if (drawer) {
    const specials = JSON.parse(drawer.dataset.specials || '{}');
    const whatsappNumber = drawer.dataset.whatsapp;

    const $ = (id) => document.getElementById(id);
    const summaryTrigger = $('cart-summary-trigger');
    const detailsPanel = $('cart-details-panel');
    const itemsList = $('cart-items-list');
    const countEl = $('cart-count');
    const totalEl = $('cart-total');
    const chevron = $('cart-chevron');
    const clearBtn = $('clear-cart-btn');
    const checkoutBtn = $('whatsapp-checkout-btn');

    const serviceSelect = $('cart-service-type');
    const nameInput = $('cart-customer-name');
    const phoneInput = $('cart-customer-phone');
    const tableInput = $('cart-table-number');
    const addressInput = $('cart-customer-address');
    const neighborhoodInput = $('cart-customer-neighborhood');
    const cutlerySelect = $('cart-cutlery');
    const paymentSelect = $('cart-payment-method');
    const cashAmountInput = $('cart-cash-amount');
    const fieldTable = $('field-table');
    const fieldAddress = $('field-address');
    const fieldNeighborhood = $('field-neighborhood');
    const fieldCutlery = $('field-cutlery');
    const fieldCashAmount = $('field-cash-amount');
    const formError = $('cart-form-error');

    const summarySubtotal = $('summary-subtotal');
    const summaryEmpaque = $('summary-empaque');
    const summaryEmpaqueLabel = $('summary-empaque-label');
    const summaryTotal = $('summary-total');
    const empaqueRow = $('empaque-row');

    const topPackagingBox = $('cart-top-packaging-box');
    const topPackagingCount = $('cart-top-packaging-count');
    const btnCartPackIcopor = $('btn-cart-pack-icopor');
    const btnCartPackCaja = $('btn-cart-pack-caja');
    let currentGlobalPackaging = 'Icopor'; // 'Icopor' | 'Caja' (Icopor por defecto)

    function updateTopPackagingButtonsUI() {
      if (!btnCartPackIcopor || !btnCartPackCaja) return;
      if (currentGlobalPackaging === 'Icopor') {
        btnCartPackIcopor.className =
          'cart-pack-btn py-2 px-3 rounded-lg border text-xs font-extrabold transition flex items-center justify-center gap-1.5 cursor-pointer bg-parrilla-gold text-white border-parrilla-gold shadow-xs';
        btnCartPackCaja.className =
          'cart-pack-btn py-2 px-3 rounded-lg border text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer bg-white text-parrilla-ivory hover:text-parrilla-gold border-parrilla-border';
      } else {
        btnCartPackCaja.className =
          'cart-pack-btn py-2 px-3 rounded-lg border text-xs font-extrabold transition flex items-center justify-center gap-1.5 cursor-pointer bg-parrilla-gold text-white border-parrilla-gold shadow-xs';
        btnCartPackIcopor.className =
          'cart-pack-btn py-2 px-3 rounded-lg border text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer bg-white text-parrilla-ivory hover:text-parrilla-gold border-parrilla-border';
      }
    }

    btnCartPackIcopor?.addEventListener('click', () => {
      currentGlobalPackaging = 'Icopor';
      updateTopPackagingButtonsUI();
      cart.forEach((it) => {
        if (it.customizable) it.packaging = 'Icopor';
      });
      updateCartUI();
    });

    btnCartPackCaja?.addEventListener('click', () => {
      currentGlobalPackaging = 'Caja';
      updateTopPackagingButtonsUI();
      cart.forEach((it) => {
        if (it.customizable) it.packaging = 'Caja';
      });
      updateCartUI();
    });

    const PACKAGING_FEE = 1000;
    const money = (n) => `$${n.toLocaleString('es-CO')}`;
    const escapeHtml = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const refreshIcons = () => { if (window.lucide) window.lucide.createIcons(); };

    let cart = [];

    // Feedback visual y micro-notificaciones
    let toastTimeout = null;
    function showCartToast(name) {
      const toast = $('cart-toast');
      const toastMsg = $('cart-toast-msg');
      if (!toast || !toastMsg) return;
      toastMsg.textContent = `✓ ${name} agregado al pedido`;
      toast.classList.remove('-translate-y-16', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('-translate-y-16', 'opacity-0');
      }, 2200);
    }

    function animateAddButton(btn) {
      if (!btn) return;
      btn.classList.add('ring-4', 'ring-emerald-400', 'bg-emerald-600', 'text-white', 'scale-110');
      setTimeout(() => {
        btn.classList.remove('ring-4', 'ring-emerald-400', 'bg-emerald-600', 'text-white', 'scale-110');
      }, 400);
    }

    function pulseCartSummary() {
      summaryTrigger.classList.add('bg-orange-100', 'scale-[1.02]');
      setTimeout(() => {
        summaryTrigger.classList.remove('bg-orange-100', 'scale-[1.02]');
      }, 350);
    }

    // ==========================================
    // MEMORIA DEL PEDIDO EN CURSO (localStorage)
    // Si el cliente recarga la página por accidente, el carrito sigue ahí.
    // ==========================================
    const CART_STATE_KEY = 'sanParrillaCart';
    const CART_STATE_TTL_MS = 6 * 60 * 60 * 1000; // 6 horas

    function saveCartState() {
      try {
        if (cart.length === 0) {
          localStorage.removeItem(CART_STATE_KEY);
          return;
        }
        localStorage.setItem(
          CART_STATE_KEY,
          JSON.stringify({
            savedAt: Date.now(),
            cart,
            globalPackaging: currentGlobalPackaging,
            service: serviceSelect.value,
            payment: paymentSelect.value,
            table: tableInput.value,
            cutlery: cutlerySelect.value,
            cash: cashAmountInput.value,
          })
        );
      } catch (err) {
        // localStorage no disponible: el carrito funciona igual, solo no se recuerda
      }
    }

    // Corrige elecciones que ya no existan (p. ej. si cambió el menú del día)
    function sanitizeItem(raw) {
      if (!raw || typeof raw.name !== 'string' || !Number.isFinite(raw.price)) return null;
      const soupDefault = specials.sopa ? `Con Sopa (${specials.sopa})` : 'Con Sopa';
      const item = {
        id: typeof raw.id === 'string' ? raw.id : `${Date.now()}${Math.random().toString(36).slice(2, 9)}`,
        name: raw.name,
        price: raw.price,
        customizable: Boolean(raw.customizable),
        soup: null,
        principle: null,
        side: null,
        salad: null,
        packaging: null,
        notes: typeof raw.notes === 'string' ? raw.notes : '',
      };
      if (item.customizable) {
        const principles = [...(specials.principios || []), 'Sin Principio'];
        const sides = [...(specials.acompanamientos || []), 'Sin Acompañamiento'];
        const salads = ['Con ensalada', 'Sin ensalada'];
        const packagings = ['Icopor', 'Caja'];

        item.soup = raw.soup === 'Sin Sopa' ? 'Sin Sopa' : soupDefault;
        item.principle = principles.includes(raw.principle) ? raw.principle : (principles[0] || 'Sin Principio');
        item.side = sides.includes(raw.side) ? raw.side : (sides[0] || 'Sin Acompañamiento');
        item.salad = salads.includes(raw.salad) ? raw.salad : 'Con ensalada';
        item.packaging = packagings.includes(raw.packaging) ? raw.packaging : 'Icopor';
      }
      return item;
    }

    function restoreCartState() {
      try {
        const saved = JSON.parse(localStorage.getItem(CART_STATE_KEY) || 'null');
        if (!saved || !Array.isArray(saved.cart) || Date.now() - saved.savedAt > CART_STATE_TTL_MS) {
          localStorage.removeItem(CART_STATE_KEY);
          return;
        }
        if (saved.globalPackaging === 'Caja' || saved.globalPackaging === 'Icopor') {
          currentGlobalPackaging = saved.globalPackaging;
        }
        cart = saved.cart.map(sanitizeItem).filter(Boolean);

        const setIfValid = (select, value) => {
          if (typeof value === 'string' && [...select.options].some((o) => o.value === value)) select.value = value;
        };
        setIfValid(serviceSelect, saved.service);
        setIfValid(paymentSelect, saved.payment);
        setIfValid(cutlerySelect, saved.cutlery);
        if (typeof saved.table === 'string') tableInput.value = saved.table;
        if (typeof saved.cash === 'string') cashAmountInput.value = saved.cash;
      } catch (err) {
        cart = [];
      }
    }

    // ==========================================
    // MEMORIA DEL CLIENTE (localStorage)
    // ==========================================
    const STORAGE_KEY = 'sanParrillaCustomer';
    const customerInputs = {
      name: nameInput,
      phone: phoneInput,
      address: addressInput,
      neighborhood: neighborhoodInput,
    };

    function loadSavedCustomer() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        Object.keys(customerInputs).forEach((key) => {
          const input = customerInputs[key];
          // Solo rellena campos vacíos para no pisar lo que el cliente está escribiendo
          if (input && !input.value && typeof saved[key] === 'string') input.value = saved[key];
        });
      } catch (err) {
        // localStorage no disponible o dañado: se ignora
      }
    }

    function saveCustomer() {
      try {
        const data = {};
        Object.keys(customerInputs).forEach((key) => {
          data[key] = customerInputs[key].value.trim();
        });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch (err) {
        // Modo privado / cuota llena: se ignora
      }
    }

    Object.values(customerInputs).forEach((input) => input.addEventListener('input', saveCustomer));

    // ==========================================
    // VALIDACIÓN / CAMPOS DINÁMICOS
    // ==========================================
    function hideFormError() {
      formError.classList.add('hidden');
      formError.textContent = '';
      drawer.querySelectorAll('input.border-red-500').forEach((el) => {
        el.classList.remove('border-red-500');
        el.classList.add('border-parrilla-border');
      });
    }

    function showFormError(message, field) {
      formError.textContent = message;
      formError.classList.remove('hidden');
      if (field) {
        field.classList.remove('border-parrilla-border');
        field.classList.add('border-red-500');
        field.focus();
      }
    }

    function updateOrderFields() {
      const service = serviceSelect.value;
      const isDelivery = service === 'Domicilio';
      const isTable = service === 'Mesa';
      const isCash = paymentSelect.value === 'Efectivo';

      fieldTable.classList.toggle('hidden', !isTable);
      fieldAddress.classList.toggle('hidden', !isDelivery);
      fieldNeighborhood.classList.toggle('hidden', !isDelivery);
      fieldCutlery.classList.toggle('hidden', !isDelivery);
      fieldCashAmount.classList.toggle('hidden', !(isDelivery && isCash));
      hideFormError();
    }

    [nameInput, phoneInput, tableInput, addressInput, neighborhoodInput, cashAmountInput].forEach((input) =>
      input.addEventListener('input', hideFormError)
    );

    // ==========================================
    // CARRITO
    // ==========================================
    const isToGo = () => serviceSelect.value === 'Domicilio' || serviceSelect.value === 'Recoger';

    function addToCart(name, price, customizable) {
      const soupDefault = specials.sopa ? `Con Sopa (${specials.sopa})` : 'Con Sopa';
      cart.push({
        id: `${Date.now()}${Math.random().toString(36).slice(2, 9)}`,
        name,
        price,
        customizable,
        soup: customizable ? soupDefault : null,
        principle: customizable ? (specials.principios?.[0] ?? 'Sin Principio') : null,
        side: customizable ? (specials.acompanamientos?.[0] ?? 'Sin Acompañamiento') : null,
        salad: customizable ? 'Con ensalada' : null,
        packaging: customizable ? currentGlobalPackaging : null,
        notes: '',
      });
      pulseCartSummary();
      updateCartUI();
    }

    function removeFromCart(id) {
      cart = cart.filter((item) => item.id !== id);
      updateCartUI();
    }

    const optionsHtml = (values, current) =>
      values
        .map((v) => `<option value="${escapeHtml(v.value)}" ${current === v.value ? 'selected' : ''}>${escapeHtml(v.label)}</option>`)
        .join('');

    function renderItem(item, index) {
      const soupDefault = specials.sopa ? `Con Sopa (${specials.sopa})` : 'Con Sopa';
      let html = `
        <div class="flex items-center justify-between gap-2">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5">
              <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-parrilla-gold/15 text-parrilla-gold font-display font-black text-xs">${index + 1}</span>
              <span class="font-bold text-sm sm:text-base text-parrilla-ivory truncate">${escapeHtml(item.name)}</span>
            </div>
            <span class="block text-xs sm:text-sm font-extrabold text-parrilla-gold mt-0.5 ml-6">${money(item.price)}</span>
          </div>
          <button type="button" class="btn-remove-item flex items-center justify-center w-9 h-9 rounded-full hover:bg-red-50 text-parrilla-muted hover:text-red-600 transition cursor-pointer" data-id="${item.id}" aria-label="Quitar ${escapeHtml(item.name)}">
            <i data-lucide="trash-2" class="w-4 h-4"></i>
          </button>
        </div>`;

      if (item.customizable) {
        const soupOptionsList = [
          { value: soupDefault, label: soupDefault },
          { value: 'Sin Sopa', label: 'Sin Sopa' },
        ];
        const soupHtml = optionsHtml(soupOptionsList, item.soup);

        const principleOptionsList = [
          ...(specials.principios || []).map((p) => ({ value: p, label: p })),
          { value: 'Sin Principio', label: 'Sin Principio' },
        ];
        const principleHtml = optionsHtml(principleOptionsList, item.principle);

        const sideOptionsList = [
          ...(specials.acompanamientos || []).map((a) => ({ value: a, label: a })),
          { value: 'Sin Acompañamiento', label: 'Sin Acompañamiento' },
        ];
        const sideHtml = optionsHtml(sideOptionsList, item.side);

        const saladOptionsList = [
          { value: 'Con ensalada', label: 'Con ensalada' },
          { value: 'Sin ensalada', label: 'Sin ensalada' },
        ];
        const saladHtml = optionsHtml(saladOptionsList, item.salad);

        const packagingOptionsList = [
          { value: 'Icopor', label: 'Icopor' },
          { value: 'Caja', label: 'Caja' },
        ];
        const packagingHtml = optionsHtml(packagingOptionsList, item.packaging || currentGlobalPackaging || 'Icopor');

        html += `
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2.5 pt-2.5 border-t border-dashed border-parrilla-border text-xs">
            <div>
              <label class="block text-[10px] font-bold text-parrilla-muted uppercase tracking-wider mb-1">🥣 Sopa</label>
              <select class="item-select w-full py-1.5 px-2 bg-white rounded-lg border border-parrilla-border text-xs font-semibold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="soup" data-id="${item.id}">
                ${soupHtml}
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-parrilla-muted uppercase tracking-wider mb-1">🍚 Principio</label>
              <select class="item-select w-full py-1.5 px-2 bg-white rounded-lg border border-parrilla-border text-xs font-semibold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="principle" data-id="${item.id}">
                ${principleHtml}
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-parrilla-muted uppercase tracking-wider mb-1">🍟 Acompañamiento</label>
              <select class="item-select w-full py-1.5 px-2 bg-white rounded-lg border border-parrilla-border text-xs font-semibold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="side" data-id="${item.id}">
                ${sideHtml}
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-parrilla-muted uppercase tracking-wider mb-1">🥗 Ensalada</label>
              <select class="item-select w-full py-1.5 px-2 bg-white rounded-lg border border-parrilla-border text-xs font-semibold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="salad" data-id="${item.id}">
                ${saladHtml}
              </select>
            </div>
            ${
              isToGo()
                ? `
            <div class="sm:col-span-2">
              <label class="block text-[10px] font-bold text-parrilla-muted uppercase tracking-wider mb-1">📦 Empaque</label>
              <select class="item-select w-full py-1.5 px-2 bg-white rounded-lg border border-parrilla-border text-xs font-semibold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="packaging" data-id="${item.id}">
                ${packagingHtml}
              </select>
            </div>`
                : ''
            }
            <div class="sm:col-span-2">
              <label class="block text-[10px] font-bold text-parrilla-muted uppercase tracking-wider mb-1">📝 Observaciones / Notas</label>
              <input type="text" class="item-notes w-full py-1.5 px-2.5 bg-white rounded-lg border border-parrilla-border text-xs text-parrilla-ivory placeholder:text-parrilla-muted focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none transition" data-id="${item.id}" placeholder="Ej: bien asado, sin cebolla..." value="${escapeHtml(item.notes || '')}">
            </div>
          </div>`;
      } else {
        html += `
          <div class="mt-2 pt-2 border-t border-dashed border-parrilla-border">
            <input type="text" class="item-notes w-full py-1.5 px-2.5 bg-white rounded-lg border border-parrilla-border text-xs text-parrilla-ivory placeholder:text-parrilla-muted focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none transition" data-id="${item.id}" placeholder="Nota opcional (ej: bien fría...)" value="${escapeHtml(item.notes || '')}">
          </div>
        `;
      }
      return html;
    }

    function updateCartUI() {
      itemsList.innerHTML = '';

      if (cart.length === 0) {
        drawer.classList.add('hidden');
        detailsPanel.classList.add('hidden');
        summaryTrigger.setAttribute('aria-expanded', 'false');
        chevron.setAttribute('data-lucide', 'chevron-up');
        document.body.classList.remove('pb-28');
        saveCartState();
        refreshIcons();
        return;
      }

      drawer.classList.remove('hidden');
      document.body.classList.add('pb-28'); // evita que el carrito tape el pie de página

      cart.forEach((item, index) => {
        const container = document.createElement('div');
        container.className = 'bg-slate-50 border border-parrilla-border rounded-xl p-3 shadow-2xs';
        container.innerHTML = renderItem(item, index);
        itemsList.appendChild(container);
      });

      const subtotal = cart.reduce((sum, item) => sum + item.price, 0);
      const foodPlatesCount = cart.filter((item) => item.customizable).length;
      const packagingFee = isToGo() ? foodPlatesCount * PACKAGING_FEE : 0;
      const total = subtotal + packagingFee;

      // Actualizar bloque superior de empaques en el carrito del cliente
      if (topPackagingBox) {
        const showTopBox = isToGo() && foodPlatesCount > 0;
        topPackagingBox.classList.toggle('hidden', !showTopBox);
        if (topPackagingCount) {
          topPackagingCount.textContent = `${foodPlatesCount} empaque${foodPlatesCount === 1 ? '' : 's'} (${money(packagingFee)})`;
        }
        updateTopPackagingButtonsUI();
      }

      summarySubtotal.textContent = money(subtotal);
      summaryEmpaque.textContent = money(packagingFee);
      if (summaryEmpaqueLabel) {
        summaryEmpaqueLabel.textContent = `Empaques (${foodPlatesCount} x ${money(PACKAGING_FEE)}):`;
      }
      summaryTotal.textContent = money(total);
      empaqueRow.classList.toggle('hidden', packagingFee === 0);
      empaqueRow.classList.toggle('flex', packagingFee > 0);

      countEl.textContent = `${cart.length} plato${cart.length > 1 ? 's' : ''}`;
      totalEl.textContent = money(total);

      saveCartState();
      refreshIcons();
    }

    // ==========================================
    // EVENTOS
    // ==========================================
    // Agregar platos desde la carta (1-CLIC: cero modales, respuesta táctil inmediata)
    document.addEventListener('click', (event) => {
      const btn = event.target.closest('.btn-add-cart');
      if (!btn || btn.disabled) return;
      const price = parseInt(btn.dataset.price, 10);
      if (Number.isNaN(price)) return;
      const name = btn.dataset.name || 'Plato';
      const customizable = btn.dataset.customizable === 'true';

      addToCart(name, price, customizable);
      animateAddButton(btn);
      showCartToast(name);
    });

    // Quitar plato
    itemsList.addEventListener('click', (event) => {
      const btn = event.target.closest('.btn-remove-item');
      if (btn) removeFromCart(btn.dataset.id);
    });

    // Cambiar elección de un plato (sopa, principio, acompañamiento, ensalada, empaque)
    itemsList.addEventListener('change', (event) => {
      const select = event.target.closest('.item-select');
      if (!select) return;
      const item = cart.find((i) => i.id === select.dataset.id);
      if (item) {
        item[select.dataset.field] = select.value;
        saveCartState();
      }
    });

    // Notas de un plato en tiempo real
    itemsList.addEventListener('input', (event) => {
      const input = event.target.closest('.item-notes');
      if (!input) return;
      const item = cart.find((i) => i.id === input.dataset.id);
      if (item) {
        item.notes = input.value;
        saveCartState();
      }
    });

    // Guarda también los campos del pedido (servicio, mesa, pago, cubiertos, monto)
    drawer.addEventListener('input', saveCartState);
    drawer.addEventListener('change', saveCartState);

    summaryTrigger.addEventListener('click', () => {
      detailsPanel.classList.toggle('hidden');
      const open = !detailsPanel.classList.contains('hidden');
      summaryTrigger.setAttribute('aria-expanded', String(open));
      chevron.setAttribute('data-lucide', open ? 'chevron-down' : 'chevron-up');
      if (open) loadSavedCustomer();
      refreshIcons();
    });

    serviceSelect.addEventListener('change', () => {
      updateOrderFields();
      updateCartUI();
    });
    paymentSelect.addEventListener('change', updateOrderFields);

    clearBtn.addEventListener('click', () => {
      cart = [];
      updateCartUI();
    });

    // ==========================================
    // ENVÍO POR WHATSAPP
    // ==========================================
    checkoutBtn.addEventListener('click', async () => {
      if (cart.length === 0) return;

      const service = serviceSelect.value;
      const isDelivery = service === 'Domicilio';
      const isTable = service === 'Mesa';
      const subtotal = cart.reduce((sum, item) => sum + item.price, 0);
      const foodPlatesCount = cart.filter((item) => item.customizable).length;
      const packagingFee = isToGo() ? foodPlatesCount * PACKAGING_FEE : 0;
      const total = subtotal + packagingFee;
      const paymentMethod = paymentSelect.value;
      const isCash = paymentMethod === 'Efectivo';

      hideFormError();
      const customerName = nameInput.value.trim();
      const customerPhone = phoneInput.value.trim();
      const tableNumber = tableInput.value.trim();
      const address = addressInput.value.trim();
      const neighborhood = neighborhoodInput.value.trim();
      const cashDigits = cashAmountInput.value.replace(/\D/g, '');
      const cashAmount = cashDigits ? parseInt(cashDigits, 10) : 0;

      if (!customerName) return showFormError('Por favor escribe tu nombre.', nameInput);
      if (!customerPhone) return showFormError('Por favor escribe tu teléfono.', phoneInput);
      if (isTable && !tableNumber) return showFormError('Indica el número de tu mesa.', tableInput);
      if (isDelivery && !address) return showFormError('Escribe la dirección completa de entrega.', addressInput);
      if (isDelivery && !neighborhood) return showFormError('Escribe tu barrio o indicaciones de entrega.', neighborhoodInput);
      if (isDelivery && isCash && cashAmount > 0 && cashAmount < total) {
        return showFormError(`El monto con el que pagas debe ser mayor o igual al total (${money(total)}).`, cashAmountInput);
      }

      saveCustomer();

      checkoutBtn.disabled = true;
      const originalBtnText = checkoutBtn.innerHTML;
      checkoutBtn.innerHTML = '<span>Generando pedido...</span>';

      // 1. Guardar como borrador web en backend (BORRADOR_WEB) para el cajero
      let generatedCode = '';
      try {
        const orderTypeEnum = isDelivery ? 'DOMICILIO' : (service === 'Recoger' ? 'PARA_LLEVAR' : 'EN_MESA');
        const notesArr = [];
        if (isDelivery) {
          notesArr.push(`Dir: ${address}`);
          if (neighborhood) notesArr.push(`Barrio: ${neighborhood}`);
          notesArr.push(`Cubiertos: ${cutlerySelect.value}`);
        }
        if (isTable) notesArr.push(`Mesa: ${tableNumber}`);

        const draftPayload = {
          cliente_nombre: customerName,
          cliente_telefono: customerPhone,
          mesa: isTable ? tableNumber : null,
          tipo: orderTypeEnum,
          delivery_fee: 0,
          packaging_fee: packagingFee,
          es_borrador_web: true,
          notas: notesArr.join(' | '),
          detalles: cart.map(item => {
            let sideNotes = '';
            if (item.customizable) {
              const parts = [
                item.soup || '',
                item.principle ? `Principio: ${item.principle}` : '',
                item.side ? `Acomp: ${item.side}` : '',
                item.salad || 'Con ensalada',
              ];
              if (isToGo()) parts.push(`Empaque: ${item.packaging || currentGlobalPackaging || 'Icopor'}`);
              if (item.notes && item.notes.trim()) parts.push(`Nota: ${item.notes.trim()}`);
              sideNotes = parts.filter(Boolean).join(' | ');
            } else if (item.notes && item.notes.trim()) {
              sideNotes = item.notes.trim();
            }
            return {
              plato_id: 1,
              cantidad: 1,
              notas_item: `${item.name}${sideNotes ? ' - ' + sideNotes : ''}`
            };
          })
        };

        const draftRes = await fetch('/api/pedidos/?es_borrador_web=true', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(draftPayload)
        });

        if (draftRes.ok) {
          const draftData = await draftRes.json();
          if (draftData && draftData.codigo_pedido) {
            generatedCode = draftData.codigo_pedido;
          }
        }
      } catch (err) {
        console.warn('Nota: Envío directo a WhatsApp sin persistir en backend.');
      }

      // 2. Construir mensaje de WhatsApp
      let text = '';
      if (generatedCode) {
        text += `🔖 *CÓDIGO DE PEDIDO:* ${generatedCode}\n`;
        text += `_(Dile este código al cajero cuando te contacte)_\n\n`;
      }
      text += '🛒 *NUEVO PEDIDO - SAN PARRILLA*\n\n';
      text += `👤 *Nombre:* ${customerName}\n`;
      text += `📞 *Teléfono:* ${customerPhone}\n`;

      const serviceEmoji = isDelivery ? '🛵' : service === 'Recoger' ? '🛍️' : '🍽️';
      text += `${serviceEmoji} *Tipo de Servicio:* ${service}\n`;
      if (isTable) text += `🪑 *Mesa:* ${tableNumber}\n`;
      if (isDelivery) {
        text += `📍 *Dirección:* ${address}\n`;
        text += `🏘️ *Barrio / Indicaciones:* ${neighborhood}\n`;
        text += `🍴 *Cubiertos plásticos:* ${cutlerySelect.value}\n`;
      }

      text += `\n💳 *Método de pago:* ${paymentMethod}\n`;
      if (isDelivery && isCash && cashAmount > 0) {
        text += `💵 *Paga con:* ${money(cashAmount)} (cambio: ${money(cashAmount - total)})\n`;
      }

      text += '\n📋 *PEDIDO*\n\n';
      cart.forEach((item, index) => {
        text += `*${index + 1}. ${item.name}* (${money(item.price)})\n`;
        if (item.customizable) {
          text += `   🥣 Sopa: ${item.soup || 'No elegida'}\n`;
          text += `   🍚 Principio: ${item.principle || 'No elegido'}\n`;
          text += `   🍟 Acompañante: ${item.side || 'No elegido'}\n`;
          text += `   🥗 Ensalada: ${item.salad || 'Con ensalada'}\n`;
          if (isToGo()) {
            text += `   📦 Empaque: ${item.packaging || currentGlobalPackaging || 'Icopor'}\n`;
          }
          if (item.notes && item.notes.trim()) {
            text += `   📝 Nota: ${item.notes.trim()}\n`;
          }
        } else if (item.notes && item.notes.trim()) {
          text += `   📝 Nota: ${item.notes.trim()}\n`;
        }
        text += '\n';
      });

      text += `🧾 *Subtotal:* ${money(subtotal)}\n`;
      if (packagingFee > 0) {
        text += `📦 *Costo de Empaque:* ${money(packagingFee)} ($1.000 x ${foodPlatesCount} plato${foodPlatesCount > 1 ? 's' : ''})\n`;
      }
      text += `💰 *TOTAL A PAGAR:* ${money(total)}\n\n`;
      text += '¡Muchas gracias! Espero mi confirmación del pedido por este medio.';

      checkoutBtn.disabled = false;
      checkoutBtn.innerHTML = originalBtnText;

      window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`, '_blank');
    });

    // Estado inicial: datos del cliente + pedido en curso (si lo había)
    loadSavedCustomer();
    restoreCartState();
    updateOrderFields();
    updateCartUI();

    function syncSpecialsInCart(data) {
      if (!data || typeof data !== 'object') return;
      const newSopa = String(data.sopa_dia || data.sopa || '').trim();
      const newPrincipios = Array.isArray(data.principios)
        ? data.principios
        : (typeof data.principios === 'string' ? data.principios.split(',').map((s) => s.trim()).filter(Boolean) : []);
      const newAcomp = Array.isArray(data.acompanamientos)
        ? data.acompanamientos
        : (typeof data.acompanamientos === 'string' ? data.acompanamientos.split(',').map((s) => s.trim()).filter(Boolean) : []);

      if (newSopa) specials.sopa = newSopa;
      if (newPrincipios.length > 0) specials.principios = newPrincipios;
      if (newAcomp.length > 0) specials.acompanamientos = newAcomp;

      if (cart.length > 0) {
        cart = cart.map(sanitizeItem).filter(Boolean);
        updateCartUI();
      }
    }

    window.addEventListener('sp:specials-updated', (ev) => {
      if (ev && ev.detail) {
        syncSpecialsInCart(ev.detail);
      }
    });

    try {
      const cachedSpec = JSON.parse(localStorage.getItem('sp_daily_specials_v1') || 'null');
      if (cachedSpec) syncSpecialsInCart(cachedSpec);
    } catch (e) {}
  }
</script>
