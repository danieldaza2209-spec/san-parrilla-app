---
/**
 * Vista "⚡ Pedidos Rápidos"
 * Replica la estructura y distribución del diseño de referencia en PALETA CLARA:
 * 1. ACOMPAÑA TU PROTEÍNA - Especiales de Hoy (3 tarjetas: Sopa del Día, Principios, Acompañamientos)
 * 2. ELIGE TU PROTEÍNA - Nuestro Menú (Tarjetas por rango de precio con botón "+" táctil de 40x40px e insignias destacadas)
 * 3. PARA COMPARTIR - Picadas Especiales (y Bebidas/Adicionales)
 */
interface Product {
  id: string;
  name: string;
  price: number;
  category_id: string;
  description?: string;
  is_active?: number;
  is_featured?: number;
  special_badge?: string;
}

interface DailySpecials {
  sopa: string;
  principios: string[];
  acompanamientos: string[];
}

interface Props {
  products: Product[];
  dailySpecials: DailySpecials;
  customizableCategories: Set<string>;
}

const { products = [], dailySpecials, customizableCategories } = Astro.props;

const formatPrice = (val: number) =>
  new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);

// Agrupar platos fuertes por rango de precio ($16.500, $17.500, $18.000, $21.000, $22.000, $23.000, $27.500, $33.000)
const mainDishes = products.filter((p) => customizableCategories.has(p.category_id));
const priceLevels = Array.from(new Set(mainDishes.map((p) => p.price))).sort((a, b) => a - b);

const priceColumns = priceLevels.map((price) => {
  const items = mainDishes.filter((p) => p.price === price);
  const regularItems = items.filter((p) => !p.special_badge);
  const specialItems = items.filter((p) => Boolean(p.special_badge));
  const badgeLabel = specialItems[0]?.special_badge || '⭐ SOLO POR HOY';

  return {
    price,
    label: formatPrice(price),
    regularItems,
    specialItems,
    badgeLabel,
  };
});

const picadas = products.filter((p) => p.category_id === 'picadas');
const bebidas = products.filter((p) => p.category_id === 'bebidas');
---

<div id="quick-order-view" class="space-y-16">
  <!-- =========================================================
       1. SECCIÓN SUPERIOR: ACOMPAÑA TU PROTEÍNA - Especiales de Hoy
       ========================================================= -->
  {dailySpecials && (
    <section aria-labelledby="heading-especiales-hoy" class="space-y-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1.5">
          ACOMPAÑA TU PROTEÍNA
        </span>
        <h2 id="heading-especiales-hoy" class="font-display font-black text-3xl sm:text-4xl text-parrilla-ivory">
          Especiales de Hoy
        </h2>
        <p class="text-sm sm:text-base text-parrilla-muted mt-2">
          Todos los platos fuertes del menú incluyen la sopa, principio y acompañamiento del día.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        <!-- Tarjeta 1: SOPA DEL DÍA -->
        <div class="bg-white rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-5 sm:p-6 shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center">
          <div class="w-12 h-12 rounded-full bg-orange-50 border border-orange-200 flex items-center justify-center text-parrilla-gold mb-3 sm:mb-4">
            <i data-lucide="soup" class="w-5 h-5"></i>
          </div>
          <span class="text-xs font-bold uppercase tracking-widest text-parrilla-muted">
            SOPA DEL DÍA
          </span>
          <h3 class="font-display font-black text-2xl sm:text-3xl text-parrilla-ivory mt-1">
            {dailySpecials.sopa}
          </h3>
          <p class="text-xs sm:text-sm text-parrilla-muted mt-1.5 max-w-xs leading-relaxed">
            Con el sabor casero tradicional de nuestro fogón.
          </p>
        </div>

        <!-- Tarjeta 2: PRINCIPIOS -->
        <div class="bg-white rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-5 sm:p-6 shadow-sm hover:shadow-md transition flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-orange-50 border border-orange-200 flex items-center justify-center text-parrilla-gold mb-3 sm:mb-4">
            <i data-lucide="beef" class="w-5 h-5"></i>
          </div>
          <span class="text-xs font-bold uppercase tracking-widest text-parrilla-muted mb-3">
            PRINCIPIOS
          </span>
          <ul class="space-y-2.5 text-left w-full max-w-[240px]">
            {dailySpecials.principios.map((p) => (
              <li class="flex items-center gap-2.5 text-base font-medium text-parrilla-ivory">
                <i data-lucide="check" class="w-4 h-4 text-parrilla-gold flex-shrink-0"></i>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tarjeta 3: ACOMPAÑAMIENTOS -->
        <div class="bg-white rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-5 sm:p-6 shadow-sm hover:shadow-md transition flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-orange-50 border border-orange-200 flex items-center justify-center text-parrilla-gold mb-3 sm:mb-4">
            <i data-lucide="salad" class="w-5 h-5"></i>
          </div>
          <span class="text-xs font-bold uppercase tracking-widest text-parrilla-muted mb-3">
            ACOMPAÑAMIENTOS
          </span>
          <ul class="space-y-2.5 text-left w-full max-w-[240px]">
            {dailySpecials.acompanamientos.map((a) => (
              <li class="flex items-center gap-2.5 text-base font-medium text-parrilla-ivory">
                <i data-lucide="check" class="w-4 h-4 text-parrilla-gold flex-shrink-0"></i>
                <span>{a}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- =========================================================
       2. SECCIÓN CENTRAL: ELIGE TU PROTEÍNA - Nuestro Menú
       ========================================================= -->
  <section aria-labelledby="heading-nuestro-menu" class="space-y-8">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1.5">
        ELIGE TU PROTEÍNA
      </span>
      <h2 id="heading-nuestro-menu" class="font-display font-black text-3xl sm:text-4xl text-parrilla-ivory">
        Nuestro Menú
      </h2>
      <p class="text-sm sm:text-base text-parrilla-muted mt-2">
        Selecciona tu plato fuerte. Los precios corresponden a la categoría de la proteína elegida.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 items-start">
      {priceColumns.map((col) => (
        <div class="bg-white rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-5 sm:p-6 shadow-sm hover:shadow-md transition flex flex-col">
          <!-- Encabezado con Precio en Grande y Naranja -->
          <div class="text-center border-b border-parrilla-border pb-4 mb-2">
            <span class="font-display font-black text-3xl sm:text-4xl text-parrilla-gold tracking-tight">
              {col.label}
            </span>
          </div>

          <!-- Lista de platos del rango de precio -->
          <ul>
            {col.regularItems.map((item) => (
              <li class="py-3 border-b border-gray-100 last:border-b-0 flex items-center justify-between gap-3">
                <span class="text-base font-medium text-parrilla-ivory leading-snug">
                  {item.name}
                </span>

                <button
                  type="button"
                  data-name={item.name}
                  data-price={item.price}
                  data-customizable="true"
                  aria-label={`Agregar ${item.name} al pedido`}
                  class="btn-add-cart flex-shrink-0 w-11 h-11 min-w-[44px] min-h-[44px] p-2.5 rounded-xl bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center shadow-2xs transition active:scale-95 cursor-pointer"
                >
                  <i data-lucide="plus" class="w-5 h-5"></i>
                </button>
              </li>
            ))}
          </ul>

          <!-- Recuadro de Destacados del Día (ej. ⭐ SOLO POR HOY / ⭐ SOLO LOS LUNES) -->
          {col.specialItems.length > 0 && (
            <div class="relative mt-5 pt-4 pb-1 px-4 rounded-xl border-2 border-parrilla-gold/60 bg-orange-50/40">
              <span class="absolute -top-3 left-3.5 bg-parrilla-gold text-white text-[11px] font-extrabold uppercase tracking-wider px-3 py-0.5 rounded-md shadow-xs">
                {col.badgeLabel}
              </span>

              <ul>
                {col.specialItems.map((item) => (
                  <li class="py-3 border-b border-orange-200/50 last:border-b-0 flex items-center justify-between gap-3">
                    <span class="text-base font-bold text-parrilla-ivory leading-snug">
                      {item.name}
                    </span>

                    <button
                      type="button"
                      data-name={item.name}
                      data-price={item.price}
                      data-customizable="true"
                      aria-label={`Agregar ${item.name} al pedido`}
                      class="btn-add-cart flex-shrink-0 w-11 h-11 min-w-[44px] min-h-[44px] p-2.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white border border-parrilla-gold flex items-center justify-center shadow-xs transition active:scale-95 cursor-pointer"
                    >
                      <i data-lucide="plus" class="w-5 h-5"></i>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- =========================================================
       3. SECCIÓN INFERIOR: PARA COMPARTIR - Picadas Especiales
       ========================================================= -->
  {picadas.length > 0 && (
    <section aria-labelledby="heading-picadas" class="space-y-8">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1.5">
          PARA COMPARTIR
        </span>
        <h2 id="heading-picadas" class="font-display font-black text-3xl sm:text-4xl text-parrilla-ivory">
          Picadas Especiales
        </h2>
        <p class="text-sm sm:text-base text-parrilla-muted mt-2">
          Las mejores combinaciones de carne para compartir.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {picadas.map((item) => (
          <div
            class:list={[
              'bg-white rounded-2xl border p-5 sm:p-6 shadow-sm hover:shadow-md transition flex items-center justify-between gap-4',
              item.is_featured === 1
                ? 'border-parrilla-gold bg-orange-50/20'
                : 'border-parrilla-border',
            ]}
          >
            <div class="min-w-0 flex-1">
              {item.is_featured === 1 && (
                <span class="inline-block bg-parrilla-gold text-white text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full mb-1.5">
                  ⭐ ¡La más buscada!
                </span>
              )}
              <h3 class="font-display font-black text-xl text-parrilla-ivory">
                {item.name}
              </h3>
              {item.description && (
                <p class="text-xs sm:text-sm text-parrilla-muted mt-1 leading-relaxed">
                  {item.description}
                </p>
              )}
            </div>

            <div class="flex items-center gap-3 flex-shrink-0">
              <span class="font-display font-black text-xl sm:text-2xl text-parrilla-gold">
                {formatPrice(item.price)}
              </span>
              <button
                type="button"
                data-name={item.name}
                data-price={item.price}
                data-customizable="false"
                aria-label={`Agregar ${item.name} al pedido`}
                class="btn-add-cart flex-shrink-0 w-11 h-11 min-w-[44px] min-h-[44px] p-2.5 rounded-xl bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center shadow-2xs transition active:scale-95 cursor-pointer"
              >
                <i data-lucide="plus" class="w-5 h-5"></i>
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Bebidas y Adicionales -->
  {bebidas.length > 0 && (
    <section aria-labelledby="heading-bebidas" class="space-y-6">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1.5">
          PARA ACOMPAÑAR
        </span>
        <h2 id="heading-bebidas" class="font-display font-black text-2xl sm:text-3xl text-parrilla-ivory">
          Bebidas y Adicionales
        </h2>
      </div>

      <div class="bg-white rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-5 sm:p-6 shadow-sm">
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8">
          {bebidas.map((item) => (
            <li class="py-3 flex items-center justify-between gap-3 border-b border-gray-100 last:border-b-0">
              <div class="min-w-0 flex-1">
                <span class="text-base font-medium text-parrilla-ivory block">
                  {item.name}
                </span>
                {item.description && (
                  <span class="text-xs text-parrilla-muted block truncate">{item.description}</span>
                )}
              </div>
              <div class="flex items-center gap-3 flex-shrink-0">
                <span class="font-display font-bold text-base sm:text-lg text-parrilla-gold">
                  {formatPrice(item.price)}
                </span>
                <button
                  type="button"
                  data-name={item.name}
                  data-price={item.price}
                  data-customizable="false"
                  aria-label={`Agregar ${item.name} al pedido`}
                  class="btn-add-cart w-10 h-10 rounded-full bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center shadow-2xs transition active:scale-90 cursor-pointer"
                >
                  <i data-lucide="plus" class="w-5 h-5"></i>
                </button>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</div>
