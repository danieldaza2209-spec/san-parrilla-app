---
/**
 * Vista "⚡ Pedidos Rápidos"
 * Replica exactamente la distribución de 3 columnas en "Especiales de Hoy" y
 * 2 columnas de precios lado a lado desde móvil (grid-cols-2 base), en PALETA CLARA.
 */
interface Product {
  id: string;
  name: string;
  price: number;
  category_id: string;
  description?: string;
  is_active?: number;
  is_featured?: number;
  special_badge?: string;
}

interface DailySpecials {
  sopa: string;
  principios: string[];
  acompanamientos: string[];
  mostrar_rotativos_16k?: boolean;
  mostrar_rotativo_fin_semana?: boolean;
}

interface Props {
  products: Product[];
  dailySpecials: DailySpecials;
  customizableCategories: Set<string>;
  showDesayunos?: boolean;
}

const {
  products = [],
  dailySpecials,
  customizableCategories,
  showDesayunos = true,
} = Astro.props;

const formatPrice = (val: number) =>
  new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);

// Agrupar platos fuertes por rango de precio ($16.500, $17.500, $18.000, $21.000, $22.000, $23.000, $27.500, $33.000)
const mainDishes = products.filter((p) => customizableCategories.has(p.category_id));
const priceLevels = Array.from(new Set(mainDishes.map((p) => p.price))).sort((a, b) => a - b);

const priceColumns = priceLevels.map((price) => {
  const items = mainDishes.filter((p) => p.price === price);
  const regularItems = items.filter((p) => !p.special_badge);
  const specialItems = items.filter((p) => Boolean(p.special_badge));
  const badgeLabel = specialItems[0]?.special_badge || '⭐ SOLO POR HOY';

  return {
    price,
    label: formatPrice(price),
    regularItems,
    specialItems,
    badgeLabel,
  };
});

const picadas = products.filter((p) => p.category_id === 'picadas');
const bebidas = products.filter((p) => p.category_id === 'bebidas');
const desayunos = showDesayunos
  ? products.filter(
      (p) => p.category_id === 'desayunos' || (p.name && p.name.toLowerCase().includes('desayuno') && !p.name.toLowerCase().includes('clínica'))
    )
  : [];
---

<div id="quick-order-view" class="space-y-10 sm:space-y-14" data-public-menu={showDesayunos ? 'false' : 'true'}>
  <!-- =========================================================
       1. SECCIÓN SUPERIOR: ACOMPAÑA TU PROTEÍNA - Especiales de Hoy
          (3 columnas lado a lado incluso en móvil: grid-cols-3)
       ========================================================= -->
  {dailySpecials && (
    <section aria-labelledby="heading-especiales-hoy" class="space-y-4 sm:space-y-6">
      <div class="text-center max-w-2xl mx-auto px-2">
        <span class="text-[10px] sm:text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1">
          ACOMPAÑA TU PROTEÍNA
        </span>
        <h2 id="heading-especiales-hoy" class="font-display font-black text-2xl sm:text-4xl text-parrilla-ivory">
          Especiales de Hoy
        </h2>
        <p class="text-xs sm:text-sm text-parrilla-muted mt-1">
          Todos los platos fuertes del menú incluyen la sopa, principio y acompañamiento del día.
        </p>
      </div>

      <div class="grid grid-cols-3 gap-2 sm:gap-5 px-1 sm:px-2 items-stretch">
        <!-- Tarjeta 1: SOPA DEL DÍA -->
        <div class="bg-white rounded-xl sm:rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-2.5 sm:p-6 shadow-sm text-center flex flex-col items-center justify-start">
          <div class="w-7 h-7 sm:w-11 sm:h-11 rounded-full bg-orange-50 border border-orange-200 flex items-center justify-center text-parrilla-gold mb-1.5 sm:mb-3">
            <i data-lucide="soup" class="w-3.5 h-3.5 sm:w-5 sm:h-5"></i>
          </div>
          <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-parrilla-muted">
            SOPA DEL DÍA
          </span>
          <h3 data-special-sopa class="font-display font-black text-sm sm:text-2xl text-parrilla-ivory mt-1 leading-tight">
            {dailySpecials.sopa}
          </h3>
        </div>

        <!-- Tarjeta 2: PRINCIPIOS -->
        <div class="bg-white rounded-xl sm:rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-2.5 sm:p-6 shadow-sm flex flex-col items-center justify-start">
          <div class="w-7 h-7 sm:w-11 sm:h-11 rounded-full bg-orange-50 border border-orange-200 flex items-center justify-center text-parrilla-gold mb-1.5 sm:mb-3">
            <i data-lucide="beef" class="w-3.5 h-3.5 sm:w-5 sm:h-5"></i>
          </div>
          <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-parrilla-muted mb-1.5 sm:mb-3 text-center">
            PRINCIPIOS
          </span>
          <ul data-special-principios class="space-y-1 sm:space-y-2 text-left w-full">
            {dailySpecials.principios.map((p) => (
              <li class="flex items-start gap-1 sm:gap-2 text-[11px] sm:text-sm font-medium text-parrilla-ivory leading-tight">
                <i data-lucide="check" class="w-3 h-3 sm:w-4 sm:h-4 text-parrilla-gold flex-shrink-0 mt-0.5"></i>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tarjeta 3: ACOMPAÑAMIENTOS -->
        <div class="bg-white rounded-xl sm:rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-2.5 sm:p-6 shadow-sm flex flex-col items-center justify-start">
          <div class="w-7 h-7 sm:w-11 sm:h-11 rounded-full bg-orange-50 border border-orange-200 flex items-center justify-center text-parrilla-gold mb-1.5 sm:mb-3">
            <i data-lucide="salad" class="w-3.5 h-3.5 sm:w-5 sm:h-5"></i>
          </div>
          <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-parrilla-muted mb-1.5 sm:mb-3 text-center">
            ACOMPAÑAMIENTOS
          </span>
          <ul data-special-acompanamientos class="space-y-1 sm:space-y-2 text-left w-full">
            {dailySpecials.acompanamientos.map((a) => (
              <li class="flex items-start gap-1 sm:gap-2 text-[11px] sm:text-sm font-medium text-parrilla-ivory leading-tight">
                <i data-lucide="check" class="w-3 h-3 sm:w-4 sm:h-4 text-parrilla-gold flex-shrink-0 mt-0.5"></i>
                <span>{a}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- =========================================================
       2. SECCIÓN CENTRAL: ELIGE TU PROTEÍNA - Nuestro Menú
          (Obligatorio 2 columnas desde móvil: grid-cols-2)
       ========================================================= -->
  <section aria-labelledby="heading-nuestro-menu" class="space-y-4 sm:space-y-6">
    <div class="text-center max-w-2xl mx-auto px-2">
      <span class="text-[10px] sm:text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1">
        ELIGE TU PROTEÍNA
      </span>
      <h2 id="heading-nuestro-menu" class="font-display font-black text-2xl sm:text-4xl text-parrilla-ivory">
        Nuestro Menú
      </h2>
      <p class="text-xs sm:text-sm text-parrilla-muted mt-1">
        Selecciona tu plato fuerte. Los precios corresponden a la categoría de la proteína elegida.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-2.5 sm:gap-5 px-1 sm:px-2 items-start">
      {priceColumns.map((col) => (
        <div class="bg-white rounded-xl sm:rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-2.5 sm:p-5 shadow-sm flex flex-col" data-price-column={col.price}>
          <!-- Encabezado con Precio en Grande y Naranja -->
          <div class="text-center border-b border-parrilla-border pb-2 sm:pb-3 mb-1.5 sm:mb-2">
            <span class="font-display font-black text-lg sm:text-3xl text-parrilla-gold tracking-tight">
              {col.label}
            </span>
          </div>

          <!-- Lista de platos del rango de precio -->
          <ul>
            {col.regularItems.map((item) => (
              <li class="flex items-center justify-between gap-1.5 py-1.5 sm:py-2.5 border-b border-gray-100 last:border-b-0">
                <span class="text-xs sm:text-sm font-medium text-parrilla-ivory leading-tight min-w-0 flex-1">
                  {item.name}
                </span>

                <button
                  type="button"
                  data-name={item.name}
                  data-price={item.price}
                  data-customizable="true"
                  aria-label={`Agregar ${item.name} al pedido`}
                  class="btn-add-cart flex-shrink-0 w-7 h-7 sm:w-9 sm:h-9 rounded-full bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer"
                >
                  <i data-lucide="plus" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                </button>
              </li>
            ))}
          </ul>

          <!-- Recuadro de Destacados del Día (ej. ⭐ SOLO POR HOY / ⭐ SOLO LOS LUNES) -->
          {col.specialItems.length > 0 && (
            <div
              class:list={[
                'relative mt-3 sm:mt-4 pt-3 pb-1 px-2 sm:px-3.5 rounded-lg sm:rounded-xl border border-parrilla-gold/70 bg-orange-50/40',
                (col.price === 16500 && dailySpecials?.mostrar_rotativos_16k === false) ||
                ((col.price === 18000 || col.price === 18500) && dailySpecials?.mostrar_rotativo_fin_semana === false)
                  ? 'hidden'
                  : '',
              ]}
              data-special-box-price={col.price}
            >
              <span
                data-special-badge
                class="absolute -top-2.5 left-2 bg-parrilla-gold text-white text-[8px] sm:text-[10px] font-extrabold uppercase tracking-wider px-1.5 sm:px-2.5 py-0.5 rounded shadow-2xs"
              >
                {col.badgeLabel}
              </span>

              <ul data-special-items>
                {col.specialItems.map((item) => (
                  <li class="flex items-center justify-between gap-1.5 py-1.5 sm:py-2 border-b border-orange-200/50 last:border-b-0">
                    <span class="text-xs sm:text-sm font-bold text-parrilla-ivory leading-tight min-w-0 flex-1">
                      {item.name}
                    </span>

                    <button
                      type="button"
                      data-name={item.name}
                      data-price={item.price}
                      data-customizable="true"
                      aria-label={`Agregar ${item.name} al pedido`}
                      class="btn-add-cart flex-shrink-0 w-7 h-7 sm:w-9 sm:h-9 rounded-full bg-parrilla-gold hover:bg-parrilla-goldLight text-white border border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer"
                    >
                      <i data-lucide="plus" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- =========================================================
       SECCIÓN: DESAYUNOS (Desayuno Tubo & Desayuno Personal)
       (2 columnas desde móvil: grid-cols-2)
       ========================================================= -->
  {showDesayunos && desayunos.length > 0 && (
    <section aria-labelledby="heading-desayunos" class="space-y-4 sm:space-y-6">
      <div class="text-center max-w-2xl mx-auto px-2">
        <span class="text-[10px] sm:text-xs font-extrabold uppercase tracking-[0.2em] text-amber-700 block mb-1">
          TRADICIÓN & MAÑANAS
        </span>
        <h2 id="heading-desayunos" class="font-display font-black text-2xl sm:text-4xl text-parrilla-ivory">
          ☕ Desayunos
        </h2>
        <p class="text-xs sm:text-sm text-parrilla-muted mt-1">
          Preparados con especificaciones y notas personalizadas en comanda.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-2.5 sm:gap-5 px-1 sm:px-2">
        {desayunos.map((item) => (
          <div class="bg-white rounded-xl sm:rounded-2xl border-2 border-amber-300/80 hover:border-amber-500 p-3 sm:p-5 shadow-sm flex flex-col justify-between gap-2.5 transition">
            <div>
              <div class="flex items-center gap-1.5 mb-1.5">
                <span class="text-xs sm:text-sm">☕</span>
                <span class="inline-block bg-amber-100 text-amber-900 border border-amber-300 text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full">
                  Con recuadro de notas
                </span>
              </div>
              <h3 class="font-display font-black text-sm sm:text-xl text-parrilla-ivory leading-tight">
                {item.name}
              </h3>
              {item.description && (
                <p class="text-[11px] sm:text-sm text-parrilla-muted mt-1 leading-snug">
                  {item.description}
                </p>
              )}
            </div>

            <div class="flex items-center justify-between gap-2 pt-2 border-t border-amber-100">
              <span class="font-display font-black text-sm sm:text-xl text-amber-800 font-mono">
                {formatPrice(item.price)}
              </span>
              <button
                type="button"
                data-id={item.id}
                data-name={item.name}
                data-price={item.price}
                data-cat={item.category_id}
                data-menu="almuerzo"
                data-customizable="false"
                aria-label={`Agregar ${item.name} al pedido`}
                class="btn-add-cart flex-shrink-0 px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-xs sm:text-sm flex items-center gap-1 transition active:scale-95 cursor-pointer shadow-xs"
              >
                <i data-lucide="plus" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                <span>+ Agregar</span>
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- =========================================================
       3. SECCIÓN INFERIOR: PARA COMPARTIR - Picadas Especiales
          (2 columnas también en móvil: grid-cols-2)
       ========================================================= -->
  {picadas.length > 0 && (
    <section aria-labelledby="heading-picadas" class="space-y-4 sm:space-y-6">
      <div class="text-center max-w-2xl mx-auto px-2">
        <span class="text-[10px] sm:text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1">
          PARA COMPARTIR
        </span>
        <h2 id="heading-picadas" class="font-display font-black text-2xl sm:text-4xl text-parrilla-ivory">
          Picadas Especiales
        </h2>
        <p class="text-xs sm:text-sm text-parrilla-muted mt-1">
          Las mejores combinaciones de carne para compartir.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-2.5 sm:gap-5 px-1 sm:px-2">
        {picadas.map((item) => {
          const isBerraca = item.id === 'pic-4' || item.name === 'Picada Berraca';
          const description = isBerraca
            ? 'Lomo de cerdo, chorizo, chicharrón, costillas de cerdo, papa a la francesa.'
            : item.description;
          const showBadge = item.is_featured === 1 && !isBerraca;

          return (
            <div
              class:list={[
                'bg-white rounded-xl sm:rounded-2xl border p-3 sm:p-5 shadow-sm flex flex-col justify-between gap-2.5',
                showBadge
                  ? 'border-parrilla-gold bg-orange-50/20'
                  : 'border-parrilla-border',
              ]}
            >
              <div>
                {showBadge && (
                  <span class="inline-block bg-parrilla-gold text-white text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full mb-1">
                    ⭐ ¡La más buscada!
                  </span>
                )}
                <h3 class="font-display font-black text-sm sm:text-xl text-parrilla-ivory leading-tight">
                  {item.name}
                </h3>
                {description && (
                  <p class="text-[11px] sm:text-sm text-parrilla-muted mt-1 leading-snug">
                    {description}
                  </p>
                )}
              </div>

              <div class="flex items-center justify-between gap-2 pt-2 border-t border-gray-100">
                <span class="font-display font-black text-sm sm:text-xl text-parrilla-gold">
                  {formatPrice(item.price)}
                </span>
                <button
                  type="button"
                  data-name={item.name}
                  data-price={item.price}
                  data-customizable="false"
                  aria-label={`Agregar ${item.name} al pedido`}
                  class="btn-add-cart flex-shrink-0 w-7 h-7 sm:w-9 sm:h-9 rounded-full bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer"
                >
                  <i data-lucide="plus" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- Bebidas y Adicionales -->
  {bebidas.length > 0 && (
    <section aria-labelledby="heading-bebidas" class="space-y-4 px-1 sm:px-2">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-[10px] sm:text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1">
          PARA ACOMPAÑAR
        </span>
        <h2 id="heading-bebidas" class="font-display font-black text-xl sm:text-3xl text-parrilla-ivory">
          Bebidas y Adicionales
        </h2>
      </div>

      <div class="bg-white rounded-xl sm:rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-3 sm:p-5 shadow-sm">
        <ul data-bebidas-list class="grid grid-cols-1 sm:grid-cols-2 gap-x-6">
          {bebidas.map((item) => (
            <li class="py-2 flex items-center justify-between gap-2 border-b border-gray-100 last:border-b-0">
              <div class="min-w-0 flex-1">
                <span class="text-xs sm:text-sm font-medium text-parrilla-ivory block truncate">
                  {item.name}
                </span>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <span class="font-display font-bold text-xs sm:text-base text-parrilla-gold">
                  {formatPrice(item.price)}
                </span>
                <button
                  type="button"
                  data-name={item.name}
                  data-price={item.price}
                  data-customizable="false"
                  aria-label={`Agregar ${item.name} al pedido`}
                  class="btn-add-cart w-7 h-7 sm:w-9 sm:h-9 rounded-full bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer"
                >
                  <i data-lucide="plus" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
                </button>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</div>

<script>
  // @ts-nocheck
  (function () {
    const CACHE_KEY = 'sp_daily_specials_v1';
    const esc = (s) =>
      String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmtCOP = (val) =>
      new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(Number(val || 0));

    function toArr(v) {
      if (Array.isArray(v)) return v.map((x) => String(x).trim()).filter(Boolean);
      if (typeof v === 'string' && v.trim()) return v.split(',').map((x) => x.trim()).filter(Boolean);
      return [];
    }

    function decodeSpecialSwitchTag(rawTag, fallbackTag, explicitBool) {
      const str = String(rawTag || fallbackTag || '').trim();
      if (str.endsWith('||OFF')) {
        return { tag: str.slice(0, -5).trim() || fallbackTag, visible: explicitBool !== undefined ? Boolean(explicitBool) : false };
      }
      if (str.endsWith('||ON')) {
        return { tag: str.slice(0, -4).trim() || fallbackTag, visible: explicitBool !== undefined ? Boolean(explicitBool) : true };
      }
      return { tag: str || fallbackTag, visible: explicitBool !== undefined ? Boolean(explicitBool) : true };
    }

    function applyLiveSpecialsToDOM(raw) {
      if (!raw || typeof raw !== 'object') return;
      const sopa = String(raw.sopa_dia || raw.sopa || '').trim();
      const principios = toArr(raw.principios);
      const acompanamientos = toArr(raw.acompanamientos);
      const esp165 = toArr(raw.especiales_16500);
      const decoded16k = decodeSpecialSwitchTag(raw.especiales_16500_etiqueta, '⭐ SOLO POR HOY', raw.mostrar_rotativos_16k);
      const esp165Badge = decoded16k.tag;
      const mostrar16k = decoded16k.visible;
      const arrozNombre = String(raw.especial_arroz_nombre || '').trim();
      const decodedFin = decodeSpecialSwitchTag(raw.especial_arroz_etiqueta, '⭐ ESPECIAL DE HOY', raw.mostrar_rotativo_fin_semana);
      const arrozBadge = decodedFin.tag;
      const mostrarFinSemana = decodedFin.visible;
      const arrozPrecio = Number(raw.especial_arroz_precio || 18000);
      const isPublicMenu = document.getElementById('quick-order-view')?.getAttribute('data-public-menu') === 'true';

      // 1. Actualizar Tarjeta Sopa del Día
      if (sopa) {
        document.querySelectorAll('[data-special-sopa]').forEach((el) => {
          el.textContent = sopa;
        });
      }

      // 2. Actualizar Tarjeta Principios
      if (principios.length > 0) {
        document.querySelectorAll('[data-special-principios]').forEach((ul) => {
          ul.innerHTML = principios
            .map(
              (p) => `
              <li class="flex items-start gap-1 sm:gap-2 text-[11px] sm:text-sm font-medium text-parrilla-ivory leading-tight">
                <i data-lucide="check" class="w-3 h-3 sm:w-4 sm:h-4 text-parrilla-gold flex-shrink-0 mt-0.5"></i>
                <span>${esc(p)}</span>
              </li>`
            )
            .join('');
        });
      }

      // 3. Actualizar Tarjeta Acompañamientos
      if (acompanamientos.length > 0) {
        document.querySelectorAll('[data-special-acompanamientos]').forEach((ul) => {
          ul.innerHTML = acompanamientos
            .map(
              (a) => `
              <li class="flex items-start gap-1 sm:gap-2 text-[11px] sm:text-sm font-medium text-parrilla-ivory leading-tight">
                <i data-lucide="check" class="w-3 h-3 sm:w-4 sm:h-4 text-parrilla-gold flex-shrink-0 mt-0.5"></i>
                <span>${esc(a)}</span>
              </li>`
            )
            .join('');
        });
      }

      // 4. Actualizar recuadro naranja ★ SOLO POR HOY en la caja de $16.500
      document.querySelectorAll('[data-special-box-price="16500"]').forEach((box) => {
        if (isPublicMenu && !mostrar16k) {
          box.classList.add('hidden');
          box.style.display = 'none';
        } else {
          box.classList.remove('hidden');
          box.style.display = '';
        }
        if (esp165.length > 0) {
          const badgeEl = box.querySelector('[data-special-badge]');
          if (badgeEl) badgeEl.textContent = esp165Badge;
          const itemsUl = box.querySelector('[data-special-items]');
          if (itemsUl) {
            itemsUl.innerHTML = esp165
              .map(
                (dishName) => `
                <li class="flex items-center justify-between gap-1.5 py-1.5 sm:py-2 border-b border-orange-200/50 last:border-b-0">
                  <span class="text-xs sm:text-sm font-bold text-parrilla-ivory leading-tight min-w-0 flex-1">
                    ${esc(dishName)}
                  </span>
                  <button
                    type="button"
                    data-name="${esc(dishName)}"
                    data-price="16500"
                    data-customizable="true"
                    aria-label="Agregar ${esc(dishName)} al pedido"
                    class="btn-add-cart flex-shrink-0 w-7 h-7 sm:w-9 sm:h-9 rounded-full bg-parrilla-gold hover:bg-parrilla-goldLight text-white border border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                  </button>
                </li>`
              )
              .join('');
          }
        }
      });

      // 5. Actualizar recuadro naranja del Especial de Arroz/Pasta en la caja de $18.000 / $18.500
      document.querySelectorAll('[data-special-box-price="18000"]').forEach((box) => {
        if (isPublicMenu && !mostrarFinSemana) {
          box.classList.add('hidden');
          box.style.display = 'none';
        } else {
          box.classList.remove('hidden');
          box.style.display = '';
        }
        if (arrozNombre) {
          const badgeEl = box.querySelector('[data-special-badge]');
          if (badgeEl) {
            badgeEl.textContent = arrozPrecio !== 18000 ? `${arrozBadge} • ${fmtCOP(arrozPrecio)}` : arrozBadge;
          }
          const itemsUl = box.querySelector('[data-special-items]');
          if (itemsUl) {
            const priceLabelHtml =
              arrozPrecio !== 18000
                ? `<span class="ml-1 text-[11px] font-extrabold text-parrilla-gold font-mono">(${fmtCOP(arrozPrecio)})</span>`
                : '';
            itemsUl.innerHTML = `
              <li class="flex items-center justify-between gap-1.5 py-1.5 sm:py-2 border-b border-orange-200/50 last:border-b-0">
                <span class="text-xs sm:text-sm font-bold text-parrilla-ivory leading-tight min-w-0 flex-1">
                  ${esc(arrozNombre)}${priceLabelHtml}
                </span>
                <button
                  type="button"
                  data-name="${esc(arrozNombre)}"
                  data-price="${arrozPrecio}"
                  data-customizable="true"
                  aria-label="Agregar ${esc(arrozNombre)} al pedido"
                  class="btn-add-cart flex-shrink-0 w-7 h-7 sm:w-9 sm:h-9 rounded-full bg-parrilla-gold hover:bg-parrilla-goldLight text-white border border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                </button>
              </li>`;
          }
        }
      });

      if (window.lucide) {
        try {
          window.lucide.createIcons();
        } catch (e) {}
      }

      // Re-aplicar estado de precios y agotados después de re-renderizar especiales
      if (lastPlatosList && lastPlatosList.length > 0) {
        applyLivePlatosToDOM(lastPlatosList);
      }

      const normalizedDetail = {
        ...raw,
        sopa: sopa || raw.sopa || 'Campesina',
        sopa_dia: sopa || raw.sopa_dia || 'Campesina',
        principios,
        acompanamientos,
        especiales_16500: esp165,
        especiales_16500_etiqueta: esp165Badge,
        especial_arroz_nombre: arrozNombre || 'Arroz ranchero',
        especial_arroz_etiqueta: arrozBadge,
        especial_arroz_precio: arrozPrecio,
        mostrar_rotativos_16k: mostrar16k,
        mostrar_rotativo_fin_semana: mostrarFinSemana,
      };

      window.dispatchEvent(new CustomEvent('sp:specials-updated', { detail: normalizedDetail }));
    }

    // =========================================================
    // SINCRONIZACIÓN EN TIEMPO REAL DE PRECIOS Y PLATOS AGOTADOS
    // =========================================================
    const PLATOS_CACHE_KEY = 'sp_platos_live_v1';
    let lastPlatosList = [];

    function normDishKey(str) {
      return String(str || '')
        .trim()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    const CALIBRATED_BEVERAGES_MAP = new Map([
      ['botella de agua', { nombre: 'Botella de Agua', precio: 3000 }],
      ['agua', { nombre: 'Botella de Agua', precio: 3000 }],
      ['cerveza club colombia / aguila', { nombre: 'Cerveza Club Colombia / Águila', precio: 5500 }],
      ['cerveza', { nombre: 'Cerveza Club Colombia / Águila', precio: 5500 }],
      ['gaseosa 1.5l', { nombre: 'Gaseosa 1.5L', precio: 8000 }],
      ['gaseosa 400ml', { nombre: 'Gaseosa 400ml', precio: 4000 }],
      ['jugo natural en agua', { nombre: 'Jugo Natural en Agua', precio: 8500 }],
      ['jugo natural en leche', { nombre: 'Jugo Natural en Leche', precio: 9500 }],
      ['soda', { nombre: 'Soda', precio: 4500 }],
      ['porcion de papas a la francesa', { nombre: 'Porción de Papas a la Francesa', precio: 5500 }],
      ['porcion de papa a la francesa', { nombre: 'Porción de Papas a la Francesa', precio: 5500 }],
      ['porcion papas a la francesa', { nombre: 'Porción de Papas a la Francesa', precio: 5500 }],
    ]);

    function sanitizeLivePlatos(rawList) {
      if (!Array.isArray(rawList)) return [];
      const seen = new Set();
      const result = [];
      for (const item of rawList) {
        if (!item) continue;
        let nombre = String(item.nombre || item.name || '').trim();
        if (!nombre) continue;
        let key = normDishKey(nombre);
        if (key.includes('patacon con hogao')) continue;
        if (key === 'espaguetis con pollo' || key === 'espagueti con pollo') {
          nombre = 'Espagueti con pollo';
          key = 'espagueti con pollo';
        }
        let precio = Number(item.precio ?? item.price ?? 0);
        if (CALIBRATED_BEVERAGES_MAP.has(key)) {
          const cal = CALIBRATED_BEVERAGES_MAP.get(key);
          nombre = cal.nombre;
          precio = cal.precio;
          key = normDishKey(nombre);
        }
        const desc = normDishKey(item.descripcion || item.description || '');
        const isRapidas =
          String(item.id || '').startsWith('rap-') ||
          item.menu_type === 'rapidas' ||
          desc.includes('comidas rapidas') ||
          desc.includes('noche');
        const dedupeKey = isRapidas && !CALIBRATED_BEVERAGES_MAP.has(key) ? `rap:${key}` : `alm:${key}`;
        if (seen.has(dedupeKey)) continue;
        seen.add(dedupeKey);
        result.push({
          ...item,
          nombre,
          name: nombre,
          precio,
          price: precio,
          disponible: item.disponible !== false && item.activo !== false && item.in_stock !== 0 && item.is_active !== 0,
        });
      }
      return result;
    }

    function isMainLunchDishCandidate(p) {
      const key = normDishKey(p.nombre || p.name);
      if (!key) return false;
      if (CALIBRATED_BEVERAGES_MAP.has(key)) return false;
      if (key.includes('patacon con hogao')) return false;
      if (key.includes('clinica') || key.includes('hipo') || key.includes('desayuno') || key.includes('terpel') || key.includes('tubo')) return false;
      if (key.startsWith('picada')) return false;
      const desc = normDishKey(p.descripcion || p.description || '');
      if (
        String(p.id || '').startsWith('rap-') ||
        p.menu_type === 'rapidas' ||
        desc.includes('comidas rapidas') ||
        desc.includes('noche') ||
        key.includes('hamburguesa') ||
        key.includes('burguer') ||
        key.includes('burger') ||
        key.includes('perro') ||
        key.includes('suizo') ||
        key.includes('salchipapa') ||
        key.includes('papas locas') ||
        key.includes('patacon') ||
        key.includes('sandwich') ||
        key.includes('granizado') ||
        key.includes('gaseosa mega') ||
        key.includes('gaseosa p400')
      ) {
        return false;
      }
      return true;
    }

    function applyLivePlatosToDOM(platosArray) {
      if (!Array.isArray(platosArray) || platosArray.length === 0) return;
      const cleanPlatos = sanitizeLivePlatos(platosArray);
      lastPlatosList = cleanPlatos;
      const isPublicMenu = document.getElementById('quick-order-view')?.getAttribute('data-public-menu') === 'true';

      const platoMap = new Map();
      cleanPlatos.forEach((p) => {
        const key = normDishKey(p.nombre || p.name);
        if (key) platoMap.set(key, p);
      });

      // En la carta pública: sincronizar dinámicamente la columna de $18.000 filtrando estrictamente por plato.disponible === true
      if (isPublicMenu) {
        const col18k = document.querySelector('[data-price-column="18000"]');
        const ul18k = col18k?.querySelector(':scope > ul');
        if (ul18k) {
          const special18kNames = new Set(
            Array.from(col18k.querySelectorAll('[data-special-items] .btn-add-cart[data-name]')).map((b) =>
              normDishKey(b.getAttribute('data-name') || '')
            )
          );
          const available18kDishes = cleanPlatos.filter(
            (p) =>
              Math.round(Number(p.precio ?? p.price ?? 0)) === 18000 &&
              p.disponible === true &&
              !p.special_badge &&
              !special18kNames.has(normDishKey(p.nombre || p.name)) &&
              isMainLunchDishCandidate(p)
          );
          ul18k.innerHTML = available18kDishes
            .map(
              (item) => `
              <li class="flex items-center justify-between gap-1.5 py-1.5 sm:py-2.5 border-b border-gray-100 last:border-b-0">
                <span class="text-xs sm:text-sm font-medium text-parrilla-ivory leading-tight min-w-0 flex-1">
                  ${esc(item.nombre || item.name)}
                </span>
                <button
                  type="button"
                  data-name="${esc(item.nombre || item.name)}"
                  data-price="18000"
                  data-customizable="true"
                  aria-label="Agregar ${esc(item.nombre || item.name)} al pedido"
                  class="btn-add-cart flex-shrink-0 w-7 h-7 sm:w-9 sm:h-9 rounded-full bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                </button>
              </li>`
            )
            .join('');
        }

        // Sincronizar dinámicamente la lista de Bebidas y Adicionales calibrada y sin duplicados
        const bebidasUl = document.querySelector('[data-bebidas-list]');
        if (bebidasUl) {
          const calibratedOrder = [
            'Botella de Agua',
            'Cerveza Club Colombia / Águila',
            'Gaseosa 1.5L',
            'Gaseosa 400ml',
            'Jugo Natural en Agua',
            'Jugo Natural en Leche',
            'Soda',
            'Porción de Papas a la Francesa',
          ];
          const bebidasItems = calibratedOrder
            .map((name) => platoMap.get(normDishKey(name)))
            .filter((item) => item && item.disponible === true);

          if (bebidasItems.length > 0) {
            bebidasUl.innerHTML = bebidasItems
              .map(
                (item) => `
                <li class="py-2 flex items-center justify-between gap-2 border-b border-gray-100 last:border-b-0">
                  <div class="min-w-0 flex-1">
                    <span class="text-xs sm:text-sm font-medium text-parrilla-ivory block truncate">
                      ${esc(item.nombre || item.name)}
                    </span>
                  </div>
                  <div class="flex items-center gap-2 flex-shrink-0">
                    <span class="font-display font-bold text-xs sm:text-base text-parrilla-gold">
                      ${fmtCOP(item.precio ?? item.price)}
                    </span>
                    <button
                      type="button"
                      data-name="${esc(item.nombre || item.name)}"
                      data-price="${item.precio ?? item.price}"
                      data-customizable="false"
                      aria-label="Agregar ${esc(item.nombre || item.name)} al pedido"
                      class="btn-add-cart w-7 h-7 sm:w-9 sm:h-9 rounded-full bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    </button>
                  </div>
                </li>`
              )
              .join('');
          }
        }
      }

      // 1. Actualizar todos los botones .btn-add-cart en QuickOrderView y vistas hermanas
      document.querySelectorAll('.btn-add-cart[data-name]').forEach((btn) => {
        const dishName = btn.getAttribute('data-name') || '';
        const normName = normDishKey(dishName);
        if (normName.includes('patacon con hogao')) {
          const row = btn.closest('li') || btn.closest('.pos-rapida-card') || btn.parentElement?.parentElement;
          if (row) row.remove();
          return;
        }
        const info = platoMap.get(normName);
        if (!info) return;

        const newPrice = Number(info.precio ?? info.price ?? btn.getAttribute('data-price') ?? 0);
        const isAvailable = info.disponible !== false && info.activo !== false && info.in_stock !== 0;

        if (newPrice > 0) {
          btn.setAttribute('data-price', String(newPrice));
          btn.dataset.price = String(newPrice);
        }

        const rowOrCard = btn.closest('li') || btn.closest('.pos-rapida-card') || btn.parentElement?.parentElement;
        const nameSpan = rowOrCard
          ? rowOrCard.querySelector('span.flex-1, h3, .pos-rapida-name, span.truncate')
          : null;

        // Actualizar precio visible en tarjetas de Picadas, Bebidas o Comidas Rápidas
        if (rowOrCard && !btn.closest('[data-price-column]')) {
          const priceLabel = rowOrCard.querySelector('.font-display.text-parrilla-gold, .font-mono.text-parrilla-gold, .pos-rapida-price');
          if (priceLabel && newPrice > 0) {
            priceLabel.textContent = fmtCOP(newPrice);
          }
        }

        // Reorganización visual dinámica: si cambió de precio, moverlo a la caja de precio correspondiente
        const parentCol = btn.closest('[data-price-column]');
        if (parentCol && newPrice > 0 && !btn.closest('[data-special-items]')) {
          const currentColPrice = Number(parentCol.getAttribute('data-price-column') || 0);
          if (currentColPrice > 0 && newPrice !== currentColPrice) {
            const li = btn.closest('li');
            if (li) {
              let targetCol = document.querySelector(`[data-price-column="${newPrice}"]`);
              if (!targetCol) {
                const newCol = document.createElement('div');
                newCol.className = 'bg-white rounded-xl sm:rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-2.5 sm:p-5 shadow-sm flex flex-col';
                newCol.setAttribute('data-price-column', String(newPrice));
                newCol.innerHTML = `
                  <div class="text-center border-b border-parrilla-border pb-2 sm:pb-3 mb-1.5 sm:mb-2">
                    <span class="font-display font-black text-lg sm:text-3xl text-parrilla-gold tracking-tight">
                      ${fmtCOP(newPrice)}
                    </span>
                  </div>
                  <ul></ul>
                `;
                const containerGrid = parentCol.parentElement;
                if (containerGrid) {
                  const existingCols = Array.from(containerGrid.querySelectorAll(':scope > [data-price-column]'));
                  let inserted = false;
                  for (const ec of existingCols) {
                    if (Number(ec.getAttribute('data-price-column')) > newPrice) {
                      containerGrid.insertBefore(newCol, ec);
                      inserted = true;
                      break;
                    }
                  }
                  if (!inserted) containerGrid.appendChild(newCol);
                  targetCol = newCol;
                }
              }

              if (targetCol) {
                targetCol.style.display = '';
                const targetUl = targetCol.querySelector(':scope > ul');
                if (targetUl && li.parentElement !== targetUl) {
                  targetUl.appendChild(li);
                }
              }

              const remainingItems = parentCol.querySelectorAll(':scope > ul > li, [data-special-items] > li');
              if (remainingItems.length === 0) {
                parentCol.style.display = 'none';
              }
            }
          }
        }

        // En la carta pública, ocultar platos con disponible === false; en POS, mostrar badge Agotado por hoy
        if (isPublicMenu && !btn.closest('[data-special-items]')) {
          if (rowOrCard) {
            rowOrCard.style.display = isAvailable ? '' : 'none';
          }
        }

        // Gestionar estado Agotado por hoy vs Disponible
        if (!isAvailable) {
          btn.disabled = true;
          btn.setAttribute('data-sold-out', 'true');
          btn.setAttribute('title', 'Agotado por hoy');
          btn.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
          if (rowOrCard) {
            rowOrCard.classList.add('opacity-60');
          }
          if (!isPublicMenu && nameSpan && !nameSpan.querySelector('[data-soldout-badge]')) {
            const badge = document.createElement('span');
            badge.setAttribute('data-soldout-badge', 'true');
            badge.className =
              'ml-1.5 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wider bg-red-100 text-red-700 border border-red-300 align-middle';
            badge.textContent = 'Agotado por hoy';
            nameSpan.appendChild(badge);
          }
        } else {
          btn.disabled = false;
          btn.removeAttribute('data-sold-out');
          btn.removeAttribute('title');
          btn.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
          if (rowOrCard) {
            rowOrCard.classList.remove('opacity-60');
          }
          if (nameSpan) {
            const oldBadge = nameSpan.querySelector('[data-soldout-badge]');
            if (oldBadge) oldBadge.remove();
          }
        }
      });

      // 2. Limpieza de badges de precios personalizados si el plato ya está en su caja correcta
      document.querySelectorAll('[data-price-column]').forEach((colEl) => {
        const colPrice = Number(colEl.getAttribute('data-price-column') || 0);
        colEl.querySelectorAll('li').forEach((li) => {
          const btn = li.querySelector('.btn-add-cart');
          const p = Number(btn?.getAttribute('data-price') || 0);
          const nameSpan = li.querySelector('span.flex-1');
          const existingPriceTag = nameSpan?.querySelector('[data-custom-price-tag]');
          if (p > 0 && p === colPrice && existingPriceTag) {
            existingPriceTag.remove();
          }
        });
      });

      window.dispatchEvent(new CustomEvent('sp:platos-updated', { detail: cleanPlatos }));
    }

    async function fetchAndSyncLivePlatos() {
      try {
        const res = await fetch('/api/platos', { cache: 'no-store' });
        if (res.ok) {
          const data = await res.json();
          const list = Array.isArray(data) ? data : (data.platos || data.products || []);
          if (Array.isArray(list) && list.length > 0) {
            try {
              localStorage.setItem(PLATOS_CACHE_KEY, JSON.stringify(list));
            } catch (e) {}
            applyLivePlatosToDOM(list);
          }
        }
      } catch (e) {}
    }

    async function fetchAndSyncLiveSpecials() {
      try {
        const res = await fetch('/api/especiales-dia', { cache: 'no-store' });
        if (res.ok) {
          const data = await res.json();
          if (data && (data.sopa_dia || data.sopa)) {
            try {
              localStorage.setItem(CACHE_KEY, JSON.stringify(data));
            } catch (e) {}
            applyLiveSpecialsToDOM(data);
          }
        }
      } catch (e) {}
    }

    // 1. Aplicar caché local de inmediato si existe
    try {
      const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || 'null');
      if (cached && (cached.sopa_dia || cached.sopa)) {
        applyLiveSpecialsToDOM(cached);
      }
      const cachedPlatos = JSON.parse(localStorage.getItem(PLATOS_CACHE_KEY) || 'null');
      if (Array.isArray(cachedPlatos) && cachedPlatos.length > 0) {
        applyLivePlatosToDOM(cachedPlatos);
      }
    } catch (e) {}

    // 2. Consultar Neon DB en vivo
    function syncAllLive() {
      fetchAndSyncLiveSpecials();
      fetchAndSyncLivePlatos();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncAllLive);
    } else {
      syncAllLive();
    }

    // 3. Escuchar BroadcastChannel y cambios de pestaña para actualización instantánea
    try {
      const bc = new BroadcastChannel('sp_specials_channel');
      bc.onmessage = (ev) => {
        if (ev.data) applyLiveSpecialsToDOM(ev.data);
      };
    } catch (e) {}

    try {
      const bcPlatos = new BroadcastChannel('sp_platos_channel');
      bcPlatos.onmessage = (ev) => {
        if (Array.isArray(ev.data)) {
          applyLivePlatosToDOM(ev.data);
        } else {
          fetchAndSyncLivePlatos();
        }
      };
    } catch (e) {}

    window.addEventListener('storage', (ev) => {
      if (ev.key === CACHE_KEY && ev.newValue) {
        try {
          applyLiveSpecialsToDOM(JSON.parse(ev.newValue));
        } catch (e) {}
      } else if (ev.key === PLATOS_CACHE_KEY && ev.newValue) {
        try {
          applyLivePlatosToDOM(JSON.parse(ev.newValue));
        } catch (e) {}
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        syncAllLive();
      }
    });
  })();
</script>
