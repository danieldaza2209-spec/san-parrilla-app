                  title="Escribe la cantidad directamente"
                />
                <button type="button" class="btn-qty-plus text-parrilla-muted hover:text-parrilla-gold font-bold px-1.5 cursor-pointer" data-uid="${item.uid}" data-idx="${idx}">+</button>
              </div>

              <div class="font-bold text-xs text-parrilla-ivory text-right w-16 font-mono">
                ${fmt(itemTotal)}
              </div>

              <button type="button" class="btn-remove-item text-parrilla-muted hover:text-red-500 p-1 cursor-pointer" data-uid="${item.uid}" data-idx="${idx}" aria-label="Eliminar plato">
                ✕
              </button>
            </div>

            ${inlineControls}
          </div>
        `;
      }).join('');

      // Enlace para el botón "Personalizar / Cambiar"
      document.querySelectorAll('.btn-customize-cart-item').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const item = cart.find((it) => it.uid === uid);
          if (item) openGarnishModalForCartItem(item);
        });
      });

      // Bind dynamic quantity buttons
      document.querySelectorAll('.btn-qty-minus').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const idx = cart.findIndex((it) => it.uid === uid);
          if (idx === -1) return;

          if (cart[idx].quantity > 1) {
            cart[idx].quantity -= 1;
          } else {
            cart.splice(idx, 1);
          }

          if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
            packagingQty = countFoodPlates();
          }
          syncHospitalHipoWaterInCart();
          renderCart();
        });
      });

      document.querySelectorAll('.btn-qty-plus').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const item = cart.find((it) => it.uid === uid);
          if (!item) return;

          if (item.isHospitalDiet) {
            item.quantity += 1;
            item.notes = buildPlateNotes(item);
          } else if (item.isCustomizable || item.isRapidasFood || item.isJuice) {
            // Duplica el plato/producto como un nuevo plato independiente para poder personalizarlo
            const cloned = {
              ...item,
              uid: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
              quantity: 1
            };
            cloned.notes = buildPlateNotes(cloned);
            cart.push(cloned);
          } else {
            item.quantity += 1;
          }

          if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
            packagingQty = countFoodPlates();
          }
          syncHospitalHipoWaterInCart();
          renderCart();
        });
      });

      // Entrada directa de cantidades por teclado
      document.querySelectorAll('.cart-qty-input').forEach((inp) => {
        inp.addEventListener('change', (e) => {
          // @ts-ignore
          const uid = e.target.getAttribute('data-uid');
          const item = cart.find((it) => it.uid === uid);
          if (!item) return;
          // @ts-ignore
          let val = parseInt(e.target.value, 10);
          if (isNaN(val) || val < 1) val = 1;
          item.quantity = val;
          if (item.isHospitalDiet) {
            item.notes = buildPlateNotes(item);
          }
          if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
            packagingQty = countFoodPlates();
          }
          syncHospitalHipoWaterInCart();
          renderCart();
        });
        inp.addEventListener('keydown', (e) => {
          // @ts-ignore
          if (e.key === 'Enter') {
            // @ts-ignore
            e.target.blur();
          }
        });
      });

      // Botón [+ Agregar otra torre]: Clona la dieta con la siguiente ubicación
      document.querySelectorAll('.btn-clone-diet-tower').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const idx = cart.findIndex((it) => it.uid === uid);
          if (idx === -1) return;
          const source = cart[idx];
          const currLoc = source.hospitalLocation || source.ubicacion || 'Torre A';
          let nextLoc = 'Torre B';
          if (currLoc === 'Torre A') nextLoc = 'Torre B';
          else if (currLoc === 'Torre B') nextLoc = 'Urgencias';
          else if (currLoc === 'Urgencias') nextLoc = 'Torre A';

          const newRowId = 'row_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
          const cloned = {
            ...source,
            uid: newRowId,
            cart_row_id: newRowId,
            quantity: 1,
            hospitalLocation: nextLoc,
            ubicacion: nextLoc,
            extraNotes: ''
          };
          cloned.notes = buildPlateNotes(cloned);
          cart.splice(idx + 1, 0, cloned);
          syncHospitalHipoWaterInCart();
          renderCart();
        });
      });

      document.querySelectorAll('.btn-remove-item').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const idx = cart.findIndex((it) => it.uid === uid);
          if (idx !== -1) {
            cart.splice(idx, 1);
            if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
              packagingQty = countFoodPlates();
            }
            renderCart();
          }
        });
      });

      // Listeners directos de cajitas en la comanda (Sopa, Principio, Acomp., Ensalada, Empaque, Ubicación)
      document.querySelectorAll('.pos-inline-select').forEach((sel) => {
        sel.addEventListener('change', (e) => {
          // @ts-ignore
          const target = e.currentTarget;
          const uid = target.getAttribute('data-uid');
          const field = target.getAttribute('data-field');
          const item = cart.find((it) => it.uid === uid);
          if (item && field) {
            item[field] = target.value;
            if (field === 'hospitalLocation') {
              item.ubicacion = target.value;
            }
            item.notes = buildPlateNotes(item);
            syncHospitalHipoWaterInCart();
            renderCart();
          }
        });
      });

      // Observaciones / Notas por plato en tiempo real
      document.querySelectorAll('.pos-inline-notes').forEach((inp) => {
        inp.addEventListener('input', (e) => {
          // @ts-ignore
          const target = e.currentTarget;
          const uid = target.getAttribute('data-uid');
          const item = cart.find((it) => it.uid === uid);
          if (item) {
            item.extraNotes = target.value;
            item.notes = buildPlateNotes(item);
          }
        });
      });

      // Actualizar Subtotal y Desglose de Empaques
      subtotalEl.textContent = fmt(subtotal);

      const packagingBox = document.getElementById('packaging-box');
      const packagingQtyDisplay = document.getElementById('packaging-qty-display');
      const packagingTotalBadge = document.getElementById('packaging-total-badge');
      const posPackagingRow = document.getElementById('pos-packaging-row');
      const posPackagingLabel = document.getElementById('pos-packaging-label');
      const posPackagingFee = document.getElementById('pos-packaging-fee');

      if (isDeliveryOrTakeout) {
        packagingBox?.classList.remove('hidden');
        if (packagingQtyDisplay) packagingQtyDisplay.textContent = String(packagingQty);
        if (packagingTotalBadge) packagingTotalBadge.textContent = fmt(packagingFee);
        if (posPackagingRow) {
          posPackagingRow.style.display = 'flex';
          if (posPackagingLabel) posPackagingLabel.textContent = `Empaques (${globalPackagingType} x ${packagingQty}):`;
          if (posPackagingFee) posPackagingFee.textContent = fmt(packagingFee);
        }
      } else {
        packagingBox?.classList.add('hidden');
        if (posPackagingRow) posPackagingRow.style.display = 'none';
      }

      // Actualizar Domicilio
      if (currentOrderType === 'domicilio' || deliveryFee > 0) {
        deliveryRow.style.display = 'flex';
        deliveryEl.textContent = fmt(deliveryFee);
      } else {
        deliveryRow.style.display = 'none';
      }

      // Actualizar Total
      totalEl.textContent = fmt(total);

      calculateChange(total);
    }

    function calculateChange(total) {
      // @ts-ignore
      const cashVal = Number(cashReceivedInput.value || 0);
      if (cashVal > 0 && currentPaymentMethod === 'efectivo') {
        const diff = cashVal - total;
        cashChangeDisplay.textContent = diff >= 0 ? fmt(diff) : 'Faltan ' + fmt(Math.abs(diff));
        cashChangeDisplay.className = diff >= 0 ? 'font-display font-black text-lg text-parrilla-accent' : 'font-display font-black text-lg text-red-400';
      } else {
        cashChangeDisplay.textContent = '$0';
        cashChangeDisplay.className = 'font-display font-black text-lg text-parrilla-accent';
      }
    }

    if (cashReceivedInput) {
      cashReceivedInput.addEventListener('input', () => {
        const { total } = calculateTotals();
        calculateChange(total);
      });
    }

    if (deliveryFeeInput) {
      deliveryFeeInput.addEventListener('input', () => {
        renderCart();
      });
    }

    function syncClinicaDomiciliosBadge() {
      // @ts-ignore
      const count = Math.max(0, parseInt(clinicaDomiciliosCountInput?.value || '0', 10) || 0);
      // @ts-ignore
      const unit = Math.max(0, Number(clinicaDomicilioUnitFeeInput?.value || 3000) || 0);
      if (clinicaDomiciliosBadge) {
        clinicaDomiciliosBadge.textContent = count > 0 ? `${count} envío(s) · ${fmt(count * unit)}` : '0 envíos';
      }
      renderCart();
    }
    clinicaDomiciliosCountInput?.addEventListener('input', syncClinicaDomiciliosBadge);
    clinicaDomicilioUnitFeeInput?.addEventListener('input', syncClinicaDomiciliosBadge);

    // Botones de selección de Pabellón / Ubicación para Raciones Hospitalarias
    document.querySelectorAll('.btn-hosp-loc-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const loc = btn.getAttribute('data-loc') || 'Torre A';
        currentActiveHospitalLocation = loc;
        document.querySelectorAll('.btn-hosp-loc-tab').forEach((b) => {
          const isSel = b.getAttribute('data-loc') === loc;
          if (isSel) {
            b.className = 'btn-hosp-loc-tab px-3 py-1.5 rounded-lg text-xs font-black transition cursor-pointer bg-emerald-700 text-white shadow-xs';
          } else {
            b.className = 'btn-hosp-loc-tab px-3 py-1.5 rounded-lg text-xs font-black transition cursor-pointer bg-white text-emerald-900 border border-emerald-300 hover:bg-emerald-100';
          }
        });
      });
    });

    // Botones de selección rápida de los 6 Clientes Institucionales / Convenios
    document.querySelectorAll('.btn-select-corporate-client').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cName = btn.getAttribute('data-corp-name') || '';
        const cPhone = btn.getAttribute('data-corp-phone') || '';
        const cAddress = btn.getAttribute('data-corp-address') || '';
        const cBarrio = btn.getAttribute('data-corp-barrio') || '';

        // Activar automáticamente método de pago FIADO
        const fiadoBtn = document.querySelector('.pay-btn[data-method="fiado"]');
        // @ts-ignore
        if (fiadoBtn) fiadoBtn.click();

        applySelectedCustomer({
          nombre: cName,
          telefono: cPhone,
          direccion: cAddress,
          barrio: cBarrio,
        });

        // Si es Clínica Primero de Mayo (Pacientes) y cantidad de domicilios está en 0, sugerir 1 domicilio por defecto
        if (normalizeStr(cName).includes('pacientes') && clinicaDomiciliosCountInput) {
          // @ts-ignore
          if (Number(clinicaDomiciliosCountInput.value || 0) === 0) {
            // @ts-ignore
            clinicaDomiciliosCountInput.value = '1';
          }
          syncClinicaDomiciliosBadge();
        }
      });
    });

    // 4. ORDER TYPE SWITCHER
    const formLlevar = document.getElementById('form-llevar');
    const llevarCustNameInput = document.getElementById('llevar-cust-name');
    const openOrderBanner = document.getElementById('open-order-banner');
    const openOrderBannerTitle = document.getElementById('open-order-banner-title');
    const btnCancelOpenEdit = document.getElementById('btn-cancel-open-edit');
    const btnSaveOpenOrder = document.getElementById('btn-save-open-order');
    const btnSaveOpenOrderLabel = document.getElementById('btn-save-open-order-label');

    let editingOpenOrder = null; // Stores loaded open Pedido object if editing an active table/order

    function setEditingOpenOrder(orderObj) {
      editingOpenOrder = orderObj || null;
      if (editingOpenOrder && editingOpenOrder.id) {
        if (openOrderBanner) {
          openOrderBanner.classList.remove('hidden');
          openOrderBanner.classList.add('flex');
        }
        if (openOrderBannerTitle) {
          const loc = editingOpenOrder.mesa || editingOpenOrder.cliente_nombre || '';
          openOrderBannerTitle.textContent = `📋 Editando Pedido Abierto ${editingOpenOrder.codigo_pedido || ('#' + editingOpenOrder.id)} ${loc ? '(' + loc + ')' : ''}`;
        }
        if (btnSaveOpenOrderLabel) {
          btnSaveOpenOrderLabel.textContent = `Actualizar Comanda Abierta (${editingOpenOrder.codigo_pedido || ('#' + editingOpenOrder.id)})`;
        }
      } else {
        if (openOrderBanner) {
          openOrderBanner.classList.add('hidden');
          openOrderBanner.classList.remove('flex');
        }
        if (btnSaveOpenOrderLabel) {
          btnSaveOpenOrderLabel.textContent = 'Guardar / Enviar a Cocina (Dejar Abierto)';
        }
      }
    }

    btnCancelOpenEdit?.addEventListener('click', () => {
      setEditingOpenOrder(null);
      cart = [];
      renderCart();
    });

    const formCustomerTitle = document.getElementById('form-customer-title');
    const formCustomerBadge = document.getElementById('form-customer-badge');
    const domicilioExtraFields = document.getElementById('domicilio-extra-fields');
    const deliveryFeeFieldWrapper = document.getElementById('delivery-fee-field-wrapper');
    const custAddressLabel = document.getElementById('cust-address-label');

    function updateCustomerFormVisibility() {
      const conveniosCartHeader = document.getElementById('convenios-cart-header');
      const orderTypeSelectorWrapper = document.getElementById('order-type-selector-wrapper');
      const clinicaDomiciliosBox = document.getElementById('clinica-domicilios-box');

      if (activeMenuMode === 'convenios') {
        // EN MODO CONVENIOS & CLÍNICA:
        // 1. Mostrar encabezado limpio institucional
        if (conveniosCartHeader) {
          conveniosCartHeader.classList.remove('hidden');
          conveniosCartHeader.style.display = 'flex';
        }
        // 2. Ocultar selector de tipo de pedido (Mesa / Domicilio / Para Llevar)
        if (orderTypeSelectorWrapper) {
          orderTypeSelectorWrapper.classList.add('hidden');
          orderTypeSelectorWrapper.style.display = 'none';
        }
        // 3. Ocultar formularios de Mesa, Llevar y Domicilio / Fiado ordinario
        if (formMesa) {
          formMesa.style.display = 'none';
          formMesa.classList.add('hidden');
        }
        if (formLlevar) {
          formLlevar.classList.add('hidden');
          formLlevar.classList.remove('flex');
          formLlevar.style.display = 'none';
        }
        if (formDomicilio) {
          formDomicilio.style.display = 'none';
          formDomicilio.classList.add('hidden');
        }
        // 4. Mostrar únicamente el bloque de domicilios/envíos de la clínica
        if (clinicaDomiciliosBox) {
          clinicaDomiciliosBox.classList.remove('hidden');
          clinicaDomiciliosBox.style.display = 'block';
        }
        // 5. Botón directo de cerrar a fiado siempre visible en convenios
        if (btnCloseFiadoDirect) {
          btnCloseFiadoDirect.classList.remove('hidden');
          btnCloseFiadoDirect.classList.add('flex');
        }
        return;
      }

      // MODO ORDINARIO (ALMUERZOS / RÁPIDAS):
      if (conveniosCartHeader) {
        conveniosCartHeader.classList.add('hidden');
        conveniosCartHeader.style.display = 'none';
      }
      if (orderTypeSelectorWrapper) {
        orderTypeSelectorWrapper.classList.remove('hidden');
        orderTypeSelectorWrapper.style.display = 'block';
      }
      if (clinicaDomiciliosBox) {
        clinicaDomiciliosBox.classList.add('hidden');
        clinicaDomiciliosBox.style.display = 'none';
      }

      const isDom = currentOrderType === 'domicilio';
      const isFiado = currentPaymentMethod === 'fiado' || selectedSingleMethod === 'FIADO';

      if (btnCloseFiadoDirect) {
        if (currentPaymentMethod === 'fiado') {
          btnCloseFiadoDirect.classList.remove('hidden');
          btnCloseFiadoDirect.classList.add('flex');
        } else {
          btnCloseFiadoDirect.classList.add('hidden');
          btnCloseFiadoDirect.classList.remove('flex');
        }
      }

      if (isDom || isFiado) {
        formDomicilio.style.display = 'flex';
        formDomicilio.classList.remove('hidden');
        if (isFiado && !isDom) {
          if (formCustomerTitle) formCustomerTitle.textContent = '📝 Cliente de Fiado (Obligatorio: Teléfono y Nombre)';
          if (formCustomerBadge) {
            formCustomerBadge.textContent = 'Cuenta por Cobrar';
            formCustomerBadge.className = 'text-[10px] font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded';
          }
          if (custAddressLabel) custAddressLabel.textContent = 'Dirección del Cliente (Opcional)';
          if (deliveryFeeFieldWrapper) deliveryFeeFieldWrapper.style.display = 'none';
        } else {
          if (formCustomerTitle) formCustomerTitle.textContent = 'Datos del Cliente & Mensajero';
          if (formCustomerBadge) {
            formCustomerBadge.textContent = 'Autocompletado Neon en vivo';
            formCustomerBadge.className = 'text-[10px] text-parrilla-muted';
          }
          if (custAddressLabel) custAddressLabel.textContent = 'Dirección de Entrega * (Se imprime en grande para mensajero)';
          if (deliveryFeeFieldWrapper) deliveryFeeFieldWrapper.style.display = 'block';
        }
      } else {
        formDomicilio.style.display = 'none';
        formDomicilio.classList.add('hidden');
      }

      if (currentOrderType === 'mesa') {
        if (formMesa) {
          formMesa.style.display = 'flex';
          formMesa.classList.remove('hidden');
        }
        if (formLlevar) {
          formLlevar.classList.add('hidden');
          formLlevar.classList.remove('flex');
          formLlevar.style.display = 'none';
        }
      } else if (currentOrderType === 'para_llevar') {
        if (formMesa) {
          formMesa.style.display = 'none';
          formMesa.classList.add('hidden');
        }
        if (formLlevar) {
          formLlevar.classList.remove('hidden');
          formLlevar.classList.add('flex');
          formLlevar.style.display = 'flex';
        }
      } else {
        if (formMesa) {
          formMesa.style.display = 'none';
          formMesa.classList.add('hidden');
        }
        if (formLlevar) {
          formLlevar.classList.add('hidden');
          formLlevar.classList.remove('flex');
          formLlevar.style.display = 'none';
        }
      }
    }

    function setOrderType(type) {
      currentOrderType = type;
      [typeMesaBtn, typeDomicilioBtn, typeLlevarBtn].forEach((b) => {
        b.className = 'order-type-btn flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-border bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold font-extrabold text-xs transition';
      });

      if (type === 'mesa') {
        typeMesaBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'flex';
        if (formLlevar) {
          formLlevar.classList.add('hidden');
          formLlevar.classList.remove('flex');
        }
        packagingQty = 0;
        manualPackagingOverride = false;
      } else if (type === 'domicilio') {
        typeDomicilioBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-accent bg-parrilla-accent text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'none';
        if (formLlevar) {
          formLlevar.classList.add('hidden');
          formLlevar.classList.remove('flex');
        }
        if (!manualPackagingOverride) {
          packagingQty = countFoodPlates();
        }
      } else {
        typeLlevarBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-amber-600 bg-amber-600 text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'none';
        if (formLlevar) {
          formLlevar.classList.remove('hidden');
          formLlevar.classList.add('flex');
        }
        if (!manualPackagingOverride) {
          packagingQty = countFoodPlates();
        }
      }

      updateCustomerFormVisibility();

      // Sincronizar notas de empaque según el nuevo tipo de pedido
      updateAllItemsPackagingNotes();

      // Update Courier Checkbox in Modal
      const chkCourierWrapper = document.getElementById('chk-courier-wrapper');
      const chkCourier = document.getElementById('chk-print-courier');
      if (chkCourierWrapper && chkCourier) {
        if (type === 'domicilio') {
          chkCourierWrapper.style.display = 'flex';
          // @ts-ignore
          chkCourier.checked = true;
        } else {
          chkCourierWrapper.style.display = 'none';
          // @ts-ignore
          chkCourier.checked = false;
        }
      }

      renderCart();
      updateMesaOccupiedIndicator();
    }

    // 4.1 MONITOR DE MESAS OCUPADAS Y ADICIONES A CUENTA ACTIVA
    let activeOccupiedTableOrders = {};

    function normalizeMesaKey(m) {
      if (!m) return '';
      return String(m).trim().toLowerCase().replace(/^mesa\s*/i, '');
    }

    function getOccupiedTableOrder(mesaVal) {
      const key = normalizeMesaKey(mesaVal);
      return key ? activeOccupiedTableOrders[key] : null;
    }

    function updateMesaOccupiedIndicator() {
      const banner = document.getElementById('mesa-occupied-banner');
      const bannerText = document.getElementById('mesa-occupied-text');
      if (!banner || !bannerText) return;

      if (currentOrderType !== 'mesa') {
        banner.classList.add('hidden');
        return;
      }

      // @ts-ignore
      const selMesa = String(tableInput?.value || '').trim();
      const openOrder = getOccupiedTableOrder(selMesa);

      if (openOrder) {
        const cod = openOrder.codigo_pedido || ('#' + openOrder.id);
        const tot = fmt(openOrder.total);
        bannerText.innerHTML = `⚠️ <strong>${escapeHtml(selMesa)}</strong> con cuenta activa (<strong>${escapeHtml(cod)}</strong> - Total actual: <strong>${tot}</strong>). Los platos que agregues se sumarán a la cuenta.`;
        banner.classList.remove('hidden');
      } else {
        banner.classList.add('hidden');
      }
    }

    async function checkOccupiedTables() {
      try {
        const res = await fetch('/api/pedidos?tipo=EN_MESA&limit=100', { cache: 'no-store' });
        if (!res.ok) return;
        const list = await res.json();
        activeOccupiedTableOrders = {};
        (Array.isArray(list) ? list : []).forEach((p) => {
          if (['PENDIENTE', 'EN_PREPARACION', 'SERVIDO', 'EN_CAMINO'].includes(p.estado)) {
            const key = normalizeMesaKey(p.mesa);
            if (key) activeOccupiedTableOrders[key] = p;
          }
        });
        updateMesaOccupiedIndicator();
      } catch (e) {}
    }

    tableInput?.addEventListener('change', updateMesaOccupiedIndicator);

    typeMesaBtn?.addEventListener('click', () => setOrderType('mesa'));
    typeDomicilioBtn?.addEventListener('click', () => setOrderType('domicilio'));
    typeLlevarBtn?.addEventListener('click', () => setOrderType('para_llevar'));

    // 5. DIRECTORIO DE CLIENTES NEON Y AUTOCOMPLETADO INSTANTÁNEO (TELÉFONO Y NOMBRE)
    let selectedCustomerId = null;
    let searchTimeout = null;
    const custDropdown = document.getElementById('cust-autocomplete-dropdown');
    const modalFiadoBox = document.getElementById('modal-fiado-customer-box');
    const modalFiadoPhone = document.getElementById('modal-fiado-phone');
    const modalFiadoName = document.getElementById('modal-fiado-name');
    const modalFiadoDropdown = document.getElementById('modal-fiado-autocomplete');

    function applySelectedCustomer(cust) {
      if (!cust) return;
      selectedCustomerId = cust.id || null;
      const cName = String(cust.nombre || cust.name || '').trim();
      const cPhone = String(cust.telefono || cust.phone || '').trim();
      const cAddress = String(cust.direccion || cust.address || '').trim();
      const cBarrio = String(cust.barrio || cust.notas || cust.notes || cust.neighborhood || '').trim();
      const orderCount = Number(cust.total_pedidos || cust.order_count || 0);

      // @ts-ignore
      if (custPhoneInput && cPhone && !cPhone.startsWith('SINTEL-')) custPhoneInput.value = cPhone;
      // @ts-ignore
      if (custNameInput && cName) custNameInput.value = cName;
      // @ts-ignore
      if (custAddressInput && cAddress) custAddressInput.value = cAddress;
      // @ts-ignore
      if (custNeighborhoodInput && cBarrio) custNeighborhoodInput.value = cBarrio;
      // @ts-ignore
      if (llevarCustNameInput && cName && currentOrderType === 'para_llevar') llevarCustNameInput.value = cName;
      // @ts-ignore
      if (modalFiadoPhone && cPhone && !cPhone.startsWith('SINTEL-')) modalFiadoPhone.value = cPhone;
      // @ts-ignore
      if (modalFiadoName && cName) modalFiadoName.value = cName;

      if (custStatus) {
        custStatus.textContent = `✅ Registrado${orderCount > 0 ? ' (' + orderCount + ')' : ''}`;
        custStatus.className = 'absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] text-emerald-600 font-extrabold pointer-events-none';
      }
      custDropdown?.classList.add('hidden');
      modalFiadoDropdown?.classList.add('hidden');
    }

    function renderCustomerAutocompleteList(list, dropdownEl, queryStr) {
      if (!dropdownEl) return;
      if (!Array.isArray(list) || list.length === 0) {
        dropdownEl.classList.add('hidden');
        dropdownEl.innerHTML = '';
        return;
      }

      dropdownEl.innerHTML = list
        .slice(0, 8)
        .map((c, idx) => {
          const cName = escapeHtml(c.nombre || c.name || 'Cliente');
          const rawPhone = String(c.telefono || c.phone || '');
          const cPhone = rawPhone.startsWith('SINTEL-') ? 'Sin teléfono' : escapeHtml(rawPhone);
          const cDir = escapeHtml(c.direccion || c.address || '');
          const cBarrio = escapeHtml(c.barrio || c.notas || c.notes || '');
          const fiadoVal = Number(c.total_fiado || 0);
          return `
            <button
              type="button"
              data-cust-idx="${idx}"
              class="cust-auto-item w-full text-left px-3 py-2 hover:bg-orange-50 transition flex items-center justify-between gap-2 cursor-pointer"
            >
              <div class="min-w-0 flex-1">
                <div class="font-bold text-xs text-parrilla-ivory truncate">${cName}</div>
                <div class="text-[11px] text-parrilla-muted truncate">
                  <span class="font-mono font-bold text-parrilla-gold">${cPhone}</span>
                  ${cDir ? ` • ${cDir}` : ''}${cBarrio ? ` (${cBarrio})` : ''}
                </div>
              </div>
              <div class="text-right flex-shrink-0">
                ${
                  fiadoVal > 0
                    ? `<span class="text-[10px] font-extrabold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded block">Fiado: ${fmt(fiadoVal)}</span>`
                    : `<span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded block">Seleccionar</span>`
                }
              </div>
            </button>
          `;
        })
        .join('');

      dropdownEl.classList.remove('hidden');
      dropdownEl.querySelectorAll('.cust-auto-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          const i = Number(btn.getAttribute('data-cust-idx'));
          if (list[i]) applySelectedCustomer(list[i]);
        });
      });
    }

    function triggerCustomerSearch(rawQuery, dropdownEl, isPhoneInput = false) {
      const q = String(rawQuery || '').trim();
      if (custStatus && isPhoneInput) custStatus.textContent = '';
      if (q.length < 2) {
        dropdownEl?.classList.add('hidden');
        return;
      }
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(async () => {
        try {
          if (custStatus && isPhoneInput) custStatus.textContent = '🔍';
          const res = await fetch(`/api/clientes/search?q=${encodeURIComponent(q)}`, { cache: 'no-store' });
          if (!res.ok) return;
          const data = await res.json();
          const list = Array.isArray(data) ? data : (data.customers || []);
          renderCustomerAutocompleteList(list, dropdownEl, q);

          // Si escribió el teléfono exacto (mínimo 7 dígitos) y hay coincidencia exacta, rellenar automáticamente
          const digitsQ = q.replace(/\D/g, '');
          if (isPhoneInput && digitsQ.length >= 7) {
            const exact = list.find((c) => String(c.telefono || c.phone || '').replace(/\D/g, '') === digitsQ);
            if (exact) {
              applySelectedCustomer(exact);
            } else if (custStatus) {
              custStatus.textContent = '✨ Nuevo';
              custStatus.className = 'absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] text-amber-600 font-bold pointer-events-none';
            }
          }
        } catch (err) {
          if (custStatus && isPhoneInput) custStatus.textContent = '';
        }
      }, 220);
    }

    custPhoneInput?.addEventListener('input', (e) => {
      // @ts-ignore
      const val = e.target.value;
      // @ts-ignore
      if (modalFiadoPhone) modalFiadoPhone.value = val;
      triggerCustomerSearch(val, custDropdown, true);
    });

    custNameInput?.addEventListener('input', (e) => {
      // @ts-ignore
      const val = e.target.value;
      // @ts-ignore
      if (modalFiadoName) modalFiadoName.value = val;
      triggerCustomerSearch(val, custDropdown, false);
    });

    modalFiadoPhone?.addEventListener('input', (e) => {
      // @ts-ignore
      const val = e.target.value;
      // @ts-ignore
      if (custPhoneInput) custPhoneInput.value = val;
      triggerCustomerSearch(val, modalFiadoDropdown, true);
    });

    modalFiadoName?.addEventListener('input', (e) => {
      // @ts-ignore
      const val = e.target.value;
      // @ts-ignore
      if (custNameInput) custNameInput.value = val;
      triggerCustomerSearch(val, modalFiadoDropdown, false);
    });

    document.addEventListener('click', (e) => {
      // @ts-ignore
      if (custDropdown && !custDropdown.contains(e.target) && e.target !== custPhoneInput && e.target !== custNameInput) {
        custDropdown.classList.add('hidden');
      }
      // @ts-ignore
      if (modalFiadoDropdown && !modalFiadoDropdown.contains(e.target) && e.target !== modalFiadoPhone && e.target !== modalFiadoName) {
        modalFiadoDropdown.classList.add('hidden');
      }
    });

    // 6. PAYMENT METHOD SWITCHER (Map inicializado en el encabezado de estado)

    // 6.1 SINCRONIZACIÓN EN VIVO DE ESPECIALES DEL DÍA Y PLATOS ROTATIVOS EN POS
    function syncPosLiveSpecials(data) {
      if (!data || typeof data !== 'object') return;
      const newSopa = String(data.sopa_dia || data.sopa || '').trim();
      const newPrincipios = Array.isArray(data.principios)
        ? data.principios
        : (typeof data.principios === 'string' ? data.principios.split(',').map((s) => s.trim()).filter(Boolean) : []);
      const newAcomp = Array.isArray(data.acompanamientos)
        ? data.acompanamientos
        : (typeof data.acompanamientos === 'string' ? data.acompanamientos.split(',').map((s) => s.trim()).filter(Boolean) : []);
      const newEsp165 = Array.isArray(data.especiales_16500)
        ? data.especiales_16500
        : (typeof data.especiales_16500 === 'string' ? data.especiales_16500.split(',').map((s) => s.trim()).filter(Boolean) : []);
      const esp165Badge = String(data.especiales_16500_etiqueta || '⭐ SOLO POR HOY').trim();
      const arrozNombre = String(data.especial_arroz_nombre || '').trim();
      const arrozBadge = String(data.especial_arroz_etiqueta || '⭐ ESPECIAL DE HOY').trim();
      const arrozPrecio = Number(data.especial_arroz_precio || 18000);

      if (newSopa) dailySpecialsData.sopa = newSopa;
      if (newPrincipios.length > 0) dailySpecialsData.principios = newPrincipios;
      if (newAcomp.length > 0) dailySpecialsData.acompanamientos = newAcomp;

      // Actualizar buscador universal (catalogData) con los platos rotativos activos de hoy
      for (let i = catalogData.length - 1; i >= 0; i--) {
        const cid = String(catalogData[i].id || '');
        if (cid === 't1-7' || cid === 't1-8' || cid === 't3-6' || cid.startsWith('rot-esp-')) {
          catalogData.splice(i, 1);
        }
      }

      newEsp165.forEach((dishName, idx) => {
        catalogData.push({
          id: `rot-esp-165-${idx}`,
          name: dishName,
          price: 16500,
          category_id: 'fuertes_165',
          menu_type: 'almuerzo',
          description: 'Especial del día ($16.500). Incluye sopa, principio y acompañamiento.',
          special_badge: esp165Badge,
          customizable: true,
        });
      });

      if (arrozNombre) {
        catalogData.push({
          id: 'rot-esp-arroz',
          name: arrozNombre,
          price: arrozPrecio,
          category_id: 'fuertes_175',
          menu_type: 'almuerzo',
          description: `Especial rotativo del día (${fmt(arrozPrecio)}). Incluye sopa, principio y acompañamiento.`,
          special_badge: arrozBadge,
          customizable: true,
        });
      }

      // Actualizar opciones de ítems actuales en el carrito si están usando valores por defecto
      if (cart.length > 0) {
        const soupDefault = dailySpecialsData.sopa ? `Con Sopa (${dailySpecialsData.sopa})` : 'Con Sopa';
        const pOpts = [...(dailySpecialsData.principios || []), 'Sin Principio'];
        const sOpts = [...(dailySpecialsData.acompanamientos || []), 'Sin Acompañamiento'];
        cart.forEach((it) => {
          if (it.isCustomizable) {
            if (it.soup !== 'Sin Sopa') it.soup = soupDefault;
            if (!pOpts.includes(it.principle)) it.principle = pOpts[0] || 'Sin Principio';
            if (!sOpts.includes(it.side)) it.side = sOpts[0] || 'Sin Acompañamiento';
            it.notes = buildPlateNotes(it);
          }
        });
        renderCart();
      }

      // @ts-ignore
      if (searchInput && searchInput.value && searchInput.value.trim()) {
        // @ts-ignore
        runUniversalSearch(searchInput.value);
      }
    }

    window.addEventListener('sp:specials-updated', (ev) => {
      // @ts-ignore
      if (ev && ev.detail) {
        // @ts-ignore
        syncPosLiveSpecials(ev.detail);
      }
    });

    // 6.2 SINCRONIZACIÓN EN VIVO DE PRECIOS Y PLATOS AGOTADOS EN POS (DESDE NEON DB)
    function syncPosCatalogPlatos(platosArray) {
      if (!Array.isArray(platosArray) || platosArray.length === 0) return;
      const platoMap = new Map();
      platosArray.forEach((p) => {
        const k = normalizeStr(p.nombre || p.name);
        if (k) platoMap.set(k, p);
      });

      catalogData.forEach((item) => {
        const info = platoMap.get(normalizeStr(item.name));
        if (info) {
          const newPrice = Number(info.precio ?? info.price ?? item.price ?? 0);
          if (newPrice > 0) item.price = newPrice;
          const isAvail = info.disponible !== false && info.activo !== false && info.in_stock !== 0;
          item.disponible = isAvail;
          item.in_stock = isAvail ? 1 : 0;
          if (info.id) item.plato_id = info.id;
        }
      });

      // @ts-ignore
      if (searchInput && searchInput.value && searchInput.value.trim()) {
        // @ts-ignore
        runUniversalSearch(searchInput.value);
      }
    }

    window.addEventListener('sp:platos-updated', (ev) => {
      // @ts-ignore
      if (ev && Array.isArray(ev.detail)) {
        // @ts-ignore
        syncPosCatalogPlatos(ev.detail);
      }
    });

    try {
      const cachedSpec = JSON.parse(localStorage.getItem('sp_daily_specials_v1') || 'null');
      if (cachedSpec) syncPosLiveSpecials(cachedSpec);
      const cachedPlatos = JSON.parse(localStorage.getItem('sp_platos_live_v1') || 'null');
      if (Array.isArray(cachedPlatos)) syncPosCatalogPlatos(cachedPlatos);
    } catch (e) {}

    function updateModalFiadoBoxVisibility() {
      if (!modalFiadoBox) return;
      const isSingleFiado = cobroPaymentMode === 'single' && selectedSingleMethod === 'FIADO';
      // @ts-ignore
      const isSplitFiado = cobroPaymentMode === 'split' && (splitMethod1?.value === 'FIADO' || splitMethod2?.value === 'FIADO');
      const needsFiadoBox = isSingleFiado || isSplitFiado;
      if (needsFiadoBox) {
        modalFiadoBox.classList.remove('hidden');
        // @ts-ignore
        if (modalFiadoPhone && custPhoneInput && !modalFiadoPhone.value) modalFiadoPhone.value = custPhoneInput.value;
        // @ts-ignore
        if (modalFiadoName && custNameInput && !modalFiadoName.value) modalFiadoName.value = custNameInput.value;
      } else {
        modalFiadoBox.classList.add('hidden');
      }
    }

    payButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        payButtons.forEach(b => {
          b.className = 'pay-btn py-2 px-1 rounded-lg text-[11px] font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition cursor-pointer';
        });
        btn.className = 'pay-btn active py-2 px-1 rounded-lg text-[11px] font-bold bg-parrilla-gold text-white shadow-sm transition cursor-pointer';
        currentPaymentMethod = btn.getAttribute('data-method') || 'efectivo';
        selectedSingleMethod = methodFrontToBackMap[currentPaymentMethod] || 'CASH';

        // Sincronizar también el botón activo en el modal de cobro
        document.querySelectorAll('.single-pay-btn').forEach(b => {
          const isMatch = b.getAttribute('data-method') === selectedSingleMethod;
          b.className = isMatch
            ? 'single-pay-btn active py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-xs flex flex-col items-center gap-1 shadow-sm cursor-pointer'
            : 'single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1 cursor-pointer';
        });
        if (singleCashCalc) {
          if (selectedSingleMethod === 'CASH') singleCashCalc.classList.remove('hidden');
          else singleCashCalc.classList.add('hidden');
        }

        if (currentPaymentMethod === 'efectivo') {
          cashChangeBox.style.display = 'flex';
        } else {
          cashChangeBox.style.display = 'none';
        }
        updateCustomerFormVisibility();
        updateModalFiadoBoxVisibility();
        if (currentPaymentMethod === 'fiado') {
          // @ts-ignore
          if (custPhoneInput && !custPhoneInput.value) custPhoneInput.focus();
        }
        renderCart();
      });
    });

    // 7. CLEAR CART
    clearCartBtn?.addEventListener('click', () => {
      if (confirm('¿Deseas vaciar la comanda actual?')) {
        cart = [];
        // @ts-ignore
        cashReceivedInput.value = '';
        renderCart();
      }
    });

    // 7.1 QUICK TEST PRINT SAT Q22 (Cola remota hacia el PC de Caja)
    quickTestBtn?.addEventListener('click', async () => {
      // @ts-ignore
      quickTestBtn.disabled = true;
      const origHtml = quickTestBtn.innerHTML;
      quickTestBtn.innerHTML = '<span>⏳...</span>';
      try {
        const res = await fetch('/api/impresion/test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ tipo: 'COCINA' })
        });
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }
        showPosToast('✅ Enviado a impresora SAT Q22 en Caja (Ticket de Prueba)');
      } catch (err) {
        alert('No se pudo enviar el ticket de prueba a la cola de impresión: ' + (err.message || err));
      } finally {
        // @ts-ignore
        quickTestBtn.disabled = false;
        quickTestBtn.innerHTML = origHtml;
      }
    });

    // 8. CHECKOUT & MODAL DE COBRO / PAGO MIXTO
    const modalCobro = document.getElementById('modal-cobro-pos');
    const btnCloseCobro = document.getElementById('btn-close-cobro-modal');
    const btnCancelCobro = document.getElementById('btn-cancel-cobro');
    const btnConfirmPayment = document.getElementById('btn-confirm-payment-print');

    const btnModeSingle = document.getElementById('btn-mode-single');
    const btnModeSplit = document.getElementById('btn-mode-split');
    const viewSingle = document.getElementById('cobro-view-single');
    const viewSplit = document.getElementById('cobro-view-split');

    let cobroPaymentMode = 'single'; // 'single' | 'split'
    selectedSingleMethod = 'CASH';
    const singleCashCalc = document.getElementById('single-cash-calc');
    const singleCashReceived = document.getElementById('single-cash-received');
    const singleChangeDisplay = document.getElementById('single-change-display');

    const splitMethod1 = document.getElementById('split-method-1');
    const splitAmount1 = document.getElementById('split-amount-1');
    const splitMethod2 = document.getElementById('split-method-2');
    const splitAmount2 = document.getElementById('split-amount-2');
    const splitSumDisplay = document.getElementById('split-sum-display');
    const splitStatusDisplay = document.getElementById('split-status-display');
    const splitBalanceBox = document.getElementById('split-balance-box');

    // Switch between Single and Split payment modes
    btnModeSingle?.addEventListener('click', () => {
      cobroPaymentMode = 'single';
      btnModeSingle.className = 'py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory shadow-sm transition';
      btnModeSplit.className = 'py-2 rounded-lg text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory transition';
      viewSingle.classList.remove('hidden');
      viewSplit.classList.add('hidden');
      updateModalFiadoBoxVisibility();
    });

    btnModeSplit?.addEventListener('click', () => {
      cobroPaymentMode = 'split';
      btnModeSplit.className = 'py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory shadow-sm transition';
      btnModeSingle.className = 'py-2 rounded-lg text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory transition';
      viewSplit.classList.remove('hidden');
      viewSingle.classList.add('hidden');

      // Pre-fill split amounts if empty
      const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
      // @ts-ignore
      const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
      const total = subtotal + deliveryFee;
      // @ts-ignore
      if (!splitAmount1.value && !splitAmount2.value) {
        // @ts-ignore
        splitAmount1.value = Math.round(total / 2);
        // @ts-ignore
        splitAmount2.value = total - Math.round(total / 2);
      }
      updateSplitBalance(total);
      updateModalFiadoBoxVisibility();
    });

    splitMethod1?.addEventListener('change', updateModalFiadoBoxVisibility);
    splitMethod2?.addEventListener('change', updateModalFiadoBoxVisibility);

    // Single payment method selector buttons
    document.querySelectorAll('.single-pay-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.single-pay-btn').forEach(b => {
          b.className = 'single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1';
        });
        btn.className = 'single-pay-btn active py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-xs flex flex-col items-center gap-1 shadow-sm';
        selectedSingleMethod = btn.getAttribute('data-method') || 'CASH';

        if (selectedSingleMethod === 'CASH') {
          singleCashCalc.classList.remove('hidden');
        } else {
          singleCashCalc.classList.add('hidden');
        }
        updateCustomerFormVisibility();
        updateModalFiadoBoxVisibility();
      });
    });

    // Single cash change calculation
    singleCashReceived?.addEventListener('input', () => {
      const { total } = calculateTotals();
      // @ts-ignore
      const paid = Number(singleCashReceived.value || 0);
      const diff = paid - total;
      if (paid > 0) {
        singleChangeDisplay.textContent = diff >= 0 ? fmt(diff) : 'Faltan ' + fmt(Math.abs(diff));
        singleChangeDisplay.className = diff >= 0 ? 'font-display font-black text-xl text-emerald-600 font-mono block' : 'font-display font-black text-xl text-red-600 font-mono block';
      } else {
        singleChangeDisplay.textContent = '$0';
        singleChangeDisplay.className = 'font-display font-black text-xl text-emerald-600 font-mono block';
      }
    });

    // Split balance calculation
    function updateSplitBalance(total) {
      // @ts-ignore
      const a1 = Number(splitAmount1.value || 0);
      // @ts-ignore
      const a2 = Number(splitAmount2.value || 0);
      const sum = a1 + a2;
      splitSumDisplay.textContent = fmt(sum);

      if (sum >= total) {
        splitStatusDisplay.textContent = '✅ Cubre el total ($' + fmt(sum) + ')';
        splitStatusDisplay.className = 'font-bold text-emerald-600';
        splitBalanceBox.className = 'p-3 rounded-xl border border-emerald-300 bg-emerald-50 flex items-center justify-between text-xs';
      } else {
        const missing = total - sum;
        splitStatusDisplay.textContent = `❌ Faltan ${fmt(missing)}`;
        splitStatusDisplay.className = 'font-bold text-red-600';
        splitBalanceBox.className = 'p-3 rounded-xl border border-red-300 bg-red-50 flex items-center justify-between text-xs';
      }
    }

    [splitAmount1, splitAmount2].forEach(input => {
      input?.addEventListener('input', () => {
        const { total } = calculateTotals();
        updateSplitBalance(total);
      });
    });

    const closeCobroModal = () => {
      modalCobro.classList.add('hidden');
      modalCobro.classList.remove('flex');
    };
    btnCloseCobro?.addEventListener('click', closeCobroModal);
    btnCancelCobro?.addEventListener('click', closeCobroModal);

    // Open Cobro Modal
    checkoutPrintBtn?.addEventListener('click', () => {
      if (cart.length === 0) {
        alert('Por favor agrega al menos un plato a la comanda.');
        return;
      }

      if (activeMenuMode === 'convenios') {
        if (custPhoneInput && !custPhoneInput.value) custPhoneInput.value = 'CONV-CLINICA-PAC';
        if (custNameInput && !custNameInput.value) custNameInput.value = 'Clínica Primero de Mayo (Pacientes)';
        if (custAddressInput && !custAddressInput.value) custAddressInput.value = 'Clínica Primero de Mayo - Área Hospitalización';
      } else {
        if (currentOrderType === 'domicilio') {
          // @ts-ignore
          if (!custPhoneInput.value.trim() || !custNameInput.value.trim() || !custAddressInput.value.trim()) {
            alert('Para domicilios es obligatorio indicar Teléfono, Nombre y Dirección.');
            return;
          }
        }

        if (currentPaymentMethod === 'fiado') {
          // @ts-ignore
          const fPhone = (custPhoneInput?.value || '').trim();
          // @ts-ignore
          const fName = (custNameInput?.value || '').trim();
          if (!fPhone || !fName) {
            updateCustomerFormVisibility();
            alert('⚠️ Para pedidos en FIADO es obligatorio seleccionar o ingresar el Teléfono y Nombre del Cliente.');
            // @ts-ignore
            if (!fPhone) custPhoneInput?.focus();
            // @ts-ignore
            else custNameInput?.focus();
            return;
          }
        }
      }

      const { subtotal, packagingFee, deliveryFee, total, isDeliveryOrTakeout } = calculateTotals();

      // Populate modal values
      document.getElementById('modal-cobro-subtotal').textContent = fmt(subtotal);

      const modalPackagingRow = document.getElementById('modal-cobro-packaging-row');
      const modalPackagingLabel = document.getElementById('modal-cobro-packaging-label');
      const modalPackagingVal = document.getElementById('modal-cobro-packaging');
      if (isDeliveryOrTakeout && packagingFee > 0) {
        if (modalPackagingRow) modalPackagingRow.style.display = 'flex';
        if (modalPackagingLabel) modalPackagingLabel.textContent = `Empaques (${globalPackagingType} x ${packagingQty}):`;
        if (modalPackagingVal) modalPackagingVal.textContent = fmt(packagingFee);
      } else {
        if (modalPackagingRow) modalPackagingRow.style.display = 'none';
      }

      const deliveryRowModal = document.getElementById('modal-cobro-delivery-row');
      if (currentOrderType === 'domicilio') {
        deliveryRowModal.style.display = 'flex';
        document.getElementById('modal-cobro-delivery').textContent = fmt(deliveryFee);
      } else {
        deliveryRowModal.style.display = 'none';
      }
      document.getElementById('modal-cobro-total').textContent = fmt(total);

      // Subtitle
      const titleInfo = currentOrderType === 'mesa' 
        // @ts-ignore
        ? `${tableInput.value || 'Mesa'} • ${cart.length} plato(s)`
        // @ts-ignore
        : (currentOrderType === 'domicilio' ? `Domicilio para ${custNameInput.value.trim()}` : 'Para Llevar');
      document.getElementById('modal-order-subtitle').textContent = titleInfo;

      // Set initial single cash input if pre-typed
      // @ts-ignore
      if (cashReceivedInput.value) {
        // @ts-ignore
        singleCashReceived.value = cashReceivedInput.value;
      }

      updateModalFiadoBoxVisibility();
      modalCobro.classList.remove('hidden');
      modalCobro.classList.add('flex');
    });

    // Helper: construir payload de pedido para FastAPI
    function buildFastapiPedidoPayload(estadoOverride = null) {
      const { subtotal, packagingFee, deliveryFee, total, cantDomClinica } = calculateTotals();
      const tipoMap = {
        mesa: 'EN_MESA',
        domicilio: 'DOMICILIO',
        para_llevar: 'PARA_LLEVAR'
      };
      const tipoBackend = tipoMap[currentOrderType] || 'EN_MESA';

      // @ts-ignore
      const mesaStr = currentOrderType === 'mesa' ? (tableInput?.value || 'Mesa 1') : '';
      // @ts-ignore
      const typedPhone = (custPhoneInput?.value || modalFiadoPhone?.value || '').trim();
      // @ts-ignore
      const typedName = (custNameInput?.value || modalFiadoName?.value || '').trim();
      // @ts-ignore
      const llevarName = (llevarCustNameInput?.value || '').trim();

      const isMostradorType = currentOrderType === 'para_llevar' || currentOrderType === 'mostrador';
      const tipoPedido = isMostradorType ? 'MOSTRADOR' : (currentOrderType === 'domicilio' ? 'DOMICILIO' : 'MESA');

      let nombreCliente = '';
      if (isMostradorType) {
        nombreCliente = llevarName || typedName;
      } else if (currentOrderType === 'domicilio') {
        nombreCliente = typedName;
      } else {
        nombreCliente = typedName || (editingOpenOrder && editingOpenOrder.cliente_nombre ? editingOpenOrder.cliente_nombre.trim() : '') || mesaStr;
      }

      const isConvenios = activeMenuMode === 'convenios';
      const custPhone = isConvenios ? 'CONV-CLINICA-PAC' : typedPhone;
      const custName = isConvenios
        ? 'Clínica Primero de Mayo (Pacientes)'
        : (nombreCliente.trim() || (tipoPedido === 'MOSTRADOR' ? 'Mostrador' : (tipoPedido === 'MESA' ? (mesaStr || 'Mesa 1') : 'Cliente General')));
      // @ts-ignore
      const custAddress = isConvenios ? 'Clínica Primero de Mayo - Área Hospitalización' : (custAddressInput?.value || '').trim();
      // @ts-ignore
      const custNeighborhood = isConvenios ? 'Convenio Institucional Pacientes' : (custNeighborhoodInput?.value || '').trim();
      // @ts-ignore
      const staffCreator = String(window.__SP_STAFF_NAME__ || 'Colaborador').trim();
      const metodoPago = isConvenios ? 'FIADO' : (selectedSingleMethod || 'EFECTIVO');
      const convenioCodigo = isConvenios ? 'CONV-CLINICA-PAC' : null;

      const notasPartes = [];
      if (custAddress) notasPartes.push(`Dirección: ${custAddress}`);
      if (custNeighborhood) notasPartes.push(`Barrio: ${custNeighborhood}`);
      if (packagingFee > 0 && packagingQty > 0) {
        notasPartes.push(`Empaques: ${packagingQty}x ${globalPackagingType} (+$${packagingFee})`);
      }
      if (cantDomClinica > 0) {
        notasPartes.push(`[DOMICILIOS_CLINICA:${cantDomClinica}]`);
      }
      if (staffCreator) {
        notasPartes.push(`[CREADO_POR:${staffCreator}]`);
      }
      const notasPedido = notasPartes.join(' | ');

      const detallesPayload = cart.map((item) => {
        let finalNotes = item.notes || '';
        const loc = item.hospitalLocation || item.ubicacion || (item.isHospitalDiet ? (currentActiveHospitalLocation || 'Torre A') : null);
        if (item.isHospitalDiet && loc) {
          const tag = getHospitalDietTag(item.name, loc);
          if (!finalNotes.includes(tag)) {
            finalNotes = `${tag} ${finalNotes}`.trim();
          }
        }
        return {
          plato_id: (Number.isInteger(Number(item.plato_id || item.id)) && Number(item.plato_id || item.id) > 0)
            ? Number(item.plato_id || item.id)
            : 1,
          nombre_plato: item.name,
          cantidad: Number(item.quantity || 1),
          precio_unitario: Number(item.price || 0),
          notas_item: finalNotes,
          notas: finalNotes,
          ubicacion_hospitalaria: loc,
          ubicacion: loc
        };
      });

      const payload = {
        tipo: isConvenios ? 'DOMICILIO' : tipoBackend,
        mesa: mesaStr || null,
        cliente_id: isConvenios ? 9001 : (selectedCustomerId || null),
        cliente_nombre: custName,
        customer_name: custName,
        cliente_telefono: custPhone || null,
        direccion: custAddress || null,
        barrio: custNeighborhood || null,
        metodo_pago: metodoPago,
        convenio_codigo: convenioCodigo,
        cantidad_envios: cantDomClinica,
        cantidad_domicilios: cantDomClinica,
        flete_domicilio: deliveryFee,
        delivery_fee: deliveryFee,
        notas: notasPedido || null,
        creado_por: staffCreator,
        subtotal: subtotal,
        packaging_fee: packagingFee,
        total,
        impreso_cocina: false,
        impreso_caja: true,
        detalles: detallesPayload,
        items: detallesPayload
      };
      if (estadoOverride) {
        payload.estado = estadoOverride;
      }
      return {
        payload,
        meta: {
          tipoBackend: payload.tipo,
          mesaStr,
          custPhone,
          custName,
          custAddress,
          custNeighborhood,
          subtotal,
          packagingFee,
          deliveryFee,
          total,
          detallesPayload,
          staffCreator,
          cantDomClinica
        }
      };
    }

    // Botón directo: "📝 Cerrar a Fiado (Guardar en Cartera)"
    btnCloseFiadoDirect?.addEventListener('click', () => {
      if (cart.length === 0) {
        alert('Por favor agrega al menos un plato a la comanda.');
        return;
      }
      // @ts-ignore
      let fName = (custNameInput?.value || modalFiadoName?.value || '').trim();
      // @ts-ignore
      let fPhone = (custPhoneInput?.value || modalFiadoPhone?.value || '').trim();

      if (activeMenuMode === 'convenios') {
        fName = 'Clínica Primero de Mayo (Pacientes)';
        fPhone = 'CONV-CLINICA-PAC';
        if (custNameInput) custNameInput.value = fName;
        if (custPhoneInput) custPhoneInput.value = fPhone;
        if (custAddressInput && !custAddressInput.value) custAddressInput.value = 'Clínica Primero de Mayo - Área Hospitalización';
      }

      if (!fName) {
        updateCustomerFormVisibility();
        alert('⚠️ Para cerrar un pedido a FIADO debes seleccionar una de las 6 Empresas de Convenio o ingresar el Nombre y Teléfono del Cliente.');
        // @ts-ignore
        custNameInput?.focus();
        return;
      }
      // @ts-ignore
      if (custPhoneInput && !fPhone) {
        // Si es convenio corporativo sin teléfono digitado, asignar código convenio
        // @ts-ignore
        custPhoneInput.value = 'CONV-' + normalizeStr(fName).slice(0, 12).toUpperCase();
      }
      cobroPaymentMode = 'single';
      selectedSingleMethod = 'FIADO';
      checkoutPrintBtn?.click();
    });

    // 8.0 GUARDAR / ENVIAR A COCINA (DEJAR ABIERTO EN /pedidos)
    btnSaveOpenOrder?.addEventListener('click', async () => {
      if (cart.length === 0) {
        alert('Por favor agrega al menos un plato a la comanda.');
        return;
      }

      if (activeMenuMode === 'convenios') {
        if (custPhoneInput && !custPhoneInput.value) custPhoneInput.value = 'CONV-CLINICA-PAC';
        if (custNameInput && !custNameInput.value) custNameInput.value = 'Clínica Primero de Mayo (Pacientes)';
        if (custAddressInput && !custAddressInput.value) custAddressInput.value = 'Clínica Primero de Mayo - Área Hospitalización';
      } else {
        if (currentOrderType === 'domicilio') {
          // @ts-ignore
          if (!custPhoneInput.value.trim() || !custNameInput.value.trim() || !custAddressInput.value.trim()) {
            alert('Para domicilios es obligatorio indicar Teléfono, Nombre y Dirección.');
            return;
          }
        }

        if (currentPaymentMethod === 'fiado') {
          // @ts-ignore
          const fPhone = (custPhoneInput?.value || '').trim();
          // @ts-ignore
          const fName = (custNameInput?.value || '').trim();
          if (!fPhone || !fName) {
            updateCustomerFormVisibility();
            alert('⚠️ Para pedidos en FIADO es obligatorio vincular un cliente indicando su Teléfono y Nombre.');
            // @ts-ignore
            if (!fPhone) custPhoneInput?.focus();
            // @ts-ignore
            else custNameInput?.focus();
            return;
          }
        }
      }

      btnSaveOpenOrder.disabled = true;
      const origHtml = btnSaveOpenOrder.innerHTML;
      btnSaveOpenOrder.innerHTML = '<span>Enviando a cocina y guardando...</span>';

      try {
        const isMostrador = currentOrderType === 'para_llevar' || currentOrderType === 'mostrador';
        const tipoPedido = isMostrador ? 'MOSTRADOR' : (currentOrderType === 'domicilio' ? 'DOMICILIO' : 'MESA');

        // Captura directa y explícita del input de cliente para evitar pérdida de valor
        // @ts-ignore
        const rawInputCliente = (custNameInput?.value || '').trim();
        // @ts-ignore
        const rawLlevarCliente = (llevarCustNameInput?.value || '').trim();
        // @ts-ignore
        const rawFiadoCliente = (modalFiadoName?.value || '').trim();

        let nombreCliente = '';
        if (isMostrador) {
          nombreCliente = rawLlevarCliente || rawInputCliente;
        } else if (currentOrderType === 'domicilio') {
          nombreCliente = rawInputCliente || rawFiadoCliente;
        } else {
          // @ts-ignore
          nombreCliente = rawInputCliente || (editingOpenOrder?.cliente_nombre?.trim() || '') || (tableInput?.value || '').trim();
        }

        const clienteNombreFinal = activeMenuMode === 'convenios'
          ? 'Clínica Primero de Mayo (Pacientes)'
          : (nombreCliente.trim() || (tipoPedido === 'MOSTRADOR' ? 'Mostrador' : (tipoPedido === 'MESA' ? (tableInput?.value || 'Mesa 1').trim() : 'Cliente General')));

        const { payload, meta } = buildFastapiPedidoPayload('EN_PREPARACION');
        payload.cliente_nombre = clienteNombreFinal;
        payload.customer_name = clienteNombreFinal;
        meta.custName = clienteNombreFinal;

        // @ts-ignore
        const wasOccupied = currentOrderType === 'mesa' && Boolean(getOccupiedTableOrder(tableInput?.value));
        let savedOrder = null;

        if (editingOpenOrder && editingOpenOrder.id) {
          // Intentar actualizar el pedido abierto existente (PUT /api/pedidos/{id})
          const putRes = await fetch(`/api/pedidos/${editingOpenOrder.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...payload,
              cliente_nombre: clienteNombreFinal,
              customer_name: clienteNombreFinal
            })
          });
          if (putRes.ok) {
            savedOrder = await putRes.json();
          }
        }

        if (!savedOrder) {
          const pedRes = await fetch('/api/pedidos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...payload,
              cliente_nombre: clienteNombreFinal,
              customer_name: clienteNombreFinal
            })
          });
          const pedData = await pedRes.json().catch(() => ({}));
          if (!pedRes.ok || !pedData.id) {
            const errMsg = pedData.detail || pedData.error || `Error HTTP ${pedRes.status} al guardar el pedido abierto.`;
            throw new Error(typeof errMsg === 'string' ? errMsg : JSON.stringify(errMsg));
          }
          savedOrder = pedData;
        }

        const ticket = {
          id: savedOrder.codigo_pedido || savedOrder.id,
          pedidoId: savedOrder.id,
          createdAt: savedOrder.fecha_hora || new Date().toISOString(),
          orderType: currentOrderType,
          table: meta.mesaStr,
          customerName: clienteNombreFinal,
          customerPhone: meta.custPhone,
          address: meta.custAddress,
          neighborhood: meta.custNeighborhood,
          items: cart.map(({ name, price, quantity, notes, packaging, isHospitalDiet, hospitalLocation }) => ({
            name,
            price,
            quantity,
            notes: notes || '',
            packaging: packaging || globalPackagingType,
            isHospitalDiet: !!isHospitalDiet,
            hospitalLocation: hospitalLocation || null,
            ubicacion: hospitalLocation || null
          })),
          subtotal: meta.subtotal,
          packagingFee: meta.packagingFee,
          packagingType: globalPackagingType,
          packagingQty,
          deliveryFee: meta.deliveryFee,
          total: meta.total,
          paymentMethod: 'PENDIENTE POR COBRAR',
          cashPaid: 0
        };

        saveLastTicket(ticket);
        setEditingOpenOrder(null);
        cart = [];
        manualPackagingOverride = false;
        packagingQty = 0;
        // @ts-ignore
        if (cashReceivedInput) cashReceivedInput.value = '';
        // @ts-ignore
        if (llevarCustNameInput) llevarCustNameInput.value = '';
        renderCart();

        // Notificación Toast Silenciosa (Sin popup window.print)
        const orderCode = savedOrder.codigo_pedido || savedOrder.id || 'NUEVO';
        if (wasOccupied) {
          showPosToast(`✅ Nuevos platos agregados a ${meta.mesaStr || 'Mesa'} y comanda enviada a Cocina`);
        } else {
          showPosToast(`✅ Pedido registrado y comanda enviada a Cocina (#${orderCode})`);
        }
        checkOccupiedTables();
      } catch (err) {
        alert('Error al guardar pedido abierto: ' + err.message);
      } finally {
        btnSaveOpenOrder.disabled = false;
        btnSaveOpenOrder.innerHTML = origHtml;
        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      }
    });

    // CONFIRMAR PAGO (POST /api/pedidos/{id}/pagar) E IMPRIMIR SAT Q22
    btnConfirmPayment?.addEventListener('click', async () => {
      const { subtotal, packagingFee, deliveryFee, total } = calculateTotals();

      let paymentsPayload = [];
      let cashGiven = 0;

      if (cobroPaymentMode === 'single') {
        // @ts-ignore
        const paidCash = Number(singleCashReceived.value || 0);
        const change = (selectedSingleMethod === 'CASH' && paidCash > total) ? (paidCash - total) : 0;
        cashGiven = paidCash;

        paymentsPayload = [{
          method: selectedSingleMethod,
          amount: total,
          change_given: change
        }];
      } else {
        // Split mode
        // @ts-ignore
        const m1 = splitMethod1.value;
        // @ts-ignore
        const a1 = Number(splitAmount1.value || 0);
        // @ts-ignore
        const m2 = splitMethod2.value;
        // @ts-ignore
        const a2 = Number(splitAmount2.value || 0);

        if ((a1 + a2) < total) {
          alert(`El total de los pagos divididos ($${fmt(a1 + a2)}) no cubre el total del pedido ($${fmt(total)}).`);
          return;
        }

        paymentsPayload = [
          { method: m1, amount: a1, change_given: 0 },
          { method: m2, amount: a2, change_given: 0 }
        ];
      }

      const includesFiado = paymentsPayload.some((p) => p.method === 'FIADO');
      if (includesFiado) {
        // @ts-ignore
        const fPhone = (modalFiadoPhone?.value || custPhoneInput?.value || '').trim();
        // @ts-ignore
        const fName = (modalFiadoName?.value || custNameInput?.value || '').trim();
        if (!fPhone || !fName) {
          updateModalFiadoBoxVisibility();
          alert('⚠️ Todo pedido en FIADO debe estar vinculado a un cliente. Por favor ingresa o selecciona el Teléfono y Nombre del Cliente.');
          // @ts-ignore
          if (!fPhone) modalFiadoPhone?.focus();
          // @ts-ignore
          else modalFiadoName?.focus();
          return;
        }
        // @ts-ignore
        if (custPhoneInput) custPhoneInput.value = fPhone;
        // @ts-ignore
        if (custNameInput) custNameInput.value = fName;
      }

      btnConfirmPayment.disabled = true;
      btnConfirmPayment.innerHTML = '<span>Procesando pago y comanda...</span>';

      try {
        const { payload: pedidoFastapiPayload, meta } = buildFastapiPedidoPayload();
        const { tipoBackend, mesaStr, custPhone, custName, custAddress, custNeighborhood, detallesPayload } = meta;

        // 1. Guardar o actualizar el pedido real en Neon DB
        const cartSignature = JSON.stringify({ tipoBackend, mesaStr, custPhone, total, detallesPayload });
        // @ts-ignore
        let savedOrder = (window.__pendingOrderSig === cartSignature && window.__pendingOrderObj?.id)
          // @ts-ignore
          ? window.__pendingOrderObj
          : null;

        if (!savedOrder && editingOpenOrder && editingOpenOrder.id) {
          const putRes = await fetch(`/api/pedidos/${editingOpenOrder.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(pedidoFastapiPayload)
          });
          if (putRes.ok) {
            savedOrder = await putRes.json();
          } else {
            savedOrder = editingOpenOrder;
          }
        }

        if (!savedOrder) {
          const pedRes = await fetch('/api/pedidos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(pedidoFastapiPayload)
          });

          const pedData = await pedRes.json().catch(() => ({}));
          if (!pedRes.ok || !pedData.id) {
            const errMsg = pedData.detail || pedData.error || `Error HTTP ${pedRes.status} al guardar el pedido en la base de datos.`;
            throw new Error(typeof errMsg === 'string' ? errMsg : JSON.stringify(errMsg));
          }
          savedOrder = pedData;
          // @ts-ignore
          window.__pendingOrderSig = cartSignature;
          // @ts-ignore
          window.__pendingOrderObj = savedOrder;
        }

        // 2. Registrar inmediatamente el pago en la Caja Activa (POST /api/caja/pay/{pedido_id})
        const payRes = await fetch(`/api/caja/pay/${savedOrder.id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            payments: paymentsPayload,
            creado_por: meta.staffCreator,
            cantidad_domicilios: meta.cantDomClinica,
            impreso_cocina: false, // La SAT Q22 imprime ÚNICAMENTE la Comanda de Cocina
            impreso_caja: true,    // NO imprime tirilla de cuenta/cliente al cobrar en POS
            imprimir_recibo: false
          })
        });

        const payData = await payRes.json().catch(() => ({}));
        if (!payRes.ok) {
          const payErrMsg = payData.detail || payData.error || `Error HTTP ${payRes.status} al registrar el pago en Caja.`;
          throw new Error(typeof payErrMsg === 'string' ? payErrMsg : JSON.stringify(payErrMsg));
        }

        // Limpiar referencia temporal tras cobro exitoso
        // @ts-ignore
        window.__pendingOrderSig = null;
        // @ts-ignore
        window.__pendingOrderObj = null;
        setEditingOpenOrder(null);

        // Sincronizar también en almacenamiento local para autocompletado de clientes por teléfono
        fetch('/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderData: {
              orderType: currentOrderType,
              tableNumber: mesaStr,
              customerPhone: custPhone,
              customerName: custName,
              deliveryAddress: custAddress,
              deliveryNeighborhood: custNeighborhood,
              subtotal,
              packagingFee,
              deliveryFee,
              total,
              paymentMethod: cobroPaymentMode === 'single' ? selectedSingleMethod.toLowerCase() : 'mixto',
              paymentChangeFor: cashGiven,
              status: 'completado'
            },
            items: cart
          })
        }).catch(() => {});

        // 3. Guardar referencia de último pedido (la comanda de cocina se imprime en el PC de Caja vía impreso_cocina = False)
        const ticket = {
          id: savedOrder.codigo_pedido || savedOrder.id,
          pedidoId: savedOrder.id,
          createdAt: new Date().toISOString(),
          orderType: currentOrderType,
          table: mesaStr,
          customerName: custName,
          customerPhone: custPhone,
          address: custAddress,
          neighborhood: custNeighborhood,
          items: cart.map(({ name, price, quantity, notes, packaging, isHospitalDiet, hospitalLocation }) => ({
            name,
            price,
            quantity,
            notes: notes || '',
            packaging: packaging || globalPackagingType,
            isHospitalDiet: !!isHospitalDiet,
            hospitalLocation: hospitalLocation || null,
            ubicacion: hospitalLocation || null
          })),
          subtotal,
          packagingFee,
          packagingType: globalPackagingType,
          packagingQty,
          deliveryFee,
          total,
          paymentMethod: cobroPaymentMode === 'single' ? selectedSingleMethod : 'MIXTO',
          cashPaid: cashGiven
        };

        saveLastTicket(ticket);
        closeCobroModal();
        setEditingOpenOrder(null);
        cart = [];
        manualPackagingOverride = false;
        packagingQty = 0;
        // @ts-ignore
        if (clinicaDomiciliosCountInput) clinicaDomiciliosCountInput.value = '0';
        if (clinicaDomiciliosBadge) clinicaDomiciliosBadge.textContent = '0 envíos';
        // @ts-ignore
        cashReceivedInput.value = '';
        renderCart();

        // Liberación inmediata de mesa en el POS para cualquier medio de pago
        if (mesaStr) {
          const key = normalizeMesaKey(mesaStr);
          if (key && activeOccupiedTableOrders[key]) {
            delete activeOccupiedTableOrders[key];
          }
        }
        updateMesaOccupiedIndicator();
        await checkOccupiedTables();

        // Notificación Toast de confirmación en pantalla
        const orderCode = (savedOrder && (savedOrder.codigo_pedido || savedOrder.id)) || 'NUEVO';
        if (currentOrderType === 'mesa') {
          showPosToast(`✅ Mesa liberada, cobro registrado y comanda enviada a Cocina (#${orderCode})`);
        } else {
          showPosToast(`✅ Pedido cobrado y comanda enviada a Cocina (#${orderCode})`);
        }
      } catch (err) {
        alert('Ocurrió un error al cobrar: ' + err.message);
      } finally {
        btnConfirmPayment.disabled = false;
        btnConfirmPayment.innerHTML = '<i data-lucide="check-circle-2" class="w-4 h-4"></i><span>Cobrar y Enviar a Cocina / SAT Q22</span>';
        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      }
    });

    // 9. SOLO COMANDA COCINA (Guarda pedido real en Neon o encola reimpresión remota en la SAT Q22 del PC)
    const btnKitchenCart = document.getElementById('btn-print-kitchen-cart');
    btnKitchenCart?.addEventListener('click', async () => {
      if (cart.length === 0) {
        alert('Por favor agrega al menos un plato a la comanda para enviar a cocina.');
        return;
      }

      // @ts-ignore
      btnKitchenCart.disabled = true;
      const origHtml = btnKitchenCart.innerHTML;
      btnKitchenCart.innerHTML = '<span>⏳ Enviando a SAT Q22...</span>';

      try {
        const { payload, meta } = buildFastapiPedidoPayload('EN_PREPARACION');
        const { tipoBackend, mesaStr, custPhone, total, detallesPayload } = meta;
        const cartSignature = JSON.stringify({ tipoBackend, mesaStr, custPhone, total, detallesPayload });

        // @ts-ignore
        let savedOrder = (window.__pendingOrderSig === cartSignature && window.__pendingOrderObj?.id)
          // @ts-ignore
          ? window.__pendingOrderObj
          : null;

        if (savedOrder && savedOrder.id) {
          const repRes = await fetch(`/api/impresion/reimprimir/${encodeURIComponent(savedOrder.id)}?tipo=COCINA`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ tipo: 'COCINA' })
          });
          if (!repRes.ok) {
            throw new Error(`HTTP ${repRes.status} al reenviar comanda a cocina`);
          }
        } else if (editingOpenOrder && editingOpenOrder.id) {
          const putRes = await fetch(`/api/pedidos/${editingOpenOrder.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (putRes.ok) {
            savedOrder = await putRes.json();
          } else {
            savedOrder = editingOpenOrder;
          }
          await fetch(`/api/impresion/reimprimir/${encodeURIComponent(savedOrder.id)}?tipo=COCINA`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ tipo: 'COCINA' })
          });
        } else {
          const pedRes = await fetch('/api/pedidos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const pedData = await pedRes.json().catch(() => ({}));
          if (!pedRes.ok || !pedData.id) {
            const errMsg = pedData.detail || pedData.error || `Error HTTP ${pedRes.status} al enviar comanda a cocina.`;
            throw new Error(typeof errMsg === 'string' ? errMsg : JSON.stringify(errMsg));
          }
          savedOrder = pedData;
          // @ts-ignore
          window.__pendingOrderSig = cartSignature;
          // @ts-ignore
          window.__pendingOrderObj = savedOrder;
        }

        const ticket = {
          id: savedOrder.codigo_pedido || savedOrder.id,
          pedidoId: savedOrder.id,
          createdAt: savedOrder.fecha_hora || new Date().toISOString(),
          orderType: currentOrderType,
          table: meta.mesaStr,
          customerName: meta.custName,
          customerPhone: meta.custPhone,
          address: meta.custAddress,
          neighborhood: meta.custNeighborhood,
          items: cart.map(({ name, price, quantity, notes, packaging, isHospitalDiet, hospitalLocation }) => ({
            name,
            price,
            quantity,
            notes: notes || '',
            packaging: packaging || globalPackagingType,
            isHospitalDiet: !!isHospitalDiet,
            hospitalLocation: hospitalLocation || null,
            ubicacion: hospitalLocation || null
          })),
          subtotal: meta.subtotal,
          packagingFee: meta.packagingFee,
          packagingType: globalPackagingType,
          packagingQty,
          deliveryFee: meta.deliveryFee,
          total: meta.total,
          paymentMethod: 'PENDIENTE POR COBRAR',
          cashPaid: 0
        };

        saveLastTicket(ticket);
        checkOccupiedTables();
        showPosToast('✅ Enviado a impresora SAT Q22 en Caja');
      } catch (err) {
        alert('Error al enviar comanda a cocina: ' + (err.message || err));
      } finally {
        // @ts-ignore
        btnKitchenCart.disabled = false;
        btnKitchenCart.innerHTML = origHtml;
        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      }
    });

    // 10. MODAL RÁPIDO DE GASTO DE CAJA MENOR DESDE POS
    const modalExpensePos = document.getElementById('modal-add-expense-pos');
    const openExpensePosModal = () => {
      // @ts-ignore
      document.getElementById('expense-pos-amount').value = '';
      // @ts-ignore
      document.getElementById('expense-pos-description').value = '';
      // @ts-ignore
      document.getElementById('expense-pos-category').value = 'OTROS';
      modalExpensePos?.classList.remove('hidden');
      modalExpensePos?.classList.add('flex');
      // @ts-ignore
      document.getElementById('expense-pos-amount')?.focus();
    };

    const closeExpensePosModal = () => {
      modalExpensePos?.classList.add('hidden');
      modalExpensePos?.classList.remove('flex');
    };

    document.getElementById('btn-quick-expense-pos')?.addEventListener('click', openExpensePosModal);
    document.getElementById('btn-expense-pos-close')?.addEventListener('click', closeExpensePosModal);
    document.getElementById('btn-expense-pos-cancel')?.addEventListener('click', closeExpensePosModal);

    document.getElementById('form-add-expense-pos')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      // @ts-ignore
      const amount = Number(document.getElementById('expense-pos-amount').value || 0);
      // @ts-ignore
      const description = document.getElementById('expense-pos-description').value.trim();
      // @ts-ignore
      const category = document.getElementById('expense-pos-category').value;

      if (!amount || amount <= 0) {
        alert('Ingresa un monto en efectivo válido mayor a 0');
        return;
      }
      if (!description) {
        alert('Ingresa una descripción del gasto (ej. verduras, agua)');
        return;
      }

      const btn = document.getElementById('btn-submit-expense-pos');
      btn.disabled = true;
      btn.innerHTML = 'Guardando...';

      try {
        const res = await fetch('/api/caja/expenses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, description, category })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || data.error || 'Error al registrar gasto');

        alert(`✅ Gasto de ${fmt(amount)} registrado exitosamente en la caja activa.`);
        closeExpensePosModal();
      } catch (err) {
        alert('Error al registrar gasto: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Registrar Salida</span>';
        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      }
    });

    // 11. CHECK FOR PENDING WHATSAPP DRAFTS
    async function checkPendingDrafts() {
      try {
        const res = await fetch('/api/pedidos/?estado=BORRADOR_WEB&limit=20');
        if (res.ok) {
          const drafts = await res.json();
          const count = (drafts && Array.isArray(drafts)) ? drafts.length : 0;
          const alertEl = document.getElementById('pos-drafts-alert');
          const countEl = document.getElementById('pos-drafts-count');
          if (alertEl && countEl) {
            if (count > 0) {
              countEl.textContent = count;
              alertEl.classList.remove('hidden');
              alertEl.classList.add('flex');
            } else {
              alertEl.classList.add('hidden');
              alertEl.classList.remove('flex');
            }
          }
        }
      } catch (e) {}
    }
    checkPendingDrafts();
    setInterval(checkPendingDrafts, 15000);

    // ==============================================================
    //  LOS 3 FORMATOS DE IMPRESIÓN TÉRMICA 80MM (POS-80C / SAT Q22)
    //  1. Comanda de Cocina (printKitchenTicket)
    //  2. Ticket Mensajero (printCourierTicket)
    //  3. Cuenta Cliente (printCustomerReceipt)
    // ==============================================================
    const LAST_TICKET_KEY = 'sp_last_ticket';

    function saveLastTicket(ticket) {
      try {
        localStorage.setItem(LAST_TICKET_KEY, JSON.stringify(ticket));
      } catch (e) {}
      refreshReprintButton();
    }

    function loadLastTicket() {
      try {
        return JSON.parse(localStorage.getItem(LAST_TICKET_KEY) || 'null');
      } catch (e) {
        return null;
      }
    }

    function refreshReprintButton() {
      const last = loadLastTicket();
      const reprintBar = document.getElementById('reprint-bar');
      const reprintLabel = document.getElementById('reprint-order-label');
      const btnCourier = document.getElementById('btn-reprint-courier');
      if (!reprintBar || !last) return;

      const codeStr = (last.id && (last.id.toString().startsWith('#') || last.id.toString().startsWith('SP-'))) ? last.id : '#' + (last.id || '001');
      if (reprintLabel) reprintLabel.textContent = `Último Pedido (${codeStr})`;

      // Mostrar botón de mensajero solo si fue domicilio
      if (btnCourier) {
        btnCourier.style.display = last.orderType === 'domicilio' ? 'flex' : 'none';
      }

      reprintBar.classList.remove('hidden');
    }

    // 1. FORMATO: COMANDA DE COCINA (SIN PRECIOS, LETRA GRANDE, NOTAS RESALTADAS)
    function renderKitchenTicketHTML(t) {
      const timeStr = new Date(t.createdAt || Date.now()).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
      const dateStr = new Date(t.createdAt || Date.now()).toLocaleDateString('es-CO');
      const codeStr = (t.id && (t.id.toString().startsWith('#') || t.id.toString().startsWith('SP-'))) ? t.id : '#' + (t.id || '001');

      const isClinica = (t.customerName && /cl[íi]nica/i.test(t.customerName)) ||
                        (t.items || []).some(it => it.isHospitalDiet || /TORRE A|TORRE B|URGENCIAS/i.test(it.notes || '') || /dieta/i.test(it.name || ''));

      if (isClinica) {
        const ubicMap = {};
        let totalRaciones = 0;
        let totalAguaItems = 0;
        let totalDietasHipo = 0;

        (t.items || []).forEach(it => {
          const cant = Number(it.quantity || 1);
          const rawName = String(it.name || '');
          const isAgua = /botella con agua|agua\s*\(dieta hipo/i.test(rawName);

          if (isAgua) {
            totalAguaItems += cant;
            return;
          }

          totalRaciones += cant;
          const isHipo = /hipos[oó]dic|hipogl[uú]cid/i.test(rawName);
          if (isHipo) totalDietasHipo += cant;

          let loc = it.hospitalLocation || 'Torre A';
          if (/TORRE B/i.test(it.notes || '')) loc = 'Torre B';
          else if (/URGENCIAS/i.test(it.notes || '')) loc = 'Urgencias';
          else if (/TORRE A/i.test(it.notes || '')) loc = 'Torre A';
          const locUpper = loc.toUpperCase();

          if (!ubicMap[locUpper]) ubicMap[locUpper] = {};

          let dietType = rawName.includes('Dieta')
            ? rawName.split(/Dieta/i)[1].trim().toUpperCase()
            : rawName.replace(/^(Desayuno|Almuerzo|Cena)\s+Cl[íi]nica\s*-\s*/i, '').trim().toUpperCase();
          if (!dietType) dietType = 'NORMAL';

          if (!ubicMap[locUpper][dietType]) {
            ubicMap[locUpper][dietType] = { cantidad: 0, notes: [] };
          }
          ubicMap[locUpper][dietType].cantidad += cant;
          if (it.notes) {
            const cleanNote = it.notes.replace(/\[.*?(TORRE A|TORRE B|URGENCIAS).*?\]/gi, '').trim();
            if (cleanNote && !ubicMap[locUpper][dietType].notes.includes(cleanNote)) {
              ubicMap[locUpper][dietType].notes.push(cleanNote);
            }
          }
        });

        const totalAguaFinal = Math.max(totalAguaItems, totalDietasHipo);
        const totalDom = t.cantidad_domicilios || (t.deliveryFee ? Math.max(1, Math.round(t.deliveryFee / 3000)) : 1);

        const ordenPabellones = ['TORRE A', 'TORRE B', 'URGENCIAS'];
        const pabellones = [...ordenPabellones.filter(p => ubicMap[p]), ...Object.keys(ubicMap).filter(p => !ordenPabellones.includes(p))];

        const groupedHtml = pabellones.map(pab => {
          const diets = ubicMap[pab];
          const linesHtml = Object.entries(diets).map(([dName, dData]) => `
            <div style="display: flex; align-items: baseline; gap: 2.5mm; margin: 1.5mm 0;">
              <span style="font-size: 16pt; font-weight: 900; min-width: 48px; border: 1.5px solid #000; text-align: center; padding: 1mm 0;">
                ${dData.cantidad}X
              </span>
              <span style="font-size: 13pt; font-weight: 900; text-transform: uppercase;">${dName}</span>
            </div>
            ${dData.notes.map(n => `<div style="font-size: 9.5pt; font-weight: bold; margin-left: 14mm; color: #333;">* ${n}</div>`).join('')}
          `).join('');

          return `
            <div style="margin-bottom: 3.5mm; border: 2px solid #000; border-radius: 4px; padding: 2.5mm;">
              <div style="font-size: 13pt; font-weight: 900; background: #000; color: #fff; padding: 1.5mm 2.5mm; text-align: center; margin-bottom: 2mm; letter-spacing: 0.5px;">
                🏢 UBICACIÓN: ${pab}
              </div>
              ${linesHtml}
            </div>
          `;
        }).join('');

        let packagingBanner = '';
        if (t.orderType !== 'mesa' || (t.packagingFee && t.packagingFee > 0)) {
          packagingBanner = `
            <div style="border: 2px solid #000; padding: 1.5mm 3mm; margin: 1.5mm 0; text-align: center; background: #fff;">
              <div style="font-size: 13pt; font-weight: 900; letter-spacing: 0.5px;">
                📦 EMPACAR EN: ${(t.packagingType || 'CAJA').toUpperCase()} (${t.packagingQty || totalRaciones} EMPAQUES)
              </div>
            </div>
          `;
        }

        return `
          <div class="ticket-header" style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 2mm; margin-bottom: 2.5mm;">
            <div style="display: inline-block; border: 2.5px solid #000; padding: 1.5mm 4mm; font-size: 13pt; font-weight: 900; letter-spacing: 0.5px; margin-bottom: 1.5mm;">
              🍳 COMANDA COCINA · CONVENIO CLÍNICA
            </div>
            <div style="font-size: 13pt; font-weight: 900; margin: 1mm 0;">
              CLÍNICA PRIMERO DE MAYO (PACIENTES)
            </div>
            ${packagingBanner}
            <div style="font-size: 9.5pt; font-family: monospace; margin-top: 1mm;">
              <span>Orden: <strong>${codeStr}</strong></span> | <span>Hora: <strong>${timeStr}</strong></span>
            </div>
          </div>

          <div style="margin: 2mm 0;">
            ${groupedHtml}
          </div>

          <!-- CONSOLIDADO GENERAL AL PIE -->
          <div style="border-top: 2.5px dashed #000; padding-top: 2mm; margin-top: 3mm; background: #fdfdfd;">
            <div style="font-size: 11pt; font-weight: 900; text-align: center; margin-bottom: 2mm; text-decoration: underline;">
              CONSOLIDADO GENERAL DEL SERVICIO
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 12pt; font-weight: 900; margin-bottom: 1mm;">
              <span>TOTAL RACIONES ENTREGADAS:</span>
              <span style="font-size: 14pt;">${totalRaciones}</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 10.5pt; font-weight: bold; margin-bottom: 1mm;">
              <span>TOTAL BOTELLAS AGUA AUTO:</span>
              <span>${totalAguaFinal} ($0)</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 10.5pt; font-weight: bold;">
              <span>CANTIDAD DOMICILIOS / CARRERAS:</span>
              <span>${totalDom}</span>
            </div>
          </div>

          <div class="ticket-footer" style="text-align: center; border-top: 1.5px dashed #000; padding-top: 1.5mm; margin-top: 3mm; font-size: 9pt; font-weight: bold;">
            *** PREPARAR Y ENTREGAR CON REVISIÓN DE DIETAS ***
          </div>
        `;
      }

      let ubicacionStr = 'MESA 1';
      if (t.orderType === 'mesa') {
        ubicacionStr = `UBICACIÓN: ${t.table || 'MESA'}`.toUpperCase();
      } else if (t.orderType === 'domicilio') {
        ubicacionStr = `🛵 DOMICILIO ${t.customerName ? '- ' + t.customerName : ''}`.toUpperCase();
      } else {
        ubicacionStr = '📦 PARA LLEVAR'.toUpperCase();
      }

      const itemsHtml = (t.items || []).map(it => {
        let notesHtml = '';
        const isHospital = it.isHospitalDiet || (it.notes && (it.notes.includes('TORRE A') || it.notes.includes('TORRE B') || it.notes.includes('URGENCIAS')));
        const hospTag = isHospital
          ? (it.hospitalLocation ? getHospitalDietTag(it.name, it.hospitalLocation) : (it.notes?.match(/\[.*?(TORRE A|TORRE B|URGENCIAS).*?\]/i)?.[0] || ''))
          : '';

        if (it.notes) {
          const parts = it.notes.split('|').map(s => s.trim()).filter(Boolean);
          notesHtml = parts.map(p => `
            <div style="font-size: 10pt; font-weight: bold; margin-top: 1mm; padding-left: 2mm;">
              └ ${p}
            </div>
          `).join('');
        }

        return `
          <div style="border-bottom: 1.5px dashed #000; padding: 2.5mm 0; break-inside: avoid;">
            <div style="display: flex; align-items: flex-start; gap: 2.5mm;">
              <span style="font-size: 17pt; font-weight: 900; line-height: 1; min-width: 48px; border: 1.5px solid #000; text-align: center; padding: 1mm 0;">
                ${it.quantity}X
              </span>
              <div style="flex: 1;">
                <div style="font-size: 13pt; font-weight: 900; text-transform: uppercase; line-height: 1.2;">
                  ${it.name}
                </div>
                ${hospTag ? `
                  <div style="font-size: 11pt; font-weight: 900; background: #000; color: #fff; padding: 1mm 2.5mm; margin-top: 1.5mm; display: inline-block; letter-spacing: 0.5px; border-radius: 2px;">
                    🏥 ${hospTag}
                  </div>
                ` : ''}
                ${notesHtml}
              </div>
            </div>
          </div>
        `;
      }).join('');

      let packagingBanner = '';
      if (t.orderType !== 'mesa' || (t.packagingFee && t.packagingFee > 0)) {
        packagingBanner = `
          <div style="border: 2px solid #000; padding: 1.5mm 3mm; margin: 1.5mm 0; text-align: center; background: #fff;">
            <div style="font-size: 13pt; font-weight: 900; letter-spacing: 0.5px;">
              📦 EMPACAR EN: ${(t.packagingType || 'ICOPOR').toUpperCase()} (${t.packagingQty || (t.items ? t.items.length : 1)} EMPAQUES)
            </div>
          </div>
        `;
      }

      return `
        <div class="ticket-header" style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 2mm; margin-bottom: 2.5mm;">
          <div style="display: inline-block; border: 2.5px solid #000; padding: 1.5mm 4mm; font-size: 14pt; font-weight: 900; letter-spacing: 0.5px; margin-bottom: 1.5mm;">
            🍳 COMANDA DE COCINA
          </div>
          <div style="font-size: 14pt; font-weight: 900; margin: 1mm 0; text-transform: uppercase;">
            ${ubicacionStr}
          </div>
          ${packagingBanner}
          <div style="font-size: 9.5pt; font-family: monospace; margin-top: 1mm;">
            <span>Orden: <strong>${codeStr}</strong></span> | <span>Hora: <strong>${timeStr}</strong></span>
          </div>
        </div>

        <div style="margin: 2mm 0;">
          ${itemsHtml}
        </div>

        <div class="ticket-footer" style="text-align: center; border-top: 2px dashed #000; padding-top: 2mm; margin-top: 4mm; font-size: 9pt; font-weight: bold;">
          *** PREPARAR CON AGILIDAD Y SAZÓN ***
        </div>
      `;
    }

    // 2. FORMATO: TICKET MENSAJERO / DOMICILIO (TELÉFONO GIGANTE, DIRECCIÓN, COBRO/NO COBRAR)
    function renderCourierTicketHTML(t) {
