  <!-- ==============================================================
       CLIENT-SIDE JAVASCRIPT FOR POS OPERATION & INSTANT PRINT
       ============================================================== -->
  <script>
    // State
    let cart = [];
    let currentOrderType = 'mesa';
    let currentPaymentMethod = 'efectivo';

    // Format COP Currency
    const fmt = (val) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
    const escapeHtml = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Elements
    const catalogRoot = document.getElementById('pos-catalog-root');
    const catalogData = JSON.parse(catalogRoot?.dataset.catalog || '[]');
    const dailySpecialsData = JSON.parse(catalogRoot?.dataset.specials || '{"sopa":"Campesina","principios":[],"acompanamientos":[]}');

    const searchInput = document.getElementById('product-search');
    const btnClearSearch = document.getElementById('btn-clear-search');
    const btnBackFullMenu = document.getElementById('btn-back-full-menu');
    const searchResultsPanel = document.getElementById('pos-search-results-panel');
    const searchResultsGrid = document.getElementById('pos-search-results-grid');
    const searchResultsTitle = document.getElementById('search-results-title');
    const quickMenuWrapper = document.getElementById('pos-quick-menu-wrapper');
    const catButtons = document.querySelectorAll('.pos-cat-btn');

    // Cart Elements
    const cartContainer = document.getElementById('cart-items-container');
    const emptyMsg = document.getElementById('cart-empty-msg');
    const subtotalEl = document.getElementById('pos-subtotal');
    const deliveryRow = document.getElementById('delivery-row');
    const deliveryEl = document.getElementById('pos-delivery');
    const totalEl = document.getElementById('pos-total');
    const cashReceivedInput = document.getElementById('cash-received');
    const cashChangeDisplay = document.getElementById('cash-change-display');
    const clearCartBtn = document.getElementById('btn-clear-cart');
    const quickTestBtn = document.getElementById('btn-quick-test-print');
    const checkoutPrintBtn = document.getElementById('btn-checkout-print');

    // Order Type Elements
    const typeMesaBtn = document.getElementById('type-mesa');
    const typeDomicilioBtn = document.getElementById('type-domicilio');
    const typeLlevarBtn = document.getElementById('type-llevar');
    const formMesa = document.getElementById('form-mesa');
    const formDomicilio = document.getElementById('form-domicilio');
    const tableInput = document.getElementById('table-input');
    const custPhoneInput = document.getElementById('cust-phone');
    const custNameInput = document.getElementById('cust-name');
    const custAddressInput = document.getElementById('cust-address');
    const custNeighborhoodInput = document.getElementById('cust-neighborhood');
    const deliveryFeeInput = document.getElementById('delivery-fee-input');
    const custStatus = document.getElementById('cust-status');

    // Payment Buttons
    const payButtons = document.querySelectorAll('.pay-btn');
    const cashChangeBox = document.getElementById('cash-change-box');

    // Normalize helper for accent-insensitive search
    const normalizeStr = (str) =>
      String(str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();

    // 1. UNIVERSAL SEARCH ENGINE & QUICK FILTERS
    function runUniversalSearch(rawQuery) {
      const q = normalizeStr(rawQuery);

      if (!q) {
        btnClearSearch?.classList.add('hidden');
        searchResultsPanel?.classList.add('hidden');
        quickMenuWrapper?.classList.remove('hidden');
        return;
      }

      btnClearSearch?.classList.remove('hidden');
      quickMenuWrapper?.classList.add('hidden');
      searchResultsPanel?.classList.remove('hidden');

      // Match by name, price, category, or family aliases
      const matches = catalogData.filter((item) => {
        const nameNorm = normalizeStr(item.name);
        const descNorm = normalizeStr(item.description);
        const catNorm = normalizeStr(item.category_id);
        const priceStr = String(item.price);

        if (q === 'mojarra') {
          return (
            nameNorm.includes('mojarra') ||
            nameNorm.includes('bagre') ||
            nameNorm.includes('robalo') ||
            nameNorm.includes('cazuela') ||
            nameNorm.includes('marisco') ||
            nameNorm.includes('camaron')
          );
        }
        if (q === 'cerdo') {
          return (
            nameNorm.includes('cerdo') ||
            nameNorm.includes('chuleta') ||
            nameNorm.includes('pernil') ||
            nameNorm.includes('costilla') ||
            nameNorm.includes('lomo')
          );
        }
        if (q === 'carne') {
          return (
            nameNorm.includes('carne') ||
            nameNorm.includes('bistec') ||
            nameNorm.includes('churrasco') ||
            nameNorm.includes('sobrebarriga') ||
            nameNorm.includes('higado') ||
            nameNorm.includes('bandeja') ||
            nameNorm.includes('parrilla') ||
            nameNorm.includes('llanera')
          );
        }
        if (q === 'bebidas') {
          return catNorm === 'bebidas';
        }
        if (q === 'picada') {
          return catNorm === 'picadas' || nameNorm.includes('picada');
        }

        return (
          nameNorm.includes(q) ||
          priceStr.includes(q) ||
          descNorm.includes(q) ||
          catNorm.includes(q)
        );
      });

      if (searchResultsTitle) {
        searchResultsTitle.textContent = `${matches.length} variante${matches.length === 1 ? '' : 's'} para "${rawQuery.trim()}"`;
      }

      if (!searchResultsGrid) return;

      if (matches.length === 0) {
        searchResultsGrid.innerHTML = `
          <div class="col-span-2 py-8 text-center text-parrilla-muted text-sm">
            No encontramos platos que coincidan con "<strong>${rawQuery}</strong>". Intenta con otra palabra o precio.
          </div>
        `;
        return;
      }

      searchResultsGrid.innerHTML = matches
        .map(
          (item) => `
          <div class="flex items-center justify-between gap-2.5 p-3 rounded-xl border border-parrilla-border hover:border-parrilla-gold bg-slate-50/70 hover:bg-orange-50/30 transition shadow-2xs">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-display font-bold text-sm text-parrilla-ivory leading-tight">
                  ${item.name}
                </span>
                ${
                  item.special_badge
                    ? `<span class="bg-parrilla-gold text-white text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded">${item.special_badge}</span>`
                    : ''
                }
              </div>
              <div class="flex items-center gap-2 mt-1">
                <span class="font-display font-black text-sm text-parrilla-gold">${fmt(item.price)}</span>
                <span class="text-[10px] text-parrilla-muted">• ${item.customizable ? '🥣 Elige sopa y principio' : '⚡ Agregado directo'}</span>
              </div>
            </div>

            <button
              type="button"
              data-id="${item.id}"
              data-name="${item.name}"
              data-price="${item.price}"
              data-customizable="${String(item.customizable)}"
              aria-label="Agregar ${item.name}"
              class="btn-add-cart flex-shrink-0 w-9 h-9 rounded-full bg-parrilla-gold hover:bg-parrilla-goldLight text-white flex items-center justify-center shadow-sm transition active:scale-90 cursor-pointer font-black text-base"
            >
              +
            </button>
          </div>
        `
        )
        .join('');
    }

    searchInput?.addEventListener('input', (e) => {
      // @ts-ignore
      const val = e.target.value;
      // Reset active pill styling if typing manually
      catButtons.forEach((b) => {
        const isAll = b.getAttribute('data-filter-query') === '' && !val.trim();
        b.classList.toggle('bg-parrilla-gold', isAll);
        b.classList.toggle('text-white', isAll);
        b.classList.toggle('bg-slate-100', !isAll);
        b.classList.toggle('text-parrilla-ivory', !isAll);
      });
      runUniversalSearch(val);
    });

    const resetUniversalSearch = () => {
      if (searchInput) {
        // @ts-ignore
        searchInput.value = '';
      }
      catButtons.forEach((b) => {
        const isAll = b.getAttribute('data-filter-query') === '';
        b.classList.toggle('bg-parrilla-gold', isAll);
        b.classList.toggle('text-white', isAll);
        b.classList.toggle('bg-slate-100', !isAll);
        b.classList.toggle('text-parrilla-ivory', !isAll);
      });
      runUniversalSearch('');
    };

    btnClearSearch?.addEventListener('click', () => {
      resetUniversalSearch();
      searchInput?.focus();
    });

    btnBackFullMenu?.addEventListener('click', resetUniversalSearch);

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => {
          b.classList.remove('bg-parrilla-gold', 'text-white', 'shadow-xs', 'active');
          b.classList.add('bg-slate-100', 'text-parrilla-ivory');
        });
        btn.classList.add('bg-parrilla-gold', 'text-white', 'shadow-xs', 'active');
        btn.classList.remove('bg-slate-100', 'text-parrilla-ivory');

        const filterQuery = btn.getAttribute('data-filter-query') || '';
        if (searchInput) {
          // @ts-ignore
          searchInput.value = filterQuery;
        }
        runUniversalSearch(filterQuery);
      });
    });

    // Keyboard shortcuts: '/' or 'F2' to focus search, 'Escape' to clear/close modals
    document.addEventListener('keydown', (e) => {
      const tag = (e.target && e.target.tagName) ? e.target.tagName.toUpperCase() : '';
      const isTyping = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';

      if ((e.key === '/' || e.key === 'F2') && !isTyping) {
        e.preventDefault();
        searchInput?.focus();
        // @ts-ignore
        searchInput?.select();
      } else if (e.key === 'Escape') {
        const garnishModal = document.getElementById('modal-garnish-pos');
        if (garnishModal && !garnishModal.classList.contains('hidden')) {
          closeGarnishModal();
          return;
        }
        // @ts-ignore
        if (searchInput && searchInput.value) {
          resetUniversalSearch();
        }
      }
    });

    // 2. MODAL RÁPIDO DE GUARNICIONES (SOPA, PRINCIPIO, ACOMPAÑAMIENTO, EMPAQUE, NOTAS)
    const modalGarnish = document.getElementById('modal-garnish-pos');
    const garnishDishName = document.getElementById('garnish-dish-name');
    const garnishDishPrice = document.getElementById('garnish-dish-price');
    const garnishQtyVal = document.getElementById('garnish-qty-val');
    const garnishSoupContainer = document.getElementById('garnish-soup-options');
    const garnishPrincipleContainer = document.getElementById('garnish-principle-options');
    const garnishSideContainer = document.getElementById('garnish-side-options');
    const garnishSaladContainer = document.getElementById('garnish-salad-options');
    const garnishPackagingContainer = document.getElementById('garnish-packaging-options');
    const garnishExtraNotes = document.getElementById('garnish-extra-notes');

    // Estado global de Empaques y Edición de Plato
    let globalPackagingType = 'Caja'; // 'Caja' | 'Icopor'
    let packagingFeePerUnit = 1000;
    let packagingQty = 0;
    let manualPackagingOverride = false;
    let editingCartUid = null;
    let pendingGarnishItem = null;

    let garnishState = {
      quantity: 1,
      soup: '',
      principle: '',
      side: '',
      salad: 'Con ensalada',
      packaging: 'Caja'
    };

    function renderOptionPills(container, options, currentVal, onSelect) {
      if (!container) return;
      container.innerHTML = options
        .map((opt) => {
          const active = opt === currentVal;
          return `
            <button
              type="button"
              data-opt="${opt}"
              class="garnish-opt-btn py-2 px-3 rounded-xl border text-xs font-bold text-left transition flex items-center justify-between gap-1.5 cursor-pointer ${
                active
                  ? 'border-parrilla-gold bg-parrilla-gold text-white shadow-xs'
                  : 'border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory'
              }"
            >
              <span class="truncate">${opt}</span>
              ${active ? '<span>✓</span>' : ''}
            </button>
          `;
        })
        .join('');

      container.querySelectorAll('.garnish-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-opt') || '';
          onSelect(val);
          renderOptionPills(container, options, val, onSelect);
        });
      });
    }

    // Cuenta cuántos platos de comida hay en la comanda (excluye bebidas/líquidos)
    function countFoodPlates() {
      return cart.reduce((acc, it) => {
        const isDrink = it.category_id === 'bebidas' ||
          /gaseosa|jugo|agua|cerveza|hit|coca|postobon|speed|red bull|pilsen|aguila|club colombia/i.test(it.name);
        return isDrink ? acc : acc + it.quantity;
      }, 0);
    }

    // Calcula Subtotal, Empaques, Domicilio y Total de forma centralizada
    function calculateTotals() {
      const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
      const isDeliveryOrTakeout = currentOrderType === 'domicilio' || currentOrderType === 'para_llevar';

      if (isDeliveryOrTakeout && !manualPackagingOverride) {
        packagingQty = countFoodPlates();
      } else if (!isDeliveryOrTakeout) {
        packagingQty = 0;
      }

      const packagingFee = isDeliveryOrTakeout ? (packagingQty * packagingFeePerUnit) : 0;
      // @ts-ignore
      const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput?.value || 0) : 0;
      const total = subtotal + packagingFee + deliveryFee;

      return { subtotal, packagingFee, deliveryFee, total, isDeliveryOrTakeout };
    }

    // Arma el string de notas y guarniciones de un plato
    function buildPlateNotes(item) {
      if (!item.isCustomizable) return item.notes || '';
      const parts = [
        item.soup || `Sopa ${dailySpecialsData.sopa || 'del Día'}`,
        `Principio: ${item.principle || (dailySpecialsData.principios?.[0] || 'Sin Principio')}`,
        `Acomp: ${item.side || (dailySpecialsData.acompanamientos?.[0] || 'Sin Acompañamiento')}`,
        item.salad || 'Con ensalada'
      ];
      if (currentOrderType !== 'mesa') {
        parts.push(`Empaque: ${item.packaging || globalPackagingType}`);
      }
      if (item.extraNotes && item.extraNotes.trim()) {
        parts.push(`Nota: ${item.extraNotes.trim()}`);
      }
      return parts.join(' | ');
    }

    // Sincroniza las notas de empaque de todos los platos
    function updateAllItemsPackagingNotes() {
      cart.forEach((it) => {
        if (it.isCustomizable) {
          it.notes = buildPlateNotes(it);
        }
      });
    }

    // Abre el modal para editar o personalizar un ítem específico del carrito
    function openGarnishModalForCartItem(cartItem) {
      if (!cartItem) return;
      editingCartUid = cartItem.uid;
      pendingGarnishItem = cartItem;

      const soupOptions = [`Sopa ${dailySpecialsData.sopa || 'del Día'}`, 'Sin Sopa', 'Solo Bandeja'];
      const principleOptions = [...(dailySpecialsData.principios || []), 'Sin Principio'];
      const sideOptions = [...(dailySpecialsData.acompanamientos || []), 'Sin Acompañamiento'];
      const saladOptions = ['Con ensalada', 'Sin ensalada'];
      const packagingOptions = ['Caja', 'Icopor'];

      garnishState = {
        quantity: 1,
        soup: cartItem.soup || soupOptions[0],
        principle: cartItem.principle || principleOptions[0] || 'Sin Principio',
        side: cartItem.side || sideOptions[0] || 'Sin Acompañamiento',
        salad: cartItem.salad || 'Con ensalada',
        packaging: cartItem.packaging || globalPackagingType || 'Caja'
      };

      if (garnishDishName) garnishDishName.textContent = cartItem.name;
      if (garnishDishPrice) garnishDishPrice.textContent = fmt(cartItem.price);

      // Ocultar selector de cantidad durante la personalización 1-a-1
      const qtyWrapper = document.getElementById('garnish-qty-wrapper');
      if (qtyWrapper) qtyWrapper.style.display = 'none';

      if (garnishExtraNotes) {
        // @ts-ignore
        garnishExtraNotes.value = cartItem.extraNotes || '';
      }

      const btnLabel = document.getElementById('btn-garnish-confirm-label');
      if (btnLabel) btnLabel.textContent = 'Guardar Cambios';

      renderOptionPills(garnishSoupContainer, soupOptions, garnishState.soup, (val) => (garnishState.soup = val));
      renderOptionPills(garnishPrincipleContainer, principleOptions, garnishState.principle, (val) => (garnishState.principle = val));
      renderOptionPills(garnishSideContainer, sideOptions, garnishState.side, (val) => (garnishState.side = val));
      renderOptionPills(garnishSaladContainer, saladOptions, garnishState.salad, (val) => (garnishState.salad = val));
      renderOptionPills(garnishPackagingContainer, packagingOptions, garnishState.packaging, (val) => (garnishState.packaging = val));

      modalGarnish?.classList.remove('hidden');
      modalGarnish?.classList.add('flex');
    }

    function closeGarnishModal() {
      modalGarnish?.classList.add('hidden');
      modalGarnish?.classList.remove('flex');
      editingCartUid = null;
      pendingGarnishItem = null;
    }

    document.getElementById('btn-garnish-close')?.addEventListener('click', closeGarnishModal);
    document.getElementById('btn-garnish-cancel')?.addEventListener('click', closeGarnishModal);

    document.querySelectorAll('.garnish-note-chip').forEach((chipBtn) => {
      chipBtn.addEventListener('click', () => {
        const chipText = chipBtn.getAttribute('data-note-chip') || '';
        if (!garnishExtraNotes || !chipText) return;
        // @ts-ignore
        const current = garnishExtraNotes.value.trim();
        // @ts-ignore
        garnishExtraNotes.value = current ? `${current}, ${chipText}` : chipText;
      });
    });

    // Guardar cambios al plato personalizado desde el carrito
    document.getElementById('form-garnish-pos')?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!editingCartUid) {
        closeGarnishModal();
        return;
      }

      const item = cart.find((it) => it.uid === editingCartUid);
      if (!item) {
        closeGarnishModal();
        return;
      }

      // @ts-ignore
      const extra = garnishExtraNotes ? garnishExtraNotes.value.trim() : '';

      item.soup = garnishState.soup;
      item.principle = garnishState.principle;
      item.side = garnishState.side;
      item.salad = garnishState.salad;
      item.packaging = garnishState.packaging;
      item.extraNotes = extra;
      item.notes = buildPlateNotes(item);

      renderCart();
      closeGarnishModal();
    });

    // 1-CLICK: Agregar plato al carrito sin bloquear con modal
    function addDishToCartInOneClick({ id, name, price, isCustomizable, category_id }) {
      const numPrice = Number(price);

      if (isCustomizable) {
        const soupOptions = [`Sopa ${dailySpecialsData.sopa || 'del Día'}`, 'Sin Sopa', 'Solo Bandeja'];
        const principleOptions = [...(dailySpecialsData.principios || []), 'Sin Principio'];
        const sideOptions = [...(dailySpecialsData.acompanamientos || []), 'Sin Acompañamiento'];

        const item = {
          uid: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
          id: id || name,
          name,
          price: numPrice,
          quantity: 1,
          category_id: category_id || 'fuertes_165',
          isCustomizable: true,
          soup: soupOptions[0],
          principle: principleOptions[0] || 'Sin Principio',
          side: sideOptions[0] || 'Sin Acompañamiento',
          salad: 'Con ensalada',
          packaging: globalPackagingType,
          extraNotes: '',
          notes: ''
        };
        item.notes = buildPlateNotes(item);
        cart.push(item);
      } else {
        const existing = cart.find((it) => it.name === name && !it.isCustomizable);
        if (existing) {
          existing.quantity += 1;
        } else {
          cart.push({
            uid: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
            id: id || name,
            name,
            price: numPrice,
            quantity: 1,
            category_id: category_id || 'bebidas',
            isCustomizable: false,
            notes: ''
          });
        }
      }

      if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
        packagingQty = countFoodPlates();
      }
      renderCart();
    }

    // Delegación global para botones '+' (.btn-add-cart) tanto del Menú Rápido como del Buscador (1-CLIC directo)
    document.addEventListener('click', (e) => {
      // @ts-ignore
      const btn = e.target.closest('.btn-add-cart');
      if (!btn || btn.disabled) return;

      btn.classList.add('ring-4', 'ring-emerald-400', 'bg-emerald-600', 'scale-110');
      setTimeout(() => {
        btn.classList.remove('ring-4', 'ring-emerald-400', 'bg-emerald-600', 'scale-110');
      }, 350);

      const name = btn.getAttribute('data-name') || 'Plato';
      const price = Number(btn.getAttribute('data-price') || 0);
      const isCustomizable = btn.getAttribute('data-customizable') === 'true';
      const id = btn.getAttribute('data-id') || name;
      const category_id = btn.getAttribute('data-cat') || '';

      addDishToCartInOneClick({ id, name, price, isCustomizable, category_id });
    });

    // Controladores de Empaques Globales (Caja / Icopor y Cantidad)
    const btnPackGlobalCaja = document.getElementById('btn-pack-global-caja');
    const btnPackGlobalIcopor = document.getElementById('btn-pack-global-icopor');
    const btnPackMinus = document.getElementById('btn-pack-minus');
    const btnPackPlus = document.getElementById('btn-pack-plus');

    function updateGlobalPackagingUI() {
      if (globalPackagingType === 'Caja') {
        btnPackGlobalCaja?.classList.add('bg-parrilla-gold', 'text-white', 'shadow-xs');
        btnPackGlobalCaja?.classList.remove('text-parrilla-muted', 'hover:text-parrilla-ivory');
        btnPackGlobalIcopor?.classList.remove('bg-parrilla-gold', 'text-white', 'shadow-xs');
        btnPackGlobalIcopor?.classList.add('text-parrilla-muted', 'hover:text-parrilla-ivory');
      } else {
        btnPackGlobalIcopor?.classList.add('bg-parrilla-gold', 'text-white', 'shadow-xs');
        btnPackGlobalIcopor?.classList.remove('text-parrilla-muted', 'hover:text-parrilla-ivory');
        btnPackGlobalCaja?.classList.remove('bg-parrilla-gold', 'text-white', 'shadow-xs');
        btnPackGlobalCaja?.classList.add('text-parrilla-muted', 'hover:text-parrilla-ivory');
      }
    }

    btnPackGlobalCaja?.addEventListener('click', () => {
      globalPackagingType = 'Caja';
      updateGlobalPackagingUI();
      cart.forEach((it) => {
        if (it.isCustomizable) it.packaging = 'Caja';
      });
      updateAllItemsPackagingNotes();
      renderCart();
    });

    btnPackGlobalIcopor?.addEventListener('click', () => {
      globalPackagingType = 'Icopor';
      updateGlobalPackagingUI();
      cart.forEach((it) => {
        if (it.isCustomizable) it.packaging = 'Icopor';
      });
      updateAllItemsPackagingNotes();
      renderCart();
    });

    btnPackMinus?.addEventListener('click', () => {
      manualPackagingOverride = true;
      packagingQty = Math.max(0, packagingQty - 1);
      renderCart();
    });

    btnPackPlus?.addEventListener('click', () => {
      manualPackagingOverride = true;
      packagingQty += 1;
      renderCart();
    });

    // 3. RENDER CART & TOTALS
    function renderCart() {
      if (!cartContainer) return;

      const { subtotal, packagingFee, deliveryFee, total, isDeliveryOrTakeout } = calculateTotals();

      if (cart.length === 0) {
        cartContainer.innerHTML = '<div class="p-6 text-center text-xs text-parrilla-muted italic">Selecciona productos del catálogo para agregar a la comanda.</div>';
        subtotalEl.textContent = '$0';
        totalEl.textContent = '$0';
        cashChangeDisplay.textContent = '$0';

        const packagingBox = document.getElementById('packaging-box');
        const posPackagingRow = document.getElementById('pos-packaging-row');
        if (packagingBox) packagingBox.classList.add('hidden');
        if (posPackagingRow) posPackagingRow.style.display = 'none';
        return;
      }

      cartContainer.innerHTML = cart.map((item, idx) => {
        const itemTotal = item.price * item.quantity;

        let inlineControls = '';
        if (item.isCustomizable) {
          const soupOptions = [
            `Sopa ${dailySpecialsData.sopa || 'del Día'}`,
            'Sin Sopa',
            'Solo Bandeja'
          ];
          const principleOptions = [
            ...(dailySpecialsData.principios || []),
            'Sin Principio'
          ];
          const sideOptions = [
            ...(dailySpecialsData.acompanamientos || []),
            'Sin Acompañamiento'
          ];
          const saladOptions = ['Con ensalada', 'Sin ensalada'];
          const packagingOptions = ['Caja', 'Icopor'];

          const optHtml = (arr, sel) =>
            arr
              .map((val) => `<option value="${escapeHtml(val)}" ${val === sel ? 'selected' : ''}>${escapeHtml(val)}</option>`)
              .join('');

          inlineControls = `
            <div class="grid grid-cols-2 gap-1.5 mt-2 pt-2 border-t border-dashed border-parrilla-border/70 text-[11px]">
              <div>
                <label class="block text-[9px] font-extrabold uppercase text-parrilla-muted tracking-wider mb-0.5">🥣 Sopa</label>
                <select class="pos-inline-select w-full py-1 px-1.5 bg-slate-50 hover:bg-white rounded-lg border border-parrilla-border text-[11px] font-bold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="soup" data-uid="${item.uid}">
                  ${optHtml(soupOptions, item.soup)}
                </select>
              </div>

              <div>
                <label class="block text-[9px] font-extrabold uppercase text-parrilla-muted tracking-wider mb-0.5">🍚 Principio</label>
                <select class="pos-inline-select w-full py-1 px-1.5 bg-slate-50 hover:bg-white rounded-lg border border-parrilla-border text-[11px] font-bold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="principle" data-uid="${item.uid}">
                  ${optHtml(principleOptions, item.principle)}
                </select>
              </div>

              <div>
                <label class="block text-[9px] font-extrabold uppercase text-parrilla-muted tracking-wider mb-0.5">🍟 Acomp.</label>
                <select class="pos-inline-select w-full py-1 px-1.5 bg-slate-50 hover:bg-white rounded-lg border border-parrilla-border text-[11px] font-bold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="side" data-uid="${item.uid}">
                  ${optHtml(sideOptions, item.side)}
                </select>
              </div>

              <div>
                <label class="block text-[9px] font-extrabold uppercase text-parrilla-muted tracking-wider mb-0.5">🥗 Ensalada</label>
                <select class="pos-inline-select w-full py-1 px-1.5 bg-slate-50 hover:bg-white rounded-lg border border-parrilla-border text-[11px] font-bold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="salad" data-uid="${item.uid}">
                  ${optHtml(saladOptions, item.salad)}
                </select>
              </div>

              ${
                currentOrderType !== 'mesa'
                  ? `
              <div class="col-span-2">
                <label class="block text-[9px] font-extrabold uppercase text-parrilla-muted tracking-wider mb-0.5">📦 Empaque</label>
                <select class="pos-inline-select w-full py-1 px-1.5 bg-slate-50 hover:bg-white rounded-lg border border-parrilla-border text-[11px] font-bold text-parrilla-ivory focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none cursor-pointer" data-field="packaging" data-uid="${item.uid}">
                  ${optHtml(packagingOptions, item.packaging || globalPackagingType)}
                </select>
              </div>`
                  : ''
              }

              <div class="col-span-2">
                <input
                  type="text"
                  class="pos-inline-notes w-full py-1 px-2 bg-slate-50 hover:bg-white focus:bg-white rounded-lg border border-parrilla-border text-[11px] font-medium text-parrilla-ivory placeholder:text-parrilla-muted focus:border-parrilla-gold focus:ring-1 focus:ring-parrilla-gold outline-none transition"
                  data-uid="${item.uid}"
                  placeholder="Nota: ej: bien asado, sin cebolla..."
                  value="${escapeHtml(item.extraNotes || '')}"
                />
              </div>
            </div>
          `;
        } else if (item.notes) {
          inlineControls = `<div class="text-[10px] text-parrilla-muted mt-1 leading-tight bg-slate-100/80 px-1.5 py-0.5 rounded border border-parrilla-border/60">${escapeHtml(item.notes)}</div>`;
        }

        return `
          <div class="p-2.5 bg-slate-50/70 border border-parrilla-border/80 hover:border-parrilla-gold/60 rounded-xl transition shadow-2xs mb-2">
            <div class="flex items-start justify-between gap-2">
              <div class="flex-1 min-w-0">
                <div class="font-bold text-xs text-parrilla-ivory leading-snug">${escapeHtml(item.name)}</div>
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-[11px] text-parrilla-gold font-bold font-mono">${fmt(item.price)}</span>
                  ${
                    item.isCustomizable
                      ? `
                    <button type="button" class="btn-customize-cart-item text-[10px] font-bold text-orange-700 bg-orange-100 hover:bg-orange-200 border border-orange-200 px-1.5 py-0.5 rounded transition flex items-center gap-1 cursor-pointer" data-uid="${item.uid}" title="Abrir modal completo de guarniciones">
                      <span>✏️ Modal</span>
                    </button>
                  `
                      : ''
                  }
                </div>
              </div>
              
              <!-- Quantity Controls -->
              <div class="flex items-center gap-1 bg-white px-1.5 py-1 rounded-lg border border-parrilla-border">
                <button type="button" class="btn-qty-minus text-parrilla-muted hover:text-red-500 font-bold px-1.5 cursor-pointer" data-uid="${item.uid}" data-idx="${idx}">-</button>
                <span class="font-bold text-xs text-parrilla-ivory px-1 min-w-[14px] text-center">${item.quantity}</span>
                <button type="button" class="btn-qty-plus text-parrilla-muted hover:text-parrilla-gold font-bold px-1.5 cursor-pointer" data-uid="${item.uid}" data-idx="${idx}">+</button>
              </div>

              <div class="font-bold text-xs text-parrilla-ivory text-right w-16 font-mono">
                ${fmt(itemTotal)}
              </div>

              <button type="button" class="btn-remove-item text-parrilla-muted hover:text-red-500 p-1 cursor-pointer" data-uid="${item.uid}" data-idx="${idx}" aria-label="Eliminar plato">
                ✕
              </button>
            </div>

            ${inlineControls}
          </div>
        `;
      }).join('');

      // Enlace para el botón "Personalizar / Cambiar"
      document.querySelectorAll('.btn-customize-cart-item').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const item = cart.find((it) => it.uid === uid);
          if (item) openGarnishModalForCartItem(item);
        });
      });

      // Bind dynamic quantity buttons
      document.querySelectorAll('.btn-qty-minus').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const idx = cart.findIndex((it) => it.uid === uid);
          if (idx === -1) return;

          if (cart[idx].quantity > 1) {
            cart[idx].quantity -= 1;
          } else {
            cart.splice(idx, 1);
          }

          if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
            packagingQty = countFoodPlates();
          }
          renderCart();
        });
      });

      document.querySelectorAll('.btn-qty-plus').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const item = cart.find((it) => it.uid === uid);
          if (!item) return;

          if (item.isCustomizable) {
            // Duplica el plato como un nuevo plato independiente para poder personalizarlo
            const cloned = {
              ...item,
              uid: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
              quantity: 1
            };
            cloned.notes = buildPlateNotes(cloned);
            cart.push(cloned);
          } else {
            item.quantity += 1;
          }

          if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
            packagingQty = countFoodPlates();
          }
          renderCart();
        });
      });

      document.querySelectorAll('.btn-remove-item').forEach((b) => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const uid = e.currentTarget.getAttribute('data-uid');
          const idx = cart.findIndex((it) => it.uid === uid);
          if (idx !== -1) {
            cart.splice(idx, 1);
            if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
              packagingQty = countFoodPlates();
            }
            renderCart();
          }
        });
      });

      // Listeners directos de cajitas en la comanda (Sopa, Principio, Acomp., Ensalada, Empaque)
      document.querySelectorAll('.pos-inline-select').forEach((sel) => {
        sel.addEventListener('change', (e) => {
          // @ts-ignore
          const target = e.currentTarget;
          const uid = target.getAttribute('data-uid');
          const field = target.getAttribute('data-field');
          const item = cart.find((it) => it.uid === uid);
          if (item && field) {
            item[field] = target.value;
            item.notes = buildPlateNotes(item);
          }
        });
      });

      // Observaciones / Notas por plato en tiempo real
      document.querySelectorAll('.pos-inline-notes').forEach((inp) => {
        inp.addEventListener('input', (e) => {
          // @ts-ignore
          const target = e.currentTarget;
          const uid = target.getAttribute('data-uid');
          const item = cart.find((it) => it.uid === uid);
          if (item) {
            item.extraNotes = target.value;
            item.notes = buildPlateNotes(item);
          }
        });
      });

      // Actualizar Subtotal y Desglose de Empaques
      subtotalEl.textContent = fmt(subtotal);

      const packagingBox = document.getElementById('packaging-box');
      const packagingQtyDisplay = document.getElementById('packaging-qty-display');
      const packagingTotalBadge = document.getElementById('packaging-total-badge');
      const posPackagingRow = document.getElementById('pos-packaging-row');
      const posPackagingLabel = document.getElementById('pos-packaging-label');
      const posPackagingFee = document.getElementById('pos-packaging-fee');

      if (isDeliveryOrTakeout) {
        packagingBox?.classList.remove('hidden');
        if (packagingQtyDisplay) packagingQtyDisplay.textContent = String(packagingQty);
        if (packagingTotalBadge) packagingTotalBadge.textContent = fmt(packagingFee);
        if (posPackagingRow) {
          posPackagingRow.style.display = 'flex';
          if (posPackagingLabel) posPackagingLabel.textContent = `Empaques (${globalPackagingType} x ${packagingQty}):`;
          if (posPackagingFee) posPackagingFee.textContent = fmt(packagingFee);
        }
      } else {
        packagingBox?.classList.add('hidden');
        if (posPackagingRow) posPackagingRow.style.display = 'none';
      }

      // Actualizar Domicilio
      if (currentOrderType === 'domicilio') {
        deliveryRow.style.display = 'flex';
        deliveryEl.textContent = fmt(deliveryFee);
      } else {
        deliveryRow.style.display = 'none';
      }

      // Actualizar Total
      totalEl.textContent = fmt(total);

      calculateChange(total);
    }

    function calculateChange(total) {
      // @ts-ignore
      const cashVal = Number(cashReceivedInput.value || 0);
      if (cashVal > 0 && currentPaymentMethod === 'efectivo') {
        const diff = cashVal - total;
        cashChangeDisplay.textContent = diff >= 0 ? fmt(diff) : 'Faltan ' + fmt(Math.abs(diff));
        cashChangeDisplay.className = diff >= 0 ? 'font-display font-black text-lg text-parrilla-accent' : 'font-display font-black text-lg text-red-400';
      } else {
        cashChangeDisplay.textContent = '$0';
        cashChangeDisplay.className = 'font-display font-black text-lg text-parrilla-accent';
      }
    }

    if (cashReceivedInput) {
      cashReceivedInput.addEventListener('input', () => {
        const { total } = calculateTotals();
        calculateChange(total);
      });
    }

    if (deliveryFeeInput) {
      deliveryFeeInput.addEventListener('input', () => {
        renderCart();
      });
    }

    // 4. ORDER TYPE SWITCHER
    function setOrderType(type) {
      currentOrderType = type;
      [typeMesaBtn, typeDomicilioBtn, typeLlevarBtn].forEach((b) => {
        b.className = 'order-type-btn flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-border bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold font-extrabold text-xs transition';
      });

      if (type === 'mesa') {
        typeMesaBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'flex';
        formDomicilio.style.display = 'none';
        packagingQty = 0;
        manualPackagingOverride = false;
      } else if (type === 'domicilio') {
        typeDomicilioBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-accent bg-parrilla-accent text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'none';
        formDomicilio.style.display = 'flex';
        if (!manualPackagingOverride) {
          packagingQty = countFoodPlates();
        }
      } else {
        typeLlevarBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-amber-600 bg-amber-600 text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'none';
        formDomicilio.style.display = 'none';
        if (!manualPackagingOverride) {
          packagingQty = countFoodPlates();
        }
      }

      // Sincronizar notas de empaque según el nuevo tipo de pedido
      updateAllItemsPackagingNotes();

      // Update Courier Checkbox in Modal
      const chkCourierWrapper = document.getElementById('chk-courier-wrapper');
      const chkCourier = document.getElementById('chk-print-courier');
      if (chkCourierWrapper && chkCourier) {
        if (type === 'domicilio') {
          chkCourierWrapper.style.display = 'flex';
          // @ts-ignore
          chkCourier.checked = true;
        } else {
          chkCourierWrapper.style.display = 'none';
          // @ts-ignore
          chkCourier.checked = false;
        }
      }

      renderCart();
    }

    typeMesaBtn?.addEventListener('click', () => setOrderType('mesa'));
    typeDomicilioBtn?.addEventListener('click', () => setOrderType('domicilio'));
    typeLlevarBtn?.addEventListener('click', () => setOrderType('para_llevar'));

    // 5. CUSTOMER INSTANT AUTOCOMPLETE VIA PHONE
    let searchTimeout = null;
    if (custPhoneInput) {
      custPhoneInput.addEventListener('input', (e) => {
        // @ts-ignore
        const phone = e.target.value.trim();
        custStatus.textContent = '';
        if (phone.length >= 7) {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(async () => {
            try {
              custStatus.textContent = '🔍';
              const res = await fetch(`/api/customers?phone=${encodeURIComponent(phone)}`);
              const cust = await res.json();
              if (cust && cust.id) {
                // @ts-ignore
                custNameInput.value = cust.name;
                // @ts-ignore
                custAddressInput.value = cust.address;
                // @ts-ignore
                custNeighborhoodInput.value = cust.neighborhood || '';
                custStatus.textContent = '✅ Cliente recurrente (' + cust.order_count + ' pedidos)';
                custStatus.className = 'absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-parrilla-accent font-bold';
              } else {
                custStatus.textContent = '✨ Nuevo';
                custStatus.className = 'absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-amber-400 font-bold';
              }
            } catch (err) {
              custStatus.textContent = '';
            }
          }, 400);
        }
      });
    }

    // 6. PAYMENT METHOD SWITCHER
    payButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        payButtons.forEach(b => {
          b.className = 'pay-btn py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition';
        });
        btn.className = 'pay-btn active py-2 rounded-lg text-xs font-bold bg-parrilla-gold text-white shadow-sm transition';
        currentPaymentMethod = btn.getAttribute('data-method') || 'efectivo';

        if (currentPaymentMethod === 'efectivo') {
          cashChangeBox.style.display = 'flex';
        } else {
          cashChangeBox.style.display = 'none';
        }
        renderCart();
      });
    });

    // 7. CLEAR CART
    clearCartBtn?.addEventListener('click', () => {
      if (confirm('¿Deseas vaciar la comanda actual?')) {
        cart = [];
        // @ts-ignore
        cashReceivedInput.value = '';
        renderCart();
      }
    });

    // 7.1 QUICK TEST PRINT SAT Q22
    quickTestBtn?.addEventListener('click', () => {
      // Add test combo to cart if not present
      const testItem = cart.find(i => i.id === 'test-print-sat');
      if (testItem) {
        testItem.quantity += 1;
      } else {
        cart.push({
          id: 'test-print-sat',
          name: '🔥 Combo Prueba Impresión SAT Q22',
          price: 1000,
          quantity: 1,
          category_id: 'fuertes_165'
        });
      }
      renderCart();
      // If delivery mode is selected, populate test delivery data so validation passes
      if (currentOrderType === 'domicilio') {
        // @ts-ignore
        if (!custPhoneInput.value) custPhoneInput.value = '3183821787';
        // @ts-ignore
        if (!custNameInput.value) custNameInput.value = 'CLIENTE PRUEBA SAT';
        // @ts-ignore
        if (!custAddressInput.value) custAddressInput.value = 'Cra 15 # 45 - 20 Apto 301';
        // @ts-ignore
        if (!custNeighborhoodInput.value) custNeighborhoodInput.value = 'Parrilla Centro';
      }
      // Trigger checkout and print immediately
      checkoutPrintBtn?.click();
    });

    // 8. CHECKOUT & MODAL DE COBRO / PAGO MIXTO
    const modalCobro = document.getElementById('modal-cobro-pos');
    const btnCloseCobro = document.getElementById('btn-close-cobro-modal');
    const btnCancelCobro = document.getElementById('btn-cancel-cobro');
    const btnConfirmPayment = document.getElementById('btn-confirm-payment-print');

    const btnModeSingle = document.getElementById('btn-mode-single');
    const btnModeSplit = document.getElementById('btn-mode-split');
    const viewSingle = document.getElementById('cobro-view-single');
    const viewSplit = document.getElementById('cobro-view-split');

    let cobroPaymentMode = 'single'; // 'single' | 'split'
    let selectedSingleMethod = 'CASH';
    const singleCashCalc = document.getElementById('single-cash-calc');
    const singleCashReceived = document.getElementById('single-cash-received');
    const singleChangeDisplay = document.getElementById('single-change-display');

    const splitMethod1 = document.getElementById('split-method-1');
    const splitAmount1 = document.getElementById('split-amount-1');
    const splitMethod2 = document.getElementById('split-method-2');
    const splitAmount2 = document.getElementById('split-amount-2');
    const splitSumDisplay = document.getElementById('split-sum-display');
    const splitStatusDisplay = document.getElementById('split-status-display');
    const splitBalanceBox = document.getElementById('split-balance-box');

    // Switch between Single and Split payment modes
    btnModeSingle?.addEventListener('click', () => {
      cobroPaymentMode = 'single';
      btnModeSingle.className = 'py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory shadow-sm transition';
      btnModeSplit.className = 'py-2 rounded-lg text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory transition';
      viewSingle.classList.remove('hidden');
      viewSplit.classList.add('hidden');
    });

    btnModeSplit?.addEventListener('click', () => {
      cobroPaymentMode = 'split';
      btnModeSplit.className = 'py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory shadow-sm transition';
      btnModeSingle.className = 'py-2 rounded-lg text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory transition';
      viewSplit.classList.remove('hidden');
      viewSingle.classList.add('hidden');

      // Pre-fill split amounts if empty
      const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
      // @ts-ignore
      const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
      const total = subtotal + deliveryFee;
      // @ts-ignore
      if (!splitAmount1.value && !splitAmount2.value) {
        // @ts-ignore
        splitAmount1.value = Math.round(total / 2);
        // @ts-ignore
        splitAmount2.value = total - Math.round(total / 2);
      }
      updateSplitBalance(total);
    });

    // Single payment method selector buttons
    document.querySelectorAll('.single-pay-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.single-pay-btn').forEach(b => {
          b.className = 'single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1';
        });
        btn.className = 'single-pay-btn active py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-xs flex flex-col items-center gap-1 shadow-sm';
        selectedSingleMethod = btn.getAttribute('data-method') || 'CASH';

        if (selectedSingleMethod === 'CASH') {
          singleCashCalc.classList.remove('hidden');
        } else {
          singleCashCalc.classList.add('hidden');
        }
      });
    });

    // Single cash change calculation
    singleCashReceived?.addEventListener('input', () => {
      const { total } = calculateTotals();
      // @ts-ignore
      const paid = Number(singleCashReceived.value || 0);
      const diff = paid - total;
      if (paid > 0) {
        singleChangeDisplay.textContent = diff >= 0 ? fmt(diff) : 'Faltan ' + fmt(Math.abs(diff));
        singleChangeDisplay.className = diff >= 0 ? 'font-display font-black text-xl text-emerald-600 font-mono block' : 'font-display font-black text-xl text-red-600 font-mono block';
      } else {
        singleChangeDisplay.textContent = '$0';
        singleChangeDisplay.className = 'font-display font-black text-xl text-emerald-600 font-mono block';
      }
    });

    // Split balance calculation
    function updateSplitBalance(total) {
      // @ts-ignore
      const a1 = Number(splitAmount1.value || 0);
      // @ts-ignore
      const a2 = Number(splitAmount2.value || 0);
      const sum = a1 + a2;
      splitSumDisplay.textContent = fmt(sum);

      if (sum >= total) {
        splitStatusDisplay.textContent = '✅ Cubre el total ($' + fmt(sum) + ')';
        splitStatusDisplay.className = 'font-bold text-emerald-600';
        splitBalanceBox.className = 'p-3 rounded-xl border border-emerald-300 bg-emerald-50 flex items-center justify-between text-xs';
      } else {
        const missing = total - sum;
        splitStatusDisplay.textContent = `❌ Faltan ${fmt(missing)}`;
        splitStatusDisplay.className = 'font-bold text-red-600';
        splitBalanceBox.className = 'p-3 rounded-xl border border-red-300 bg-red-50 flex items-center justify-between text-xs';
      }
    }

    [splitAmount1, splitAmount2].forEach(input => {
      input?.addEventListener('input', () => {
        const { total } = calculateTotals();
        updateSplitBalance(total);
      });
    });

    const closeCobroModal = () => {
      modalCobro.classList.add('hidden');
      modalCobro.classList.remove('flex');
    };
    btnCloseCobro?.addEventListener('click', closeCobroModal);
    btnCancelCobro?.addEventListener('click', closeCobroModal);

    // Open Cobro Modal
    checkoutPrintBtn?.addEventListener('click', () => {
      if (cart.length === 0) {
        alert('Por favor agrega al menos un plato a la comanda.');
        return;
      }

      if (currentOrderType === 'domicilio') {
        // @ts-ignore
        if (!custPhoneInput.value.trim() || !custNameInput.value.trim() || !custAddressInput.value.trim()) {
          alert('Para domicilios es obligatorio indicar Teléfono, Nombre y Dirección.');
          return;
        }
      }

      const { subtotal, packagingFee, deliveryFee, total, isDeliveryOrTakeout } = calculateTotals();

      // Populate modal values
      document.getElementById('modal-cobro-subtotal').textContent = fmt(subtotal);

      const modalPackagingRow = document.getElementById('modal-cobro-packaging-row');
      const modalPackagingLabel = document.getElementById('modal-cobro-packaging-label');
      const modalPackagingVal = document.getElementById('modal-cobro-packaging');
      if (isDeliveryOrTakeout && packagingFee > 0) {
        if (modalPackagingRow) modalPackagingRow.style.display = 'flex';
        if (modalPackagingLabel) modalPackagingLabel.textContent = `Empaques (${globalPackagingType} x ${packagingQty}):`;
        if (modalPackagingVal) modalPackagingVal.textContent = fmt(packagingFee);
      } else {
        if (modalPackagingRow) modalPackagingRow.style.display = 'none';
      }

      const deliveryRowModal = document.getElementById('modal-cobro-delivery-row');
      if (currentOrderType === 'domicilio') {
        deliveryRowModal.style.display = 'flex';
        document.getElementById('modal-cobro-delivery').textContent = fmt(deliveryFee);
      } else {
        deliveryRowModal.style.display = 'none';
      }
      document.getElementById('modal-cobro-total').textContent = fmt(total);

      // Subtitle
      const titleInfo = currentOrderType === 'mesa' 
        // @ts-ignore
        ? `${tableInput.value || 'Mesa'} • ${cart.length} plato(s)`
        // @ts-ignore
        : (currentOrderType === 'domicilio' ? `Domicilio para ${custNameInput.value.trim()}` : 'Para Llevar');
      document.getElementById('modal-order-subtitle').textContent = titleInfo;

      // Set initial single cash input if pre-typed
      // @ts-ignore
      if (cashReceivedInput.value) {
        // @ts-ignore
        singleCashReceived.value = cashReceivedInput.value;
      }

      modalCobro.classList.remove('hidden');
      modalCobro.classList.add('flex');
    });

    // CONFIRMAR PAGO (POST /api/pedidos/{id}/pagar) E IMPRIMIR SAT Q22
    btnConfirmPayment?.addEventListener('click', async () => {
      const { subtotal, packagingFee, deliveryFee, total } = calculateTotals();

      let paymentsPayload = [];
      let cashGiven = 0;

      if (cobroPaymentMode === 'single') {
        // @ts-ignore
        const paidCash = Number(singleCashReceived.value || 0);
        const change = (selectedSingleMethod === 'CASH' && paidCash > total) ? (paidCash - total) : 0;
        cashGiven = paidCash;

        paymentsPayload = [{
          method: selectedSingleMethod,
          amount: total,
          change_given: change
        }];
      } else {
        // Split mode
        // @ts-ignore
        const m1 = splitMethod1.value;
        // @ts-ignore
        const a1 = Number(splitAmount1.value || 0);
        // @ts-ignore
        const m2 = splitMethod2.value;
        // @ts-ignore
        const a2 = Number(splitAmount2.value || 0);

        if ((a1 + a2) < total) {
          alert(`El total de los pagos divididos ($${fmt(a1 + a2)}) no cubre el total del pedido ($${fmt(total)}).`);
          return;
        }

        paymentsPayload = [
          { method: m1, amount: a1, change_given: 0 },
          { method: m2, amount: a2, change_given: 0 }
        ];
      }

      btnConfirmPayment.disabled = true;
      btnConfirmPayment.innerHTML = '<span>Procesando pago y comanda...</span>';

      try {
        // 1. Guardar el pedido
        const orderPayload = {
          orderData: {
            orderType: currentOrderType,
            // @ts-ignore
            tableNumber: currentOrderType === 'mesa' ? tableInput.value : '',
            // @ts-ignore
            customerPhone: currentOrderType === 'domicilio' ? custPhoneInput.value.trim() : '',
            // @ts-ignore
            customerName: currentOrderType === 'domicilio' ? custNameInput.value.trim() : (tableInput.value || 'Cliente'),
            // @ts-ignore
            deliveryAddress: currentOrderType === 'domicilio' ? custAddressInput.value.trim() : '',
            // @ts-ignore
            deliveryNeighborhood: currentOrderType === 'domicilio' ? custNeighborhoodInput.value.trim() : '',
            subtotal,
            packagingFee,
            deliveryFee,
            total,
            paymentMethod: cobroPaymentMode === 'single' ? selectedSingleMethod.toLowerCase() : 'mixto',
            paymentChangeFor: cashGiven,
            status: 'completado'
          },
          items: cart
        };

        const response = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(orderPayload)
        });

        const resData = await response.json();
        if (!response.ok || !resData.success) {
          throw new Error(resData.error || 'Error al registrar pedido');
        }

        const savedOrder = resData.order;

        // 2. Registrar el pago en la caja activa del backend FastAPI (/api/pedidos/{id}/pagar)
        try {
          await fetch(`/api/pedidos/${savedOrder.id}/pagar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ payments: paymentsPayload })
          });
        } catch (e) {
          console.warn('Nota: Pago registrado localmente en comanda.');
        }

        // 3. Imprimir comanda en SAT Q22
        const ticket = {
          id: savedOrder.id,
          createdAt: new Date().toISOString(),
          orderType: currentOrderType,
          // @ts-ignore
          table: currentOrderType === 'mesa' ? (tableInput.value || 'Mesa') : '',
          customerName: orderPayload.orderData.customerName,
          customerPhone: orderPayload.orderData.customerPhone,
          address: orderPayload.orderData.deliveryAddress,
          neighborhood: orderPayload.orderData.deliveryNeighborhood,
          items: cart.map(({ name, price, quantity, notes, packaging }) => ({
            name,
            price,
            quantity,
            notes: notes || '',
            packaging: packaging || globalPackagingType
          })),
          subtotal,
          packagingFee,
          packagingType: globalPackagingType,
          packagingQty,
          deliveryFee,
          total,
          paymentMethod: cobroPaymentMode === 'single' ? selectedSingleMethod : 'MIXTO',
          cashPaid: cashGiven
        };

        saveLastTicket(ticket);
        closeCobroModal();
        cart = [];
        manualPackagingOverride = false;
        packagingQty = 0;
        // @ts-ignore
        cashReceivedInput.value = '';
        renderCart();

        // Leer opciones de tickets a imprimir marcadas por el cajero
        // @ts-ignore
        const wantCustomer = document.getElementById('chk-print-customer')?.checked ?? true;
        // @ts-ignore
        const wantKitchen = document.getElementById('chk-print-kitchen')?.checked ?? true;
        // @ts-ignore
        const wantCourier = (currentOrderType === 'domicilio') && (document.getElementById('chk-print-courier')?.checked ?? true);

        // Armar cola de impresión
        const printQueue = [];
        if (wantKitchen) printQueue.push('kitchen');
        if (wantCourier) printQueue.push('courier');
        if (wantCustomer) printQueue.push('customer');

        if (printQueue.length === 0) {
          printQueue.push('customer');
        }

        // Ejecutar impresión secuencial para impresora térmica
        (async () => {
          for (let i = 0; i < printQueue.length; i++) {
            printTicketType(ticket, printQueue[i]);
            if (i < printQueue.length - 1) {
              await new Promise(r => setTimeout(r, 650));
            }
          }
        })();

      } catch (err) {
        alert('Ocurrió un error al cobrar: ' + err.message);
      } finally {
        btnConfirmPayment.disabled = false;
        btnConfirmPayment.innerHTML = '<i data-lucide="printer" class="w-4 h-4"></i><span>Confirmar Pago y Generar Comanda</span>';
        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      }
    });

    // 9. COMANDA DIRECTA DE COCINA DESDE EL CARRITO
    document.getElementById('btn-print-kitchen-cart')?.addEventListener('click', () => {
      if (cart.length === 0) {
        alert('Por favor agrega al menos un plato a la comanda para imprimir la orden de cocina.');
        return;
      }

      const { subtotal, packagingFee, deliveryFee } = calculateTotals();

      const tempTicket = {
        id: 'COCINA-' + new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' }),
        createdAt: new Date().toISOString(),
        orderType: currentOrderType,
        // @ts-ignore
        table: currentOrderType === 'mesa' ? (tableInput.value || 'Mesa 1') : '',
        // @ts-ignore
        customerName: currentOrderType === 'domicilio' ? custNameInput.value.trim() : '',
        // @ts-ignore
        customerPhone: currentOrderType === 'domicilio' ? custPhoneInput.value.trim() : '',
        items: cart.map(({ name, price, quantity, notes, packaging }) => ({
          name,
          price,
          quantity,
          notes: notes || '',
          packaging: packaging || globalPackagingType
        })),
        subtotal,
        packagingFee,
        packagingType: globalPackagingType,
        packagingQty,
        deliveryFee,
        total: 0,
        paymentMethod: 'PENDIENTE'
      };

      printTicketType(tempTicket, 'kitchen');
    });

    // 10. MODAL RÁPIDO DE GASTO DE CAJA MENOR DESDE POS
    const modalExpensePos = document.getElementById('modal-add-expense-pos');
    const openExpensePosModal = () => {
      // @ts-ignore
      document.getElementById('expense-pos-amount').value = '';
      // @ts-ignore
      document.getElementById('expense-pos-description').value = '';
      // @ts-ignore
      document.getElementById('expense-pos-category').value = 'OTROS';
      modalExpensePos?.classList.remove('hidden');
      modalExpensePos?.classList.add('flex');
      // @ts-ignore
      document.getElementById('expense-pos-amount')?.focus();
    };

    const closeExpensePosModal = () => {
      modalExpensePos?.classList.add('hidden');
      modalExpensePos?.classList.remove('flex');
    };

    document.getElementById('btn-quick-expense-pos')?.addEventListener('click', openExpensePosModal);
    document.getElementById('btn-expense-pos-close')?.addEventListener('click', closeExpensePosModal);
    document.getElementById('btn-expense-pos-cancel')?.addEventListener('click', closeExpensePosModal);

    document.getElementById('form-add-expense-pos')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      // @ts-ignore
      const amount = Number(document.getElementById('expense-pos-amount').value || 0);
      // @ts-ignore
      const description = document.getElementById('expense-pos-description').value.trim();
      // @ts-ignore
      const category = document.getElementById('expense-pos-category').value;

      if (!amount || amount <= 0) {
        alert('Ingresa un monto en efectivo válido mayor a 0');
        return;
      }
      if (!description) {
        alert('Ingresa una descripción del gasto (ej. verduras, agua)');
        return;
      }

      const btn = document.getElementById('btn-submit-expense-pos');
      btn.disabled = true;
      btn.innerHTML = 'Guardando...';

      try {
        const res = await fetch('/api/caja/expenses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, description, category })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || data.error || 'Error al registrar gasto');

        alert(`✅ Gasto de ${fmt(amount)} registrado exitosamente en la caja activa.`);
        closeExpensePosModal();
      } catch (err) {
        alert('Error al registrar gasto: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Registrar Salida</span>';
        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      }
    });

    // 11. CHECK FOR PENDING WHATSAPP DRAFTS
    async function checkPendingDrafts() {
      try {
        const res = await fetch('/api/pedidos/?estado=BORRADOR_WEB&limit=20');
        if (res.ok) {
          const drafts = await res.json();
          const count = (drafts && Array.isArray(drafts)) ? drafts.length : 0;
          const alertEl = document.getElementById('pos-drafts-alert');
          const countEl = document.getElementById('pos-drafts-count');
          if (alertEl && countEl) {
            if (count > 0) {
              countEl.textContent = count;
              alertEl.classList.remove('hidden');
              alertEl.classList.add('flex');
            } else {
              alertEl.classList.add('hidden');
              alertEl.classList.remove('flex');
            }
          }
        }
      } catch (e) {}
    }
    checkPendingDrafts();
    setInterval(checkPendingDrafts, 15000);

    // ==============================================================
    //  LOS 3 FORMATOS DE IMPRESIÓN TÉRMICA 80MM (POS-80C / SAT Q22)
    //  1. Comanda de Cocina (printKitchenTicket)
    //  2. Ticket Mensajero (printCourierTicket)
    //  3. Cuenta Cliente (printCustomerReceipt)
    // ==============================================================
    const LAST_TICKET_KEY = 'sp_last_ticket';

    function saveLastTicket(ticket) {
      try {
        localStorage.setItem(LAST_TICKET_KEY, JSON.stringify(ticket));
      } catch (e) {}
      refreshReprintButton();
    }

    function loadLastTicket() {
      try {
        return JSON.parse(localStorage.getItem(LAST_TICKET_KEY) || 'null');
      } catch (e) {
        return null;
      }
    }

    function refreshReprintButton() {
      const last = loadLastTicket();
      const reprintBar = document.getElementById('reprint-bar');
      const reprintLabel = document.getElementById('reprint-order-label');
      const btnCourier = document.getElementById('btn-reprint-courier');
      if (!reprintBar || !last) return;

      const codeStr = (last.id && (last.id.toString().startsWith('#') || last.id.toString().startsWith('SP-'))) ? last.id : '#' + (last.id || '001');
      if (reprintLabel) reprintLabel.textContent = `Último Pedido (${codeStr})`;

      // Mostrar botón de mensajero solo si fue domicilio
      if (btnCourier) {
        btnCourier.style.display = last.orderType === 'domicilio' ? 'flex' : 'none';
      }

      reprintBar.classList.remove('hidden');
    }

    // 1. FORMATO: COMANDA DE COCINA (SIN PRECIOS, LETRA GRANDE, NOTAS RESALTADAS)
    function renderKitchenTicketHTML(t) {
      const timeStr = new Date(t.createdAt || Date.now()).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
      const dateStr = new Date(t.createdAt || Date.now()).toLocaleDateString('es-CO');
      const codeStr = (t.id && (t.id.toString().startsWith('#') || t.id.toString().startsWith('SP-'))) ? t.id : '#' + (t.id || '001');

