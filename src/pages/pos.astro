          let loc = it.hospitalLocation || 'Torre A';
          if (/TORRE B/i.test(it.notes || '')) loc = 'Torre B';
          else if (/URGENCIAS/i.test(it.notes || '')) loc = 'Urgencias';
          else if (/TORRE A/i.test(it.notes || '')) loc = 'Torre A';
          const locUpper = loc.toUpperCase();

          if (!ubicMap[locUpper]) ubicMap[locUpper] = {};

          let dietType = rawName.includes('Dieta')
            ? rawName.split(/Dieta/i)[1].trim().toUpperCase()
            : rawName.replace(/^(Desayuno|Almuerzo|Cena)\s+Cl[íi]nica\s*-\s*/i, '').trim().toUpperCase();
          if (!dietType) dietType = 'NORMAL';

          if (!ubicMap[locUpper][dietType]) {
            ubicMap[locUpper][dietType] = 0;
          }
          ubicMap[locUpper][dietType] += cant;
        });

        const totalAguaFinal = Math.max(totalAguaItems, totalDietasHipo);
        const totalDom = t.cantidad_domicilios || (t.deliveryFee ? Math.max(1, Math.round(t.deliveryFee / 3000)) : 1);

        const ordenPabellones = ['TORRE A', 'TORRE B', 'URGENCIAS'];
        const pabellones = [...ordenPabellones.filter(p => ubicMap[p]), ...Object.keys(ubicMap).filter(p => !ordenPabellones.includes(p))];

        const groupedSummaryHtml = pabellones.map(pab => {
          const diets = ubicMap[pab];
          const lines = Object.entries(diets).map(([dName, count]) => `
            <div style="font-size: 10pt; padding: 0.5mm 0; margin-left: 3mm;">
