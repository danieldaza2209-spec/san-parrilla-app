---
export const prerender = true;
import StaffLayout from '../layouts/StaffLayout.astro';
import { getCategories, getProducts, getActiveCashRegister, fallbackCategories, initialProductList } from '../lib/db.js';

const rawCategories = getCategories();
const categories = (rawCategories && rawCategories.length > 0) ? rawCategories : fallbackCategories;

const rawProducts = getProducts(true);
const products = (rawProducts && rawProducts.length > 0) ? rawProducts : initialProductList;
console.log(">>> POS PRODUCTS IN ASTRO BUILD:", products.length, "Categories:", categories.length);
const activeCash = getActiveCashRegister();

// Format Colombian Peso
const formatPrice = (val) => {
  return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
};
---

<StaffLayout title="POS Punto de Venta | San Parrilla">
  <div class="max-w-[1600px] mx-auto px-2 sm:px-4 py-4 flex-1 flex flex-col no-print">

    <!-- Top Alert if Cash Register is closed -->
    {!activeCash && (
      <div class="mb-4 bg-amber-500/20 border border-amber-500/50 text-amber-300 p-3.5 rounded-xl flex items-center justify-between">
        <div class="flex items-center gap-3">
          <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-400"></i>
          <span class="text-sm font-semibold">Atención: No hay una caja abierta actualmente. Las ventas se registrarán sin cuadre de turno.</span>
        </div>
        <a href="/caja" class="bg-amber-500 hover:bg-amber-400 text-parrilla-dark font-bold text-xs px-3 py-1.5 rounded-lg transition">
          Abrir Caja Ahora
        </a>
      </div>
    )}

    <!-- Top Alert: Pending WhatsApp Drafts -->
    <div id="pos-drafts-alert" class="hidden mb-4 bg-emerald-50 border border-emerald-300 text-emerald-800 p-3.5 rounded-xl items-center justify-between shadow-sm">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-sm font-bold">
          📱 Tienes <span id="pos-drafts-count" class="underline">0</span> pedidos web de WhatsApp pendientes de aprobación.
        </span>
      </div>
      <a href="/caja" class="bg-emerald-600 hover:bg-emerald-700 text-white font-display font-extrabold text-xs px-3.5 py-1.5 rounded-lg transition shadow-sm flex items-center gap-1.5">
        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
        <span>Ir a Bandeja de Borradores</span>
      </a>
    </div>

    <!-- Main POS Grid: Left Catalog, Right Order Cart -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1 items-start">
      
      <!-- LEFT SECTION: PRODUCT CATALOG & FILTERS (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        
        <!-- Search & Filter Bar -->
        <div class="bg-parrilla-surface rounded-2xl p-4 border border-parrilla-border flex flex-col sm:flex-row items-center gap-3">
          <div class="relative w-full sm:flex-1">
            <i data-lucide="search" class="w-4 h-4 text-parrilla-muted absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input 
              type="text" 
              id="product-search" 
              placeholder="Buscar plato o bebida (ej. Churrasco, Pechuga, Picada)..." 
              class="w-full pl-10 pr-4 py-2.5 bg-parrilla-dark rounded-xl border border-parrilla-border text-sm text-parrilla-ivory placeholder-parrilla-muted focus:outline-none focus:border-parrilla-gold transition"
            />
          </div>

          <!-- Quick Category Filters -->
          <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto no-scrollbar pb-1 sm:pb-0">
            <button class="pos-cat-btn active px-3 py-2 rounded-xl text-xs font-bold bg-parrilla-gold text-white shadow-sm transition" data-category="all">
              Todos
            </button>
            {categories.map(cat => (
              <button class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold hover:bg-slate-200/70 border border-parrilla-border transition whitespace-nowrap" data-category={cat.id}>
                {cat.name}
              </button>
            ))}
          </div>
        </div>

        <!-- Products Quick-Touch Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-h-[calc(100vh-250px)] overflow-y-auto pr-1" id="pos-product-list">
          {products.map(p => (
            <button 
              type="button"
              class="pos-item-btn text-left bg-white hover:bg-slate-50/90 rounded-xl p-3.5 border border-parrilla-border hover:border-parrilla-gold/60 transition active:scale-[0.98] flex flex-col justify-between min-h-[95px] group shadow-sm hover:shadow"
              data-id={p.id}
              data-name={p.name}
              data-price={p.price}
              data-cat={p.category_id}
            >
              <span class="font-display font-bold text-sm text-parrilla-ivory group-hover:text-parrilla-gold line-clamp-2 leading-tight">
                {p.name}
              </span>
              <div class="flex items-center justify-between mt-2 pt-2 border-t border-parrilla-border/60 w-full">
                <span class="font-extrabold text-sm text-parrilla-gold">
                  {formatPrice(p.price)}
                </span>
                <span class="w-6 h-6 rounded-lg bg-slate-100 group-hover:bg-parrilla-gold group-hover:text-white flex items-center justify-center text-parrilla-gold transition text-xs font-black">
                  +
                </span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- RIGHT SECTION: ORDER BUILDER & TICKET SUMMARY (5 cols) -->
      <div class="lg:col-span-5 bg-white rounded-2xl border border-parrilla-border p-4 sm:p-5 flex flex-col gap-4 sticky top-20 shadow-xl">
        
        <!-- Order Type Selector (Mesa / Domicilio / Para Llevar) -->
        <div>
          <label class="block text-xs font-bold text-parrilla-gold uppercase tracking-wider mb-2">Tipo de Pedido</label>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" id="type-mesa" class="order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-extrabold text-xs shadow-sm transition">
              <i data-lucide="utensils" class="w-4 h-4"></i>
              <span>Mesa</span>
            </button>
            <button type="button" id="type-domicilio" class="order-type-btn flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-border bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold font-extrabold text-xs transition">
              <i data-lucide="bike" class="w-4 h-4 text-parrilla-accent"></i>
              <span>Domicilio</span>
            </button>
            <button type="button" id="type-llevar" class="order-type-btn flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-border bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold font-extrabold text-xs transition">
              <i data-lucide="package" class="w-4 h-4 text-amber-600"></i>
              <span>Para Llevar</span>
            </button>
          </div>
        </div>

        <!-- CONDITIONAL FORM: MESA -->
        <div id="form-mesa" class="flex items-center gap-2">
          <span class="text-xs text-parrilla-muted font-medium">Mesa:</span>
          <input 
            type="text" 
            id="table-input" 
            value="Mesa 1" 
            placeholder="Ej. Mesa 3 o Barra" 
            class="flex-1 px-3 py-1.5 bg-parrilla-dark rounded-lg border border-parrilla-border text-sm text-parrilla-ivory focus:border-parrilla-gold outline-none"
          />
        </div>

        <!-- CONDITIONAL FORM: DOMICILIOS & CLIENTES DATABASE -->
        <div id="form-domicilio" class="hidden bg-parrilla-dark/90 rounded-xl p-3 border border-parrilla-gold/30 flex-col gap-2.5">
          <div class="flex items-center justify-between pb-1 border-b border-parrilla-border/60">
            <span class="text-xs font-bold text-parrilla-gold uppercase flex items-center gap-1.5">
              <i data-lucide="user-check" class="w-4 h-4"></i>
              <span>Datos del Cliente & Mensajero</span>
            </span>
            <span class="text-[10px] text-parrilla-muted">Guarda en BD automáticamente</span>
          </div>

          <!-- Teléfono con autocompletado instantáneo -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Teléfono Celular *</label>
              <div class="relative">
                <input 
                  type="tel" 
                  id="cust-phone" 
                  placeholder="3183821787" 
                  class="w-full px-3 py-2 bg-parrilla-surface rounded-lg border border-parrilla-border text-sm font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
                />
                <span id="cust-status" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs"></span>
              </div>
            </div>

            <div>
              <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Nombre del Cliente *</label>
              <input 
                type="text" 
                id="cust-name" 
                placeholder="Nombre completo" 
                class="w-full px-3 py-2 bg-parrilla-surface rounded-lg border border-parrilla-border text-sm text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
          </div>

          <!-- Dirección y Barrio/Referencia -->
          <div>
            <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Dirección de Entrega * (Se imprime en grande para mensajero)</label>
            <input 
              type="text" 
              id="cust-address" 
              placeholder="Calle 123 # 45 - 67 Apto 302" 
              class="w-full px-3 py-2 bg-parrilla-surface rounded-lg border border-parrilla-border text-sm font-semibold text-parrilla-gold focus:border-parrilla-gold outline-none"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Barrio / Indicaciones</label>
              <input 
                type="text" 
                id="cust-neighborhood" 
                placeholder="Ej. Centro, frente al parque" 
                class="w-full px-3 py-1.5 bg-parrilla-surface rounded-lg border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div>
              <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Costo Domicilio ($)</label>
              <input 
                type="number" 
                id="delivery-fee-input" 
                value="3000" 
                step="500" 
                class="w-full px-3 py-1.5 bg-parrilla-surface rounded-lg border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
          </div>
        </div>

        <!-- ORDER ITEMS CART LIST -->
        <div class="border border-parrilla-border rounded-xl bg-parrilla-dark/50 overflow-hidden flex flex-col flex-1">
          <div class="bg-parrilla-dark px-3 py-2 border-b border-parrilla-border flex items-center justify-between text-xs font-bold text-parrilla-muted uppercase">
            <span>Plato / Producto</span>
            <div class="flex items-center gap-6">
              <span>Cant.</span>
              <span>Total</span>
            </div>
          </div>

          <div id="cart-items-container" class="divide-y divide-parrilla-border/40 max-h-56 overflow-y-auto p-1 text-sm min-h-[120px]">
            <!-- Items injected by JS -->
            <div class="p-6 text-center text-xs text-parrilla-muted italic" id="cart-empty-msg">
              Selecciona productos del catálogo para agregar a la comanda.
            </div>
          </div>
        </div>

        <!-- PAYMENT METHOD & TOTALS -->
        <div class="bg-parrilla-dark/80 rounded-xl p-3 border border-parrilla-border space-y-2">
          
          <div class="flex items-center justify-between text-xs text-parrilla-muted">
            <span>Subtotal:</span>
            <span id="pos-subtotal" class="font-semibold text-parrilla-ivory">$0</span>
          </div>

          <div class="flex items-center justify-between text-xs text-parrilla-muted" id="delivery-row" style="display: none;">
            <span>Envío Domicilio:</span>
            <span id="pos-delivery" class="font-semibold text-parrilla-accent">$0</span>
          </div>

          <div class="flex items-center justify-between text-base font-black text-parrilla-gold pt-2 border-t border-parrilla-border">
            <span>TOTAL A COBRAR:</span>
            <span id="pos-total" class="text-xl font-display">$0</span>
          </div>

          <!-- Payment Method Buttons -->
          <div class="pt-2">
            <span class="block text-[11px] text-parrilla-muted uppercase font-semibold mb-1.5">Método de Pago</span>
            <div class="grid grid-cols-4 gap-1.5">
              <button type="button" class="pay-btn active py-2 rounded-lg text-xs font-bold bg-parrilla-gold text-white shadow-sm transition" data-method="efectivo">
                💵 Efectivo
              </button>
              <button type="button" class="pay-btn py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition" data-method="nequi">
                🟣 Nequi
              </button>
              <button type="button" class="pay-btn py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition" data-method="daviplata">
                🔴 Daviplata
              </button>
              <button type="button" class="pay-btn py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition" data-method="tarjeta">
                💳 Tarjeta
              </button>
            </div>
          </div>

          <!-- Cash Change Calculation (Si Efectivo) -->
          <div id="cash-change-box" class="pt-2 flex items-center gap-3">
            <div class="flex-1">
              <label class="block text-[10px] text-parrilla-muted uppercase font-semibold mb-0.5">Paga con ($):</label>
              <input 
                type="number" 
                id="cash-received" 
                placeholder="Ej. 50000" 
                class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-parrilla-border text-sm font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div class="flex-1 text-right">
              <span class="block text-[10px] text-parrilla-muted uppercase font-semibold mb-0.5">Vueltas / Cambio:</span>
              <span id="cash-change-display" class="font-display font-black text-lg text-parrilla-accent">$0</span>
            </div>
          </div>
        </div>

        <!-- ACTION BUTTONS: COBRAR, COMANDA COCINA Y GASTO CAJA -->
        <div class="space-y-2 pt-1">
          <div class="grid grid-cols-2 gap-2">
            <button 
              type="button" 
              id="btn-print-kitchen-cart" 
              class="py-2.5 px-3 rounded-xl bg-orange-50 hover:bg-orange-100 text-orange-700 border border-orange-200 text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-sm active:scale-95"
              title="Imprime la comanda de cocina directamente con los platos en el carrito"
            >
              <i data-lucide="utensils" class="w-4 h-4 text-orange-600"></i>
              <span>🍳 Comanda Cocina</span>
            </button>

            <button 
              type="button" 
              id="btn-quick-expense-pos" 
              class="py-2.5 px-3 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300 text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-sm active:scale-95"
              title="Registrar salida de efectivo menor desde la caja"
            >
              <i data-lucide="wallet" class="w-4 h-4 text-amber-600"></i>
              <span>💰 + Gasto Caja</span>
            </button>
          </div>

          <div class="flex items-center gap-2">
            <button 
              type="button" 
              id="btn-clear-cart" 
              class="px-3.5 py-3.5 rounded-xl bg-slate-100 hover:bg-red-50 text-parrilla-muted hover:text-red-500 border border-parrilla-border text-xs font-bold transition"
              title="Vaciar comanda"
            >
              Limpiar
            </button>

            <button 
              type="button" 
              id="btn-quick-test-print" 
              class="px-3 py-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-parrilla-muted border border-parrilla-border text-xs font-bold transition flex items-center gap-1"
              title="Test de impresión térmica"
            >
              <i data-lucide="zap" class="w-4 h-4 text-parrilla-gold"></i>
              <span>Test</span>
            </button>

            <button 
              type="button" 
              id="btn-checkout-print" 
              class="flex-1 py-3.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-display font-black text-sm shadow-lg shadow-orange-700/20 flex items-center justify-center gap-2 transition active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <i data-lucide="printer" class="w-4 h-4"></i>
              <span>Cobrar e Imprimir</span>
            </button>
          </div>
        </div>

        <!-- BARRA DE REIMPRESIÓN (3 FORMATOS TÉRMICOS 80MM) -->
        <div id="reprint-bar" class="hidden bg-slate-50 border border-parrilla-border rounded-xl p-3 space-y-2">
          <div class="flex items-center justify-between text-xs font-bold text-parrilla-muted">
            <span class="flex items-center gap-1.5">
              <i data-lucide="rotate-ccw" class="w-3.5 h-3.5 text-parrilla-gold"></i>
              <span id="reprint-order-label">Último Pedido (#000)</span>
            </span>
            <span class="text-[10px] text-emerald-600 font-mono font-bold">Cobrado con éxito</span>
          </div>
          <div class="grid grid-cols-3 gap-1.5">
            <button 
              type="button" 
              id="btn-reprint-customer" 
              class="py-2 px-1 rounded-lg bg-white hover:bg-slate-100 border border-parrilla-border text-[11px] font-bold text-parrilla-ivory hover:text-parrilla-gold transition flex items-center justify-center gap-1 shadow-xs"
              title="Reimprimir cuenta o recibo para el cliente"
            >
              <span>🧾 Cliente</span>
            </button>
            <button 
              type="button" 
              id="btn-reprint-kitchen" 
              class="py-2 px-1 rounded-lg bg-white hover:bg-slate-100 border border-parrilla-border text-[11px] font-bold text-parrilla-ivory hover:text-orange-600 transition flex items-center justify-center gap-1 shadow-xs"
              title="Reimprimir comanda de cocina sin precios"
            >
              <span>🍳 Cocina</span>
            </button>
            <button 
              type="button" 
              id="btn-reprint-courier" 
              class="py-2 px-1 rounded-lg bg-white hover:bg-slate-100 border border-parrilla-border text-[11px] font-bold text-parrilla-ivory hover:text-emerald-600 transition flex items-center justify-center gap-1 shadow-xs"
              title="Reimprimir ticket / guía de entrega para mensajero"
            >
              <span>🛵 Mensajero</span>
            </button>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- ==============================================================
       MODAL RÁPIDO: REGISTRAR GASTO DE CAJA MENOR (DESDE POS)
       ============================================================== -->
  <div id="modal-add-expense-pos" class="no-print fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl border border-parrilla-border max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-parrilla-border pb-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
            <i data-lucide="wallet" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="font-display font-black text-lg text-parrilla-ivory">Gasto de Caja Menor</h3>
            <span class="text-[11px] text-parrilla-muted">Registrar salida de efectivo físico</span>
          </div>
        </div>
        <button type="button" id="btn-expense-pos-close" class="text-parrilla-muted hover:text-parrilla-ivory">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="form-add-expense-pos" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-parrilla-gold uppercase mb-1">Monto en Efectivo ($) *</label>
          <input 
            type="number" 
            id="expense-pos-amount" 
            placeholder="Ej. 10000" 
            step="500" 
            min="500"
            required
            class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-parrilla-border text-2xl font-bold font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
          />
          <span class="text-[11px] text-parrilla-muted mt-1 block">Se restará automáticamente del arqueo de caja de hoy.</span>
        </div>

        <div>
          <label class="block text-xs font-semibold text-parrilla-muted mb-1">Concepto / Descripción *</label>
          <input 
            type="text" 
            id="expense-pos-description" 
            placeholder="Ej. Pago verduras, Paca de agua, Bolsas" 
            required
            class="w-full px-4 py-2.5 bg-slate-50 rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-parrilla-muted mb-1">Categoría</label>
          <select 
            id="expense-pos-category" 
            class="w-full px-4 py-2.5 bg-slate-50 rounded-xl border border-parrilla-border text-xs font-semibold text-parrilla-ivory focus:border-parrilla-gold outline-none"
          >
            <option value="INSUMOS">🥬 Insumos / Verduras / Carnes</option>
            <option value="SERVICIOS">💡 Servicios / Domicilios Internos</option>
            <option value="OTROS" selected>📦 Otros Gastos / Desechables</option>
          </select>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <button 
            type="button" 
            id="btn-expense-pos-cancel" 
            class="flex-1 py-3 rounded-xl border border-parrilla-border text-parrilla-muted hover:bg-slate-100 font-bold text-xs"
          >
            Cancelar
          </button>
          <button 
            type="submit" 
            id="btn-submit-expense-pos"
            class="flex-1 py-3 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-display font-black text-xs shadow-md flex items-center justify-center gap-1.5"
          >
            <i data-lucide="check" class="w-4 h-4"></i>
            <span>Registrar Salida</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==============================================================
       MODAL DE COBRO Y PAGO MIXTO (POST /api/pedidos/{id}/pagar)
       ============================================================== -->
  <div id="modal-cobro-pos" class="no-print fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl border border-parrilla-border max-w-lg w-full p-6 shadow-2xl space-y-4 max-h-[95vh] overflow-y-auto">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-parrilla-border pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-orange-100 text-parrilla-gold flex items-center justify-center font-bold">
            <i data-lucide="credit-card" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-display font-black text-xl text-parrilla-ivory">Cobro de Comanda</h3>
            <span id="modal-order-subtitle" class="text-xs text-parrilla-muted">Mesa 1 • 0 platos</span>
          </div>
        </div>
        <button type="button" id="btn-close-cobro-modal" class="text-parrilla-muted hover:text-parrilla-ivory">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Resumen de Costos -->
      <div class="bg-slate-50 p-3.5 rounded-xl border border-parrilla-border space-y-1.5 text-xs">
        <div class="flex justify-between text-parrilla-muted">
          <span>Subtotal consumo:</span>
          <span id="modal-cobro-subtotal" class="font-bold text-parrilla-ivory font-mono">$0</span>
        </div>
        <div class="flex justify-between text-parrilla-muted" id="modal-cobro-delivery-row">
          <span>Domicilio / Entrega:</span>
          <span id="modal-cobro-delivery" class="font-bold text-parrilla-accent font-mono">$0</span>
        </div>
        <div class="flex justify-between text-base font-black text-parrilla-gold border-t border-parrilla-border pt-1.5">
          <span>TOTAL A COBRAR:</span>
          <span id="modal-cobro-total" class="font-display text-2xl font-mono text-parrilla-gold">$0</span>
        </div>
      </div>

      <!-- Selector de Modo de Pago (Único vs Mixto) -->
      <div class="space-y-3">
        <div class="grid grid-cols-2 gap-2 bg-slate-100 p-1 rounded-xl border border-parrilla-border">
          <button type="button" id="btn-mode-single" class="py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory shadow-sm transition">
            💵 Pago Único
          </button>
          <button type="button" id="btn-mode-split" class="py-2 rounded-lg text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory transition">
            ⚖️ Pago Mixto / Dividido
          </button>
        </div>

        <!-- MODO 1: PAGO ÚNICO -->
        <div id="cobro-view-single" class="space-y-3">
          <span class="block text-[11px] font-bold text-parrilla-muted uppercase">Selecciona Método:</span>
          <div class="grid grid-cols-4 gap-2">
            <button type="button" class="single-pay-btn active py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-xs flex flex-col items-center gap-1 shadow-sm" data-method="CASH">
              <span>💵</span>
              <span>Efectivo</span>
            </button>
            <button type="button" class="single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1" data-method="NEQUI">
              <span>🟣</span>
              <span>Nequi</span>
            </button>
            <button type="button" class="single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1" data-method="DAVIPLATA">
              <span>🔴</span>
              <span>Daviplata</span>
            </button>
            <button type="button" class="single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1" data-method="CARD">
              <span>💳</span>
              <span>Tarjeta</span>
            </button>
          </div>

          <!-- Calculadora de Cambio en Efectivo -->
          <div id="single-cash-calc" class="bg-slate-50 p-3 rounded-xl border border-parrilla-border space-y-2">
            <div class="flex items-center justify-between gap-3">
              <div class="flex-1">
                <label class="block text-[10px] font-bold text-parrilla-muted uppercase mb-1">Efectivo recibido ($):</label>
                <input 
                  type="number" 
                  id="single-cash-received" 
                  placeholder="Ej. 50000" 
                  step="1000"
                  class="w-full px-3 py-2 bg-white rounded-lg border border-parrilla-border font-bold text-lg font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
                />
              </div>
              <div class="flex-1 text-right">
                <span class="block text-[10px] font-bold text-parrilla-muted uppercase mb-1">Vueltas / Cambio:</span>
                <span id="single-change-display" class="font-display font-black text-xl text-emerald-600 font-mono block">$0</span>
              </div>
            </div>
          </div>
        </div>

        <!-- MODO 2: PAGO MIXTO / DIVIDIDO -->
        <div id="cobro-view-split" class="hidden space-y-3">
          <div class="bg-amber-50 border border-amber-200 text-amber-800 p-2.5 rounded-xl text-xs">
            Divide la cuenta en dos medios de pago (ej. parte por Nequi y el resto en Efectivo).
          </div>

          <!-- Método 1 -->
          <div class="bg-slate-50 p-3 rounded-xl border border-parrilla-border space-y-2">
            <span class="text-[10px] font-bold text-parrilla-muted uppercase block">Primer Medio de Pago</span>
            <div class="grid grid-cols-2 gap-2">
              <select id="split-method-1" class="px-3 py-2 bg-white rounded-lg border border-parrilla-border text-xs font-bold text-parrilla-ivory outline-none">
                <option value="NEQUI">🟣 Nequi</option>
                <option value="CASH">💵 Efectivo</option>
                <option value="DAVIPLATA">🔴 Daviplata</option>
                <option value="CARD">💳 Tarjeta</option>
              </select>
              <input 
                type="number" 
                id="split-amount-1" 
                placeholder="Monto ($)" 
                step="500"
                class="px-3 py-2 bg-white rounded-lg border border-parrilla-border text-xs font-bold font-mono text-parrilla-ivory outline-none focus:border-parrilla-gold"
              />
            </div>
          </div>

          <!-- Método 2 -->
          <div class="bg-slate-50 p-3 rounded-xl border border-parrilla-border space-y-2">
            <span class="text-[10px] font-bold text-parrilla-muted uppercase block">Segundo Medio de Pago</span>
            <div class="grid grid-cols-2 gap-2">
              <select id="split-method-2" class="px-3 py-2 bg-white rounded-lg border border-parrilla-border text-xs font-bold text-parrilla-ivory outline-none">
                <option value="CASH">💵 Efectivo</option>
                <option value="NEQUI">🟣 Nequi</option>
                <option value="DAVIPLATA">🔴 Daviplata</option>
                <option value="CARD">💳 Tarjeta</option>
              </select>
              <input 
                type="number" 
                id="split-amount-2" 
                placeholder="Monto restante ($)" 
                step="500"
                class="px-3 py-2 bg-white rounded-lg border border-parrilla-border text-xs font-bold font-mono text-parrilla-ivory outline-none focus:border-parrilla-gold"
              />
            </div>
          </div>

          <!-- Split Balance Status -->
          <div class="p-3 rounded-xl border flex items-center justify-between text-xs" id="split-balance-box">
            <div>
              <span class="text-[10px] uppercase font-bold text-parrilla-muted block">Suma Pagada:</span>
              <span id="split-sum-display" class="font-bold font-mono">$0</span>
            </div>
            <div class="text-right">
              <span class="text-[10px] uppercase font-bold text-parrilla-muted block">Estado:</span>
              <span id="split-status-display" class="font-bold text-amber-600">Falta asignar dinero</span>
            </div>
          </div>
        </div>
      </div>

      <!-- SELECCIÓN DE TICKETS A IMPRIMIR (80MM) -->
      <div class="bg-slate-50 p-3.5 rounded-xl border border-parrilla-border space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="block text-[11px] font-bold text-parrilla-gold uppercase tracking-wider">Impresión Térmica 80mm al Confirmar:</span>
          <span class="text-[10px] text-parrilla-muted font-mono">POS-80C / SAT Q22</span>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-xs">
          <label class="flex items-center gap-2 cursor-pointer font-bold text-parrilla-ivory hover:text-parrilla-gold transition select-none">
            <input type="checkbox" id="chk-print-customer" checked class="w-4 h-4 rounded text-parrilla-gold focus:ring-0 cursor-pointer" />
            <span>🧾 Cuenta Cliente</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer font-bold text-parrilla-ivory hover:text-orange-600 transition select-none">
            <input type="checkbox" id="chk-print-kitchen" checked class="w-4 h-4 rounded text-orange-600 focus:ring-0 cursor-pointer" />
            <span>🍳 Comanda Cocina</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer font-bold text-parrilla-ivory hover:text-emerald-600 transition select-none" id="chk-courier-wrapper">
            <input type="checkbox" id="chk-print-courier" class="w-4 h-4 rounded text-emerald-600 focus:ring-0 cursor-pointer" />
            <span>🛵 Guía Mensajero</span>
          </label>
        </div>
      </div>

      <!-- Footer Buttons -->
      <div class="flex items-center gap-2 pt-2">
        <button 
          type="button" 
          id="btn-cancel-cobro" 
          class="py-3 px-4 rounded-xl border border-parrilla-border text-parrilla-muted hover:bg-slate-100 font-bold text-xs"
        >
          Cancelar
        </button>
        <button 
          type="button" 
          id="btn-confirm-payment-print" 
          class="flex-1 py-3.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-display font-black text-xs shadow-lg flex items-center justify-center gap-2 transition active:scale-95"
        >
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span>Confirmar Pago y Generar Comanda</span>
        </button>
      </div>

    </div>
  </div>

  <!-- ==============================================================
       THERMAL TICKET CONTAINER FOR 80MM PRINTER (POS-80C / SAT Q22)
       Invisible in screen, only element visible in @media print
       Dynamically filled with: Kitchen, Courier, or Customer template
       ============================================================== -->
  <div id="printable-ticket" class="receipt-ticket hidden">
    <!-- Contenido inyectado dinámicamente según el formato solicitado -->
  </div>

  <!-- ==============================================================
       CLIENT-SIDE JAVASCRIPT FOR POS OPERATION & INSTANT PRINT
       ============================================================== -->
  <script>
    // State
    let cart = [];
    let currentOrderType = 'mesa';
    let currentPaymentMethod = 'efectivo';

    // Format COP Currency
    const fmt = (val) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);

    // Elements
    const posProductList = document.getElementById('pos-product-list');
    const searchInput = document.getElementById('product-search');
    const catButtons = document.querySelectorAll('.pos-cat-btn');
    const itemButtons = document.querySelectorAll('.pos-item-btn');

    // Cart Elements
    const cartContainer = document.getElementById('cart-items-container');
    const emptyMsg = document.getElementById('cart-empty-msg');
    const subtotalEl = document.getElementById('pos-subtotal');
    const deliveryRow = document.getElementById('delivery-row');
    const deliveryEl = document.getElementById('pos-delivery');
    const totalEl = document.getElementById('pos-total');
    const cashReceivedInput = document.getElementById('cash-received');
    const cashChangeDisplay = document.getElementById('cash-change-display');
    const clearCartBtn = document.getElementById('btn-clear-cart');
    const quickTestBtn = document.getElementById('btn-quick-test-print');
    const checkoutPrintBtn = document.getElementById('btn-checkout-print');

    // Order Type Elements
    const typeMesaBtn = document.getElementById('type-mesa');
    const typeDomicilioBtn = document.getElementById('type-domicilio');
    const typeLlevarBtn = document.getElementById('type-llevar');
    const formMesa = document.getElementById('form-mesa');
    const formDomicilio = document.getElementById('form-domicilio');
    const tableInput = document.getElementById('table-input');
    const custPhoneInput = document.getElementById('cust-phone');
    const custNameInput = document.getElementById('cust-name');
    const custAddressInput = document.getElementById('cust-address');
    const custNeighborhoodInput = document.getElementById('cust-neighborhood');
    const deliveryFeeInput = document.getElementById('delivery-fee-input');
    const custStatus = document.getElementById('cust-status');

    // Payment Buttons
    const payButtons = document.querySelectorAll('.pay-btn');
    const cashChangeBox = document.getElementById('cash-change-box');

    // 1. FILTERING PRODUCTS
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        // @ts-ignore
        const q = e.target.value.toLowerCase().trim();
        itemButtons.forEach(btn => {
          const name = btn.getAttribute('data-name')?.toLowerCase() || '';
          // @ts-ignore
          btn.style.display = name.includes(q) ? 'flex' : 'none';
        });
      });
    }

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('bg-parrilla-gold', 'text-white', 'shadow-sm', 'active');
          b.classList.add('bg-slate-100', 'text-parrilla-ivory');
        });
        btn.classList.add('bg-parrilla-gold', 'text-white', 'shadow-sm', 'active');
        btn.classList.remove('bg-slate-100', 'text-parrilla-ivory');

        const cat = btn.getAttribute('data-category');
        itemButtons.forEach(card => {
          const cardCat = card.getAttribute('data-cat');
          // @ts-ignore
          card.style.display = (cat === 'all' || cardCat === cat) ? 'flex' : 'none';
        });
      });
    });

    // 2. ADD PRODUCT TO CART
    itemButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const price = Number(btn.getAttribute('data-price'));

        const existing = cart.find(item => item.id === id);
        if (existing) {
          existing.quantity += 1;
        } else {
          cart.push({ id, name, price, quantity: 1, notes: '' });
        }
        renderCart();
      });
    });

    // 3. RENDER CART & TOTALS
    function renderCart() {
      if (!cartContainer) return;

      if (cart.length === 0) {
        cartContainer.innerHTML = '<div class="p-6 text-center text-xs text-parrilla-muted italic">Selecciona productos del catálogo para agregar a la comanda.</div>';
        subtotalEl.textContent = '$0';
        totalEl.textContent = '$0';
        cashChangeDisplay.textContent = '$0';
        return;
      }

      let subtotal = 0;
      cartContainer.innerHTML = cart.map((item, idx) => {
        const itemTotal = item.price * item.quantity;
        subtotal += itemTotal;
        return `
          <div class="p-2.5 flex items-center justify-between gap-2 hover:bg-parrilla-surface/50 rounded-lg">
            <div class="flex-1 min-w-0">
              <div class="font-bold text-xs text-parrilla-ivory truncate">${item.name}</div>
              <div class="text-[11px] text-parrilla-gold">${fmt(item.price)} c/u</div>
            </div>
            
            <!-- Quantity Controls -->
            <div class="flex items-center gap-1.5 bg-parrilla-dark px-2 py-1 rounded-lg border border-parrilla-border">
              <button type="button" class="btn-qty-minus text-parrilla-muted hover:text-red-400 font-bold px-1" data-idx="${idx}">-</button>
              <span class="font-bold text-xs text-parrilla-ivory px-1">${item.quantity}</span>
              <button type="button" class="btn-qty-plus text-parrilla-muted hover:text-parrilla-gold font-bold px-1" data-idx="${idx}">+</button>
            </div>

            <div class="font-bold text-xs text-parrilla-ivory text-right w-16">
              ${fmt(itemTotal)}
            </div>

            <button type="button" class="btn-remove-item text-parrilla-muted hover:text-red-400 p-1" data-idx="${idx}">
              ✕
            </button>
          </div>
        `;
      }).join('');

      // Bind dynamic quantity buttons
      document.querySelectorAll('.btn-qty-minus').forEach(b => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const i = Number(e.currentTarget.getAttribute('data-idx'));
          if (cart[i].quantity > 1) {
            cart[i].quantity -= 1;
          } else {
            cart.splice(i, 1);
          }
          renderCart();
        });
      });

      document.querySelectorAll('.btn-qty-plus').forEach(b => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const i = Number(e.currentTarget.getAttribute('data-idx'));
          cart[i].quantity += 1;
          renderCart();
        });
      });

      document.querySelectorAll('.btn-remove-item').forEach(b => {
        b.addEventListener('click', (e) => {
          // @ts-ignore
          const i = Number(e.currentTarget.getAttribute('data-idx'));
          cart.splice(i, 1);
          renderCart();
        });
      });

      // Calculate Total
      // @ts-ignore
      const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
      const total = subtotal + deliveryFee;

      subtotalEl.textContent = fmt(subtotal);
      if (currentOrderType === 'domicilio') {
        deliveryRow.style.display = 'flex';
        deliveryEl.textContent = fmt(deliveryFee);
      } else {
        deliveryRow.style.display = 'none';
      }
      totalEl.textContent = fmt(total);

      calculateChange(total);
    }

    function calculateChange(total) {
      // @ts-ignore
      const cashVal = Number(cashReceivedInput.value || 0);
      if (cashVal > 0 && currentPaymentMethod === 'efectivo') {
        const diff = cashVal - total;
        cashChangeDisplay.textContent = diff >= 0 ? fmt(diff) : 'Faltan ' + fmt(Math.abs(diff));
        cashChangeDisplay.className = diff >= 0 ? 'font-display font-black text-lg text-parrilla-accent' : 'font-display font-black text-lg text-red-400';
      } else {
        cashChangeDisplay.textContent = '$0';
        cashChangeDisplay.className = 'font-display font-black text-lg text-parrilla-accent';
      }
    }

    if (cashReceivedInput) {
      cashReceivedInput.addEventListener('input', () => {
        const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
        // @ts-ignore
        const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
        calculateChange(subtotal + deliveryFee);
      });
    }

    if (deliveryFeeInput) {
      deliveryFeeInput.addEventListener('input', () => {
        renderCart();
      });
    }

    // 4. ORDER TYPE SWITCHER
    function setOrderType(type) {
      currentOrderType = type;
      [typeMesaBtn, typeDomicilioBtn, typeLlevarBtn].forEach(b => {
        b.className = 'order-type-btn flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-border bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold font-extrabold text-xs transition';
      });

      if (type === 'mesa') {
        typeMesaBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'flex';
        formDomicilio.style.display = 'none';
      } else if (type === 'domicilio') {
        typeDomicilioBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-accent bg-parrilla-accent text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'none';
        formDomicilio.style.display = 'flex';
      } else {
        typeLlevarBtn.className = 'order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-amber-600 bg-amber-600 text-white font-extrabold text-xs shadow-sm transition';
        formMesa.style.display = 'none';
        formDomicilio.style.display = 'none';
      }

      // Update Courier Checkbox in Modal
      const chkCourierWrapper = document.getElementById('chk-courier-wrapper');
      const chkCourier = document.getElementById('chk-print-courier');
      if (chkCourierWrapper && chkCourier) {
        if (type === 'domicilio') {
          chkCourierWrapper.style.display = 'flex';
          // @ts-ignore
          chkCourier.checked = true;
        } else {
          chkCourierWrapper.style.display = 'none';
          // @ts-ignore
          chkCourier.checked = false;
        }
      }

      renderCart();
    }

    typeMesaBtn?.addEventListener('click', () => setOrderType('mesa'));
    typeDomicilioBtn?.addEventListener('click', () => setOrderType('domicilio'));
    typeLlevarBtn?.addEventListener('click', () => setOrderType('para_llevar'));

    // 5. CUSTOMER INSTANT AUTOCOMPLETE VIA PHONE
    let searchTimeout = null;
    if (custPhoneInput) {
      custPhoneInput.addEventListener('input', (e) => {
        // @ts-ignore
        const phone = e.target.value.trim();
        custStatus.textContent = '';
        if (phone.length >= 7) {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(async () => {
            try {
              custStatus.textContent = '🔍';
              const res = await fetch(`/api/customers?phone=${encodeURIComponent(phone)}`);
              const cust = await res.json();
              if (cust && cust.id) {
                // @ts-ignore
                custNameInput.value = cust.name;
                // @ts-ignore
                custAddressInput.value = cust.address;
                // @ts-ignore
                custNeighborhoodInput.value = cust.neighborhood || '';
                custStatus.textContent = '✅ Cliente recurrente (' + cust.order_count + ' pedidos)';
                custStatus.className = 'absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-parrilla-accent font-bold';
              } else {
                custStatus.textContent = '✨ Nuevo';
                custStatus.className = 'absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-amber-400 font-bold';
              }
            } catch (err) {
              custStatus.textContent = '';
            }
          }, 400);
        }
      });
    }

    // 6. PAYMENT METHOD SWITCHER
    payButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        payButtons.forEach(b => {
          b.className = 'pay-btn py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition';
        });
        btn.className = 'pay-btn active py-2 rounded-lg text-xs font-bold bg-parrilla-gold text-white shadow-sm transition';
        currentPaymentMethod = btn.getAttribute('data-method') || 'efectivo';

        if (currentPaymentMethod === 'efectivo') {
          cashChangeBox.style.display = 'flex';
        } else {
          cashChangeBox.style.display = 'none';
        }
        renderCart();
      });
    });

    // 7. CLEAR CART
    clearCartBtn?.addEventListener('click', () => {
      if (confirm('¿Deseas vaciar la comanda actual?')) {
        cart = [];
        // @ts-ignore
        cashReceivedInput.value = '';
        renderCart();
      }
    });

    // 7.1 QUICK TEST PRINT SAT Q22
    quickTestBtn?.addEventListener('click', () => {
      // Add test combo to cart if not present
      const testItem = cart.find(i => i.id === 'test-print-sat');
      if (testItem) {
        testItem.quantity += 1;
      } else {
        cart.push({
          id: 'test-print-sat',
          name: '🔥 Combo Prueba Impresión SAT Q22',
          price: 1000,
          quantity: 1,
          category_id: 'fuertes_165'
        });
      }
      renderCart();
      // If delivery mode is selected, populate test delivery data so validation passes
      if (currentOrderType === 'domicilio') {
        // @ts-ignore
        if (!custPhoneInput.value) custPhoneInput.value = '3183821787';
        // @ts-ignore
        if (!custNameInput.value) custNameInput.value = 'CLIENTE PRUEBA SAT';
        // @ts-ignore
        if (!custAddressInput.value) custAddressInput.value = 'Cra 15 # 45 - 20 Apto 301';
        // @ts-ignore
        if (!custNeighborhoodInput.value) custNeighborhoodInput.value = 'Parrilla Centro';
      }
      // Trigger checkout and print immediately
      checkoutPrintBtn?.click();
    });

    // 8. CHECKOUT & MODAL DE COBRO / PAGO MIXTO
    const modalCobro = document.getElementById('modal-cobro-pos');
    const btnCloseCobro = document.getElementById('btn-close-cobro-modal');
    const btnCancelCobro = document.getElementById('btn-cancel-cobro');
    const btnConfirmPayment = document.getElementById('btn-confirm-payment-print');

    const btnModeSingle = document.getElementById('btn-mode-single');
    const btnModeSplit = document.getElementById('btn-mode-split');
    const viewSingle = document.getElementById('cobro-view-single');
    const viewSplit = document.getElementById('cobro-view-split');

    let cobroPaymentMode = 'single'; // 'single' | 'split'
    let selectedSingleMethod = 'CASH';
    const singleCashCalc = document.getElementById('single-cash-calc');
    const singleCashReceived = document.getElementById('single-cash-received');
    const singleChangeDisplay = document.getElementById('single-change-display');

    const splitMethod1 = document.getElementById('split-method-1');
    const splitAmount1 = document.getElementById('split-amount-1');
    const splitMethod2 = document.getElementById('split-method-2');
    const splitAmount2 = document.getElementById('split-amount-2');
    const splitSumDisplay = document.getElementById('split-sum-display');
    const splitStatusDisplay = document.getElementById('split-status-display');
    const splitBalanceBox = document.getElementById('split-balance-box');

    // Switch between Single and Split payment modes
    btnModeSingle?.addEventListener('click', () => {
      cobroPaymentMode = 'single';
      btnModeSingle.className = 'py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory shadow-sm transition';
      btnModeSplit.className = 'py-2 rounded-lg text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory transition';
      viewSingle.classList.remove('hidden');
      viewSplit.classList.add('hidden');
    });

    btnModeSplit?.addEventListener('click', () => {
      cobroPaymentMode = 'split';
      btnModeSplit.className = 'py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory shadow-sm transition';
      btnModeSingle.className = 'py-2 rounded-lg text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory transition';
      viewSplit.classList.remove('hidden');
      viewSingle.classList.add('hidden');

      // Pre-fill split amounts if empty
      const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
      // @ts-ignore
      const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
      const total = subtotal + deliveryFee;
      // @ts-ignore
      if (!splitAmount1.value && !splitAmount2.value) {
        // @ts-ignore
        splitAmount1.value = Math.round(total / 2);
        // @ts-ignore
        splitAmount2.value = total - Math.round(total / 2);
      }
      updateSplitBalance(total);
    });

    // Single payment method selector buttons
    document.querySelectorAll('.single-pay-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.single-pay-btn').forEach(b => {
          b.className = 'single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1';
        });
        btn.className = 'single-pay-btn active py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-xs flex flex-col items-center gap-1 shadow-sm';
        selectedSingleMethod = btn.getAttribute('data-method') || 'CASH';

        if (selectedSingleMethod === 'CASH') {
          singleCashCalc.classList.remove('hidden');
        } else {
          singleCashCalc.classList.add('hidden');
        }
      });
    });

    // Single cash change calculation
    singleCashReceived?.addEventListener('input', () => {
      const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
      // @ts-ignore
      const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
      const total = subtotal + deliveryFee;
      // @ts-ignore
      const paid = Number(singleCashReceived.value || 0);
      const diff = paid - total;
      if (paid > 0) {
        singleChangeDisplay.textContent = diff >= 0 ? fmt(diff) : 'Faltan ' + fmt(Math.abs(diff));
        singleChangeDisplay.className = diff >= 0 ? 'font-display font-black text-xl text-emerald-600 font-mono block' : 'font-display font-black text-xl text-red-600 font-mono block';
      } else {
        singleChangeDisplay.textContent = '$0';
        singleChangeDisplay.className = 'font-display font-black text-xl text-emerald-600 font-mono block';
      }
    });

    // Split balance calculation
    function updateSplitBalance(total) {
      // @ts-ignore
      const a1 = Number(splitAmount1.value || 0);
      // @ts-ignore
      const a2 = Number(splitAmount2.value || 0);
      const sum = a1 + a2;
      splitSumDisplay.textContent = fmt(sum);

      if (sum >= total) {
        splitStatusDisplay.textContent = '✅ Cubre el total ($' + fmt(sum) + ')';
        splitStatusDisplay.className = 'font-bold text-emerald-600';
        splitBalanceBox.className = 'p-3 rounded-xl border border-emerald-300 bg-emerald-50 flex items-center justify-between text-xs';
      } else {
        const missing = total - sum;
        splitStatusDisplay.textContent = `❌ Faltan ${fmt(missing)}`;
        splitStatusDisplay.className = 'font-bold text-red-600';
        splitBalanceBox.className = 'p-3 rounded-xl border border-red-300 bg-red-50 flex items-center justify-between text-xs';
      }
    }

    [splitAmount1, splitAmount2].forEach(input => {
      input?.addEventListener('input', () => {
        const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
        // @ts-ignore
        const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
        updateSplitBalance(subtotal + deliveryFee);
      });
    });

    const closeCobroModal = () => {
      modalCobro.classList.add('hidden');
      modalCobro.classList.remove('flex');
    };
    btnCloseCobro?.addEventListener('click', closeCobroModal);
    btnCancelCobro?.addEventListener('click', closeCobroModal);

    // Open Cobro Modal
    checkoutPrintBtn?.addEventListener('click', () => {
      if (cart.length === 0) {
        alert('Por favor agrega al menos un plato a la comanda.');
        return;
      }

      if (currentOrderType === 'domicilio') {
        // @ts-ignore
        if (!custPhoneInput.value.trim() || !custNameInput.value.trim() || !custAddressInput.value.trim()) {
          alert('Para domicilios es obligatorio indicar Teléfono, Nombre y Dirección.');
          return;
        }
      }

      const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
      // @ts-ignore
      const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
      const total = subtotal + deliveryFee;

      // Populate modal values
      document.getElementById('modal-cobro-subtotal').textContent = fmt(subtotal);
      const deliveryRowModal = document.getElementById('modal-cobro-delivery-row');
      if (currentOrderType === 'domicilio') {
        deliveryRowModal.style.display = 'flex';
        document.getElementById('modal-cobro-delivery').textContent = fmt(deliveryFee);
      } else {
        deliveryRowModal.style.display = 'none';
      }
      document.getElementById('modal-cobro-total').textContent = fmt(total);

      // Subtitle
      const titleInfo = currentOrderType === 'mesa' 
        // @ts-ignore
        ? `${tableInput.value || 'Mesa'} • ${cart.length} plato(s)`
        // @ts-ignore
        : (currentOrderType === 'domicilio' ? `Domicilio para ${custNameInput.value.trim()}` : 'Para Llevar');
      document.getElementById('modal-order-subtitle').textContent = titleInfo;

      // Set initial single cash input if pre-typed
      // @ts-ignore
      if (cashReceivedInput.value) {
        // @ts-ignore
        singleCashReceived.value = cashReceivedInput.value;
      }

      modalCobro.classList.remove('hidden');
      modalCobro.classList.add('flex');
    });

    // CONFIRMAR PAGO (POST /api/pedidos/{id}/pagar) E IMPRIMIR SAT Q22
    btnConfirmPayment?.addEventListener('click', async () => {
      const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
      // @ts-ignore
      const deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0;
      const total = subtotal + deliveryFee;

      let paymentsPayload = [];
      let cashGiven = 0;

      if (cobroPaymentMode === 'single') {
        // @ts-ignore
        const paidCash = Number(singleCashReceived.value || 0);
        const change = (selectedSingleMethod === 'CASH' && paidCash > total) ? (paidCash - total) : 0;
        cashGiven = paidCash;

        paymentsPayload = [{
          method: selectedSingleMethod,
          amount: total,
          change_given: change
        }];
      } else {
        // Split mode
        // @ts-ignore
        const m1 = splitMethod1.value;
        // @ts-ignore
        const a1 = Number(splitAmount1.value || 0);
        // @ts-ignore
        const m2 = splitMethod2.value;
        // @ts-ignore
        const a2 = Number(splitAmount2.value || 0);

        if ((a1 + a2) < total) {
          alert(`El total de los pagos divididos ($${fmt(a1 + a2)}) no cubre el total del pedido ($${fmt(total)}).`);
          return;
        }

        paymentsPayload = [
          { method: m1, amount: a1, change_given: 0 },
          { method: m2, amount: a2, change_given: 0 }
        ];
      }

      btnConfirmPayment.disabled = true;
      btnConfirmPayment.innerHTML = '<span>Procesando pago y comanda...</span>';

      try {
        // 1. Guardar el pedido
        const orderPayload = {
          orderData: {
            orderType: currentOrderType,
            // @ts-ignore
            tableNumber: currentOrderType === 'mesa' ? tableInput.value : '',
            // @ts-ignore
            customerPhone: currentOrderType === 'domicilio' ? custPhoneInput.value.trim() : '',
            // @ts-ignore
            customerName: currentOrderType === 'domicilio' ? custNameInput.value.trim() : (tableInput.value || 'Cliente'),
            // @ts-ignore
            deliveryAddress: currentOrderType === 'domicilio' ? custAddressInput.value.trim() : '',
            // @ts-ignore
            deliveryNeighborhood: currentOrderType === 'domicilio' ? custNeighborhoodInput.value.trim() : '',
            subtotal,
            deliveryFee,
            total,
            paymentMethod: cobroPaymentMode === 'single' ? selectedSingleMethod.toLowerCase() : 'mixto',
            paymentChangeFor: cashGiven,
            status: 'completado'
          },
          items: cart
        };

        const response = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(orderPayload)
        });

        const resData = await response.json();
        if (!response.ok || !resData.success) {
          throw new Error(resData.error || 'Error al registrar pedido');
        }

        const savedOrder = resData.order;

        // 2. Registrar el pago en la caja activa del backend FastAPI (/api/pedidos/{id}/pagar)
        try {
          await fetch(`/api/pedidos/${savedOrder.id}/pagar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ payments: paymentsPayload })
          });
        } catch (e) {
          console.warn('Nota: Pago registrado localmente en comanda.');
        }

        // 3. Imprimir comanda en SAT Q22
        const ticket = {
          id: savedOrder.id,
          createdAt: new Date().toISOString(),
          orderType: currentOrderType,
          // @ts-ignore
          table: currentOrderType === 'mesa' ? (tableInput.value || 'Mesa') : '',
          customerName: orderPayload.orderData.customerName,
          customerPhone: orderPayload.orderData.customerPhone,
          address: orderPayload.orderData.deliveryAddress,
          neighborhood: orderPayload.orderData.deliveryNeighborhood,
          items: cart.map(({ name, price, quantity, notes }) => ({ name, price, quantity, notes: notes || '' })),
          subtotal,
          deliveryFee,
          total,
          paymentMethod: cobroPaymentMode === 'single' ? selectedSingleMethod : 'MIXTO',
          cashPaid: cashGiven
        };

        saveLastTicket(ticket);
        closeCobroModal();
        cart = [];
        // @ts-ignore
        cashReceivedInput.value = '';
        renderCart();

        // Leer opciones de tickets a imprimir marcadas por el cajero
        // @ts-ignore
        const wantCustomer = document.getElementById('chk-print-customer')?.checked ?? true;
        // @ts-ignore
        const wantKitchen = document.getElementById('chk-print-kitchen')?.checked ?? true;
        // @ts-ignore
        const wantCourier = (currentOrderType === 'domicilio') && (document.getElementById('chk-print-courier')?.checked ?? true);

        // Armar cola de impresión
        const printQueue = [];
        if (wantKitchen) printQueue.push('kitchen');
        if (wantCourier) printQueue.push('courier');
        if (wantCustomer) printQueue.push('customer');

        if (printQueue.length === 0) {
          printQueue.push('customer');
        }

        // Ejecutar impresión secuencial para impresora térmica
        (async () => {
          for (let i = 0; i < printQueue.length; i++) {
            printTicketType(ticket, printQueue[i]);
            if (i < printQueue.length - 1) {
              await new Promise(r => setTimeout(r, 650));
            }
          }
        })();

      } catch (err) {
        alert('Ocurrió un error al cobrar: ' + err.message);
      } finally {
        btnConfirmPayment.disabled = false;
        btnConfirmPayment.innerHTML = '<i data-lucide="printer" class="w-4 h-4"></i><span>Confirmar Pago y Generar Comanda</span>';
        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      }
    });

    // 9. COMANDA DIRECTA DE COCINA DESDE EL CARRITO
    document.getElementById('btn-print-kitchen-cart')?.addEventListener('click', () => {
      if (cart.length === 0) {
        alert('Por favor agrega al menos un plato a la comanda para imprimir la orden de cocina.');
        return;
      }

      const tempTicket = {
        id: 'COCINA-' + new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' }),
        createdAt: new Date().toISOString(),
        orderType: currentOrderType,
        // @ts-ignore
        table: currentOrderType === 'mesa' ? (tableInput.value || 'Mesa 1') : '',
        // @ts-ignore
        customerName: currentOrderType === 'domicilio' ? custNameInput.value.trim() : '',
        // @ts-ignore
        customerPhone: currentOrderType === 'domicilio' ? custPhoneInput.value.trim() : '',
        items: cart.map(({ name, price, quantity, notes }) => ({ name, price, quantity, notes: notes || '' })),
        subtotal: cart.reduce((acc, it) => acc + (it.price * it.quantity), 0),
        // @ts-ignore
        deliveryFee: currentOrderType === 'domicilio' ? Number(deliveryFeeInput.value || 0) : 0,
        total: 0,
        paymentMethod: 'PENDIENTE'
      };

      printTicketType(tempTicket, 'kitchen');
    });

    // 10. MODAL RÁPIDO DE GASTO DE CAJA MENOR DESDE POS
    const modalExpensePos = document.getElementById('modal-add-expense-pos');
    const openExpensePosModal = () => {
      // @ts-ignore
      document.getElementById('expense-pos-amount').value = '';
      // @ts-ignore
      document.getElementById('expense-pos-description').value = '';
      // @ts-ignore
      document.getElementById('expense-pos-category').value = 'OTROS';
      modalExpensePos?.classList.remove('hidden');
      modalExpensePos?.classList.add('flex');
      // @ts-ignore
      document.getElementById('expense-pos-amount')?.focus();
    };

    const closeExpensePosModal = () => {
      modalExpensePos?.classList.add('hidden');
      modalExpensePos?.classList.remove('flex');
    };

    document.getElementById('btn-quick-expense-pos')?.addEventListener('click', openExpensePosModal);
    document.getElementById('btn-expense-pos-close')?.addEventListener('click', closeExpensePosModal);
    document.getElementById('btn-expense-pos-cancel')?.addEventListener('click', closeExpensePosModal);

    document.getElementById('form-add-expense-pos')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      // @ts-ignore
      const amount = Number(document.getElementById('expense-pos-amount').value || 0);
      // @ts-ignore
      const description = document.getElementById('expense-pos-description').value.trim();
      // @ts-ignore
      const category = document.getElementById('expense-pos-category').value;

      if (!amount || amount <= 0) {
        alert('Ingresa un monto en efectivo válido mayor a 0');
        return;
      }
      if (!description) {
        alert('Ingresa una descripción del gasto (ej. verduras, agua)');
        return;
      }

      const btn = document.getElementById('btn-submit-expense-pos');
      btn.disabled = true;
      btn.innerHTML = 'Guardando...';

      try {
        const res = await fetch('/api/caja/expenses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, description, category })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.detail || data.error || 'Error al registrar gasto');

        alert(`✅ Gasto de ${fmt(amount)} registrado exitosamente en la caja activa.`);
        closeExpensePosModal();
      } catch (err) {
        alert('Error al registrar gasto: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i data-lucide="check" class="w-4 h-4"></i><span>Registrar Salida</span>';
        // @ts-ignore
        if (window.lucide) window.lucide.createIcons();
      }
    });

    // 11. CHECK FOR PENDING WHATSAPP DRAFTS
    async function checkPendingDrafts() {
      try {
        const res = await fetch('/api/pedidos/?estado=BORRADOR_WEB&limit=20');
        if (res.ok) {
          const drafts = await res.json();
          const count = (drafts && Array.isArray(drafts)) ? drafts.length : 0;
          const alertEl = document.getElementById('pos-drafts-alert');
          const countEl = document.getElementById('pos-drafts-count');
          if (alertEl && countEl) {
            if (count > 0) {
              countEl.textContent = count;
              alertEl.classList.remove('hidden');
              alertEl.classList.add('flex');
            } else {
              alertEl.classList.add('hidden');
              alertEl.classList.remove('flex');
            }
          }
        }
      } catch (e) {}
    }
    checkPendingDrafts();
    setInterval(checkPendingDrafts, 15000);

    // ==============================================================
    //  LOS 3 FORMATOS DE IMPRESIÓN TÉRMICA 80MM (POS-80C / SAT Q22)
    //  1. Comanda de Cocina (printKitchenTicket)
    //  2. Ticket Mensajero (printCourierTicket)
    //  3. Cuenta Cliente (printCustomerReceipt)
    // ==============================================================
    const LAST_TICKET_KEY = 'sp_last_ticket';

    function saveLastTicket(ticket) {
      try {
        localStorage.setItem(LAST_TICKET_KEY, JSON.stringify(ticket));
      } catch (e) {}
      refreshReprintButton();
    }

    function loadLastTicket() {
      try {
        return JSON.parse(localStorage.getItem(LAST_TICKET_KEY) || 'null');
      } catch (e) {
        return null;
      }
    }

    function refreshReprintButton() {
      const last = loadLastTicket();
      const reprintBar = document.getElementById('reprint-bar');
      const reprintLabel = document.getElementById('reprint-order-label');
      const btnCourier = document.getElementById('btn-reprint-courier');
      if (!reprintBar || !last) return;

      const codeStr = (last.id && (last.id.toString().startsWith('#') || last.id.toString().startsWith('SP-'))) ? last.id : '#' + (last.id || '001');
      if (reprintLabel) reprintLabel.textContent = `Último Pedido (${codeStr})`;

      // Mostrar botón de mensajero solo si fue domicilio
      if (btnCourier) {
        btnCourier.style.display = last.orderType === 'domicilio' ? 'flex' : 'none';
      }

      reprintBar.classList.remove('hidden');
    }

    // 1. FORMATO: COMANDA DE COCINA (SIN PRECIOS, LETRA GRANDE, NOTAS RESALTADAS)
    function renderKitchenTicketHTML(t) {
      const timeStr = new Date(t.createdAt || Date.now()).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
      const dateStr = new Date(t.createdAt || Date.now()).toLocaleDateString('es-CO');
      const codeStr = (t.id && (t.id.toString().startsWith('#') || t.id.toString().startsWith('SP-'))) ? t.id : '#' + (t.id || '001');

      let ubicacionStr = 'MESA 1';
      if (t.orderType === 'mesa') {
        ubicacionStr = `UBICACIÓN: ${t.table || 'MESA'}`.toUpperCase();
      } else if (t.orderType === 'domicilio') {
        ubicacionStr = `🛵 DOMICILIO ${t.customerName ? '- ' + t.customerName : ''}`.toUpperCase();
      } else {
        ubicacionStr = '📦 PARA LLEVAR'.toUpperCase();
      }

      const itemsHtml = (t.items || []).map(it => {
        let notesHtml = '';
        if (it.notes) {
          const parts = it.notes.split('|').map(s => s.trim()).filter(Boolean);
          notesHtml = parts.map(p => `
            <div style="font-size: 10pt; font-weight: bold; margin-top: 1mm; padding-left: 2mm;">
              └ ${p}
            </div>
          `).join('');
        }

        return `
          <div style="border-bottom: 1.5px dashed #000; padding: 2.5mm 0; break-inside: avoid;">
            <div style="display: flex; align-items: flex-start; gap: 2.5mm;">
              <span style="font-size: 17pt; font-weight: 900; line-height: 1; min-width: 48px; border: 1.5px solid #000; text-align: center; padding: 1mm 0;">
                ${it.quantity}X
              </span>
              <div style="flex: 1;">
                <div style="font-size: 13pt; font-weight: 900; text-transform: uppercase; line-height: 1.2;">
                  ${it.name}
                </div>
                ${notesHtml}
              </div>
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="ticket-header" style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 2mm; margin-bottom: 2.5mm;">
          <div style="display: inline-block; border: 2.5px solid #000; padding: 1.5mm 4mm; font-size: 14pt; font-weight: 900; letter-spacing: 0.5px; margin-bottom: 1.5mm;">
            🍳 COMANDA DE COCINA
          </div>
          <div style="font-size: 14pt; font-weight: 900; margin: 1mm 0; text-transform: uppercase;">
            ${ubicacionStr}
          </div>
          <div style="font-size: 9.5pt; font-family: monospace; margin-top: 1mm;">
            <span>Orden: <strong>${codeStr}</strong></span> | <span>Hora: <strong>${timeStr}</strong></span>
          </div>
        </div>

        <div style="margin: 2mm 0;">
          ${itemsHtml}
        </div>

        <div class="ticket-footer" style="text-align: center; border-top: 2px dashed #000; padding-top: 2mm; margin-top: 4mm; font-size: 9pt; font-weight: bold;">
          *** PREPARAR CON AGILIDAD Y SAZÓN ***
        </div>
      `;
    }

    // 2. FORMATO: TICKET MENSAJERO / DOMICILIO (TELÉFONO GIGANTE, DIRECCIÓN, COBRO/NO COBRAR)
    function renderCourierTicketHTML(t) {
      const timeStr = new Date(t.createdAt || Date.now()).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
      const codeStr = (t.id && (t.id.toString().startsWith('#') || t.id.toString().startsWith('SP-'))) ? t.id : '#' + (t.id || '001');

      const isCash = (t.paymentMethod === 'efectivo' || t.paymentMethod === 'CASH');
      const hasChange = isCash && t.cashPaid > t.total;

      const itemsSummary = (t.items || []).map(it => `
        <div style="font-size: 10pt; padding: 0.5mm 0;">
          • <strong>${it.quantity}x</strong> ${it.name}
        </div>
      `).join('');

      return `
        <div class="ticket-header" style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 2mm; margin-bottom: 2mm;">
          <h1 class="restaurant-name" style="font-size: 16pt; font-weight: 900; margin: 0;">SAN PARRILLA</h1>
          <div style="display: inline-block; border: 2px solid #000; padding: 1mm 3mm; font-size: 12pt; font-weight: 900; margin: 1.5mm 0;">
            🛵 GUÍA DOMICILIO / MENSAJERO
          </div>
          <div style="font-size: 9pt; font-family: monospace;">
            <span>Pedido: <strong>${codeStr}</strong></span> | <span>Hora: <strong>${timeStr}</strong></span>
          </div>
        </div>

        <!-- DATOS DEL CLIENTE EN GRANDE -->
        <div class="delivery-banner" style="border: 2px solid #000; padding: 2.5mm; margin: 2mm 0; background: #fff;">
          <div style="font-size: 9pt; font-weight: bold; text-transform: uppercase;">CLIENTE:</div>
          <div style="font-size: 14pt; font-weight: 900; text-transform: uppercase; margin-bottom: 2mm;">
            ${t.customerName || 'Cliente Domicilio'}
          </div>

          <div style="font-size: 9pt; font-weight: bold; text-transform: uppercase;">TELÉFONO (LLAMAR):</div>
          <div class="delivery-phone" style="font-size: 17pt; font-weight: 900; font-family: monospace; letter-spacing: 0.5px; margin-bottom: 2mm;">
            📞 ${t.customerPhone || 'Sin teléfono'}
          </div>

          <div style="font-size: 9pt; font-weight: bold; text-transform: uppercase;">DIRECCIÓN DE ENTREGA:</div>
          <div class="delivery-address" style="font-size: 13pt; font-weight: 900; line-height: 1.25;">
            📍 ${t.address || 'Sin dirección registrada'}
          </div>
          ${t.neighborhood ? `<div style="font-size: 10.5pt; font-weight: bold; font-style: italic; margin-top: 1mm;">Ref: ${t.neighborhood}</div>` : ''}
        </div>

        <!-- FLETE DEL MENSAJERO -->
        <div style="display: flex; justify-content: space-between; font-size: 11pt; font-weight: bold; border-bottom: 1.5px dashed #000; padding: 1.5mm 0; margin: 2mm 0;">
          <span>CARRERA / FLETE MENSAJERO:</span>
          <span style="font-size: 13pt; font-weight: 900;">${fmt(t.deliveryFee)}</span>
        </div>

        <!-- RESUMEN DEL PAQUETE -->
        <div style="margin: 2.5mm 0; border-bottom: 1.5px dashed #000; padding-bottom: 2mm;">
          <div style="font-size: 9.5pt; font-weight: bold; text-transform: uppercase; margin-bottom: 1mm;">
            CONTENIDO DEL PAQUETE (${(t.items || []).reduce((a, b) => a + b.quantity, 0)} platos):
          </div>
          ${itemsSummary}
        </div>

        <!-- INSTRUCCIÓN DE COBRO EN CUADRO GIGANTE -->
        ${isCash ? `
          <div style="border: 3px solid #000; padding: 2.5mm; margin: 3mm 0; text-align: center; background: #fff;">
            <div style="font-size: 12pt; font-weight: 900; text-transform: uppercase; border-bottom: 1.5px solid #000; padding-bottom: 1mm; margin-bottom: 1.5mm;">
              ⚠️ COBRAR AL CLIENTE EN EFECTIVO
            </div>
            <div style="font-size: 19pt; font-weight: 900; margin: 1.5mm 0;">
              TOTAL: ${fmt(t.total)}
            </div>
            ${hasChange ? `
              <div style="border-top: 1.5px dashed #000; padding-top: 1.5mm; margin-top: 1.5mm; font-size: 11pt; font-weight: 900;">
                Cliente paga con: ${fmt(t.cashPaid)}<br/>
                <span style="font-size: 13pt;">👉 LLEVAR VUELTAS: ${fmt(t.cashPaid - t.total)}</span>
              </div>
            ` : `
              <div style="font-size: 9.5pt; font-weight: bold; margin-top: 1mm;">
                (Cobrar valor exacto en efectivo)
              </div>
            `}
          </div>
        ` : `
          <div style="border: 3px solid #000; padding: 3mm 2mm; margin: 3mm 0; text-align: center; background: #fff;">
            <div style="font-size: 12.5pt; font-weight: 900; text-transform: uppercase; margin-bottom: 1mm;">
              ✅ PEDIDO YA PAGADO POR TRANSFERENCIA
            </div>
            <div style="font-size: 16pt; font-weight: 900; border-top: 2px solid #000; padding-top: 1.5mm; margin-top: 1.5mm;">
              🚫 NO COBRAR AL CLIENTE
            </div>
            <div style="font-size: 9pt; margin-top: 1mm; font-weight: bold;">
              (Pago confirmado vía ${t.paymentMethod})
            </div>
          </div>
        `}

        <div class="ticket-footer" style="text-align: center; border-top: 1px dashed #000; padding-top: 2mm; margin-top: 3mm; font-size: 8pt;">
          San Parrilla Domicilios • Teléfono: 318 382 1787
        </div>
      `;
    }

    // 3. FORMATO: CUENTA DEL CLIENTE (RECIBO COMERCIAL COMPLETO)
    function renderCustomerReceiptHTML(t, isCopy = false) {
      const timeStr = new Date(t.createdAt || Date.now()).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
      const dateStr = new Date(t.createdAt || Date.now()).toLocaleDateString('es-CO');
      const codeStr = (t.id && (t.id.toString().startsWith('#') || t.id.toString().startsWith('SP-'))) ? t.id : '#' + (t.id || '001');

      const isDelivery = t.orderType === 'domicilio';
      const badgeText = isDelivery ? 'DOMICILIO' : (t.orderType === 'mesa' ? ('CUENTA ' + (t.table || 'MESA 1')) : 'PARA LLEVAR');

      const itemsRows = (t.items || []).map(it => {
        let noteHtml = '';
        if (it.notes) {
          const parts = it.notes.split('|').map(s => s.trim()).filter(Boolean);
          noteHtml = parts.map(p => `<div style="font-size: 8.5pt; font-style: italic; margin-top: 0.5mm;">└ ${p}</div>`).join('');
        }

        return `
          <tr style="border-bottom: 1px solid #ddd; break-inside: avoid;">
            <td style="padding: 1.5mm 0; font-size: 11pt; font-weight: 900; vertical-align: top;">${it.quantity}</td>
            <td style="padding: 1.5mm 1mm; vertical-align: top;">
              <div style="font-weight: bold;">${it.name}</div>
              ${noteHtml}
            </td>
            <td style="padding: 1.5mm 0; text-align: right; font-weight: bold; white-space: nowrap; vertical-align: top;">
              ${fmt(it.price * it.quantity)}
            </td>
          </tr>
        `;
      }).join('');

      const isCash = (t.paymentMethod === 'efectivo' || t.paymentMethod === 'CASH');
      const showChange = isCash && t.cashPaid > 0;

      return `
        <div class="ticket-header" style="text-align: center; border-bottom: 1.5px dashed #000; padding-bottom: 2mm; margin-bottom: 2mm;">
          <h1 class="restaurant-name" style="font-size: 16pt; font-weight: 900; margin: 0;">SAN PARRILLA</h1>
          <p style="margin: 1mm 0; font-size: 9.5pt;">Fogón, Carbón & Sazón Casero</p>
          <p style="margin: 0; font-size: 9pt;">Tel / WhatsApp: 318 382 1787</p>
          <div class="ticket-badge" style="display: inline-block; border: 2px solid #000; padding: 1mm 3mm; font-size: 11pt; font-weight: bold; margin: 2mm 0;">
            ${badgeText} ${isCopy ? '- COPIA' : ''}
          </div>
          <div style="font-size: 8.5pt; font-family: monospace;">
            <span>Factura / Pedido: <strong>${codeStr}</strong></span> | <span>Fecha: <strong>${dateStr} ${timeStr}</strong></span>
          </div>
          ${isDelivery ? `
            <div style="font-size: 9pt; margin-top: 1.5mm; text-align: left; border: 1px solid #000; padding: 1.5mm;">
              <strong>Cliente:</strong> ${t.customerName || 'Cliente'}<br/>
              <strong>Tel:</strong> ${t.customerPhone || 'Sin teléfono'}<br/>
              <strong>Dirección:</strong> ${t.address || ''} ${t.neighborhood ? '(' + t.neighborhood + ')' : ''}
            </div>
          ` : ''}
        </div>

        <table class="items-table" style="width: 100%; border-collapse: collapse; margin: 2mm 0; font-size: 9.5pt;">
          <thead>
            <tr>
              <th style="width: 15%; border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 1.5mm 0; text-align: left; font-size: 9pt;">CANT</th>
              <th style="width: 55%; border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 1.5mm 1mm; text-align: left; font-size: 9pt;">DESCRIPCIÓN</th>
              <th style="width: 30%; border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 1.5mm 0; text-align: right; font-size: 9pt;">TOTAL</th>
            </tr>
          </thead>
          <tbody>
            ${itemsRows}
          </tbody>
        </table>

        <div class="totals-box" style="border-top: 1.5px dashed #000; padding-top: 2mm; margin-top: 2mm;">
          <div class="total-row" style="display: flex; justify-content: space-between; font-size: 10.5pt; margin-bottom: 1mm;">
            <span>Subtotal:</span>
            <span>${fmt(t.subtotal)}</span>
          </div>
          ${t.deliveryFee ? `
            <div class="total-row" style="display: flex; justify-content: space-between; font-size: 10.5pt; margin-bottom: 1mm;">
              <span>Envío Domicilio:</span>
              <span>${fmt(t.deliveryFee)}</span>
            </div>
          ` : ''}
          <div class="total-row grand-total" style="display: flex; justify-content: space-between; font-size: 14pt; font-weight: 900; border-top: 1.5px solid #000; border-bottom: 2px solid #000; padding: 1.5mm 0; margin: 2mm 0;">
            <span>TOTAL A COBRAR:</span>
            <span>${fmt(t.total)}</span>
          </div>
          <div class="total-row" style="display: flex; justify-content: space-between; font-size: 10.5pt; font-weight: bold; margin-top: 1mm;">
            <span>FORMA DE PAGO:</span>
            <span style="text-transform: uppercase;">${t.paymentMethod}</span>
          </div>
        </div>

        ${showChange ? `
          <div class="change-box" style="border: 1.5px solid #000; padding: 2mm; margin-top: 2mm; font-size: 10.5pt;">
            <div class="total-row" style="display: flex; justify-content: space-between;">
              <span>Cliente paga con:</span>
              <strong>${fmt(t.cashPaid)}</strong>
            </div>
            <div class="total-row" style="display: flex; justify-content: space-between; font-size: 12pt; font-weight: 900; margin-top: 1mm;">
              <span>CAMBIO / VUELTAS:</span>
              <strong>${fmt(Math.max(0, t.cashPaid - t.total))}</strong>
            </div>
          </div>
        ` : ''}

        <div class="ticket-footer" style="text-align: center; border-top: 1px dashed #000; margin-top: 4mm; padding-top: 2mm; font-size: 8.5pt;">
          <p style="margin: 0; font-weight: bold;">¡MUCHAS GRACIAS POR SU COMPRA!</p>
          <p style="margin: 1mm 0 0 0; font-size: 8pt;">Software San Parrilla POS</p>
        </div>
      `;
    }

    // DISPARADOR DE IMPRESIÓN POR TIPO
    function printTicketType(ticket, type = 'customer', isCopy = false) {
      const printable = document.getElementById('printable-ticket');
      if (!printable) return;

      // Ocultar modales en DOM antes de imprimir
      closeCobroModal();
      closeExpensePosModal();

      let html = '';
      if (type === 'kitchen') {
        html = renderKitchenTicketHTML(ticket);
      } else if (type === 'courier') {
        html = renderCourierTicketHTML(ticket);
      } else {
        html = renderCustomerReceiptHTML(ticket, isCopy);
      }

      printable.innerHTML = html;
      printable.classList.remove('hidden');

      setTimeout(() => {
        window.print();
        setTimeout(() => {
          printable.classList.add('hidden');
        }, 1000);
      }, 80);
    }

    // BOTONES DE REIMPRESIÓN EN BARRA INFERIOR
    document.getElementById('btn-reprint-customer')?.addEventListener('click', () => {
      const last = loadLastTicket();
      if (last) printTicketType(last, 'customer', true);
    });

    document.getElementById('btn-reprint-kitchen')?.addEventListener('click', () => {
      const last = loadLastTicket();
      if (last) printTicketType(last, 'kitchen', true);
    });

    document.getElementById('btn-reprint-courier')?.addEventListener('click', () => {
      const last = loadLastTicket();
      if (last) printTicketType(last, 'courier', true);
    });

    refreshReprintButton();
  </script>
</StaffLayout>
