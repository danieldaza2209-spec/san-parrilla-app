---
export const prerender = true;
import StaffLayout from '../layouts/StaffLayout.astro';
import QuickOrderView from '../components/QuickOrderView.astro';
import {
  getCategories,
  getProducts,
  getPublicProducts,
  getDailySpecials,
  getActiveCashRegister,
  fallbackCategories,
  fallbackDailySpecials,
  initialProductList,
  rapidasCategories,
  rapidasProductList,
  conveniosProductList,
  CORPORATE_CUSTOMERS,
} from '../lib/db.js';

const rawCategories = getCategories();
const categories = (rawCategories && rawCategories.length > 0) ? rawCategories : fallbackCategories;

const rawProducts = getProducts(true);
const products = (rawProducts && rawProducts.length > 0) ? rawProducts : initialProductList;
const publicProducts = getPublicProducts();
const dailySpecials = getDailySpecials() || fallbackDailySpecials;
const customizableCategories = new Set(['especiales_hoy', 'fuertes_165', 'fuertes_175', 'especiales_21']);

const rapidasProducts = publicProducts.filter((p) => p.id.startsWith('rap-') || p.menu_type === 'rapidas');
const lunchProducts = publicProducts.filter((p) => !p.id.startsWith('rap-') && p.menu_type !== 'rapidas');

const rapidasCatCards = [
  { id: 'hamburguesas', title: 'Hamburguesas', icon: '🍔' },
  { id: 'perros_calientes', title: 'Perros Calientes', icon: '🌭' },
  { id: 'salchipapas_papas_locas', title: 'Salchipapas y Papas Locas', icon: '🍟' },
  { id: 'patacones', title: 'Patacones', icon: '🫓' },
  { id: 'sandwich', title: 'Sándwich', icon: '🥪' },
  { id: 'picadas_noche', title: 'Picadas Noche', icon: '🥩' },
  { id: 'especiales_noche', title: 'Especiales Noche', icon: '🔥' },
  { id: 'granizados_jugos', title: 'Granizados y Jugos', icon: '🥤' },
  { id: 'bebidas_rapidas', title: 'Bebidas', icon: '🧊' },
];

const CLINICA_DIETAS_TARGET = [
  { shortName: 'Dieta Normal', isHipo: false },
  { shortName: 'Dieta Hiposódica', isHipo: true },
  { shortName: 'Dieta Hipoglúcida', isHipo: true },
  { shortName: 'Dieta Hiposódica e Hipoglúcida', isHipo: true },
  { shortName: 'Dieta Líquida', isHipo: false },
  { shortName: 'Dieta Hiperproteica', isHipo: false },
  { shortName: 'Dieta Blanda', isHipo: false },
];

console.log(">>> POS PRODUCTS IN ASTRO BUILD:", publicProducts.length, "Categories:", categories.length);
const activeCash = getActiveCashRegister();

// Format Colombian Peso
const formatPrice = (val) => {
  return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
};

// Serialize catalog for instant client-side universal search (including Convenios & Clínica)
const allPosProducts = [...publicProducts, ...conveniosProductList];
const searchableCatalog = allPosProducts.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.price,
  category_id: p.category_id,
  menu_type: p.menu_type || (p.id.startsWith('rap-') ? 'rapidas' : p.id.startsWith('conv-') ? 'convenios' : 'almuerzo'),
  description: p.description || '',
  special_badge: p.special_badge || '',
  customizable: customizableCategories.has(p.category_id),
}));
---

<StaffLayout title="POS Punto de Venta | San Parrilla">
  <div class="max-w-[1600px] mx-auto px-2 sm:px-4 py-4 flex-1 flex flex-col no-print">

    <!-- Notificación Toast Silenciosa: Pedido Enviado a Cocina / Impresora SAT Q22 -->
    <div id="pos-toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 hidden transition-all duration-300 transform -translate-y-3 opacity-0 pointer-events-none">
      <div class="px-5 py-3 rounded-2xl bg-slate-900 text-white border-2 border-emerald-400 shadow-2xl flex items-center gap-3">
        <span class="text-2xl animate-pulse">🖨️</span>
        <div>
          <div id="pos-toast-title" class="font-display font-black text-sm text-white">✅ Pedido enviado a cocina e impresora</div>
          <div id="pos-toast-desc" class="text-[11px] text-emerald-300 font-bold">Impresión automática silenciosa en SAT Q22</div>
        </div>
      </div>
    </div>

    <!-- Top Alert if Cash Register is closed -->
    {!activeCash && (
      <div class="mb-4 bg-amber-500/20 border border-amber-500/50 text-amber-300 p-3.5 rounded-xl flex items-center justify-between">
        <div class="flex items-center gap-3">
          <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-400"></i>
          <span class="text-sm font-semibold">Atención: No hay una caja abierta actualmente. Las ventas se registrarán sin cuadre de turno.</span>
        </div>
        <a href="/caja" class="bg-amber-500 hover:bg-amber-400 text-parrilla-dark font-bold text-xs px-3 py-1.5 rounded-lg transition">
          Abrir Caja Ahora
        </a>
      </div>
    )}

    <!-- Top Alert: Pending WhatsApp Drafts -->
    <div id="pos-drafts-alert" class="hidden mb-4 bg-emerald-50 border border-emerald-300 text-emerald-800 p-3.5 rounded-xl items-center justify-between shadow-sm">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-sm font-bold">
          📱 Tienes <span id="pos-drafts-count" class="underline">0</span> pedidos web de WhatsApp pendientes de aprobación.
        </span>
      </div>
      <a href="/caja" class="bg-emerald-600 hover:bg-emerald-700 text-white font-display font-extrabold text-xs px-3.5 py-1.5 rounded-lg transition shadow-sm flex items-center gap-1.5">
        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
        <span>Ir a Bandeja de Borradores</span>
      </a>
    </div>

    <!-- Main POS Grid: Left Catalog, Right Order Cart -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1 items-start">
      
      <!-- LEFT SECTION: BUSCADOR UNIVERSAL POS + CATÁLOGO MENÚ RÁPIDO (7 cols) -->
      <div
        class="lg:col-span-7 flex flex-col gap-4"
        id="pos-catalog-root"
        data-catalog={JSON.stringify(searchableCatalog)}
        data-specials={JSON.stringify(dailySpecials)}
      >
        <!-- SELECTOR PRINCIPAL DE MENÚ: ALMUERZOS VS COMIDAS RÁPIDAS VS CONVENIOS & CLÍNICA -->
        <div id="pos-menu-tabs-wrapper" class="grid grid-cols-2 md:grid-cols-3 gap-1.5 sm:gap-2 bg-slate-100 p-1.5 rounded-2xl border border-parrilla-border shadow-xs">
          <button
            type="button"
            id="tab-menu-almuerzos"
            class="menu-mode-tab active py-2.5 sm:py-3 px-2 sm:px-3 rounded-xl text-xs sm:text-sm font-display font-black flex items-center justify-center gap-1 bg-parrilla-gold text-white shadow-sm transition-all cursor-pointer"
          >
            <span>☀️ Almuerzos</span>
          </button>
          <button
            type="button"
            id="tab-menu-rapidas"
            class="menu-mode-tab py-2.5 sm:py-3 px-2 sm:px-3 rounded-xl text-xs sm:text-sm font-display font-black flex items-center justify-center gap-1 text-parrilla-ivory hover:text-parrilla-gold transition-all cursor-pointer"
          >
            <span>🍔 Rápidas</span>
          </button>
          <button
            type="button"
            id="tab-menu-convenios"
            class="menu-mode-tab hidden py-2.5 sm:py-3 px-2 sm:px-3 rounded-xl text-xs sm:text-sm font-display font-black flex items-center justify-center gap-1 text-parrilla-ivory hover:text-parrilla-gold transition-all cursor-pointer"
            style="display: none;"
          >
            <span>🏥 Convenios & Clínica</span>
          </button>
        </div>

        <!-- Validación inmediata de rol para evitar FOUC (Flash of Unstyled Content) -->
        <script is:inline>
          (function() {
            try {
              var r = (
                (typeof window !== 'undefined' && window.__SP_STAFF_ROLE__) ||
                localStorage.getItem('user_role') ||
                (JSON.parse(localStorage.getItem('sp_staff_session') || '{}').role) ||
                localStorage.getItem('sanparrilla_last_role') ||
                ''
              ).toLowerCase().trim();
              var isAllowed = r === 'admin' || r === 'administrador' || r === 'cajero';
              var tab = document.getElementById('tab-menu-convenios');
              var wrapper = document.getElementById('pos-menu-tabs-wrapper');
              if (isAllowed) {
                if (tab) {
                  tab.classList.remove('hidden');
                  tab.style.display = '';
                }
                if (wrapper) {
                  wrapper.classList.remove('grid-cols-2');
                  wrapper.classList.add('grid-cols-3');
                }
              } else {
                if (tab) {
                  tab.classList.add('hidden');
                  tab.style.display = 'none';
                }
                if (wrapper) {
                  wrapper.classList.remove('grid-cols-3');
                  wrapper.classList.add('grid-cols-2');
                }
              }
            } catch (e) {}
          })();
        </script>

        <!-- 1. PARTE SUPERIOR: BUSCADOR UNIVERSAL PROTAGONISTA & FILTROS RÁPIDOS -->
        <div id="pos-universal-search-container" class="bg-white rounded-2xl p-4 sm:p-5 border-2 border-parrilla-gold/60 shadow-md space-y-3.5 sticky top-16 z-30">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-parrilla-gold flex items-center gap-1.5">
              <i data-lucide="zap" class="w-3.5 h-3.5"></i>
              <span>Buscador Universal de Platos & Precios</span>
            </span>
            <span class="hidden sm:inline-flex items-center gap-1 text-[11px] text-parrilla-muted font-medium">
              Presiona <kbd class="px-1.5 py-0.5 text-[10px] font-mono font-bold bg-slate-100 border border-parrilla-border rounded">/</kbd> o <kbd class="px-1.5 py-0.5 text-[10px] font-mono font-bold bg-slate-100 border border-parrilla-border rounded">F2</kbd> para buscar al instante
            </span>
          </div>

          <div class="relative w-full">
            <input 
              type="text" 
              id="product-search" 
              placeholder="🔍 Buscar plato rápido... (ej: pechuga, bistec, mojarra, 16500)" 
              autocomplete="off"
              class="w-full pl-4 pr-24 py-3.5 bg-slate-50 hover:bg-white focus:bg-white rounded-xl border-2 border-parrilla-border focus:border-parrilla-gold text-base sm:text-lg font-bold text-parrilla-ivory placeholder-parrilla-muted focus:outline-none focus:ring-4 focus:ring-orange-500/15 transition shadow-inner"
            />
            <div class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
              <button 
                type="button" 
                id="btn-clear-search" 
                class="hidden px-2.5 py-1.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 text-xs font-extrabold transition cursor-pointer"
                title="Limpiar búsqueda (Esc)"
              >
                ✕ Limpiar
              </button>
            </div>
          </div>

          <!-- Filtros Rápidos Almuerzos -->
          <div id="pos-filters-almuerzo" class="flex items-center gap-1.5 overflow-x-auto w-full no-scrollbar pb-0.5">
            <button type="button" class="pos-cat-btn active px-3.5 py-2 rounded-xl text-xs font-extrabold bg-parrilla-gold text-white shadow-xs transition whitespace-nowrap cursor-pointer" data-filter-query="">
              ⚡ Todo Almuerzos
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="pechuga">
              🍗 Pechugas
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="carne">
              🥩 Carnes / Bistec
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="cerdo">
              🐖 Cerdo / Chuleta
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="mojarra">
              🐟 Mojarra / Bagre / Róbalo
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="picada">
              🔥 Picadas
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="bebida">
              🥤 Bebidas
            </button>
          </div>

          <!-- Filtros Rápidos Comidas Rápidas -->
          <div id="pos-filters-rapidas" class="hidden flex items-center gap-1.5 overflow-x-auto w-full no-scrollbar pb-0.5">
            <button type="button" class="pos-cat-btn active px-3.5 py-2 rounded-xl text-xs font-extrabold bg-parrilla-gold text-white shadow-xs transition whitespace-nowrap cursor-pointer" data-filter-query="">
              ⚡ Todo Rápidas
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="hamburguesa">
              🍔 Hamburguesas
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="perro">
              🌭 Perros
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="salchipapa|papas locas">
              🍟 Salchipapas / Papas Locas
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="patacón|patacon">
              🫓 Patacones
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="sándwich|sandwich">
              🥪 Sándwich
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="picada|bandeja san parrilla|alitas|costillitas">
              🥩 Picadas & Especiales
            </button>
            <button type="button" class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition whitespace-nowrap cursor-pointer" data-filter-query="jugo|granizado|limonada|agua|soda|gaseosa|cerveza">
              🥤 Jugos & Bebidas
            </button>
          </div>
        </div>

        <!-- 2. PANEL DE RESULTADOS INSTANTÁNEOS DEL BUSCADOR (Oculto cuando el buscador está vacío) -->
        <div id="pos-search-results-panel" class="hidden bg-white rounded-2xl border-2 border-parrilla-gold/50 p-4 sm:p-5 shadow-lg space-y-4">
          <div class="flex items-center justify-between border-b border-parrilla-border pb-3">
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-parrilla-gold block">Resultados Instantáneos</span>
              <h3 id="search-results-title" class="font-display font-black text-lg sm:text-xl text-parrilla-ivory">
                Coincidencias encontradas
              </h3>
            </div>
            <button
              type="button"
              id="btn-back-full-menu"
              class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-bold text-parrilla-ivory transition cursor-pointer"
            >
              Ver Menú Completo
            </button>
          </div>

          <div id="pos-search-results-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <!-- Inyectado dinámicamente al escribir en el buscador -->
          </div>
        </div>

        <!-- 3. CUERPO DEL CATÁLOGO ALMUERZOS: ESTRUCTURA VISUAL EXACTA DEL MENÚ RÁPIDO (index.astro) -->
        <div id="pos-quick-menu-wrapper">
          <QuickOrderView
            products={lunchProducts}
            dailySpecials={dailySpecials}
            customizableCategories={customizableCategories}
          />
        </div>

        <!-- 4. CUERPO DEL CATÁLOGO COMIDAS RÁPIDAS (TURNO NOCHE) -->
        <div id="pos-rapidas-menu-wrapper" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 items-start">
          {rapidasCatCards.map((cat) => {
            const catItems = rapidasProducts.filter((p) => p.category_id === cat.id);
            if (catItems.length === 0) return null;
            return (
              <div class="rapidas-cat-card bg-white rounded-xl sm:rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-3 sm:p-4 shadow-sm flex flex-col" data-cat={cat.id}>
                <div class="text-center border-b border-parrilla-border pb-2 mb-2">
                  <span class="font-display font-black text-sm sm:text-base text-parrilla-gold tracking-tight flex items-center justify-center gap-1.5 uppercase">
                    <span>{cat.icon}</span>
                    <span>{cat.title}</span>
                  </span>
                </div>
                <ul class="divide-y divide-gray-100">
                  {catItems.map((item) => (
                    <li class="flex items-center justify-between gap-2 py-2">
                      <span class="text-xs sm:text-sm font-semibold text-parrilla-ivory leading-tight min-w-0 flex-1">
                        {item.name}
                      </span>
                      <div class="flex items-center gap-2 flex-shrink-0">
                        <span class="font-display font-black text-xs sm:text-sm text-parrilla-gold font-mono">
                          {formatPrice(item.price)}
                        </span>
                        <button
                          type="button"
                          data-id={item.id}
                          data-name={item.name}
                          data-price={item.price}
                          data-cat={item.category_id}
                          data-menu="rapidas"
                          data-customizable="false"
                          aria-label={`Agregar ${item.name}`}
                          class="btn-add-cart w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer font-bold text-sm"
                        >
                          +
                        </button>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>

        <!-- 5. CUERPO DEL CATÁLOGO CONVENIOS INSTITUCIONALES Y DIETAS HOSPITALARIAS (CLÍNICA PRIMERO DE MAYO) -->
        <div id="pos-convenios-menu-wrapper" class="hidden space-y-4">
          <!-- 1. Tarjeta Institucional Fija Activa: Clínica Primero de Mayo (Pacientes) -->
          <div class="bg-gradient-to-r from-blue-50 via-indigo-50 to-emerald-50 rounded-2xl border-2 border-indigo-400 p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="text-3xl sm:text-4xl">🏥</span>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-[10px] font-black uppercase tracking-widest text-indigo-700 bg-indigo-100 px-2.5 py-0.5 rounded-full">Convenio Activo</span>
                  <span class="text-[10px] font-mono font-bold text-indigo-900 bg-white px-2 py-0.5 rounded border border-indigo-300">CONV-CLINICA-PAC</span>
                </div>
                <h3 class="font-display font-black text-lg sm:text-xl text-slate-900 mt-0.5">Clínica Primero de Mayo (Pacientes)</h3>
                <p class="text-xs text-slate-600">Área de Hospitalización · Raciones Clínicas y Dietas Hospitalarias por Pabellón</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-600 text-white font-extrabold text-xs shadow-xs">
                <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                <span>Cliente Vinculado (Fiado Institucional)</span>
              </span>
            </div>
          </div>

          <!-- 2. Menú Hospitalario: Raciones y Dietas Clínicas (Desayuno, Almuerzo y Cena) -->
          <div class="bg-white rounded-2xl border-2 border-emerald-400 p-4 sm:p-5 shadow-sm space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
              <div>
                <span class="text-[10px] font-black uppercase tracking-widest text-emerald-700 block">🏥 Menú Hospitalario Exclusivo</span>
                <h3 class="font-display font-black text-base sm:text-lg text-parrilla-ivory">2. Raciones y Dietas Clínicas (Desayuno, Almuerzo y Cena)</h3>
              </div>
              <span class="text-[11px] font-extrabold bg-sky-50 text-sky-800 border border-sky-200 px-2.5 py-1 rounded-lg">
                💧 Regla Hipo Activa: Dietas Hiposódicas/Hipoglúcidas incluyen Botella con Agua ($0)
              </span>
            </div>

            <!-- Selector Activo de Pabellón / Ubicación para Raciones Hospitalarias -->
            <div class="flex flex-wrap items-center justify-between gap-2 bg-emerald-50/90 border border-emerald-300 rounded-xl p-3">
              <div class="flex items-center gap-2">
                <span class="text-lg">🏢</span>
                <div>
                  <span class="block text-xs font-black uppercase tracking-wider text-emerald-950">Pabellón / Sector Activo:</span>
                  <span class="block text-[11px] text-emerald-700">Las raciones que agregues con (+1, +5, +10) se registrarán en esta torre</span>
                </div>
              </div>
              <div class="flex items-center gap-2" id="hospital-active-loc-bar">
                <button
                  type="button"
                  data-loc="Torre A"
                  class="btn-hosp-loc-tab px-4 py-2 rounded-xl text-xs font-black transition cursor-pointer bg-emerald-700 text-white shadow-xs"
                >
                  🏢 Torre A
                </button>
                <button
                  type="button"
                  data-loc="Torre B"
                  class="btn-hosp-loc-tab px-4 py-2 rounded-xl text-xs font-black transition cursor-pointer bg-white text-emerald-900 border border-emerald-300 hover:bg-emerald-100"
                >
                  🏢 Torre B
                </button>
                <button
                  type="button"
                  data-loc="Urgencias"
                  class="btn-hosp-loc-tab px-4 py-2 rounded-xl text-xs font-black transition cursor-pointer bg-white text-emerald-900 border border-emerald-300 hover:bg-emerald-100"
                >
                  🚨 Urgencias
                </button>
              </div>
            </div>

