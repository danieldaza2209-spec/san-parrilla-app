          if (isFixed) {
            // Plato con receta fija (Bandeja Paisa, Pescados/Cazuelas, Arroces, Creps):
            // MOSTRAR ÚNICAMENTE Sopa, Empaque (si es para llevar/domicilio) y Notas
            inlineControls = `
