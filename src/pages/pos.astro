    <!-- Contenido inyectado dinámicamente según el formato solicitado -->
  </div>

  <!-- ==============================================================
       CLIENT-SIDE JAVASCRIPT FOR POS OPERATION & INSTANT PRINT
       ============================================================== -->
  <script>
    // State
    let cart = [];
    let currentOrderType = 'mesa';
    let currentPaymentMethod = 'efectivo';
    let selectedSingleMethod = 'CASH';
    let activeMenuMode = 'almuerzos'; // 'almuerzos' | 'rapidas' | 'convenios'
    let currentActiveHospitalLocation = 'Torre A';

    const methodFrontToBackMap = {
      efectivo: 'CASH',
      nequi: 'NEQUI',
      bancolombia: 'BANCOLOMBIA',
      daviplata: 'DAVIPLATA',
      tarjeta: 'CARD',
      fiado: 'FIADO'
    };

    // Format COP Currency
    const fmt = (val) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
    const escapeHtml = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Elements
    const catalogRoot = document.getElementById('pos-catalog-root');
    const catalogData = JSON.parse(catalogRoot?.dataset.catalog || '[]');
    const dailySpecialsData = JSON.parse(catalogRoot?.dataset.specials || '{"sopa":"Campesina","principios":[],"acompanamientos":[]}');

    // Menu Mode Tabs & Wrappers
    const tabMenuAlmuerzos = document.getElementById('tab-menu-almuerzos');
    const tabMenuRapidas = document.getElementById('tab-menu-rapidas');
    const tabMenuConvenios = document.getElementById('tab-menu-convenios');
    const posFiltersAlmuerzo = document.getElementById('pos-filters-almuerzo');
    const posFiltersRapidas = document.getElementById('pos-filters-rapidas');
    const quickMenuWrapper = document.getElementById('pos-quick-menu-wrapper');
    const rapidasMenuWrapper = document.getElementById('pos-rapidas-menu-wrapper');
    const conveniosMenuWrapper = document.getElementById('pos-convenios-menu-wrapper');
    const clinicaDomiciliosCountInput = document.getElementById('clinica-domicilios-count');
    const clinicaDomicilioUnitFeeInput = document.getElementById('clinica-domicilio-unit-fee');
    const clinicaDomiciliosBadge = document.getElementById('clinica-domicilios-badge');
    const btnCloseFiadoDirect = document.getElementById('btn-close-fiado-direct');

    // Control de Permisos por Rol: Administrador, Cajero vs Mesero
    function getCurrentUserRole() {
      try {
        if (typeof window !== 'undefined' && window.__SP_STAFF_ROLE__) {
          return String(window.__SP_STAFF_ROLE__).trim().toLowerCase();
        }
        const directRole = localStorage.getItem('user_role');
        if (directRole) return directRole.trim().toLowerCase();

        const sessionRaw = localStorage.getItem('sp_staff_session');
        if (sessionRaw) {
          const parsed = JSON.parse(sessionRaw);
          if (parsed && parsed.role) return String(parsed.role).trim().toLowerCase();
        }

        const lastRole = localStorage.getItem('sanparrilla_last_role');
        if (lastRole) return lastRole.trim().toLowerCase();

        const cookieMatch = document.cookie.match(/(?:^|;\s*)sp_role=([^;]+)/);
        if (cookieMatch) return decodeURIComponent(cookieMatch[1]).trim().toLowerCase();
      } catch (e) {
        console.error('Error detectando rol de usuario:', e);
      }
      return 'mesero';
    }

    function canAccessConvenios() {
      const r = getCurrentUserRole();
      return r === 'admin' || r === 'administrador' || r === 'cajero';
    }

    function enforceRoleConveniosPermissions() {
      const isAllowed = canAccessConvenios();
      const tab = document.getElementById('tab-menu-convenios');
      const wrapper = document.getElementById('pos-menu-tabs-wrapper');

      if (isAllowed) {
        if (tab) {
          tab.classList.remove('hidden');
          tab.style.display = '';
        }
        if (wrapper) {
          wrapper.classList.remove('grid-cols-2');
          wrapper.classList.add('grid-cols-3');
        }
      } else {
        if (tab) {
          tab.classList.add('hidden');
          tab.style.display = 'none';
        }
        if (wrapper) {
          wrapper.classList.remove('grid-cols-3');
          wrapper.classList.add('grid-cols-2');
        }
        // Si el usuario tenía seleccionada esa pestaña por error o recarga la página, fuerza el cambio automático a Almuerzos
        if (activeMenuMode === 'convenios') {
          setMenuMode('almuerzos');
        }

        const expBtn = document.getElementById('btn-quick-expense-pos');
        if (expBtn) expBtn.style.display = 'none';
        document.querySelectorAll('a[href="/caja"]').forEach((a) => {
          // @ts-ignore
          a.style.display = 'none';
        });
      }
    }

    enforceRoleConveniosPermissions();

    const searchInput = document.getElementById('product-search');
    const btnClearSearch = document.getElementById('btn-clear-search');
    const btnBackFullMenu = document.getElementById('btn-back-full-menu');
    const searchResultsPanel = document.getElementById('pos-search-results-panel');
    const searchResultsGrid = document.getElementById('pos-search-results-grid');
    const searchResultsTitle = document.getElementById('search-results-title');

    // Cart Elements
    const cartContainer = document.getElementById('cart-items-container');
    const emptyMsg = document.getElementById('cart-empty-msg');
    const subtotalEl = document.getElementById('pos-subtotal');
    const deliveryRow = document.getElementById('delivery-row');
    const deliveryEl = document.getElementById('pos-delivery');
    const totalEl = document.getElementById('pos-total');
    const cashReceivedInput = document.getElementById('cash-received');
    const cashChangeDisplay = document.getElementById('cash-change-display');
    const clearCartBtn = document.getElementById('btn-clear-cart');
    const quickTestBtn = document.getElementById('btn-quick-test-print');
    const checkoutPrintBtn = document.getElementById('btn-checkout-print');

    // Order Type Elements
    const typeMesaBtn = document.getElementById('type-mesa');
    const typeDomicilioBtn = document.getElementById('type-domicilio');
    const typeLlevarBtn = document.getElementById('type-llevar');
    const formMesa = document.getElementById('form-mesa');
    const formDomicilio = document.getElementById('form-domicilio');
    const tableInput = document.getElementById('table-input');
    const custPhoneInput = document.getElementById('cust-phone');
    const custNameInput = document.getElementById('cust-name');
    const custAddressInput = document.getElementById('cust-address');
    const custNeighborhoodInput = document.getElementById('cust-neighborhood');
    const deliveryFeeInput = document.getElementById('delivery-fee-input');
    const custStatus = document.getElementById('cust-status');

    // Payment Buttons
    const payButtons = document.querySelectorAll('.pay-btn');
    const cashChangeBox = document.getElementById('cash-change-box');

    // Flavors for Jugos & Granizados
    const JUICE_FLAVORS = ['Uva', 'Lulo', 'Fresa', 'Limón', 'Mango', 'Naranja', 'Maracuyá', 'Tamarindo', 'Guanábana', 'Mandarina'];

    // Normalize helper for accent-insensitive search
    const normalizeStr = (str) =>
      String(str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();

    function isJuiceProduct(name, category_id) {
      const normCat = String(category_id || '').toLowerCase();
      const normName = normalizeStr(name);
      if (normCat === 'granizados_jugos') return true;
      if (normName.includes('jugo') || normName.includes('granizado') || normName.includes('limonada cerezada')) return true;
      return false;
    }

    function isDrinkProduct(name, category_id) {
      const normCat = String(category_id || '').toLowerCase();
      const normName = normalizeStr(name);
      if (normCat === 'bebidas' || normCat === 'bebidas_rapidas') return true;
      if (/gaseosa|agua|soda|cerveza|hit|coca|postobon|speed|red bull|pilsen|aguila|club colombia/i.test(normName)) return true;
      return false;
    }

    function isRapidasFoodProduct(item) {
      const isRap = item.menu_type === 'rapidas' ||
        String(item.id || '').startsWith('rap-') ||
        ['hamburguesas', 'perros_calientes', 'salchipapas_papas_locas', 'patacones', 'sandwich', 'picadas_noche', 'especiales_noche'].includes(item.category_id);
      if (!isRap) return false;
      return !isJuiceProduct(item.name, item.category_id) && !isDrinkProduct(item.name, item.category_id);
    }

    function isHospitalDietProduct(item) {
      if (!item) return false;
      const normCat = String(item.category_id || '').toLowerCase();
      const normName = normalizeStr(item.name || '');
      if (normName.includes('botella con agua')) return false;

      if (normCat === 'convenios_clinica') {
        if (normName.includes('desayuno') || normName.includes('almuerzo') || normName.includes('cena') || normName.includes('dieta')) {
          return true;
        }
      }
      if (String(item.id || '').startsWith('conv-des-') || String(item.id || '').startsWith('conv-alm-') || String(item.id || '').startsWith('conv-cen-')) {
        return true;
      }
      if (normName.includes('clinica') && (normName.includes('desayuno') || normName.includes('almuerzo') || normName.includes('cena') || normName.includes('dieta'))) {
        return true;
      }
      return false;
    }

    function getHospitalDietTag(dishName, location) {
      const loc = String(location || 'Torre A').toUpperCase();
      let clean = String(dishName || '')
        .replace(/Clínica\s*-\s*/gi, '')
        .replace(/Dieta\s+/gi, '')
        .trim()
        .toUpperCase();
      return `[${clean} - ${loc}]`;
    }

    function formatHospitalDietShortName(dishName) {
      let clean = String(dishName || '')
        .replace(/Clínica\s*-\s*/gi, '')
        .replace(/Dieta\s+/gi, '')
        .trim();
      return clean;
    }

    // Platos con Guarnición Fija por receta (Bandeja Paisa, Pescados/Cazuelas, Arroces, Creps)
    function isFixedGarnishDish(name) {
      if (!name) return false;
      const n = normalizeStr(name);
      const fixed = [
        'bandeja paisa',
        'creps de pollo',
        'crep de pollo',
        'crepe de pollo',
        'crepes de pollo',
        'arroz con pollo',
        'arroz campesino',
        'arroz mixto',
        'arroz paisa',
        'arroz ranchero',
        'espagueti con pollo',
        'spaghetti con pollo',
        'bagre frito',
        'bagre sudado',
        'bagre al ajillo',
        'robalo apanado',
        'robalo al ajillo',
        'mojarra',
        'mini cazuela',
        'cazuela de mariscos',
        'cazuela'
      ];
      return fixed.some((f) => n.includes(f));
    }

    function showPosToast(title, desc = 'Impresión automática silenciosa en SAT Q22') {
      const toast = document.getElementById('pos-toast');
      const tTitle = document.getElementById('pos-toast-title');
      const tDesc = document.getElementById('pos-toast-desc');
      if (!toast) return;
      if (tTitle) tTitle.textContent = title;
      if (tDesc) tDesc.textContent = desc;
      toast.classList.remove('hidden', '-translate-y-3', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('-translate-y-3', 'opacity-0');
        setTimeout(() => toast.classList.add('hidden'), 350);
      }, 4000);
    }

    // VINCULAR AUTOMÁTICAMENTE CLIENTE INSTITUCIONAL CLÍNICA PRIMERO DE MAYO (PACIENTES)
    function linkClinicaPrimeroDeMayoPacientes() {
      // 1. Establecer tipo de pedido en Domicilio
      setOrderType('domicilio');

      // 2. Activar método de pago FIADO de forma segura y directa
      currentPaymentMethod = 'fiado';
      selectedSingleMethod = 'FIADO';
      payButtons?.forEach((b) => {
        const isFiado = b.getAttribute('data-method') === 'fiado';
        b.className = isFiado
          ? 'pay-btn active py-2 px-1 rounded-lg text-[11px] font-bold bg-parrilla-gold text-white shadow-sm transition cursor-pointer'
          : 'pay-btn py-2 px-1 rounded-lg text-[11px] font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition cursor-pointer';
      });
      document.querySelectorAll('.single-pay-btn').forEach((b) => {
        const isMatch = b.getAttribute('data-method') === 'FIADO';
        b.className = isMatch
          ? 'single-pay-btn active py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-xs flex flex-col items-center gap-1 shadow-sm cursor-pointer'
          : 'single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1 cursor-pointer';
      });
      if (cashChangeBox) cashChangeBox.style.display = 'none';
      if (singleCashCalc) singleCashCalc.classList.add('hidden');
      updateCustomerFormVisibility();
      updateModalFiadoBoxVisibility();

      // 3. Vincular datos institucionales del cliente CONV-CLINICA-PAC
      applySelectedCustomer({
        id: 9001,
        nombre: 'Clínica Primero de Mayo (Pacientes)',
        telefono: 'CONV-CLINICA-PAC',
        direccion: 'Clínica Primero de Mayo - Área Hospitalización',
        barrio: 'Convenio Institucional Pacientes',
        notes: 'Dietas hospitalarias + Domicilios por turno',
        es_institucional: true
      });

      // 4. Si la cantidad de domicilios está en 0, sugerir 1 domicilio por defecto
      if (clinicaDomiciliosCountInput) {
        // @ts-ignore
        if (Number(clinicaDomiciliosCountInput.value || 0) === 0) {
          // @ts-ignore
          clinicaDomiciliosCountInput.value = '1';
        }
        syncClinicaDomiciliosBadge();
      }

      showToast('🏥 Clínica Primero de Mayo', 'Vinculado a CONV-CLINICA-PAC (Domicilio · Fiado)');
    }

    // MENU MODE SWITCHER (ALMUERZOS VS COMIDAS RÁPIDAS VS CONVENIOS & CLÍNICA)
    function setMenuMode(mode) {
      if (mode === 'convenios' && !canAccessConvenios()) {
        console.warn('Acceso denegado a Convenios & Clínica: el rol actual no tiene permisos.');
        mode = 'almuerzos';
      }
      activeMenuMode = mode;

      [tabMenuAlmuerzos, tabMenuRapidas, tabMenuConvenios].forEach((tab) => {
        if (!tab) return;
        tab.classList.remove('bg-parrilla-gold', 'text-white', 'shadow-sm', 'active');
        tab.classList.add('text-parrilla-ivory', 'hover:text-parrilla-gold');
      });

      const activeTab = mode === 'rapidas' ? tabMenuRapidas : mode === 'convenios' ? tabMenuConvenios : tabMenuAlmuerzos;
      activeTab?.classList.add('bg-parrilla-gold', 'text-white', 'shadow-sm', 'active');
      activeTab?.classList.remove('text-parrilla-ivory', 'hover:text-parrilla-gold');

      const universalSearchContainer = document.getElementById('pos-universal-search-container');

      if (mode === 'convenios') {
        // OCULTAR por completo el menú ordinario del restaurante (sopas, principios, carnes)
        quickMenuWrapper?.classList.add('hidden');
        rapidasMenuWrapper?.classList.add('hidden');
        // MOSTRAR ÚNICAMENTE el catálogo de dietas hospitalarias
        conveniosMenuWrapper?.classList.remove('hidden');
        // Ocultar buscador universal y filtros de almuerzo/rápidas
        universalSearchContainer?.classList.add('hidden');
        posFiltersAlmuerzo?.classList.add('hidden');
        posFiltersRapidas?.classList.add('hidden');
        try {
          linkClinicaPrimeroDeMayoPacientes();
        } catch (e) {
          console.error('Error linking clinica customer:', e);
        }
      } else if (mode === 'rapidas') {
        quickMenuWrapper?.classList.add('hidden');
        rapidasMenuWrapper?.classList.remove('hidden');
        conveniosMenuWrapper?.classList.add('hidden');
        universalSearchContainer?.classList.remove('hidden');
        posFiltersAlmuerzo?.classList.add('hidden');
        posFiltersRapidas?.classList.remove('hidden');
        if (searchInput) {
          // @ts-ignore
          searchInput.placeholder = '🔍 Buscar comida rápida... (ej: hamburguesa, perro, salchipapa, jugo)';
        }
      } else {
        quickMenuWrapper?.classList.remove('hidden');
        rapidasMenuWrapper?.classList.add('hidden');
        conveniosMenuWrapper?.classList.add('hidden');
        universalSearchContainer?.classList.remove('hidden');
        posFiltersRapidas?.classList.add('hidden');
        posFiltersAlmuerzo?.classList.remove('hidden');
        if (searchInput) {
          // @ts-ignore
          searchInput.placeholder = '🔍 Buscar plato rápido... (ej: pechuga, bistec, mojarra, 16500)';
        }
      }

      resetUniversalSearch();
      updateCustomerFormVisibility();
    }

    tabMenuAlmuerzos?.addEventListener('click', () => setMenuMode('almuerzos'));
    tabMenuRapidas?.addEventListener('click', () => setMenuMode('rapidas'));
    tabMenuConvenios?.addEventListener('click', (e) => {
      if (!canAccessConvenios()) {
        e.preventDefault();
        e.stopPropagation();
        alert('⚠️ La sección Convenios & Clínica es de uso exclusivo para Administradores y Cajeros.');
        setMenuMode('almuerzos');
        return;
      }
      setMenuMode('convenios');
    });

    // 1. UNIVERSAL SEARCH ENGINE & QUICK FILTERS
    function runUniversalSearch(rawQuery) {
      const q = normalizeStr(rawQuery);

      if (!q) {
        btnClearSearch?.classList.add('hidden');
        searchResultsPanel?.classList.add('hidden');
        if (activeMenuMode === 'rapidas') {
          quickMenuWrapper?.classList.add('hidden');
          rapidasMenuWrapper?.classList.remove('hidden');
          conveniosMenuWrapper?.classList.add('hidden');
        } else if (activeMenuMode === 'convenios') {
          quickMenuWrapper?.classList.add('hidden');
          rapidasMenuWrapper?.classList.add('hidden');
          conveniosMenuWrapper?.classList.remove('hidden');
        } else {
          quickMenuWrapper?.classList.remove('hidden');
          rapidasMenuWrapper?.classList.add('hidden');
          conveniosMenuWrapper?.classList.add('hidden');
        }
        return;
      }

      btnClearSearch?.classList.remove('hidden');
      quickMenuWrapper?.classList.add('hidden');
      rapidasMenuWrapper?.classList.add('hidden');
      conveniosMenuWrapper?.classList.add('hidden');
      searchResultsPanel?.classList.remove('hidden');

      const subQueries = q.split('|').map((s) => normalizeStr(s)).filter(Boolean);

      // Match by name, price, category, or family aliases respecting active menu tab
      const matches = catalogData.filter((item) => {
        const itemMenu = item.menu_type || (String(item.id).startsWith('rap-') ? 'rapidas' : String(item.id).startsWith('conv-') ? 'convenios' : 'almuerzos');
        if (activeMenuMode === 'rapidas' && itemMenu !== 'rapidas') return false;
        if (activeMenuMode === 'convenios' && itemMenu !== 'convenios') return false;
        if (activeMenuMode === 'almuerzos' && (itemMenu === 'rapidas' || itemMenu === 'convenios')) return false;

        const nameNorm = normalizeStr(item.name);
        const descNorm = normalizeStr(item.description);
        const catNorm = normalizeStr(item.category_id);
        const priceStr = String(item.price);

        return subQueries.some((subQ) => {
          if (subQ === 'mojarra') {
            return (
              nameNorm.includes('mojarra') ||
              nameNorm.includes('bagre') ||
              nameNorm.includes('robalo') ||
              nameNorm.includes('cazuela') ||
              nameNorm.includes('marisco') ||
              nameNorm.includes('camaron')
            );
          }
          if (subQ === 'cerdo') {
            return (
              nameNorm.includes('cerdo') ||
              nameNorm.includes('chuleta') ||
              nameNorm.includes('pernil') ||
              nameNorm.includes('costilla') ||
              nameNorm.includes('lomo')
            );
          }
          if (subQ === 'carne') {
            return (
              nameNorm.includes('carne') ||
              nameNorm.includes('bistec') ||
              nameNorm.includes('churrasco') ||
              nameNorm.includes('sobrebarriga') ||
              nameNorm.includes('higado') ||
              nameNorm.includes('bandeja') ||
              nameNorm.includes('parrilla') ||
              nameNorm.includes('llanera')
            );
          }
          if (subQ === 'bebidas' || subQ === 'bebida') {
            return catNorm === 'bebidas' || catNorm === 'bebidas_rapidas';
          }
          if (subQ === 'picada') {
            return catNorm === 'picadas' || catNorm === 'picadas_noche' || nameNorm.includes('picada');
          }

          return (
            nameNorm.includes(subQ) ||
            priceStr.includes(subQ) ||
            descNorm.includes(subQ) ||
            catNorm.includes(subQ)
          );
        });
      });

      if (searchResultsTitle) {
        searchResultsTitle.textContent = `${matches.length} producto${matches.length === 1 ? '' : 's'} para "${rawQuery.trim()}"`;
      }

      if (!searchResultsGrid) return;

      if (matches.length === 0) {
        searchResultsGrid.innerHTML = `
          <div class="col-span-2 py-8 text-center text-parrilla-muted text-sm">
            No encontramos platos que coincidan con "<strong>${escapeHtml(rawQuery)}</strong>" en el menú actual. Intenta con otra palabra o precio.
          </div>
        `;
        return;
      }

      searchResultsGrid.innerHTML = matches
        .map((item) => {
          const isSoldOut = item.disponible === false || item.in_stock === 0;
          return `
          <div class="flex items-center justify-between gap-2.5 p-3 rounded-xl border border-parrilla-border hover:border-parrilla-gold bg-slate-50/70 hover:bg-orange-50/30 transition shadow-2xs ${isSoldOut ? 'opacity-60' : ''}">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-display font-bold text-sm text-parrilla-ivory leading-tight">
                  ${escapeHtml(item.name)}
                </span>
                ${
                  isSoldOut
                    ? `<span class="bg-red-100 text-red-700 border border-red-300 text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded">Agotado por hoy</span>`
                    : ''
                }
                ${
                  item.special_badge
                    ? `<span class="bg-parrilla-gold text-white text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded">${escapeHtml(item.special_badge)}</span>`
                    : ''
                }
              </div>
              <div class="flex items-center gap-2 mt-1">
                <span class="font-display font-black text-sm text-parrilla-gold">${fmt(item.price)}</span>
                <span class="text-[10px] text-parrilla-muted">• ${item.customizable ? '🥣 Elige sopa y principio' : '⚡ Agregado directo'}</span>
              </div>
            </div>

            <button
              type="button"
              data-id="${item.id}"
              data-name="${escapeHtml(item.name)}"
              data-price="${item.price}"
              data-cat="${item.category_id || ''}"
              data-menu="${item.menu_type || ''}"
              data-customizable="${String(item.customizable)}"
              ${isSoldOut ? 'disabled data-sold-out="true" title="Agotado por hoy"' : ''}
              aria-label="Agregar ${escapeHtml(item.name)}"
              class="btn-add-cart flex-shrink-0 w-9 h-9 rounded-full bg-parrilla-gold hover:bg-parrilla-goldLight text-white flex items-center justify-center shadow-sm transition active:scale-90 cursor-pointer font-black text-base ${isSoldOut ? 'opacity-40 cursor-not-allowed pointer-events-none' : ''}"
            >
              +
            </button>
          </div>
        `;
        })
        .join('');
    }

    searchInput?.addEventListener('input', (e) => {
      // @ts-ignore
      const val = e.target.value;
      const activeContainer = activeMenuMode === 'rapidas' ? posFiltersRapidas : posFiltersAlmuerzo;
      activeContainer?.querySelectorAll('.pos-cat-btn').forEach((b, idx) => {
        const isAll = idx === 0 && !val.trim();
        b.classList.toggle('bg-parrilla-gold', isAll);
        b.classList.toggle('text-white', isAll);
        b.classList.toggle('shadow-xs', isAll);
        b.classList.toggle('active', isAll);
        b.classList.toggle('bg-slate-100', !isAll);
        b.classList.toggle('text-parrilla-ivory', !isAll);
      });
      runUniversalSearch(val);
    });

    const resetUniversalSearch = () => {
      if (searchInput) {
        // @ts-ignore
        searchInput.value = '';
      }
      const activeContainer = activeMenuMode === 'rapidas' ? posFiltersRapidas : posFiltersAlmuerzo;
      activeContainer?.querySelectorAll('.pos-cat-btn').forEach((b, idx) => {
        const isAll = idx === 0;
        b.classList.toggle('bg-parrilla-gold', isAll);
        b.classList.toggle('text-white', isAll);
        b.classList.toggle('shadow-xs', isAll);
        b.classList.toggle('active', isAll);
        b.classList.toggle('bg-slate-100', !isAll);
        b.classList.toggle('text-parrilla-ivory', !isAll);
      });
      runUniversalSearch('');
    };

    btnClearSearch?.addEventListener('click', () => {
      resetUniversalSearch();
      searchInput?.focus();
    });

    btnBackFullMenu?.addEventListener('click', resetUniversalSearch);

    document.querySelectorAll('.pos-cat-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const parentContainer = btn.parentElement;
        parentContainer?.querySelectorAll('.pos-cat-btn').forEach((b) => {
          b.classList.remove('bg-parrilla-gold', 'text-white', 'shadow-xs', 'active');
          b.classList.add('bg-slate-100', 'text-parrilla-ivory');
        });
        btn.classList.add('bg-parrilla-gold', 'text-white', 'shadow-xs', 'active');
        btn.classList.remove('bg-slate-100', 'text-parrilla-ivory');

        const filterQuery = btn.getAttribute('data-filter-query') || '';
        if (searchInput) {
          // @ts-ignore
          searchInput.value = filterQuery;
        }
        runUniversalSearch(filterQuery);
      });
    });

    // Keyboard shortcuts: '/' or 'F2' to focus search, 'Escape' to clear/close modals, Alt+1/Alt+2/Alt+3 para categorías
    document.addEventListener('keydown', (e) => {
      const tag = (e.target && e.target.tagName) ? e.target.tagName.toUpperCase() : '';
      const isTyping = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';

      // Atajos de categoría: Alt+1 (Almuerzos), Alt+2 (Rápidas), Alt+3 (Convenios)
      if (e.altKey && !isTyping) {
        if (e.key === '1') {
          e.preventDefault();
          setMenuMode('almuerzos');
          return;
        } else if (e.key === '2') {
          e.preventDefault();
          setMenuMode('rapidas');
          return;
        } else if (e.key === '3') {
          e.preventDefault();
          if (canAccessConvenios()) {
            setMenuMode('convenios');
          } else {
            console.warn('Atajo Alt+3 bloqueado: El rol mesero no tiene permiso para acceder a Convenios & Clínica');
          }
          return;
        }
      }

      // Bloquear cualquier intento de teclado para alternar a Convenios si no es admin o cajero
      if (!canAccessConvenios()) {
        // @ts-ignore
        if (e.target && (e.target.id === 'tab-menu-convenios' || e.target.closest?.('#tab-menu-convenios'))) {
          e.preventDefault();
          e.stopPropagation();
          setMenuMode('almuerzos');
          return;
        }
      }

      if ((e.key === '/' || e.key === 'F2') && !isTyping) {
        e.preventDefault();
        searchInput?.focus();
        // @ts-ignore
        searchInput?.select();
      } else if (e.key === 'Escape') {
        const garnishModal = document.getElementById('modal-garnish-pos');
        if (garnishModal && !garnishModal.classList.contains('hidden')) {
          closeGarnishModal();
          return;
        }
        // @ts-ignore
        if (searchInput && searchInput.value) {
          resetUniversalSearch();
        }
      }
    });

    // 2. MODAL RÁPIDO DE GUARNICIONES (SOPA, PRINCIPIO, ACOMPAÑAMIENTO, EMPAQUE, NOTAS)
    const modalGarnish = document.getElementById('modal-garnish-pos');
    const garnishDishName = document.getElementById('garnish-dish-name');
    const garnishDishPrice = document.getElementById('garnish-dish-price');
    const garnishQtyVal = document.getElementById('garnish-qty-val');
    const garnishSoupContainer = document.getElementById('garnish-soup-options');
    const garnishPrincipleContainer = document.getElementById('garnish-principle-options');
    const garnishSideContainer = document.getElementById('garnish-side-options');
    const garnishSaladContainer = document.getElementById('garnish-salad-options');
    const garnishPackagingContainer = document.getElementById('garnish-packaging-options');
    const garnishExtraNotes = document.getElementById('garnish-extra-notes');

    // Estado global de Empaques y Edición de Plato (Icopor por defecto)
    let globalPackagingType = 'Icopor'; // 'Icopor' | 'Caja'
    let packagingFeePerUnit = 1000;
    let packagingQty = 0;
    let manualPackagingOverride = false;
    let editingCartUid = null;
    let pendingGarnishItem = null;

    let garnishState = {
      quantity: 1,
      soup: '',
      principle: '',
      side: '',
      salad: 'Con ensalada',
      packaging: 'Icopor'
    };

    function renderOptionPills(container, options, currentVal, onSelect) {
      if (!container) return;
      container.innerHTML = options
        .map((opt) => {
          const active = opt === currentVal;
          return `
            <button
              type="button"
              data-opt="${opt}"
              class="garnish-opt-btn py-2 px-3 rounded-xl border text-xs font-bold text-left transition flex items-center justify-between gap-1.5 cursor-pointer ${
                active
                  ? 'border-parrilla-gold bg-parrilla-gold text-white shadow-xs'
                  : 'border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory'
              }"
            >
              <span class="truncate">${opt}</span>
              ${active ? '<span>✓</span>' : ''}
            </button>
          `;
        })
        .join('');

      container.querySelectorAll('.garnish-opt-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-opt') || '';
          onSelect(val);
          renderOptionPills(container, options, val, onSelect);
        });
      });
    }

    // Cuenta cuántos platos de comida hay en la comanda (excluye bebidas/líquidos)
    function countFoodPlates() {
      return cart.reduce((acc, it) => {
        if (it.isRapidasFood || it.isCustomizable || it.isHospitalDiet) {
          return acc + it.quantity;
        }
        if (it.isJuice || it.isDrink || isJuiceProduct(it.name, it.category_id) || isDrinkProduct(it.name, it.category_id)) {
          return acc;
        }
        return acc + it.quantity;
      }, 0);
    }

    // Calcula Subtotal, Empaques, Domicilio y Total de forma centralizada
    function calculateTotals() {
      const subtotal = cart.reduce((acc, it) => acc + (it.price * it.quantity), 0);
      const isDeliveryOrTakeout = currentOrderType === 'domicilio' || currentOrderType === 'para_llevar';

      if (isDeliveryOrTakeout && !manualPackagingOverride) {
        packagingQty = countFoodPlates();
      } else if (!isDeliveryOrTakeout) {
        packagingQty = 0;
      }

      const packagingFee = isDeliveryOrTakeout ? (packagingQty * packagingFeePerUnit) : 0;
      // @ts-ignore
      const cantDomClinica = Math.max(0, parseInt(clinicaDomiciliosCountInput?.value || '0', 10) || 0);
      // @ts-ignore
      const unitDomClinica = Math.max(0, Number(clinicaDomicilioUnitFeeInput?.value || 3000) || 0);
      // @ts-ignore
      let deliveryFee = currentOrderType === 'domicilio' ? Number(deliveryFeeInput?.value || 0) : 0;
      if (cantDomClinica > 0) {
        deliveryFee = cantDomClinica * unitDomClinica;
      }
      const total = subtotal + packagingFee + deliveryFee;

      return { subtotal, packagingFee, deliveryFee, total, isDeliveryOrTakeout, cantDomClinica };
    }

    // Arma el string de notas y guarniciones de un plato
    function buildPlateNotes(item) {
      if (item.isCustomizable) {
        const isFixed = isFixedGarnishDish(item.name);
        const soupDefault = dailySpecialsData.sopa ? `Con Sopa (${dailySpecialsData.sopa})` : 'Con Sopa';
        const parts = [item.soup || soupDefault];
        if (!isFixed) {
          parts.push(`Principio: ${item.principle || (dailySpecialsData.principios?.[0] || 'Sin Principio')}`);
          parts.push(`Acomp: ${item.side || (dailySpecialsData.acompanamientos?.[0] || 'Sin Acompañamiento')}`);
          parts.push(item.salad || 'Con ensalada');
        }
        if (currentOrderType !== 'mesa') {
          parts.push(`Empaque: ${item.packaging || globalPackagingType}`);
        }
        if (item.extraNotes && item.extraNotes.trim()) {
          parts.push(`Nota: ${item.extraNotes.trim()}`);
        }
        return parts.join(' | ');
      }

      if (item.isRapidasFood) {
        const parts = [];
        if (currentOrderType !== 'mesa') {
          parts.push(`Empaque: ${item.packaging || globalPackagingType}`);
        }
        if (item.extraNotes && item.extraNotes.trim()) {
          parts.push(`Nota: ${item.extraNotes.trim()}`);
        }
        return parts.join(' | ');
      }

      if (item.isHospitalDiet) {
        const loc = item.hospitalLocation || 'Torre A';
        const tag = getHospitalDietTag(item.name, loc);
        const parts = [tag, `Ubicación: ${loc}`];
        if (currentOrderType !== 'mesa') {
          parts.push(`Empaque: ${item.packaging || globalPackagingType}`);
        }
        if (item.extraNotes && item.extraNotes.trim()) {
          parts.push(`Nota: ${item.extraNotes.trim()}`);
        }
        return parts.join(' | ');
      }

      if (item.isJuice) {
        const parts = [];
        if (item.flavor) {
          parts.push(`Sabor: ${item.flavor}`);
        }
        if (item.extraNotes && item.extraNotes.trim()) {
          parts.push(`Nota: ${item.extraNotes.trim()}`);
        }
        return parts.join(' | ');
      }

      if (item.extraNotes && item.extraNotes.trim()) {
        return `Nota: ${item.extraNotes.trim()}`;
      }

      return item.notes || '';
    }

    // Sincroniza las notas de empaque de todos los platos
    function updateAllItemsPackagingNotes() {
      cart.forEach((it) => {
        if (it.isCustomizable || it.isRapidasFood || it.isJuice || it.isHospitalDiet) {
          it.notes = buildPlateNotes(it);
        }
      });
    }

    // Abre el modal para editar o personalizar un ítem específico del carrito
    function openGarnishModalForCartItem(cartItem) {
      if (!cartItem) return;
      editingCartUid = cartItem.uid;
      pendingGarnishItem = cartItem;

      const isFixed = isFixedGarnishDish(cartItem.name);
      const soupDefault = dailySpecialsData.sopa ? `Con Sopa (${dailySpecialsData.sopa})` : 'Con Sopa';
      const soupOptions = [soupDefault, 'Sin Sopa'];
      const principleOptions = [...(dailySpecialsData.principios || []), 'Sin Principio'];
      const sideOptions = [...(dailySpecialsData.acompanamientos || []), 'Sin Acompañamiento'];
      const saladOptions = ['Con ensalada', 'Sin ensalada'];
      const packagingOptions = ['Icopor', 'Caja'];

      garnishState = {
        quantity: 1,
        soup: cartItem.soup || soupOptions[0],
        principle: isFixed ? null : (cartItem.principle || principleOptions[0] || 'Sin Principio'),
        side: isFixed ? null : (cartItem.side || sideOptions[0] || 'Sin Acompañamiento'),
        salad: isFixed ? null : (cartItem.salad || 'Con ensalada'),
        packaging: cartItem.packaging || globalPackagingType || 'Icopor'
      };

      if (garnishDishName) garnishDishName.textContent = cartItem.name;
      if (garnishDishPrice) garnishDishPrice.textContent = fmt(cartItem.price);

      // Ocultar selector de cantidad durante la personalización 1-a-1
      const qtyWrapper = document.getElementById('garnish-qty-wrapper');
      if (qtyWrapper) qtyWrapper.style.display = 'none';

      if (garnishExtraNotes) {
        // @ts-ignore
        garnishExtraNotes.value = cartItem.extraNotes || '';
      }

      const btnLabel = document.getElementById('btn-garnish-confirm-label');
      if (btnLabel) btnLabel.textContent = 'Guardar Cambios';

      renderOptionPills(garnishSoupContainer, soupOptions, garnishState.soup, (val) => (garnishState.soup = val));

      // Si es plato con receta fija, ocultar los selectores de Principio, Acompañamiento y Ensalada
      const principleSection = garnishPrincipleContainer ? garnishPrincipleContainer.closest('div') : null;
      const sideSection = garnishSideContainer ? garnishSideContainer.closest('div') : null;
      const saladSection = garnishSaladContainer ? garnishSaladContainer.closest('div') : null;

      if (principleSection) principleSection.style.display = isFixed ? 'none' : 'block';
      if (sideSection) sideSection.style.display = isFixed ? 'none' : 'block';
      if (saladSection) saladSection.style.display = isFixed ? 'none' : 'block';

      if (!isFixed) {
        renderOptionPills(garnishPrincipleContainer, principleOptions, garnishState.principle, (val) => (garnishState.principle = val));
        renderOptionPills(garnishSideContainer, sideOptions, garnishState.side, (val) => (garnishState.side = val));
        renderOptionPills(garnishSaladContainer, saladOptions, garnishState.salad, (val) => (garnishState.salad = val));
      }
      renderOptionPills(garnishPackagingContainer, packagingOptions, garnishState.packaging, (val) => (garnishState.packaging = val));

      modalGarnish?.classList.remove('hidden');
      modalGarnish?.classList.add('flex');
    }

    function closeGarnishModal() {
      modalGarnish?.classList.add('hidden');
      modalGarnish?.classList.remove('flex');
      editingCartUid = null;
      pendingGarnishItem = null;
    }

    document.getElementById('btn-garnish-close')?.addEventListener('click', closeGarnishModal);
    document.getElementById('btn-garnish-cancel')?.addEventListener('click', closeGarnishModal);

    document.querySelectorAll('.garnish-note-chip').forEach((chipBtn) => {
      chipBtn.addEventListener('click', () => {
        const chipText = chipBtn.getAttribute('data-note-chip') || '';
        if (!garnishExtraNotes || !chipText) return;
        // @ts-ignore
        const current = garnishExtraNotes.value.trim();
        // @ts-ignore
        garnishExtraNotes.value = current ? `${current}, ${chipText}` : chipText;
      });
    });

    // Guardar cambios al plato personalizado desde el carrito
    document.getElementById('form-garnish-pos')?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!editingCartUid) {
        closeGarnishModal();
        return;
      }

      const item = cart.find((it) => it.uid === editingCartUid);
      if (!item) {
        closeGarnishModal();
        return;
      }

      // @ts-ignore
      const extra = garnishExtraNotes ? garnishExtraNotes.value.trim() : '';
      const isFixed = isFixedGarnishDish(item.name);

      item.soup = garnishState.soup;
      item.principle = isFixed ? null : garnishState.principle;
      item.side = isFixed ? null : garnishState.side;
      item.salad = isFixed ? null : garnishState.salad;
      item.packaging = garnishState.packaging;
      item.extraNotes = extra;
      item.notes = buildPlateNotes(item);

      renderCart();
      closeGarnishModal();
    });

    // 1-CLICK: Agregar plato al carrito sin bloquear con modal (soporta cantidades directas)
    function addDishToCartInOneClick({ id, name, price, isCustomizable, category_id, menu_type, quantity = 1 }) {
      const numPrice = Number(price);
      const isHospitalDiet = isHospitalDietProduct({ id, name, category_id, menu_type });
      const isRapFood = isRapidasFoodProduct({ id, name, category_id, menu_type });
      const isJuice = isJuiceProduct(name, category_id);
      const isDrink = isDrinkProduct(name, category_id);
      const addQty = Math.max(1, parseInt(String(quantity || 1), 10) || 1);

      // Si es dieta clínica hospitalaria: NUNCA abrir modal de sopas/principios, agregar fila independiente por renglón
      if (isHospitalDiet) {
        const targetLoc = currentActiveHospitalLocation || 'Torre A';
        const cartRowId = 'row_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
        const item = {
          uid: cartRowId,
          cart_row_id: cartRowId,
          id: id || name,
          name,
          price: numPrice,
          quantity: addQty,
          category_id: category_id || 'convenios_clinica',
          isCustomizable: false,
          isRapidasFood: false,
          isJuice: false,
          isDrink: false,
          isHospitalDiet: true,
          hospitalLocation: targetLoc,
          ubicacion: targetLoc,
          packaging: globalPackagingType,
          extraNotes: '',
          notes: ''
        };
        item.notes = buildPlateNotes(item);
        cart.push(item);
        syncHospitalHipoWaterInCart();
        renderCart();
        return;
      }

      if (isCustomizable) {
        const isFixed = isFixedGarnishDish(name);
        const soupDefault = dailySpecialsData.sopa ? `Con Sopa (${dailySpecialsData.sopa})` : 'Con Sopa';
        const soupOptions = [soupDefault, 'Sin Sopa'];
        const principleOptions = [...(dailySpecialsData.principios || []), 'Sin Principio'];
        const sideOptions = [...(dailySpecialsData.acompanamientos || []), 'Sin Acompañamiento'];

        for (let q = 0; q < addQty; q++) {
          const item = {
            uid: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7) + '_' + q,
            id: id || name,
            name,
            price: numPrice,
            quantity: 1,
            category_id: category_id || 'fuertes_165',
            isCustomizable: true,
            isFixedGarnish: isFixed,
            isRapidasFood: false,
            isJuice: false,
            isDrink: false,
            soup: soupOptions[0],
            principle: isFixed ? null : (principleOptions[0] || 'Sin Principio'),
            side: isFixed ? null : (sideOptions[0] || 'Sin Acompañamiento'),
            salad: isFixed ? null : 'Con ensalada',
            packaging: globalPackagingType,
            extraNotes: '',
            notes: ''
          };
          item.notes = buildPlateNotes(item);
          cart.push(item);
        }

      } else if (isRapFood) {
        const item = {
          uid: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
          id: id || name,
          name,
          price: numPrice,
          quantity: addQty,
          category_id: category_id || 'rapidas',
          isCustomizable: false,
          isRapidasFood: true,
          isJuice: false,
          isDrink: false,
          packaging: globalPackagingType,
          extraNotes: '',
          notes: ''
        };
        item.notes = buildPlateNotes(item);
        cart.push(item);

      } else if (isJuice) {
        const isCerezada = normalizeStr(name).includes('cerezada');
        const defaultFlavor = isCerezada ? 'Cerezada' : 'Lulo';
        const item = {
          uid: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
          id: id || name,
          name,
          price: numPrice,
          quantity: 1,
          category_id: category_id || 'granizados_jugos',
          isCustomizable: false,
          isRapidasFood: false,
          isJuice: true,
          isDrink: false,
          flavor: defaultFlavor,
          packaging: null,
          extraNotes: '',
          notes: ''
        };
        item.notes = buildPlateNotes(item);
        cart.push(item);

      } else {
        const existing = cart.find((it) => it.name === name && !it.isCustomizable && !it.isRapidasFood && !it.isJuice && !it.isHospitalDiet);
        if (existing) {
          existing.quantity += 1;
        } else {
          cart.push({
            uid: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
            id: id || name,
            name,
            price: numPrice,
            quantity: 1,
            category_id: category_id || 'bebidas',
            isCustomizable: false,
            isRapidasFood: false,
            isJuice: false,
            isDrink: true,
            packaging: null,
            extraNotes: '',
            notes: ''
          });
        }
      }

      // REGLA AUTOMÁTICA HOSPITALARIA:
      // Si se seleccionó una dieta que contenga "Hiposódica" o "Hipoglúcida", asegurar automáticamente "Botella con Agua (Dieta Hipo Clínica)" a $0
      syncHospitalHipoWaterInCart();

      if (currentOrderType !== 'mesa' && !manualPackagingOverride) {
        packagingQty = countFoodPlates();
      }
      renderCart();
    }

    function isHipoDietName(dishName) {
      const n = normalizeStr(dishName);
      if (n.includes('botella con agua')) return false;
      return n.includes('hiposodica') || n.includes('hipoglucida') || n.includes('hiposodico') || n.includes('hipoglucido');
    }

    function syncHospitalHipoWaterInCart() {
      const totalHipoQty = cart.reduce((acc, it) => {
        return isHipoDietName(it.name) ? acc + Number(it.quantity || 1) : acc;
      }, 0);
      const waterName = 'Botella con Agua (Dieta Hipo Clínica)';
      const existingWaterIdx = cart.findIndex(
        (it) => normalizeStr(it.name).includes('botella con agua') && Number(it.price || 0) === 0
      );

      if (totalHipoQty <= 0) {
        if (existingWaterIdx !== -1) {
          cart.splice(existingWaterIdx, 1);
        }
        return;
      }

      if (existingWaterIdx !== -1) {
        cart[existingWaterIdx].quantity = totalHipoQty;
      } else {
        cart.push({
          uid: 'c_agua_' + Date.now(),
          id: 'conv-agua-hipo',
          name: waterName,
          price: 0,
          quantity: totalHipoQty,
          category_id: 'convenios_clinica',
          isCustomizable: false,
          isRapidasFood: false,
          isJuice: false,
          isDrink: true,
          packaging: null,
          extraNotes: 'Incluida en Dieta Hipo ($0)',
          notes: 'Regla Hospitalaria: Incluida en Dieta Hipo ($0)'
        });
      }
    }

    // Delegación global para botones '+' (.btn-add-cart) y botones rápidos (+1, +5, +10) (.btn-add-cart-qty)
    document.addEventListener('click', (e) => {
      // @ts-ignore
      const btn = e.target.closest('.btn-add-cart, .btn-add-cart-qty');
      if (!btn || btn.disabled || btn.getAttribute('data-sold-out') === 'true') return;

      btn.classList.add('ring-4', 'ring-emerald-400', 'bg-emerald-600', 'scale-110');
      setTimeout(() => {
        btn.classList.remove('ring-4', 'ring-emerald-400', 'bg-emerald-600', 'scale-110');
      }, 350);

      const name = btn.getAttribute('data-name') || 'Plato';
      const price = Number(btn.getAttribute('data-price') || 0);
      const isCustomizable = btn.getAttribute('data-customizable') === 'true';
      const id = btn.getAttribute('data-id') || name;
      const category_id = btn.getAttribute('data-cat') || '';
      const menu_type = btn.getAttribute('data-menu') || '';
      const quantity = parseInt(btn.getAttribute('data-qty') || '1', 10) || 1;

      addDishToCartInOneClick({ id, name, price, isCustomizable, category_id, menu_type, quantity });
    });

    // Controladores de Empaques Globales (Caja / Icopor y Cantidad)
    const btnPackGlobalCaja = document.getElementById('btn-pack-global-caja');
    const btnPackGlobalIcopor = document.getElementById('btn-pack-global-icopor');
    const btnPackMinus = document.getElementById('btn-pack-minus');
    const btnPackPlus = document.getElementById('btn-pack-plus');

    function updateGlobalPackagingUI() {
      if (globalPackagingType === 'Caja') {
        btnPackGlobalCaja?.classList.add('bg-parrilla-gold', 'text-white', 'shadow-xs');
        btnPackGlobalCaja?.classList.remove('text-parrilla-muted', 'hover:text-parrilla-ivory');
        btnPackGlobalIcopor?.classList.remove('bg-parrilla-gold', 'text-white', 'shadow-xs');
        btnPackGlobalIcopor?.classList.add('text-parrilla-muted', 'hover:text-parrilla-ivory');
      } else {
        btnPackGlobalIcopor?.classList.add('bg-parrilla-gold', 'text-white', 'shadow-xs');
        btnPackGlobalIcopor?.classList.remove('text-parrilla-muted', 'hover:text-parrilla-ivory');
        btnPackGlobalCaja?.classList.remove('bg-parrilla-gold', 'text-white', 'shadow-xs');
        btnPackGlobalCaja?.classList.add('text-parrilla-muted', 'hover:text-parrilla-ivory');
      }
    }

    btnPackGlobalCaja?.addEventListener('click', () => {
      globalPackagingType = 'Caja';
      updateGlobalPackagingUI();
      cart.forEach((it) => {
        if (it.isCustomizable || it.isRapidasFood) it.packaging = 'Caja';
      });
      updateAllItemsPackagingNotes();
      renderCart();
    });

    btnPackGlobalIcopor?.addEventListener('click', () => {
      globalPackagingType = 'Icopor';
      updateGlobalPackagingUI();
      cart.forEach((it) => {
        if (it.isCustomizable || it.isRapidasFood) it.packaging = 'Icopor';
      });
      updateAllItemsPackagingNotes();
      renderCart();
    });

    btnPackMinus?.addEventListener('click', () => {
      manualPackagingOverride = true;
      packagingQty = Math.max(0, packagingQty - 1);
      renderCart();
    });

    btnPackPlus?.addEventListener('click', () => {
      manualPackagingOverride = true;
      packagingQty += 1;
      renderCart();
    });

    // 3. RENDER CART & TOTALS
    function renderCart() {
      if (!cartContainer) return;

      const { subtotal, packagingFee, deliveryFee, total, isDeliveryOrTakeout } = calculateTotals();

      if (cart.length === 0) {
