---
export const prerender = true;
import StaffLayout from '../layouts/StaffLayout.astro';
import { getCategories, getProducts, getActiveCashRegister, fallbackCategories, initialProductList } from '../lib/db.js';

const rawCategories = getCategories();
const categories = (rawCategories && rawCategories.length > 0) ? rawCategories : fallbackCategories;

const rawProducts = getProducts(true);
const products = (rawProducts && rawProducts.length > 0) ? rawProducts : initialProductList;
console.log(">>> POS PRODUCTS IN ASTRO BUILD:", products.length, "Categories:", categories.length);
const activeCash = getActiveCashRegister();

// Format Colombian Peso
const formatPrice = (val) => {
  return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
};
---

<StaffLayout title="POS Punto de Venta | San Parrilla">
  <div class="max-w-[1600px] mx-auto px-2 sm:px-4 py-4 flex-1 flex flex-col no-print">

    <!-- Top Alert if Cash Register is closed -->
    {!activeCash && (
      <div class="mb-4 bg-amber-500/20 border border-amber-500/50 text-amber-300 p-3.5 rounded-xl flex items-center justify-between">
        <div class="flex items-center gap-3">
          <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-400"></i>
          <span class="text-sm font-semibold">Atención: No hay una caja abierta actualmente. Las ventas se registrarán sin cuadre de turno.</span>
        </div>
        <a href="/caja" class="bg-amber-500 hover:bg-amber-400 text-parrilla-dark font-bold text-xs px-3 py-1.5 rounded-lg transition">
          Abrir Caja Ahora
        </a>
      </div>
    )}

    <!-- Top Alert: Pending WhatsApp Drafts -->
    <div id="pos-drafts-alert" class="hidden mb-4 bg-emerald-50 border border-emerald-300 text-emerald-800 p-3.5 rounded-xl items-center justify-between shadow-sm">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-sm font-bold">
          📱 Tienes <span id="pos-drafts-count" class="underline">0</span> pedidos web de WhatsApp pendientes de aprobación.
        </span>
      </div>
      <a href="/caja" class="bg-emerald-600 hover:bg-emerald-700 text-white font-display font-extrabold text-xs px-3.5 py-1.5 rounded-lg transition shadow-sm flex items-center gap-1.5">
        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
        <span>Ir a Bandeja de Borradores</span>
      </a>
    </div>

    <!-- Main POS Grid: Left Catalog, Right Order Cart -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1 items-start">
      
      <!-- LEFT SECTION: PRODUCT CATALOG & FILTERS (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        
        <!-- Search & Filter Bar -->
        <div class="bg-parrilla-surface rounded-2xl p-4 border border-parrilla-border flex flex-col sm:flex-row items-center gap-3">
          <div class="relative w-full sm:flex-1">
            <i data-lucide="search" class="w-4 h-4 text-parrilla-muted absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input 
              type="text" 
              id="product-search" 
              placeholder="Buscar plato o bebida (ej. Churrasco, Pechuga, Picada)..." 
              class="w-full pl-10 pr-4 py-2.5 bg-parrilla-dark rounded-xl border border-parrilla-border text-sm text-parrilla-ivory placeholder-parrilla-muted focus:outline-none focus:border-parrilla-gold transition"
            />
          </div>

          <!-- Quick Category Filters -->
          <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto no-scrollbar pb-1 sm:pb-0">
            <button class="pos-cat-btn active px-3 py-2 rounded-xl text-xs font-bold bg-parrilla-gold text-white shadow-sm transition" data-category="all">
              Todos
            </button>
            {categories.map(cat => (
              <button class="pos-cat-btn px-3 py-2 rounded-xl text-xs font-bold bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold hover:bg-slate-200/70 border border-parrilla-border transition whitespace-nowrap" data-category={cat.id}>
                {cat.name}
              </button>
            ))}
          </div>
        </div>

        <!-- Products Quick-Touch Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-h-[calc(100vh-250px)] overflow-y-auto pr-1" id="pos-product-list">
          {products.map(p => (
            <button 
              type="button"
              class="pos-item-btn text-left bg-white hover:bg-slate-50/90 rounded-xl p-3.5 border border-parrilla-border hover:border-parrilla-gold/60 transition active:scale-[0.98] flex flex-col justify-between min-h-[95px] group shadow-sm hover:shadow"
              data-id={p.id}
              data-name={p.name}
              data-price={p.price}
              data-cat={p.category_id}
            >
              <span class="font-display font-bold text-sm text-parrilla-ivory group-hover:text-parrilla-gold line-clamp-2 leading-tight">
                {p.name}
              </span>
              <div class="flex items-center justify-between mt-2 pt-2 border-t border-parrilla-border/60 w-full">
                <span class="font-extrabold text-sm text-parrilla-gold">
                  {formatPrice(p.price)}
                </span>
                <span class="w-6 h-6 rounded-lg bg-slate-100 group-hover:bg-parrilla-gold group-hover:text-white flex items-center justify-center text-parrilla-gold transition text-xs font-black">
                  +
                </span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- RIGHT SECTION: ORDER BUILDER & TICKET SUMMARY (5 cols) -->
      <div class="lg:col-span-5 bg-white rounded-2xl border border-parrilla-border p-4 sm:p-5 flex flex-col gap-4 sticky top-20 shadow-xl">
        
        <!-- Order Type Selector (Mesa / Domicilio / Para Llevar) -->
        <div>
          <label class="block text-xs font-bold text-parrilla-gold uppercase tracking-wider mb-2">Tipo de Pedido</label>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" id="type-mesa" class="order-type-btn active flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-extrabold text-xs shadow-sm transition">
              <i data-lucide="utensils" class="w-4 h-4"></i>
              <span>Mesa</span>
            </button>
            <button type="button" id="type-domicilio" class="order-type-btn flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-border bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold font-extrabold text-xs transition">
              <i data-lucide="bike" class="w-4 h-4 text-parrilla-accent"></i>
              <span>Domicilio</span>
            </button>
            <button type="button" id="type-llevar" class="order-type-btn flex items-center justify-center gap-1.5 py-2.5 rounded-xl border border-parrilla-border bg-slate-100 text-parrilla-ivory hover:text-parrilla-gold font-extrabold text-xs transition">
              <i data-lucide="package" class="w-4 h-4 text-amber-600"></i>
              <span>Para Llevar</span>
            </button>
          </div>
        </div>

        <!-- CONDITIONAL FORM: MESA -->
        <div id="form-mesa" class="flex items-center gap-2">
          <span class="text-xs text-parrilla-muted font-medium">Mesa:</span>
          <input 
            type="text" 
            id="table-input" 
            value="Mesa 1" 
            placeholder="Ej. Mesa 3 o Barra" 
            class="flex-1 px-3 py-1.5 bg-parrilla-dark rounded-lg border border-parrilla-border text-sm text-parrilla-ivory focus:border-parrilla-gold outline-none"
          />
        </div>

        <!-- CONDITIONAL FORM: DOMICILIOS & CLIENTES DATABASE -->
        <div id="form-domicilio" class="hidden bg-parrilla-dark/90 rounded-xl p-3 border border-parrilla-gold/30 flex-col gap-2.5">
          <div class="flex items-center justify-between pb-1 border-b border-parrilla-border/60">
            <span class="text-xs font-bold text-parrilla-gold uppercase flex items-center gap-1.5">
              <i data-lucide="user-check" class="w-4 h-4"></i>
              <span>Datos del Cliente & Mensajero</span>
            </span>
            <span class="text-[10px] text-parrilla-muted">Guarda en BD automáticamente</span>
          </div>

          <!-- Teléfono con autocompletado instantáneo -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Teléfono Celular *</label>
              <div class="relative">
                <input 
                  type="tel" 
                  id="cust-phone" 
                  placeholder="3183821787" 
                  class="w-full px-3 py-2 bg-parrilla-surface rounded-lg border border-parrilla-border text-sm font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
                />
                <span id="cust-status" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs"></span>
              </div>
            </div>

            <div>
              <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Nombre del Cliente *</label>
              <input 
                type="text" 
                id="cust-name" 
                placeholder="Nombre completo" 
                class="w-full px-3 py-2 bg-parrilla-surface rounded-lg border border-parrilla-border text-sm text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
          </div>

          <!-- Dirección y Barrio/Referencia -->
          <div>
            <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Dirección de Entrega * (Se imprime en grande para mensajero)</label>
            <input 
              type="text" 
              id="cust-address" 
              placeholder="Calle 123 # 45 - 67 Apto 302" 
              class="w-full px-3 py-2 bg-parrilla-surface rounded-lg border border-parrilla-border text-sm font-semibold text-parrilla-gold focus:border-parrilla-gold outline-none"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Barrio / Indicaciones</label>
              <input 
                type="text" 
                id="cust-neighborhood" 
                placeholder="Ej. Centro, frente al parque" 
                class="w-full px-3 py-1.5 bg-parrilla-surface rounded-lg border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div>
              <label class="block text-[11px] text-parrilla-muted mb-1 font-semibold">Costo Domicilio ($)</label>
              <input 
                type="number" 
                id="delivery-fee-input" 
                value="3000" 
                step="500" 
                class="w-full px-3 py-1.5 bg-parrilla-surface rounded-lg border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
          </div>
        </div>

        <!-- ORDER ITEMS CART LIST -->
        <div class="border border-parrilla-border rounded-xl bg-parrilla-dark/50 overflow-hidden flex flex-col flex-1">
          <div class="bg-parrilla-dark px-3 py-2 border-b border-parrilla-border flex items-center justify-between text-xs font-bold text-parrilla-muted uppercase">
            <span>Plato / Producto</span>
            <div class="flex items-center gap-6">
              <span>Cant.</span>
              <span>Total</span>
            </div>
          </div>

          <div id="cart-items-container" class="divide-y divide-parrilla-border/40 max-h-56 overflow-y-auto p-1 text-sm min-h-[120px]">
            <!-- Items injected by JS -->
            <div class="p-6 text-center text-xs text-parrilla-muted italic" id="cart-empty-msg">
              Selecciona productos del catálogo para agregar a la comanda.
            </div>
          </div>
        </div>

        <!-- PAYMENT METHOD & TOTALS -->
        <div class="bg-parrilla-dark/80 rounded-xl p-3 border border-parrilla-border space-y-2">
          
          <div class="flex items-center justify-between text-xs text-parrilla-muted">
            <span>Subtotal:</span>
            <span id="pos-subtotal" class="font-semibold text-parrilla-ivory">$0</span>
          </div>

          <div class="flex items-center justify-between text-xs text-parrilla-muted" id="delivery-row" style="display: none;">
            <span>Envío Domicilio:</span>
            <span id="pos-delivery" class="font-semibold text-parrilla-accent">$0</span>
          </div>

          <div class="flex items-center justify-between text-base font-black text-parrilla-gold pt-2 border-t border-parrilla-border">
            <span>TOTAL A COBRAR:</span>
            <span id="pos-total" class="text-xl font-display">$0</span>
          </div>

          <!-- Payment Method Buttons -->
          <div class="pt-2">
            <span class="block text-[11px] text-parrilla-muted uppercase font-semibold mb-1.5">Método de Pago</span>
            <div class="grid grid-cols-4 gap-1.5">
              <button type="button" class="pay-btn active py-2 rounded-lg text-xs font-bold bg-parrilla-gold text-white shadow-sm transition" data-method="efectivo">
                💵 Efectivo
              </button>
              <button type="button" class="pay-btn py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition" data-method="nequi">
                🟣 Nequi
              </button>
              <button type="button" class="pay-btn py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition" data-method="daviplata">
                🔴 Daviplata
              </button>
              <button type="button" class="pay-btn py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition" data-method="tarjeta">
                💳 Tarjeta
              </button>
            </div>
          </div>

          <!-- Cash Change Calculation (Si Efectivo) -->
          <div id="cash-change-box" class="pt-2 flex items-center gap-3">
            <div class="flex-1">
              <label class="block text-[10px] text-parrilla-muted uppercase font-semibold mb-0.5">Paga con ($):</label>
              <input 
                type="number" 
                id="cash-received" 
                placeholder="Ej. 50000" 
                class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-parrilla-border text-sm font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div class="flex-1 text-right">
              <span class="block text-[10px] text-parrilla-muted uppercase font-semibold mb-0.5">Vueltas / Cambio:</span>
              <span id="cash-change-display" class="font-display font-black text-lg text-parrilla-accent">$0</span>
            </div>
          </div>
        </div>

        <!-- ACTION BUTTONS: COBRAR E IMPRIMIR SAT Q22 -->
        <div class="flex items-center gap-2 pt-1">
          <button 
            type="button" 
            id="btn-clear-cart" 
            class="px-3.5 py-3 rounded-xl bg-slate-100 hover:bg-red-50 text-parrilla-muted hover:text-red-500 border border-parrilla-border text-xs font-bold transition"
          >
            Limpiar
          </button>

          <button 
            type="button" 
            id="btn-quick-test-print" 
            class="px-3 py-3 rounded-xl bg-orange-50 hover:bg-orange-100 text-parrilla-gold border border-orange-200 text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap"
            title="Carga automáticamente el combo de prueba y lanza la impresión a la SAT Q22"
          >
            <i data-lucide="zap" class="w-4 h-4 text-parrilla-gold"></i>
            <span>Test SAT Q22</span>
          </button>

          <button 
            type="button" 
            id="btn-checkout-print" 
            class="flex-1 py-3.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-display font-black text-base shadow-lg shadow-orange-700/20 flex items-center justify-center gap-2 transition active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <i data-lucide="printer" class="w-5 h-5"></i>
            <span>Cobrar e Imprimir (SAT Q22)</span>
          </button>
        </div>

        <!-- Reimprimir el último ticket (sin cobrar de nuevo) -->
        <button
          type="button"
          id="btn-reprint"
          class="hidden w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-parrilla-ivory border border-parrilla-border text-xs font-bold transition items-center justify-center gap-2"
        >
          <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
          <span id="btn-reprint-label">Reimprimir último ticket</span>
        </button>

      </div>

    </div>
  </div>

  <!-- ==============================================================
       MODAL DE COBRO Y PAGO MIXTO (POST /api/pedidos/{id}/pagar)
       ============================================================== -->
  <div id="modal-cobro-pos" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl border border-parrilla-border max-w-lg w-full p-6 shadow-2xl space-y-4 max-h-[95vh] overflow-y-auto">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between border-b border-parrilla-border pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-orange-100 text-parrilla-gold flex items-center justify-center font-bold">
            <i data-lucide="credit-card" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-display font-black text-xl text-parrilla-ivory">Cobro de Comanda</h3>
            <span id="modal-order-subtitle" class="text-xs text-parrilla-muted">Mesa 1 • 0 platos</span>
          </div>
        </div>
        <button type="button" id="btn-close-cobro-modal" class="text-parrilla-muted hover:text-parrilla-ivory">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Resumen de Costos -->
      <div class="bg-slate-50 p-3.5 rounded-xl border border-parrilla-border space-y-1.5 text-xs">
        <div class="flex justify-between text-parrilla-muted">
          <span>Subtotal consumo:</span>
          <span id="modal-cobro-subtotal" class="font-bold text-parrilla-ivory font-mono">$0</span>
        </div>
        <div class="flex justify-between text-parrilla-muted" id="modal-cobro-delivery-row">
          <span>Domicilio / Entrega:</span>
          <span id="modal-cobro-delivery" class="font-bold text-parrilla-accent font-mono">$0</span>
        </div>
        <div class="flex justify-between text-base font-black text-parrilla-gold border-t border-parrilla-border pt-1.5">
          <span>TOTAL A COBRAR:</span>
          <span id="modal-cobro-total" class="font-display text-2xl font-mono text-parrilla-gold">$0</span>
        </div>
      </div>

      <!-- Selector de Modo de Pago (Único vs Mixto) -->
      <div class="space-y-3">
        <div class="grid grid-cols-2 gap-2 bg-slate-100 p-1 rounded-xl border border-parrilla-border">
          <button type="button" id="btn-mode-single" class="py-2 rounded-lg text-xs font-bold bg-white text-parrilla-ivory shadow-sm transition">
            💵 Pago Único
          </button>
          <button type="button" id="btn-mode-split" class="py-2 rounded-lg text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory transition">
            ⚖️ Pago Mixto / Dividido
          </button>
        </div>

        <!-- MODO 1: PAGO ÚNICO -->
        <div id="cobro-view-single" class="space-y-3">
          <span class="block text-[11px] font-bold text-parrilla-muted uppercase">Selecciona Método:</span>
          <div class="grid grid-cols-4 gap-2">
            <button type="button" class="single-pay-btn active py-2.5 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-xs flex flex-col items-center gap-1 shadow-sm" data-method="CASH">
              <span>💵</span>
              <span>Efectivo</span>
            </button>
            <button type="button" class="single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1" data-method="NEQUI">
              <span>🟣</span>
              <span>Nequi</span>
            </button>
            <button type="button" class="single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1" data-method="DAVIPLATA">
              <span>🔴</span>
              <span>Daviplata</span>
            </button>
            <button type="button" class="single-pay-btn py-2.5 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1" data-method="CARD">
              <span>💳</span>
              <span>Tarjeta</span>
            </button>
          </div>

          <!-- Calculadora de Cambio en Efectivo -->
          <div id="single-cash-calc" class="bg-slate-50 p-3 rounded-xl border border-parrilla-border space-y-2">
            <div class="flex items-center justify-between gap-3">
              <div class="flex-1">
                <label class="block text-[10px] font-bold text-parrilla-muted uppercase mb-1">Efectivo recibido ($):</label>
                <input 
                  type="number" 
                  id="single-cash-received" 
                  placeholder="Ej. 50000" 
                  step="1000"
                  class="w-full px-3 py-2 bg-white rounded-lg border border-parrilla-border font-bold text-lg font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
                />
              </div>
              <div class="flex-1 text-right">
                <span class="block text-[10px] font-bold text-parrilla-muted uppercase mb-1">Vueltas / Cambio:</span>
                <span id="single-change-display" class="font-display font-black text-xl text-emerald-600 font-mono block">$0</span>
              </div>
            </div>
          </div>
        </div>

        <!-- MODO 2: PAGO MIXTO / DIVIDIDO -->
        <div id="cobro-view-split" class="hidden space-y-3">
          <div class="bg-amber-50 border border-amber-200 text-amber-800 p-2.5 rounded-xl text-xs">
            Divide la cuenta en dos medios de pago (ej. parte por Nequi y el resto en Efectivo).
          </div>

          <!-- Método 1 -->
          <div class="bg-slate-50 p-3 rounded-xl border border-parrilla-border space-y-2">
            <span class="text-[10px] font-bold text-parrilla-muted uppercase block">Primer Medio de Pago</span>
            <div class="grid grid-cols-2 gap-2">
              <select id="split-method-1" class="px-3 py-2 bg-white rounded-lg border border-parrilla-border text-xs font-bold text-parrilla-ivory outline-none">
                <option value="NEQUI">🟣 Nequi</option>
                <option value="CASH">💵 Efectivo</option>
                <option value="DAVIPLATA">🔴 Daviplata</option>
                <option value="CARD">💳 Tarjeta</option>
              </select>
              <input 
                type="number" 
                id="split-amount-1" 
                placeholder="Monto ($)" 
                step="500"
                class="px-3 py-2 bg-white rounded-lg border border-parrilla-border text-xs font-bold font-mono text-parrilla-ivory outline-none focus:border-parrilla-gold"
              />
            </div>
          </div>

          <!-- Método 2 -->
          <div class="bg-slate-50 p-3 rounded-xl border border-parrilla-border space-y-2">
            <span class="text-[10px] font-bold text-parrilla-muted uppercase block">Segundo Medio de Pago</span>
            <div class="grid grid-cols-2 gap-2">
              <select id="split-method-2" class="px-3 py-2 bg-white rounded-lg border border-parrilla-border text-xs font-bold text-parrilla-ivory outline-none">
                <option value="CASH">💵 Efectivo</option>
                <option value="NEQUI">🟣 Nequi</option>
                <option value="DAVIPLATA">🔴 Daviplata</option>
                <option value="CARD">💳 Tarjeta</option>
              </select>
              <input 
                type="number" 
                id="split-amount-2" 
                placeholder="Monto restante ($)" 
                step="500"
                class="px-3 py-2 bg-white rounded-lg border border-parrilla-border text-xs font-bold font-mono text-parrilla-ivory outline-none focus:border-parrilla-gold"
              />
            </div>
          </div>

          <!-- Split Balance Status -->
          <div class="p-3 rounded-xl border flex items-center justify-between text-xs" id="split-balance-box">
            <div>
              <span class="text-[10px] uppercase font-bold text-parrilla-muted block">Suma Pagada:</span>
              <span id="split-sum-display" class="font-bold font-mono">$0</span>
            </div>
            <div class="text-right">
              <span class="text-[10px] uppercase font-bold text-parrilla-muted block">Estado:</span>
              <span id="split-status-display" class="font-bold text-amber-600">Falta asignar dinero</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Buttons -->
      <div class="flex items-center gap-2 pt-2">
        <button 
          type="button" 
          id="btn-cancel-cobro" 
          class="flex-1 py-3 rounded-xl border border-parrilla-border text-parrilla-muted hover:bg-slate-100 font-bold text-xs"
        >
          Cancelar
        </button>
        <button 
          type="button" 
          id="btn-confirm-payment-print" 
          class="flex-1 py-3.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-display font-black text-xs shadow-lg flex items-center justify-center gap-2 transition active:scale-95"
        >
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span>Confirmar e Imprimir (SAT Q22)</span>
        </button>
      </div>

    </div>
  </div>

  <!-- ==============================================================
       THERMAL TICKET TEMPLATE FOR SAT Q22 (80MM ROLL)
       Invisible in screen, perfectly formatted for @media print
       ============================================================== -->
  <div id="printable-ticket" class="receipt-ticket hidden">
    <!-- Header -->
    <div class="ticket-header">
      <h1 class="restaurant-name">SAN PARRILLA</h1>
      <p style="margin: 1mm 0; font-size: 9.5pt;">Fogón, Carbón & Sazón Casero</p>
      <p style="margin: 0; font-size: 9pt;">Tel / WhatsApp: 318 382 1787</p>
      <div id="ticket-badge" class="ticket-badge">CUENTA MESA</div>
      <div style="font-size: 8.5pt; margin-top: 1mm;">
        <span>Fecha: <strong id="t-date">--/--/--</strong></span> | 
        <span>Ticket #: <strong id="t-id">000</strong></span>
      </div>
    </div>

    <!-- SECCIÓN MENSAJERO / DOMICILIO (RESALTADO EN GRANDE) -->
    <div id="t-delivery-box" class="delivery-banner" style="display: none;">
      <div class="delivery-title">DOMICILIO - MENSAJERO</div>
      <div>
        <span style="font-size: 9pt;">CLIENTE:</span>
        <div id="t-cust-name" style="font-size: 13pt; font-weight: 900; text-transform: uppercase;">--</div>
      </div>
      <div style="margin-top: 1.5mm;">
        <span style="font-size: 9pt;">TELÉFONO (LLAMAR):</span>
        <div id="t-cust-phone" class="delivery-phone">--</div>
      </div>
      <div style="margin-top: 1.5mm;">
        <span style="font-size: 9pt;">DIRECCIÓN DE ENTREGA:</span>
        <div id="t-cust-address" class="delivery-address">--</div>
        <div id="t-cust-notes" style="font-size: 10pt; font-style: italic; margin-top: 0.5mm;">--</div>
      </div>
      <div style="margin-top: 2mm; border-top: 2px solid #000; padding-top: 1.5mm;">
        <div style="display: flex; justify-content: space-between; font-size: 13pt; font-weight: 900;">
          <span>COBRAR:</span>
          <span id="t-courier-collect">$0</span>
        </div>
        <div id="t-courier-change-row" style="display: none; justify-content: space-between; font-size: 11pt; font-weight: bold; margin-top: 0.5mm;">
          <span>LLEVAR VUELTAS:</span>
          <span id="t-courier-change">$0</span>
