      if (t.orderType === 'mesa') {
        ubicacionStr = `UBICACIÓN: ${t.table || 'MESA'}`.toUpperCase();
      } else if (t.orderType === 'domicilio') {
        ubicacionStr = `🛵 DOMICILIO ${t.customerName ? '- ' + t.customerName : ''}`.toUpperCase();
      } else {
