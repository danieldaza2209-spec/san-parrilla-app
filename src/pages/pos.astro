              .map((val) => `<option value="${escapeHtml(val)}" ${val === sel ? 'selected' : ''}>${escapeHtml(val)}</option>`)
              .join('');

          inlineControls = `
            <div class="mt-2 pt-2 border-t border-dashed border-parrilla-border/70 text-[11px] space-y-1.5">
              ${
                currentOrderType !== 'mesa'
