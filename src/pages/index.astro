---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { getCategories, getProducts, getDailySpecials } from '../lib/db.js';

const categories = getCategories();
const products = getProducts(true);
const dailySpecials = getDailySpecials();

// Group products by category
const productsByCat = {};
categories.forEach(cat => {
  productsByCat[cat.id] = products.filter(p => p.category_id === cat.id);
});

// Format Colombian Peso
const formatPrice = (val) => {
  return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
};
---

<Layout title="San Parrilla | Menú Digital & Brasas">
  <!-- Hero Section (Pinterest Grill Style) -->
  <section class="relative min-h-[50vh] sm:min-h-[60vh] flex items-center justify-center overflow-hidden border-b border-parrilla-border">
    <!-- Background Image with Gradient Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="/hero-bg.jpg" alt="Parrilla San Parrilla" class="w-full h-full object-cover object-center filter brightness-[0.35] scale-105 transform hover:scale-100 transition duration-1000" />
      <div class="absolute inset-0 bg-gradient-to-t from-parrilla-dark via-parrilla-dark/70 to-transparent"></div>
      <div class="absolute inset-0 bg-radial-gradient from-transparent via-parrilla-dark/40 to-parrilla-dark"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 py-16 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-parrilla-gold/15 border border-parrilla-gold/40 text-parrilla-gold font-bold text-xs sm:text-sm tracking-wide uppercase mb-6 shadow-lg shadow-parrilla-gold/10">
        <span>🔥</span> Tradición, Fogón y Brasas
      </div>

      <h1 class="font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight text-parrilla-ivory mb-4">
        RESTAURANTE <span class="text-transparent bg-clip-text bg-gradient-to-r from-parrilla-gold via-parrilla-goldLight to-amber-500">SAN PARRILLA</span>
      </h1>

      <p class="text-base sm:text-xl text-parrilla-ivory/80 max-w-2xl mx-auto mb-8 font-light leading-relaxed">
        Carnes selectas al carbón, cortes premium, menú casero del día y las mejores picadas para compartir en familia.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#menu-carta" class="inline-flex items-center gap-2 bg-parrilla-gold hover:bg-parrilla-goldLight text-parrilla-dark font-extrabold px-6 py-3.5 rounded-xl text-base shadow-xl hover:shadow-parrilla-gold/25 transition active:scale-95">
          <i data-lucide="book-open" class="w-5 h-5"></i>
          <span>Ver Carta Completa</span>
        </a>

        <a href="https://wa.me/573183821787?text=Hola%20San%20Parrilla,%20deseo%20hacer%20un%20pedido" target="_blank" class="inline-flex items-center gap-2 bg-parrilla-surface/90 hover:bg-parrilla-surface text-parrilla-ivory hover:text-parrilla-gold font-bold px-6 py-3.5 rounded-xl border border-parrilla-border text-base transition active:scale-95">
          <i data-lucide="message-circle" class="w-5 h-5 text-parrilla-accent"></i>
          <span>Pedir a Domicilio</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Especiales de Hoy (Sopa, Principios, Acompañamientos) -->
  {dailySpecials && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
      <div class="bg-gradient-to-br from-parrilla-surface via-parrilla-card to-parrilla-surface rounded-2xl border border-parrilla-gold/30 p-6 sm:p-8 shadow-2xl">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-parrilla-border/80 pb-5 mb-6">
          <div>
            <span class="text-xs font-bold text-parrilla-gold uppercase tracking-widest">Incluido con tus Platos Fuertes</span>
            <h2 class="font-display font-black text-2xl sm:text-3xl text-parrilla-ivory mt-0.5">Especiales del Día</h2>
          </div>
          <div class="inline-flex items-center gap-2 bg-parrilla-dark/80 px-3.5 py-1.5 rounded-lg border border-parrilla-border text-xs text-parrilla-muted">
            <i data-lucide="sparkles" class="w-4 h-4 text-parrilla-gold"></i>
            <span>Sazón casera fresca de hoy</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Sopa -->
          <div class="bg-parrilla-dark/60 rounded-xl p-5 border border-parrilla-border/60 hover:border-parrilla-gold/40 transition">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400">
                <i data-lucide="soup" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="text-[11px] text-parrilla-muted uppercase tracking-wider font-semibold">Entrada</span>
                <h3 class="font-bold text-sm text-parrilla-ivory">Sopa del Día</h3>
              </div>
            </div>
            <div class="text-xl font-display font-black text-parrilla-gold mt-1">
              {dailySpecials.sopa}
            </div>
            <p class="text-xs text-parrilla-muted mt-2">Con caldo artesanal y hierbas del campo.</p>
          </div>

          <!-- Principios -->
          <div class="bg-parrilla-dark/60 rounded-xl p-5 border border-parrilla-border/60 hover:border-parrilla-gold/40 transition">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-parrilla-accent/10 border border-parrilla-accent/30 flex items-center justify-center text-parrilla-accent">
                <i data-lucide="utensils" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="text-[11px] text-parrilla-muted uppercase tracking-wider font-semibold">Elige 1</span>
                <h3 class="font-bold text-sm text-parrilla-ivory">Principios</h3>
              </div>
            </div>
            <ul class="space-y-1.5">
              {dailySpecials.principios.map(p => (
                <li class="flex items-center gap-2 text-sm text-parrilla-ivory/90">
                  <i data-lucide="check-circle-2" class="w-4 h-4 text-parrilla-accent flex-shrink-0"></i>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Acompañamientos -->
          <div class="bg-parrilla-dark/60 rounded-xl p-5 border border-parrilla-border/60 hover:border-parrilla-gold/40 transition">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-yellow-500/10 border border-yellow-500/30 flex items-center justify-center text-yellow-400">
                <i data-lucide="salad" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="text-[11px] text-parrilla-muted uppercase tracking-wider font-semibold">Elige 1</span>
                <h3 class="font-bold text-sm text-parrilla-ivory">Acompañamientos</h3>
              </div>
            </div>
            <ul class="space-y-1.5">
              {dailySpecials.acompanamientos.map(a => (
                <li class="flex items-center gap-2 text-sm text-parrilla-ivory/90">
                  <i data-lucide="check-circle-2" class="w-4 h-4 text-parrilla-gold flex-shrink-0"></i>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Menu Carta Section -->
  <section id="menu-carta" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <span class="text-parrilla-gold text-xs font-extrabold uppercase tracking-widest">Nuestra Oferta Gastronómica</span>
      <h2 class="font-display font-black text-3xl sm:text-5xl text-parrilla-ivory mt-1">La Carta del Asador</h2>
      <p class="text-sm sm:text-base text-parrilla-muted mt-2">
        Selecciona tu corte o preparación favorita. Todos los platos se preparan al instante para garantizar la máxima frescura y sabor.
      </p>
    </div>

    <!-- Category Filter Tabs (Sticky on Mobile) -->
    <div class="sticky top-16 z-30 bg-parrilla-dark/95 backdrop-blur-md py-3 -mx-4 px-4 sm:mx-0 sm:px-0 mb-8 overflow-x-auto no-scrollbar border-b sm:border-b-0 border-parrilla-border">
      <div class="flex items-center gap-2 min-w-max justify-start sm:justify-center">
        <button class="cat-filter-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-parrilla-gold text-parrilla-dark shadow-md transition" data-category="all">
          Todos los Platos
        </button>
        {categories.map(cat => (
          <button class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-parrilla-surface text-parrilla-ivory hover:text-parrilla-gold border border-parrilla-border transition" data-category={cat.id}>
            {cat.name}
          </button>
        ))}
      </div>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="products-grid">
      {products.map(prod => (
        <div class="product-card group bg-parrilla-surface/70 hover:bg-parrilla-surface rounded-2xl border border-parrilla-border hover:border-parrilla-gold/50 p-5 flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-parrilla-gold/5 hover:-translate-y-1" data-cat={prod.category_id}>
          <div>
            <div class="flex items-start justify-between gap-3 mb-2">
              <h3 class="font-display font-bold text-lg text-parrilla-ivory group-hover:text-parrilla-gold transition">
                {prod.name}
              </h3>
              {prod.is_featured === 1 && (
                <span class="flex-shrink-0 bg-parrilla-gold/20 text-parrilla-gold border border-parrilla-gold/40 text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider">
                  Estrella ⭐
                </span>
              )}
            </div>

            <p class="text-xs text-parrilla-muted leading-relaxed line-clamp-2 mb-4">
              {prod.description || 'Preparado con el toque especial de la casa a fuego de leña.'}
            </p>
          </div>

          <div class="pt-4 border-t border-parrilla-border/60 flex items-center justify-between">
            <div>
              <span class="text-[10px] text-parrilla-muted uppercase font-medium block">Precio</span>
              <span class="font-display font-extrabold text-xl text-parrilla-gold">
                {formatPrice(prod.price)}
              </span>
            </div>

            <a 
              href={`https://wa.me/573183821787?text=Hola%20San%20Parrilla,%20quiero%20pedir:%20${encodeURIComponent(prod.name)}`}
              target="_blank"
              class="inline-flex items-center gap-1.5 bg-parrilla-dark hover:bg-parrilla-gold text-parrilla-ivory hover:text-parrilla-dark font-bold text-xs px-3.5 py-2.5 rounded-xl border border-parrilla-border hover:border-parrilla-gold transition active:scale-95"
            >
              <i data-lucide="plus" class="w-3.5 h-3.5"></i>
              <span>Pedir</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Interactive JavaScript for Category Filtering -->
  <script>
    const filterButtons = document.querySelectorAll('.cat-filter-btn');
    const productCards = document.querySelectorAll('.product-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-parrilla-gold', 'text-parrilla-dark', 'active');
          b.classList.add('bg-parrilla-surface', 'text-parrilla-ivory');
        });

        btn.classList.add('bg-parrilla-gold', 'text-parrilla-dark', 'active');
        btn.classList.remove('bg-parrilla-surface', 'text-parrilla-ivory');

        const cat = btn.getAttribute('data-category');

        productCards.forEach(card => {
          const cardCat = card.getAttribute('data-cat');
          if (cat === 'all' || cardCat === cat) {
            // @ts-ignore
            card.style.display = 'flex';
          } else {
            // @ts-ignore
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
