---
export const prerender = true;
import PublicLayout from '../layouts/PublicLayout.astro';
import CartDrawer from '../components/CartDrawer.astro';
import QuickOrderView from '../components/QuickOrderView.astro';
import StyledMenuView from '../components/StyledMenuView.astro';
import { getCategories, getPublicProducts, getDailySpecials, fallbackCategories, fallbackDailySpecials } from '../lib/db.js';

const rawCategories = getCategories();
const categories = (rawCategories && rawCategories.length > 0) ? rawCategories : fallbackCategories;

// Solo platos del menú: los productos internos (ej. prueba de impresión) nunca llegan al público.
const rawProducts = getPublicProducts();
const CALIBRATED_BEVERAGE_PRICES: Record<string, { name: string; price: number }> = {
  'botella de agua': { name: 'Botella de Agua', price: 3000 },
  'agua': { name: 'Botella de Agua', price: 3000 },
  'cerveza club colombia / aguila': { name: 'Cerveza Club Colombia / Águila', price: 5500 },
  'cerveza': { name: 'Cerveza Club Colombia / Águila', price: 5500 },
  'gaseosa 1.5l': { name: 'Gaseosa 1.5L', price: 8000 },
  'gaseosa 400ml': { name: 'Gaseosa 400ml', price: 4000 },
  'jugo natural en agua': { name: 'Jugo Natural en Agua', price: 8500 },
  'jugo natural en leche': { name: 'Jugo Natural en Leche', price: 9500 },
  'soda': { name: 'Soda', price: 4500 },
  'porcion de papas a la francesa': { name: 'Porción de Papas a la Francesa', price: 5500 },
  'porcion de papa a la francesa': { name: 'Porción de Papas a la Francesa', price: 5500 },
  'porcion papas a la francesa': { name: 'Porción de Papas a la Francesa', price: 5500 },
};

const normKey = (s: string) =>
  String(s || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();

const seenPublicKeys = new Set<string>();
const products = rawProducts
  .filter((p) => {
    const n = normKey(p.name);
    if (n.includes('patacon con hogao')) return false;
    if (p.is_active === 0 || p.disponible === false) return false;
    return true;
  })
  .map((p) => {
    let item = { ...p };
    const n = normKey(item.name);
    if (n === 'espaguetis con pollo' || n === 'espagueti con pollo') {
      item.name = 'Espagueti con pollo';
    }
    if (CALIBRATED_BEVERAGE_PRICES[n]) {
      item.name = CALIBRATED_BEVERAGE_PRICES[n].name;
      item.price = CALIBRATED_BEVERAGE_PRICES[n].price;
    }
    if (item.id === 'pic-4' || item.name === 'Picada Berraca') {
      item = {
        ...item,
        is_featured: 0,
        description: 'Lomo de cerdo, chorizo, chicharrón, costillas de cerdo, papa a la francesa.',
      };
    }
    return item;
  })
  .filter((p) => {
    const scope = p.id.startsWith('rap-') || p.menu_type === 'rapidas' ? 'rap' : 'alm';
    const key = `${scope}:${normKey(p.name)}`;
    if (seenPublicKeys.has(key)) return false;
    seenPublicKeys.add(key);
    return true;
  });

const dailySpecials = getDailySpecials() || fallbackDailySpecials;

// Platos fuertes: llevan sopa, principio, acompañamiento y ensalada a elección en el carrito.
// Picadas y bebidas se agregan tal cual, sin esas opciones.
const customizableCategories = new Set(['especiales_hoy', 'fuertes_165', 'fuertes_175', 'especiales_21']);

// Separación limpia: Almuerzos (Día) vs Comidas Rápidas (Noche)
// En la carta pública excluimos desayunos y convenios institucionales
const lunchProducts = products.filter(
  (p) => !p.id.startsWith('rap-') &&
         p.menu_type !== 'rapidas' &&
         p.category_id !== 'desayunos' &&
         !p.name.toLowerCase().includes('desayuno')
);
const rapidasProducts = products.filter((p) => p.id.startsWith('rap-') || p.menu_type === 'rapidas');

const rapidasCatCards = [
  { id: 'hamburguesas', title: 'Hamburguesas', icon: '🍔' },
  { id: 'perros_calientes', title: 'Perros Calientes', icon: '🌭' },
  { id: 'salchipapas_papas_locas', title: 'Salchipapas y Papas Locas', icon: '🍟' },
  { id: 'patacones', title: 'Patacones', icon: '🫓' },
  { id: 'sandwich', title: 'Sándwiches', icon: '🥪' },
  { id: 'picadas_noche', title: 'Picadas Noche', icon: '🥩' },
  { id: 'especiales_noche', title: 'Especiales Noche', icon: '🔥' },
  { id: 'bebidas', title: 'Granizados, Jugos y Bebidas', icon: '🥤', catIds: ['granizados_jugos', 'bebidas_rapidas'] },
];

// Group products by category
const productsByCat = {};
categories.forEach(cat => {
  productsByCat[cat.id] = products.filter(p => p.category_id === cat.id);
});

// Format Colombian Peso
const formatPrice = (val) => {
  return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
};
---

<PublicLayout title="San Parrilla | Menú Digital & Brasas">
  <!-- Hero Section -->
  <section class="w-full relative overflow-hidden border-b border-parrilla-border bg-gradient-to-b from-slate-100/60 to-parrilla-dark">
    <!-- Background Image with Soft Light Warm Overlay -->
    <div class="absolute inset-0 z-0 w-full h-full pointer-events-none">
      <img
        src="/hero-bg.jpg"
        alt="Parrilla San Parrilla"
        class="absolute inset-0 w-full h-full object-cover object-center filter brightness-105 opacity-25"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-parrilla-dark via-parrilla-dark/75 to-transparent"></div>
    </div>

    <div class="px-4 py-8 sm:py-12 relative z-10 w-full max-w-md mx-auto flex flex-col items-center text-center">
      <h1 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-parrilla-ivory mb-5 sm:mb-6 leading-tight">
        RESTAURANTE <span class="text-transparent bg-clip-text bg-gradient-to-r from-parrilla-gold via-orange-600 to-amber-700">SAN PARRILLA</span>
      </h1>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full">
        <a
          href="#menu-carta"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-extrabold px-6 py-3 rounded-xl text-sm sm:text-base shadow-md hover:shadow-lg transition active:scale-95"
        >
          <i data-lucide="book-open" class="w-4 h-4 sm:w-5 sm:h-5"></i>
          <span>Ver Carta Completa</span>
        </a>

        <a
          href="https://wa.me/573183821787?text=Hola%20San%20Parrilla,%20deseo%20hacer%20un%20pedido"
          target="_blank"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 text-parrilla-ivory hover:text-parrilla-gold font-bold px-6 py-3 rounded-xl border border-parrilla-border text-sm sm:text-base shadow-sm transition active:scale-95"
        >
          <i data-lucide="message-circle" class="w-4 h-4 sm:w-5 sm:h-5 text-parrilla-accent"></i>
          <span>Pedir a Domicilio</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Menu Carta Section -->
  <section id="menu-carta" class="w-full max-w-lg lg:max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-24">
    <!-- Selector Prominente de Menú: ☀️ Almuerzos vs 🍔 Comidas Rápidas -->
    <div class="flex flex-col items-center justify-center mb-6 sm:mb-10 w-full">
      <span class="text-[10px] sm:text-xs font-black uppercase tracking-[0.2em] text-parrilla-gold block mb-2 text-center">
        SELECCIONA TU MENÚ
      </span>
      <div
        class="inline-flex items-center justify-center bg-white p-1 rounded-2xl border-2 border-parrilla-gold/40 shadow-md w-full max-w-md mx-auto"
        role="tablist"
        aria-label="Selector de menú"
      >
        <button
          type="button"
          data-menu-switch="almuerzos"
          class="menu-switch-btn active flex-1 px-3 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-black transition bg-parrilla-gold text-white shadow-xs cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span class="text-base sm:text-lg">☀️</span>
          <span class="truncate">Almuerzos</span>
        </button>
        <button
          type="button"
          data-menu-switch="rapidas"
          class="menu-switch-btn flex-1 px-3 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition text-parrilla-ivory hover:text-parrilla-gold cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span class="text-base sm:text-lg">🍔</span>
          <span class="truncate">Comidas Rápidas</span>
        </button>
      </div>
    </div>

    <!-- Vista 1: ☀️ Almuerzos (Activa por defecto en el día) -->
    <div id="view-panel-almuerzos">
      <QuickOrderView
        products={lunchProducts}
        dailySpecials={dailySpecials}
        customizableCategories={customizableCategories}
        showDesayunos={false}
      />
    </div>

    <!-- Vista 2: 🍔 Comidas Rápidas (Turno Noche) -->
    <div id="view-panel-rapidas" class="hidden space-y-8 sm:space-y-12">
      <div class="text-center max-w-2xl mx-auto px-2">
        <span class="text-[10px] sm:text-xs font-extrabold uppercase tracking-[0.2em] text-parrilla-gold block mb-1">
          TURNO NOCHE & BRASAS
        </span>
        <h2 class="font-display font-black text-2xl sm:text-4xl text-parrilla-ivory">
          Comidas Rápidas
        </h2>
        <p class="text-xs sm:text-sm text-parrilla-muted mt-1">
          Hamburguesas artesanales, perros calientes, salchipapas, patacones, sándwiches, picadas de la casa y bebidas.
        </p>
      </div>

      <!-- Grid de 2 columnas compactas (grid-cols-1 sm:grid-cols-2) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-5 px-0 items-start">
        {rapidasCatCards.map((cat) => {
          const catItems = cat.catIds
            ? rapidasProducts.filter((p) => cat.catIds.includes(p.category_id))
            : rapidasProducts.filter((p) => p.category_id === cat.id);
          if (catItems.length === 0) return null;
          return (
            <div class="bg-white rounded-xl sm:rounded-2xl border border-parrilla-border border-t-2 border-t-parrilla-gold p-3 sm:p-5 shadow-sm flex flex-col" data-cat={cat.id}>
              <div class="text-center border-b border-parrilla-border pb-2 sm:pb-3 mb-2 sm:mb-3">
                <span class="font-display font-black text-sm sm:text-lg text-parrilla-gold tracking-tight flex items-center justify-center gap-1.5 uppercase">
                  <span>{cat.icon}</span>
                  <span>{cat.title}</span>
                </span>
              </div>
              <ul class="divide-y divide-gray-100">
                {catItems.map((item) => (
                  <li class="flex items-center justify-between gap-2 py-2 sm:py-2.5">
                    <span class="text-xs sm:text-sm font-semibold text-parrilla-ivory leading-tight min-w-0 flex-1">
                      {item.name}
                    </span>
                    <div class="flex items-center gap-2 flex-shrink-0">
                      <span class="font-display font-black text-xs sm:text-sm text-parrilla-gold font-mono">
                        {formatPrice(item.price)}
                      </span>
                      <button
                        type="button"
                        data-name={item.name}
                        data-price={item.price}
                        data-customizable="false"
                        aria-label={`Agregar ${item.name} al pedido`}
                        class="btn-add-cart w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-orange-50 hover:bg-parrilla-gold text-parrilla-gold hover:text-white border border-orange-200 hover:border-parrilla-gold flex items-center justify-center transition active:scale-90 cursor-pointer font-bold text-sm"
                      >
                        +
                      </button>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Script de alternancia de menú: ☀️ Almuerzos vs 🍔 Comidas Rápidas -->
  <script>
    function setClientActiveMenu(menu: string, scrollIntoMenu = false) {
      const isAlmuerzos = menu !== 'rapidas';
      const almuerzosPanel = document.getElementById('view-panel-almuerzos');
      const rapidasPanel = document.getElementById('view-panel-rapidas');

      if (almuerzosPanel) almuerzosPanel.classList.toggle('hidden', !isAlmuerzos);
      if (rapidasPanel) rapidasPanel.classList.toggle('hidden', isAlmuerzos);

      document.querySelectorAll('[data-menu-switch]').forEach((btn) => {
        const btnMenu = btn.getAttribute('data-menu-switch');
        const isActive = (isAlmuerzos && btnMenu === 'almuerzos') || (!isAlmuerzos && btnMenu === 'rapidas');
        btn.classList.toggle('bg-parrilla-gold', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('shadow-xs', isActive);
        btn.classList.toggle('font-black', isActive);
        btn.classList.toggle('text-parrilla-ivory', !isActive);
        btn.classList.toggle('hover:text-parrilla-gold', !isActive);
        btn.classList.toggle('font-extrabold', !isActive);
      });

      if (scrollIntoMenu) {
        const menuSection = document.getElementById('menu-carta');
        if (menuSection && window.scrollY < menuSection.offsetTop - 100) {
          menuSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      try {
        localStorage.setItem('sp_active_client_menu', isAlmuerzos ? 'almuerzos' : 'rapidas');
      } catch (_) {}
    }

    document.querySelectorAll('[data-menu-switch]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetMenu = btn.getAttribute('data-menu-switch') || 'almuerzos';
        const inHeader = Boolean(btn.closest('header'));
        setClientActiveMenu(targetMenu, inHeader);
      });
    });

    try {
      const saved = localStorage.getItem('sp_active_client_menu');
      if (saved === 'rapidas') {
        setClientActiveMenu('rapidas', false);
      }
    } catch (_) {}
  </script>

  <!-- Carrito flotante (pedido local, campos de entrega/pago y envío por WhatsApp) -->
  <CartDrawer specials={dailySpecials} />

  <style>
    /* Carta pública móvil: alinear cuadrícula al 100% simétrica con los márgenes del navbar y evitar desbordes */
    @media (max-width: 639px) {
      #view-panel-almuerzos :global(.grid) {
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: auto !important;
        margin-right: auto !important;
        width: 100% !important;
        max-width: 100% !important;
        justify-content: center !important;
      }
      #view-panel-almuerzos :global(section) {
        margin-left: auto !important;
        margin-right: auto !important;
        width: 100% !important;
      }
      #view-panel-almuerzos :global(.max-w-2xl) {
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: auto !important;
        margin-right: auto !important;
        max-width: 100% !important;
      }
    }
  </style>
</PublicLayout>
