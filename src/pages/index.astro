---
export const prerender = true;
import PublicLayout from '../layouts/PublicLayout.astro';
import CartDrawer from '../components/CartDrawer.astro';
import QuickOrderView from '../components/QuickOrderView.astro';
import StyledMenuView from '../components/StyledMenuView.astro';
import { getCategories, getPublicProducts, getDailySpecials, fallbackCategories, fallbackDailySpecials } from '../lib/db.js';

const rawCategories = getCategories();
const categories = (rawCategories && rawCategories.length > 0) ? rawCategories : fallbackCategories;

// Solo platos del menú: los productos internos (ej. prueba de impresión) nunca llegan al público.
const products = getPublicProducts();

const dailySpecials = getDailySpecials() || fallbackDailySpecials;

// Platos fuertes: llevan sopa, principio, acompañamiento y ensalada a elección en el carrito.
// Picadas y bebidas se agregan tal cual, sin esas opciones.
const customizableCategories = new Set(['especiales_hoy', 'fuertes_165', 'fuertes_175', 'especiales_21']);

// Group products by category
const productsByCat = {};
categories.forEach(cat => {
  productsByCat[cat.id] = products.filter(p => p.category_id === cat.id);
});

// Format Colombian Peso
const formatPrice = (val) => {
  return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val);
};
---

<PublicLayout title="San Parrilla | Menú Digital & Brasas">
  <!-- Hero Section -->
  <section class="relative min-h-[50vh] sm:min-h-[58vh] flex items-center justify-center overflow-hidden border-b border-parrilla-border bg-gradient-to-b from-slate-100/60 to-parrilla-dark">
    <!-- Background Image with Soft Light Warm Overlay -->
    <div class="absolute inset-0 z-0">
      <img src="/hero-bg.jpg" alt="Parrilla San Parrilla" class="w-full h-full object-cover object-center filter brightness-105 opacity-20 scale-105 transform hover:scale-100 transition duration-1000" />
      <div class="absolute inset-0 bg-gradient-to-t from-parrilla-dark via-parrilla-dark/70 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 py-16 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-100 border border-orange-200 text-parrilla-gold font-bold text-xs sm:text-sm tracking-wide uppercase mb-6 shadow-sm">
        <span>🔥</span> Tradición, Fogón y Brasas
      </div>

      <h1 class="font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight text-parrilla-ivory mb-4">
        RESTAURANTE <span class="text-transparent bg-clip-text bg-gradient-to-r from-parrilla-gold via-orange-600 to-amber-700">SAN PARRILLA</span>
      </h1>

      <p class="text-base sm:text-xl text-parrilla-muted max-w-2xl mx-auto mb-8 font-normal leading-relaxed">
        Carnes selectas al carbón, cortes premium, menú casero del día y las mejores picadas para compartir en familia.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#menu-carta" class="inline-flex items-center gap-2 bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-extrabold px-6 py-3.5 rounded-xl text-base shadow-md hover:shadow-lg transition active:scale-95">
          <i data-lucide="book-open" class="w-5 h-5"></i>
          <span>Ver Carta Completa</span>
        </a>

        <a href="https://wa.me/573183821787?text=Hola%20San%20Parrilla,%20deseo%20hacer%20un%20pedido" target="_blank" class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-parrilla-ivory hover:text-parrilla-gold font-bold px-6 py-3.5 rounded-xl border border-parrilla-border text-base shadow-sm transition active:scale-95">
          <i data-lucide="message-circle" class="w-5 h-5 text-parrilla-accent"></i>
          <span>Pedir a Domicilio</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Especiales de Hoy (Sopa, Principios, Acompañamientos) -->
  {dailySpecials && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
      <div class="bg-white rounded-2xl border border-parrilla-border p-6 sm:p-8 shadow-xl">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-parrilla-border pb-5 mb-6">
          <div>
            <span class="text-xs font-bold text-parrilla-gold uppercase tracking-widest">Incluido con tus Platos Fuertes</span>
            <h2 class="font-display font-black text-2xl sm:text-3xl text-parrilla-ivory mt-0.5">Especiales del Día</h2>
          </div>
          <div class="inline-flex items-center gap-2 bg-slate-50 px-3.5 py-1.5 rounded-lg border border-parrilla-border text-xs text-parrilla-muted">
            <i data-lucide="sparkles" class="w-4 h-4 text-parrilla-gold"></i>
            <span>Sazón casera fresca de hoy</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Sopa -->
          <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80 hover:border-parrilla-gold/40 transition">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-orange-100 border border-orange-200 flex items-center justify-center text-parrilla-gold">
                <i data-lucide="soup" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="text-[11px] text-parrilla-muted uppercase tracking-wider font-semibold">Entrada</span>
                <h3 class="font-bold text-sm text-parrilla-ivory">Sopa del Día</h3>
              </div>
            </div>
            <div class="text-xl font-display font-black text-parrilla-gold mt-1">
              {dailySpecials.sopa}
            </div>
            <p class="text-xs text-parrilla-muted mt-2">Con caldo artesanal y hierbas del campo.</p>
          </div>

          <!-- Principios -->
          <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80 hover:border-parrilla-gold/40 transition">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-green-100 border border-green-200 flex items-center justify-center text-parrilla-accent">
                <i data-lucide="utensils" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="text-[11px] text-parrilla-muted uppercase tracking-wider font-semibold">Elige 1</span>
                <h3 class="font-bold text-sm text-parrilla-ivory">Principios</h3>
              </div>
            </div>
            <ul class="space-y-1.5">
              {dailySpecials.principios.map(p => (
                <li class="flex items-center gap-2 text-sm text-parrilla-ivory">
                  <i data-lucide="check-circle-2" class="w-4 h-4 text-parrilla-accent flex-shrink-0"></i>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Acompañamientos -->
          <div class="bg-slate-50 rounded-xl p-5 border border-slate-200/80 hover:border-parrilla-gold/40 transition">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-amber-100 border border-amber-200 flex items-center justify-center text-amber-700">
                <i data-lucide="salad" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="text-[11px] text-parrilla-muted uppercase tracking-wider font-semibold">Elige 1</span>
                <h3 class="font-bold text-sm text-parrilla-ivory">Acompañamientos</h3>
              </div>
            </div>
            <ul class="space-y-1.5">
              {dailySpecials.acompanamientos.map(a => (
                <li class="flex items-center gap-2 text-sm text-parrilla-ivory">
                  <i data-lucide="check-circle-2" class="w-4 h-4 text-parrilla-gold flex-shrink-0"></i>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Menu Carta Section -->
  <section id="menu-carta" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Selector de Vista Destacado -->
    <div class="flex flex-col items-center justify-center mb-10">
      <span class="text-[11px] font-bold uppercase tracking-widest text-parrilla-muted mb-2">Elige cómo prefieres ver el menú</span>
      <div
        class="inline-flex items-center bg-white p-1.5 rounded-2xl border border-parrilla-border shadow-md"
        role="tablist"
        aria-label="Selector de vista de la carta"
      >
        <button
          type="button"
          data-menu-view="quick"
          role="tab"
          aria-selected="true"
          class="menu-view-btn px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition bg-parrilla-gold text-white shadow-sm"
        >
          ⚡ Pedidos Rápidos
        </button>
        <button
          type="button"
          data-menu-view="styled"
          role="tab"
          aria-selected="false"
          class="menu-view-btn px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition text-parrilla-ivory hover:text-parrilla-gold"
        >
          📖 Carta Estilizada
        </button>
      </div>
    </div>

    <!-- Vista 1 (Por defecto): ⚡ Pedidos Rápidos -->
    <div id="view-panel-quick">
      <QuickOrderView products={products} customizableCategories={customizableCategories} />
    </div>

    <!-- Vista 2 (Alternativa): 📖 Carta Estilizada ("La Carta del Asador") -->
    <div id="view-panel-styled" class="hidden">
      <StyledMenuView categories={categories} products={products} customizableCategories={customizableCategories} />
    </div>
  </section>

  <!-- Alternancia instantánea entre vistas sin recargar ni perder el carrito -->
  <script>
    const viewButtons = document.querySelectorAll('.menu-view-btn');
    const quickPanel = document.getElementById('view-panel-quick');
    const styledPanel = document.getElementById('view-panel-styled');

    function setActiveMenuView(view: string, scrollIntoMenu = false) {
      const isQuick = view !== 'styled';
      quickPanel?.classList.toggle('hidden', !isQuick);
      styledPanel?.classList.toggle('hidden', isQuick);

      viewButtons.forEach((btn) => {
        const active = btn.getAttribute('data-menu-view') === (isQuick ? 'quick' : 'styled');
        btn.setAttribute('aria-selected', String(active));
        btn.classList.toggle('bg-parrilla-gold', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('shadow-sm', active);
        btn.classList.toggle('text-parrilla-ivory', !active);
        btn.classList.toggle('hover:text-parrilla-gold', !active);
      });

      if (scrollIntoMenu) {
        const menuSection = document.getElementById('menu-carta');
        if (menuSection && window.scrollY < menuSection.offsetTop - 140) {
          menuSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    viewButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetView = btn.getAttribute('data-menu-view') || 'quick';
        const inHeader = Boolean(btn.closest('header'));
        setActiveMenuView(targetView, inHeader);
      });
    });
  </script>

  <!-- Carrito flotante (pedido local compartido por ambas vistas, se envía por WhatsApp) -->
  <CartDrawer specials={dailySpecials} />
</PublicLayout>
