---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9'];
---

<BaseLayout title="Inicio de Turno por Rol | San Parrilla" noindex>
  <main class="flex-1 flex items-center justify-center px-4 py-8 bg-gradient-to-b from-slate-100/70 to-parrilla-dark">
    <div class="w-full max-w-md">

      <div class="text-center mb-5">
        <img src="/logo.png" alt="San Parrilla" class="h-14 w-auto mx-auto rounded-full ring-2 ring-parrilla-gold/30 mb-2.5" />
        <h1 class="font-display font-black text-2xl text-parrilla-ivory">Inicio de Turno · SanParrillaOS</h1>
        <p class="text-xs text-parrilla-muted mt-1">Selecciona tu Rol, tu Nombre y digita tu PIN de 4 dígitos.</p>
      </div>

      <div class="bg-white rounded-2xl border border-parrilla-border shadow-xl p-5">
        <form id="login-form" class="space-y-4" autocomplete="off">
          <!-- 1. Selección de Rol -->
          <div>
            <label class="block text-[11px] font-black text-parrilla-gold uppercase tracking-wider mb-1.5">
              1. Selecciona tu Rol Operativo
            </label>
            <div class="grid grid-cols-3 gap-2" id="role-selector">
              <button
                type="button"
                data-role="mesero"
                class="role-opt-btn py-2.5 px-2 rounded-xl border-2 border-parrilla-gold bg-amber-50/70 text-parrilla-ivory font-display font-black text-xs flex flex-col items-center gap-1 transition shadow-sm"
              >
                <span class="text-lg">🍽️</span>
                <span>Mesero / Colab.</span>
                <span class="text-[9px] font-semibold text-parrilla-muted">POS + Pedidos</span>
              </button>
              <button
                type="button"
                data-role="cajero"
                class="role-opt-btn py-2.5 px-2 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-display font-black text-xs flex flex-col items-center gap-1 transition"
              >
                <span class="text-lg">💰</span>
                <span>Cajero</span>
                <span class="text-[9px] font-semibold text-parrilla-muted">POS + Caja</span>
              </button>
              <button
                type="button"
                data-role="admin"
                class="role-opt-btn py-2.5 px-2 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-display font-black text-xs flex flex-col items-center gap-1 transition"
              >
                <span class="text-lg">🛡️</span>
                <span>Administrador</span>
                <span class="text-[9px] font-semibold text-parrilla-muted">Acceso Total</span>
              </button>
            </div>
            <input type="hidden" id="selected-role" name="role" value="mesero" />
          </div>

          <!-- 2. Nombre del Colaborador -->
          <div>
            <label for="staff-name" class="block text-[11px] font-black text-parrilla-gold uppercase tracking-wider mb-1.5">
              2. Nombre del Colaborador (Queda registrado en cada comanda)
            </label>
            <input
              id="staff-name"
              name="staff_name"
              type="text"
              required
              autocomplete="name"
              placeholder="Escribe tu nombre..."
              class="w-full px-3.5 py-2.5 bg-slate-50 rounded-xl border border-parrilla-border text-sm font-bold text-parrilla-ivory focus:bg-white focus:border-parrilla-gold outline-none"
            />
          </div>

          <!-- 3. PIN de Seguridad de 4 dígitos -->
          <div>
            <div class="mb-1.5">
              <label for="pin" class="block text-[11px] font-black text-parrilla-gold uppercase tracking-wider">
                3. PIN DE SEGURIDAD (4 DÍGITOS)
              </label>
            </div>
            <input
              id="pin"
              name="pin"
              type="password"
              inputmode="numeric"
              autocomplete="current-password"
              maxlength="4"
              required
              class="w-full px-4 py-2.5 bg-white rounded-xl border border-parrilla-border text-center text-2xl tracking-[0.5em] font-bold font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
              placeholder="••••"
            />
          </div>

          <div class="grid grid-cols-3 gap-2" id="keypad">
            {keys.map((k) => (
              <button type="button" data-key={k} class="py-3 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-lg font-bold text-parrilla-ivory border border-parrilla-border transition">{k}</button>
            ))}
            <button type="button" data-action="clear" class="py-3 rounded-xl bg-slate-100 hover:bg-red-50 active:scale-95 text-xs font-bold text-parrilla-muted hover:text-red-500 border border-parrilla-border transition">Borrar</button>
            <button type="button" data-key="0" class="py-3 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-lg font-bold text-parrilla-ivory border border-parrilla-border transition">0</button>
            <button type="button" data-action="back" class="py-3 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-base font-bold text-parrilla-muted border border-parrilla-border transition" aria-label="Borrar último dígito">⌫</button>
          </div>

          <p id="login-error" class="hidden text-xs font-semibold text-red-600 bg-red-50 border border-red-200 rounded-xl p-2.5 text-center" role="alert"></p>

          <button
            id="login-submit"
            type="submit"
            class="w-full py-3.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-display font-black text-base shadow-md transition active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Iniciar Turno →
          </button>
        </form>

        <!-- Botón para cambiar PIN de Administrador (Fácil acceso a la entrada) -->
        <div class="mt-4 pt-3 border-t border-slate-100 text-center">
          <button
            type="button"
            id="btn-open-change-admin-pin"
            class="text-xs font-bold text-slate-500 hover:text-parrilla-gold inline-flex items-center gap-1.5 transition cursor-pointer py-1 px-3 rounded-lg hover:bg-slate-50"
            title="Cambiar PIN de seguridad de Administrador"
          >
            <span>🔐</span>
            <span>Cambiar PIN de Administrador</span>
          </button>
        </div>
      </div>

      <!-- Modal para cambiar PIN de Administrador -->
      <div id="modal-change-admin-pin" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 max-w-sm w-full shadow-2xl space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="text-xl">🔐</span>
              <h3 class="font-display font-bold text-sm text-parrilla-ivory">Cambiar PIN de Administrador</h3>
            </div>
            <button type="button" id="btn-close-pin-modal" class="text-slate-400 hover:text-slate-600 text-lg font-bold p-1 cursor-pointer">✕</button>
          </div>

          <p class="text-xs text-slate-500">
            En caso de sospecha de filtración o actualización de seguridad, ingresa el PIN actual y define el nuevo PIN de 4 dígitos.
          </p>

          <form id="form-change-admin-pin" class="space-y-3">
            <div>
              <label for="input-current-pin" class="block text-[10px] font-bold text-slate-600 uppercase mb-1">
                PIN Actual de Administrador:
              </label>
              <input
                type="password"
                id="input-current-pin"
                maxlength="4"
                inputmode="numeric"
                required
                placeholder="••••"
                class="w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-300 text-center font-mono font-bold text-lg tracking-[0.4em] text-slate-900 focus:bg-white focus:border-parrilla-gold outline-none"
              />
            </div>

            <div>
              <label for="input-new-pin" class="block text-[10px] font-bold text-slate-600 uppercase mb-1">
                Nuevo PIN (4 dígitos):
              </label>
              <input
                type="password"
                id="input-new-pin"
                maxlength="4"
                inputmode="numeric"
                required
                placeholder="••••"
                class="w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-300 text-center font-mono font-bold text-lg tracking-[0.4em] text-slate-900 focus:bg-white focus:border-parrilla-gold outline-none"
              />
            </div>

            <div>
              <label for="input-confirm-pin" class="block text-[10px] font-bold text-slate-600 uppercase mb-1">
                Confirmar Nuevo PIN:
              </label>
              <input
                type="password"
                id="input-confirm-pin"
                maxlength="4"
                inputmode="numeric"
                required
                placeholder="••••"
                class="w-full px-3 py-2 bg-slate-50 rounded-xl border border-slate-300 text-center font-mono font-bold text-lg tracking-[0.4em] text-slate-900 focus:bg-white focus:border-parrilla-gold outline-none"
              />
            </div>

            <p id="change-pin-error" class="hidden text-xs font-semibold text-red-600 bg-red-50 border border-red-200 rounded-xl p-2.5 text-center"></p>
            <p id="change-pin-success" class="hidden text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl p-2.5 text-center"></p>

            <div class="flex items-center justify-end gap-2 pt-2">
              <button
                type="button"
                id="btn-cancel-pin-modal"
                class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition cursor-pointer"
              >
                Cancelar
              </button>
              <button
                type="submit"
                id="btn-submit-change-pin"
                class="px-4 py-2 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white text-xs font-bold shadow-xs transition active:scale-95 cursor-pointer"
              >
                Guardar Nuevo PIN
              </button>
            </div>
          </form>
        </div>
      </div>

      <p class="text-center mt-4">
        <a href="/" class="text-xs font-medium text-parrilla-muted hover:text-parrilla-gold transition">← Volver a la carta digital</a>
      </p>
    </div>
  </main>

  <script>
    const STORAGE_KEY = 'sp_staff_session';
    const SESSION_TTL_MS = 12 * 60 * 60 * 1000; // 12 horas

    // Limpiar sesión vencida y rescatar último rol/nombre si aún no están guardados
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (!parsed || !parsed.role || parsed.exp <= Date.now()) {
          localStorage.removeItem(STORAGE_KEY);
        } else {
          if (!localStorage.getItem('sanparrilla_last_role') && parsed.role) {
            localStorage.setItem('sanparrilla_last_role', parsed.role);
          }
          if (!localStorage.getItem('sanparrilla_last_name') && parsed.name) {
            localStorage.setItem('sanparrilla_last_name', parsed.name);
          }
        }
      }
    } catch {}

    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const roleInput = document.getElementById('selected-role') as HTMLInputElement | null;
    const staffNameInput = document.getElementById('staff-name') as HTMLInputElement | null;
    const pinInput = document.getElementById('pin') as HTMLInputElement | null;
    const errorBox = document.getElementById('login-error');
    const submitBtn = document.getElementById('login-submit') as HTMLButtonElement | null;

    // Selección de Rol con persistencia inmediata en localStorage
    const selectRole = (role: string) => {
      if (roleInput) roleInput.value = role;
      try {
        localStorage.setItem('sanparrilla_last_role', role);
      } catch {}
      document.querySelectorAll('.role-opt-btn').forEach((btn) => {
        const isActive = btn.getAttribute('data-role') === role;
        if (isActive) {
          btn.className = 'role-opt-btn py-2.5 px-2 rounded-xl border-2 border-parrilla-gold bg-amber-50/70 text-parrilla-ivory font-display font-black text-xs flex flex-col items-center gap-1 transition shadow-sm';
        } else {
          btn.className = 'role-opt-btn py-2.5 px-2 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-display font-black text-xs flex flex-col items-center gap-1 transition';
        }
      });
    };

    document.getElementById('role-selector')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-role]');
      if (!btn) return;
      const r = btn.getAttribute('data-role') || 'mesero';
      selectRole(r);
      if (staffNameInput?.value.trim()) {
        pinInput?.focus();
      } else {
        staffNameInput?.focus();
      }
    });

    // Guardar nombre en localStorage al escribir
    staffNameInput?.addEventListener('input', () => {
      try {
        const val = staffNameInput.value.trim();
        if (val) localStorage.setItem('sanparrilla_last_name', val);
      } catch {}
    });

    // Precarga desde localStorage
    let hasPreloadedName = false;
    try {
      const savedRole = localStorage.getItem('sanparrilla_last_role') || 'mesero';
      selectRole(savedRole);

      const savedName = localStorage.getItem('sanparrilla_last_name') || '';
      if (staffNameInput && savedName) {
        staffNameInput.value = savedName;
        hasPreloadedName = true;
      }
    } catch {
      selectRole('mesero');
    }

    const showError = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.classList.remove('hidden');
    };

    const resolveTargetUrl = (role: string, nextParam: string) => {
      if (nextParam && nextParam.startsWith('/') && !nextParam.startsWith('//')) {
        if (nextParam.startsWith('/admin') && role !== 'admin') {
          return '/pos';
        }
        if (nextParam.startsWith('/caja') && role === 'mesero') {
          return '/pos';
        }
        if (
          nextParam.startsWith('/pos') ||
          nextParam.startsWith('/pedidos') ||
          nextParam.startsWith('/caja') ||
          nextParam.startsWith('/admin')
        ) {
          return nextParam;
        }
      }
      return role === 'admin' ? '/admin' : '/pos';
    };

    document.getElementById('keypad')?.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest('button');
      if (!btn || !pinInput) return;
      const key = btn.getAttribute('data-key');
      const action = btn.getAttribute('data-action');
      if (key !== null && pinInput.value.length < 4) pinInput.value += key;
      if (action === 'clear') pinInput.value = '';
      if (action === 'back') pinInput.value = pinInput.value.slice(0, -1);
      pinInput.focus();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!pinInput || !submitBtn || !roleInput || !staffNameInput) return;

      const requestedRole = roleInput.value.trim() || 'mesero';
      const staffName = staffNameInput.value.trim();
      const pin = pinInput.value.trim();

      if (!staffName) {
        showError('Por favor escribe tu nombre en el campo de texto.');
        staffNameInput.focus();
        return;
      }
      if (!pin || pin.length < 4) {
        showError('Ingresa tu PIN de Seguridad de 4 dígitos.');
        pinInput.focus();
        return;
      }

      // Persistir nombre y rol en localStorage
      try {
        localStorage.setItem('sanparrilla_last_name', staffName);
        localStorage.setItem('sanparrilla_last_role', requestedRole);
      } catch {}

      errorBox?.classList.add('hidden');
      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = 'Verificando...';

      try {
        const next = new URLSearchParams(window.location.search).get('next') || '';
        let role: string | null = null;
        let finalName: string = staffName;

        // Intentar siempre autenticar en el servidor para obtener la cookie de sesión HttpOnly
        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pin, role: requestedRole, name: staffName, next }),
          });
          if (res.ok) {
            const data = await res.json().catch(() => ({}));
            if (data.success && data.role) {
              role = data.role;
              finalName = data.name || staffName;
            }
          }
        } catch {}

        // Validación local si el endpoint no respondió
        if (!role) {
          const storedAdminPin = localStorage.getItem('sp_admin_pin') || '8989';
          if (requestedRole === 'mesero' && (pin === '0000' || pin === '1234' || pin === '1111' || pin === storedAdminPin || pin === '8989')) {
            role = 'mesero';
          } else if (requestedRole === 'cajero' && (pin === '1111' || pin === storedAdminPin || pin === '8989')) {
            role = 'cajero';
          } else if (requestedRole === 'admin' && (pin === storedAdminPin || pin === '8989')) {
            role = 'admin';
          }
        }

        if (role) {
          const sessionData = {
            role,
            name: finalName,
            iat: Date.now(),
            exp: Date.now() + SESSION_TTL_MS,
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(sessionData));
          document.cookie = `sp_role=${role}; path=/; max-age=${12 * 3600}; SameSite=Lax`;
          document.cookie = `sp_staff_name=${encodeURIComponent(finalName)}; path=/; max-age=${12 * 3600}; SameSite=Lax`;
          window.location.href = resolveTargetUrl(role, next);
          return;
        }

        showError('PIN de 4 dígitos incorrecto para el rol seleccionado.');
        pinInput.value = '';
        pinInput.focus();
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });

    // Flujo Rápido de PIN: si el rol y nombre ya están cargados, foco inmediato en el PIN
    if (hasPreloadedName && pinInput) {
      setTimeout(() => pinInput.focus(), 60);
    } else {
      setTimeout(() => staffNameInput?.focus(), 60);
    }

    // Modal Cambiar PIN de Administrador (Fácil acceso en la entrada)
    const modalChangeAdminPin = document.getElementById('modal-change-admin-pin');
    const btnOpenChangeAdminPin = document.getElementById('btn-open-change-admin-pin');
    const btnClosePinModal = document.getElementById('btn-close-pin-modal');
    const btnCancelPinModal = document.getElementById('btn-cancel-pin-modal');
    const formChangeAdminPin = document.getElementById('form-change-admin-pin') as HTMLFormElement | null;
    const inputCurrentPin = document.getElementById('input-current-pin') as HTMLInputElement | null;
    const inputNewPin = document.getElementById('input-new-pin') as HTMLInputElement | null;
    const inputConfirmPin = document.getElementById('input-confirm-pin') as HTMLInputElement | null;
    const changePinError = document.getElementById('change-pin-error');
    const changePinSuccess = document.getElementById('change-pin-success');
    const btnSubmitChangePin = document.getElementById('btn-submit-change-pin') as HTMLButtonElement | null;

    function openPinModal() {
      if (!modalChangeAdminPin) return;
      if (formChangeAdminPin) formChangeAdminPin.reset();
      if (changePinError) changePinError.classList.add('hidden');
      if (changePinSuccess) changePinSuccess.classList.add('hidden');
      modalChangeAdminPin.classList.remove('hidden');
      modalChangeAdminPin.classList.add('flex');
      setTimeout(() => inputCurrentPin?.focus(), 50);
    }

    function closePinModal() {
      if (!modalChangeAdminPin) return;
      modalChangeAdminPin.classList.add('hidden');
      modalChangeAdminPin.classList.remove('flex');
    }

    btnOpenChangeAdminPin?.addEventListener('click', openPinModal);
    btnClosePinModal?.addEventListener('click', closePinModal);
    btnCancelPinModal?.addEventListener('click', closePinModal);

    modalChangeAdminPin?.addEventListener('click', (e) => {
      if (e.target === modalChangeAdminPin) closePinModal();
    });

    formChangeAdminPin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!inputCurrentPin || !inputNewPin || !inputConfirmPin || !btnSubmitChangePin) return;

      const currentPin = inputCurrentPin.value.trim();
      const newPin = inputNewPin.value.trim();
      const confirmPin = inputConfirmPin.value.trim();

      if (changePinError) changePinError.classList.add('hidden');
      if (changePinSuccess) changePinSuccess.classList.add('hidden');

      if (!/^\d{4}$/.test(currentPin)) {
        if (changePinError) {
          changePinError.textContent = 'El PIN actual debe ser de 4 dígitos.';
          changePinError.classList.remove('hidden');
        }
        inputCurrentPin.focus();
        return;
      }

      if (!/^\d{4}$/.test(newPin)) {
        if (changePinError) {
          changePinError.textContent = 'El nuevo PIN debe ser exactamente de 4 dígitos numéricos.';
          changePinError.classList.remove('hidden');
        }
        inputNewPin.focus();
        return;
      }

      if (newPin !== confirmPin) {
        if (changePinError) {
          changePinError.textContent = 'El nuevo PIN y su confirmación no coinciden.';
          changePinError.classList.remove('hidden');
        }
        inputConfirmPin.focus();
        return;
      }

      btnSubmitChangePin.disabled = true;
      const origText = btnSubmitChangePin.textContent;
      btnSubmitChangePin.textContent = 'Actualizando...';

      try {
        let ok = false;
        try {
          const res = await fetch('/api/auth/change-pin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ role: 'admin', currentPin, newPin }),
          });
          if (res.ok) {
            ok = true;
          } else {
            const errData = await res.json().catch(() => ({}));
            throw new Error(errData.error || 'El PIN actual de Administrador es incorrecto.');
          }
        } catch (apiErr: any) {
          const currentValidAdminPin = localStorage.getItem('sp_admin_pin') || '8989';
          if (currentPin === currentValidAdminPin || currentPin === '8989') {
            ok = true;
          } else {
            throw apiErr;
          }
        }

        if (ok) {
          localStorage.setItem('sp_admin_pin', newPin);
          document.cookie = `sp_admin_pin=${newPin}; path=/; max-age=${365 * 24 * 3600}; SameSite=Lax`;
          if (changePinSuccess) {
            changePinSuccess.textContent = '✓ PIN de Administrador actualizado con éxito.';
            changePinSuccess.classList.remove('hidden');
          }
          setTimeout(() => {
            closePinModal();
            selectRole('admin');
            if (pinInput) {
              pinInput.value = '';
              pinInput.focus();
            }
          }, 1100);
        }
      } catch (err: any) {
        if (changePinError) {
          changePinError.textContent = err.message || 'Error al actualizar el PIN.';
          changePinError.classList.remove('hidden');
        }
      } finally {
        btnSubmitChangePin.disabled = false;
        btnSubmitChangePin.textContent = origText;
      }
    });
  </script>
</BaseLayout>
