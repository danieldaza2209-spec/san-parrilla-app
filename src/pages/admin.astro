    function categorizeDishesIntoBlocks(platos) {
      const assignedIds = new Set();
      const blocks = [];

      // 1. Asignar bloques definidos por lista de nombres o categoría
      for (const def of ADMIN_PRICE_GROUP_DEFS) {
        const normTargets = new Set(def.names.map(normDishText));
        const items = platos.filter(p => {
          if (assignedIds.has(p.id)) return false;
          const n = normDishText(p.nombre);
          if (normTargets.has(n)) return true;
          if (def.key === 'OTROS_PICADAS_BEBIDAS' && Number(p.categoria_id) === 3) return true;
          return false;
        });

        if (items.length > 0) {
          items.forEach(i => assignedIds.add(i.id));
          items.sort((a, b) => Number(a.precio || 0) - Number(b.precio || 0) || String(a.nombre).localeCompare(String(b.nombre)));
          const repPrice = items[0]?.precio || 16500;
          blocks.push({
            key: def.key,
            family: def.family,
            title: def.title,
            subtitle: def.subtitle,
            badgeColor: def.badgeColor,
            representativePrice: repPrice,
            items
          });
        }
      }

      // 2. Platos de Comidas Rápidas (por descripción de seed_rapidas o categoría/nombre)
      const rapidasItems = platos.filter(p => {
        if (assignedIds.has(p.id)) return false;
        const d = normDishText(p.descripcion);
        const n = normDishText(p.nombre);
        if (d.includes('comidas rapidas') || d.includes('noche')) return true;
        if (
          n.includes('hamburguesa') || n.includes('burguer') || n.includes('burger') ||
          n.includes('perro') || n.includes('suizo') || n.includes('salchipapa') ||
          n.includes('papas locas') || n.includes('patacon') || n.includes('sandwich') ||
          n.includes('bandeja san parrilla') || n.includes('picada duo') || n.includes('picada trio') ||
          n.includes('granizado') || n.includes('gaseosa mega') || n.includes('gaseosa p400')
        ) {
          return true;
        }
        return false;
      });
      if (rapidasItems.length > 0) {
        const rapidasSubgroups = [
          { key: 'RAP_BURGER', title: '🍔 Hamburguesas Artesanales (Comidas Rápidas)', match: (n) => n.includes('hamburguesa') || n.includes('burguer') || n.includes('burger') },
          { key: 'RAP_PERROS', title: '🌭 Perros Calientes y Choriperros (Comidas Rápidas)', match: (n) => n.includes('perro') || n.includes('suizo') },
          { key: 'RAP_SALCHI_PAPAS', title: '🍟 Salchipapas y Papas Locas (Comidas Rápidas)', match: (n) => n.includes('salchipapa') || n.includes('papas locas') },
          { key: 'RAP_PATACON_SANDWICH', title: '🫓 Patacones y 🥪 Sándwiches (Comidas Rápidas)', match: (n) => n.includes('patacon') || n.includes('sandwich') },
          { key: 'RAP_PICADAS_ESPECIALES', title: '🔥 Picadas Noche, Bandejas y Alitas (Comidas Rápidas)', match: (n) => n.includes('picada') || n.includes('bandeja') || n.includes('alitas') || n.includes('costillitas') || n.includes('desgranado') },
          { key: 'RAP_BEBIDAS_NOCHE', title: '🥤 Granizados, Jugos y Bebidas (Comidas Rápidas)', match: () => true }
        ];

        for (const sg of rapidasSubgroups) {
          const subItems = rapidasItems.filter(p => !assignedIds.has(p.id) && sg.match(normDishText(p.nombre)));
          if (subItems.length > 0) {
            subItems.forEach(i => assignedIds.add(i.id));
            subItems.sort((a, b) => Number(a.precio || 0) - Number(b.precio || 0) || String(a.nombre).localeCompare(String(b.nombre)));
            blocks.push({
              key: sg.key,
              family: 'RAPIDAS',
              title: sg.title,
              subtitle: `${subItems.length} plato(s) en este grupo de Comidas Rápidas`,
              badgeColor: 'bg-slate-800 text-amber-300',
              representativePrice: subItems[0]?.precio || 18000,
              items: subItems
            });
          }
        }
      }

      // 3. Cualquier plato restante en Neon DB (agrupado por su precio actual)
      const remaining = platos.filter(p => !assignedIds.has(p.id));
      if (remaining.length > 0) {
        const byPriceMap = new Map();
        for (const p of remaining) {
          const pr = Math.round(Number(p.precio || 0));
          const list = byPriceMap.get(pr) || [];
          list.push(p);
          byPriceMap.set(pr, list);
        }
        const sortedPrices = Array.from(byPriceMap.keys()).sort((a, b) => a - b);
        for (const pr of sortedPrices) {
          const items = byPriceMap.get(pr) || [];
          const fmtPr = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(pr);
          blocks.push({
            key: `EXTRA_${pr}`,
            family: 'ALMUERZOS',
            title: `🍽️ Otros Platos de ${fmtPr}`,
            subtitle: `${items.length} plato(s) con tarifa de ${fmtPr}`,
            badgeColor: 'bg-parrilla-gold text-white',
            representativePrice: pr,
            items
          });
        }
      }

      return blocks;
    }

    function renderAdminPriceGroups() {
      const container = document.getElementById('admin-price-groups-container');
      if (!container) return;

      if (!Array.isArray(allLivePlatos) || allLivePlatos.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-10 text-center text-xs text-parrilla-muted italic">
            No se encontraron platos en Neon DB. Haz clic en "🔄 Sincronizar".
          </div>
        `;
        return;
      }

      const blocks = categorizeDishesIntoBlocks(allLivePlatos);
      const q = normDishText(currentPlatosSearch);

      const visibleBlocks = blocks
        .filter(b => currentPlatosFamilyTab === 'ALL' || b.family === currentPlatosFamilyTab)
        .map(b => {
          if (!q) return b;
          const filteredItems = b.items.filter(item =>
            normDishText(item.nombre).includes(q) ||
            String(Math.round(Number(item.precio || 0))).includes(q) ||
            normDishText(b.title).includes(q)
          );
          return { ...b, items: filteredItems };
        })
        .filter(b => b.items.length > 0);

      if (visibleBlocks.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-10 text-center text-xs text-parrilla-muted italic">
            No hay platos que coincidan con la búsqueda "${currentPlatosSearch}".
          </div>
        `;
        return;
      }

      container.innerHTML = visibleBlocks.map(block => {
        const idsJson = JSON.stringify(block.items.map(i => i.id));
        const defaultBulkPrice = Math.round(Number(block.items[0]?.precio || block.representativePrice || 16500));
        const agotadosCount = block.items.filter(i => i.disponible === false || i.activo === false).length;

        return `
          <div class="bg-parrilla-dark/70 rounded-2xl border border-parrilla-border overflow-hidden flex flex-col shadow-sm" data-block-key="${block.key}">
            <!-- Encabezado del Bloque de Precio + Actualización Masiva -->
            <div class="p-4 bg-white border-b border-parrilla-border space-y-3">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block px-2.5 py-0.5 rounded-md text-[10px] font-extrabold uppercase tracking-wider ${block.badgeColor} mb-1">
                    ${block.items.length} Platos ${agotadosCount > 0 ? `• 🚫 ${agotadosCount} Agotado(s)` : '• ✓ Todos Disponibles'}
                  </span>
                  <h3 class="font-display font-black text-sm sm:text-base text-parrilla-ivory leading-tight">${block.title}</h3>
                  <p class="text-[11px] text-parrilla-muted mt-0.5">${block.subtitle}</p>
                </div>
              </div>

              <!-- Barra de actualización masiva del grupo -->
              <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 bg-amber-50/90 border border-amber-200 rounded-xl p-2.5">
                <label class="text-[11px] font-extrabold text-amber-950 whitespace-nowrap">
                  Actualizar precio de todo este grupo a:
                </label>
                <div class="flex items-center gap-1.5 flex-1 min-w-[160px]">
                  <span class="text-xs font-black text-amber-900">$</span>
                  <input
                    type="number"
                    step="100"
                    value="${defaultBulkPrice}"
                    data-bulk-input="${block.key}"
                    class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-amber-300 text-xs font-mono font-black text-parrilla-ivory focus:border-parrilla-gold outline-none"
                  />
                  <button
                    type="button"
                    data-bulk-btn="${block.key}"
                    data-plato-ids='${idsJson}'
                    class="btn-apply-bulk-price px-3 py-1.5 rounded-lg bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-extrabold text-[11px] whitespace-nowrap shadow-xs transition active:scale-95 cursor-pointer"
                  >
                    Aplicar a todos
                  </button>
                </div>
              </div>
            </div>

            <!-- Lista de Platos del Grupo -->
            <div class="divide-y divide-parrilla-border/60 max-h-[420px] overflow-y-auto p-2 space-y-1">
              ${block.items.map(dish => {
                const isDisp = dish.disponible !== false && dish.activo !== false;
                const priceNum = Math.round(Number(dish.precio || 0));
                return `
                  <div class="dish-item-row flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 px-3 py-2 rounded-xl transition ${isDisp ? 'bg-white hover:bg-slate-50' : 'bg-red-50/70 border border-red-200'}" data-plato-id="${dish.id}">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5">
                        <span class="font-bold text-xs text-parrilla-ivory truncate ${!isDisp ? 'line-through opacity-70' : ''}">${dish.nombre}</span>
                        ${!isDisp ? '<span class="px-1.5 py-0.5 rounded bg-red-600 text-white font-extrabold text-[9px] uppercase">Agotado hoy</span>' : ''}
                      </div>
                    </div>

                    <div class="flex items-center gap-1.5 shrink-0">
                      <!-- Precio individual -->
                      <div class="flex items-center bg-parrilla-dark rounded-lg border border-parrilla-border px-2 py-1">
                        <span class="text-[10px] font-bold text-parrilla-muted mr-1">$</span>
                        <input
                          type="number"
                          step="100"
                          value="${priceNum}"
                          data-single-price-input="${dish.id}"
                          class="w-20 bg-transparent text-xs font-mono font-bold text-parrilla-ivory outline-none"
                        />
                      </div>
                      <button
                        type="button"
                        data-save-single-id="${dish.id}"
                        class="btn-save-single-plato px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-900 text-white font-bold text-[10px] transition cursor-pointer"
                        title="Guardar nuevo precio de este plato"
                      >
                        Guardar $
                      </button>

                      <!-- Interruptor 1-Clic Disponible / Agotado -->
                      <button
                        type="button"
                        data-toggle-disp-id="${dish.id}"
                        data-current-disp="${isDisp ? '1' : '0'}"
                        class="btn-toggle-plato-disp px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] transition cursor-pointer whitespace-nowrap ${
                          isDisp
                            ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-emerald-200'
                            : 'bg-red-600 text-white border border-red-700 hover:bg-red-700 shadow-xs'
                        }"
                      >
                        ${isDisp ? '✓ Disponible' : '🚫 No Disponible (Agotado)'}
                      </button>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }).join('');

      // Bind eventos de actualización masiva por bloque
      container.querySelectorAll('.btn-apply-bulk-price').forEach(btn => {
        btn.addEventListener('click', async () => {
          const blockKey = btn.getAttribute('data-bulk-btn');
          const idsRaw = btn.getAttribute('data-plato-ids') || '[]';
          let platoIds = [];
          try { platoIds = JSON.parse(idsRaw); } catch (_) {}
          // @ts-ignore
          const inputEl = container.querySelector(`input[data-bulk-input="${blockKey}"]`);
          // @ts-ignore
          const nuevoPrecio = Number(inputEl?.value || 0);
          if (!platoIds.length || !nuevoPrecio || nuevoPrecio <= 0) {
            alert('Ingresa un precio válido mayor a $0 para actualizar el grupo.');
            return;
          }

          const origText = btn.textContent;
          btn.textContent = 'Aplicando...';
          try {
            const res = await fetch('/api/platos/bulk-price', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ plato_ids: platoIds, nuevo_precio: nuevoPrecio })
            });
            if (!res.ok) throw new Error('Error HTTP ' + res.status);
            // Actualizar estado local y propagar a POS e Index
            const idSet = new Set(platoIds.map(Number));
            allLivePlatos = allLivePlatos.map(p => idSet.has(Number(p.id)) ? { ...p, precio: nuevoPrecio } : p);
            broadcastPlatosUpdate(allLivePlatos);
            renderAdminPriceGroups();
          } catch (err) {
            alert('No se pudo actualizar el precio del grupo: ' + (err.message || err));
            btn.textContent = origText;
          }
        });
      });

      // Bind eventos de guardar precio individual
      container.querySelectorAll('.btn-save-single-plato').forEach(btn => {
        btn.addEventListener('click', async () => {
          const platoId = Number(btn.getAttribute('data-save-single-id'));
          // @ts-ignore
          const inputEl = container.querySelector(`input[data-single-price-input="${platoId}"]`);
          // @ts-ignore
          const nuevoPrecio = Number(inputEl?.value || 0);
          if (!platoId || !nuevoPrecio || nuevoPrecio <= 0) return;

          const origText = btn.textContent;
          btn.textContent = '⏳';
          try {
            const res = await fetch(`/api/platos/${platoId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ precio: nuevoPrecio })
            });
            if (!res.ok) throw new Error('Error HTTP ' + res.status);
            const updated = await res.json();
            allLivePlatos = allLivePlatos.map(p => Number(p.id) === platoId ? { ...p, ...updated, precio: nuevoPrecio } : p);
            broadcastPlatosUpdate(allLivePlatos);
            btn.textContent = '✓ Guardado';
            setTimeout(() => { btn.textContent = origText; }, 1400);
          } catch (err) {
            alert('Error al guardar precio del plato: ' + (err.message || err));
            btn.textContent = origText;
          }
        });
      });

      // Bind interruptor 1-Clic Disponible / No Disponible (Agotado)
      container.querySelectorAll('.btn-toggle-plato-disp').forEach(btn => {
        btn.addEventListener('click', async () => {
          const platoId = Number(btn.getAttribute('data-toggle-disp-id'));
          const curDisp = btn.getAttribute('data-current-disp') === '1';
          const nextDisp = !curDisp;

          btn.textContent = '⏳...';
          try {
            const res = await fetch(`/api/platos/${platoId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ disponible: nextDisp, activo: nextDisp })
            });
            if (!res.ok) throw new Error('Error HTTP ' + res.status);
            const updated = await res.json();
            allLivePlatos = allLivePlatos.map(p =>
              Number(p.id) === platoId ? { ...p, ...updated, disponible: nextDisp, activo: nextDisp } : p
            );
            broadcastPlatosUpdate(allLivePlatos);
            renderAdminPriceGroups();
          } catch (err) {
            alert('Error cambiando disponibilidad del plato: ' + (err.message || err));
            renderAdminPriceGroups();
          }
        });
      });
    }

    async function loadLivePlatosIntoAdmin() {
      try {
        const res = await fetch('/api/platos', { cache: 'no-store' });
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data)) {
            allLivePlatos = data;
            broadcastPlatosUpdate(allLivePlatos);
            renderAdminPriceGroups();
            const badge = document.getElementById('platos-sync-badge');
            if (badge) badge.classList.remove('hidden');
          }
        }
      } catch (err) {
        console.warn('Error cargando /api/platos en Admin:', err);
      }
    }

    // Buscador de platos y pestañas de familia en Gestor de Precios
    const adminSearchDishEl = document.getElementById('admin-search-dish');
    if (adminSearchDishEl) {
      adminSearchDishEl.addEventListener('input', (e) => {
        // @ts-ignore
        currentPlatosSearch = e.target.value || '';
        renderAdminPriceGroups();
      });
    }

    document.querySelectorAll('.platos-family-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        currentPlatosFamilyTab = tab.getAttribute('data-platos-tab') || 'ALL';
        document.querySelectorAll('.platos-family-tab').forEach(t => {
          t.classList.remove('bg-parrilla-gold', 'text-white', 'font-extrabold');
          t.classList.add('bg-parrilla-dark', 'text-parrilla-ivory', 'font-bold');
        });
        tab.classList.remove('bg-parrilla-dark', 'text-parrilla-ivory', 'font-bold');
        tab.classList.add('bg-parrilla-gold', 'text-white', 'font-extrabold');
        renderAdminPriceGroups();
      });
    });

    const btnRefreshPlatosAdmin = document.getElementById('btn-refresh-platos-admin');
    if (btnRefreshPlatosAdmin) {
      btnRefreshPlatosAdmin.addEventListener('click', () => loadLivePlatosIntoAdmin());
    }

    // =====================================================================
    // SINCRONIZACIÓN EN VIVO CON NEON DB, AUDITORÍA DE PEDIDOS & CAJA (/admin)
    // =====================================================================
    const fmtCOP = (val) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val || 0);

    let allAuditOrders = [];
    let currentPaymentFilter = 'ALL';
    let currentCourierFilter = 'ALL';
    let currentSearchQuery = '';

    const COURIERS_STORAGE_KEY = 'sp_couriers_list';
    const DEFAULT_ADMIN_COURIERS = ['Lucely', 'Mensajero 1', 'Mensajero 2'];

    function getAdminCouriersList() {
      const set = new Set(DEFAULT_ADMIN_COURIERS);
      try {
        const raw = localStorage.getItem(COURIERS_STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) {
            parsed.forEach(c => { if (c && String(c).trim()) set.add(String(c).trim()); });
          }
        }
      } catch (_) {}
      for (const p of allAuditOrders) {
        if (p.courier_name && String(p.courier_name).trim()) {
          set.add(String(p.courier_name).trim());
        }
      }
      return Array.from(set);
    }

    function saveAdminCourier(name) {
      const clean = (name || '').trim();
      if (!clean) return;
      const list = getAdminCouriersList();
      if (!list.includes(clean)) list.push(clean);
      try {
        localStorage.setItem(COURIERS_STORAGE_KEY, JSON.stringify(list));
      } catch (_) {}
    }

    const METHOD_LABELS = {
      CASH: '💵 Efectivo',
      NEQUI: '🟣 Nequi',
      BANCOLOMBIA: '🟡 Bancolombia',
      DAVIPLATA: '🔴 Daviplata',
      CARD: '💳 Datáfono / Tarjeta',
      FIADO: '📝 Fiado'
    };

    function getOrderPrimaryMethod(p) {
      if (Array.isArray(p.payments) && p.payments.length > 0) {
        return String(p.payments[p.payments.length - 1].method || 'CASH').toUpperCase();
      }
      return 'PENDIENTE';
    }

    function formatHoraBogota(isoStr) {
      if (!isoStr) return '--:--';
      const raw = (typeof isoStr === 'string' && !isoStr.endsWith('Z') && !isoStr.includes('+') && !isoStr.includes('-', 10))
        ? isoStr + 'Z'
        : isoStr;
      const d = new Date(raw);
      if (isNaN(d.getTime())) return '--:--';
      return d.toLocaleTimeString('es-CO', { timeZone: 'America/Bogota', hour: '2-digit', minute: '2-digit' });
    }

    function showAuditToast(msg) {
      const toast = document.getElementById('audit-toast');
      const text = document.getElementById('audit-toast-text');
      if (text && msg) text.textContent = msg;
      if (toast) {
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 6000);
      }
    }

    function renderCourierFilterButtons() {
      const container = document.getElementById('audit-courier-tabs');
      if (!container) return;
      const couriers = getAdminCouriersList();

      const baseButtons = [
        { key: 'ALL', label: '👥 Todos' },
        { key: 'MESA_LLEVAR', label: '🏠 Mesa / Para Llevar' },
        ...couriers.map(c => ({ key: c, label: `🛵 ${c}` }))
      ];

      container.innerHTML = baseButtons.map(b => {
        const isActive = currentCourierFilter.toLowerCase() === b.key.toLowerCase();
        const cls = isActive
          ? 'audit-courier-btn active px-3 py-1.5 rounded-xl font-bold text-xs border transition flex items-center gap-1.5 bg-blue-600 text-white border-blue-600 shadow-sm'
          : 'audit-courier-btn px-3 py-1.5 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-blue-500 transition flex items-center gap-1.5';
        return `<button type="button" data-courier="${b.key}" class="${cls}"><span>${b.label}</span></button>`;
      }).join('');

      container.querySelectorAll('.audit-courier-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentCourierFilter = btn.getAttribute('data-courier') || 'ALL';
          renderCourierFilterButtons();
          updateAuditTabsAndRender();
        });
      });
    }

    document.getElementById('btn-admin-add-courier')?.addEventListener('click', () => {
      const name = prompt('Ingresa el nombre del mensajero (ej. Lucely, Carlos):');
      if (name && name.trim()) {
        saveAdminCourier(name.trim());
        currentCourierFilter = name.trim();
        renderCourierFilterButtons();
        updateAuditTabsAndRender();
      }
    });

    function matchesCourierFilter(p) {
      if (currentCourierFilter === 'ALL') return true;
      if (currentCourierFilter === 'MESA_LLEVAR') {
        return p.tipo !== 'DOMICILIO';
      }
      return p.tipo === 'DOMICILIO' && String(p.courier_name || '').trim().toLowerCase() === currentCourierFilter.toLowerCase();
    }

    function updateCourierSettlementCard() {
      const card = document.getElementById('courier-settlement-card');
      if (!card) return;

      if (currentCourierFilter === 'ALL' || currentCourierFilter === 'MESA_LLEVAR') {
        card.classList.add('hidden');
        return;
      }

      card.classList.remove('hidden');
      const courierOrders = allAuditOrders.filter(p =>
        p.estado !== 'CANCELADO' &&
        p.tipo === 'DOMICILIO' &&
        String(p.courier_name || '').trim().toLowerCase() === currentCourierFilter.toLowerCase()
      );

      let cashCollected = 0;
      let digitalTotal = 0;
      let fiadoTotal = 0;
      let deliveryFees = 0;

      for (const p of courierOrders) {
        deliveryFees += Number(p.delivery_fee || 0);
        if (Array.isArray(p.payments) && p.payments.length > 0) {
          for (const pay of p.payments) {
            const m = String(pay.method || 'CASH').toUpperCase();
            const amt = Number(pay.amount || p.total || 0);
            if (m === 'CASH') cashCollected += amt;
            else if (m === 'FIADO') fiadoTotal += amt;
            else digitalTotal += amt;
          }
        }
      }

      const nameEl = document.getElementById('settlement-courier-name');
      const badgeEl = document.getElementById('settlement-total-orders');
      const countBoxEl = document.getElementById('settlement-count-box');
      const cashEl = document.getElementById('settlement-cash');
      const digEl = document.getElementById('settlement-digital');
      const fiadoEl = document.getElementById('settlement-fiado');
      const feesEl = document.getElementById('settlement-fees');

      if (nameEl) nameEl.textContent = currentCourierFilter;
      if (badgeEl) badgeEl.textContent = `${courierOrders.length} domicilio(s)`;
      if (countBoxEl) countBoxEl.textContent = `${courierOrders.length} domicilio(s)`;
      if (cashEl) cashEl.textContent = fmtCOP(cashCollected);
      if (digEl) digEl.textContent = fmtCOP(digitalTotal);
      if (fiadoEl) fiadoEl.textContent = fmtCOP(fiadoTotal);
      if (feesEl) feesEl.textContent = fmtCOP(deliveryFees);
    }

    function updateAuditTabsAndRender() {
      renderCourierFilterButtons();
      updateCourierSettlementCard();

      const sums = {
        ALL: 0,
        CASH: 0,
        NEQUI: 0,
        BANCOLOMBIA: 0,
        DAVIPLATA: 0,
        CARD: 0,
        FIADO: 0
      };

      for (const p of allAuditOrders) {
        if (p.estado === 'CANCELADO') continue;
        if (!matchesCourierFilter(p)) continue;
        if (Array.isArray(p.payments) && p.payments.length > 0) {
          for (const pay of p.payments) {
            const m = String(pay.method || 'CASH').toUpperCase();
            const amt = Number(pay.amount || p.total || 0);
            sums.ALL += amt;
            if (sums[m] !== undefined) sums[m] += amt;
          }
        }
      }

      Object.keys(sums).forEach(k => {
        const el = document.getElementById(`tab-sum-${k}`);
        if (el) el.textContent = fmtCOP(sums[k]);
      });

      const tbody = document.getElementById('audit-orders-tbody');
      if (!tbody) return;

      const filtered = allAuditOrders.filter(p => {
        if (!matchesCourierFilter(p)) return false;
        const method = getOrderPrimaryMethod(p);
        if (currentPaymentFilter !== 'ALL') {
          const hasMethod = (Array.isArray(p.payments) && p.payments.some(pay => String(pay.method).toUpperCase() === currentPaymentFilter))
            || method === currentPaymentFilter;
          if (!hasMethod) return false;
        }
        if (currentSearchQuery) {
          const hay = [
            `#sp-${p.id}`,
            String(p.id),
            p.cliente_nombre || '',
            p.cliente_telefono || '',
            p.mesa || '',
            p.courier_name || '',
            p.tipo || '',
            method
          ].join(' ').toLowerCase();
          if (!hay.includes(currentSearchQuery)) return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-8 text-center text-parrilla-muted italic">
              No hay pedidos registrados para este filtro en el turno/día actual.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(p => {
        const hora = formatHoraBogota(p.fecha_hora || p.created_at);
        const method = getOrderPrimaryMethod(p);
        const isCancelled = p.estado === 'CANCELADO';
        const isPaid = p.estado === 'PAGADO' || p.estado === 'ENTREGADO' || (Array.isArray(p.payments) && p.payments.length > 0);

        let tipoBadge = '';
        if (p.tipo === 'MESA') {
          tipoBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-amber-100 text-amber-900 font-bold text-[11px]">🍽️ ${p.mesa || 'Mesa'}</span>`;
        } else if (p.tipo === 'DOMICILIO') {
