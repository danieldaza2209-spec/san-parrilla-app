    // =====================================================================
    // 2.5 MÓDULO DE CUENTAS DE FIADO Y EXPORTACIÓN A EXCEL MENSUAL
    // =====================================================================
    let allHistoricalOrders = [];
    let allNeonClientes = [];
    let fiadoStatusFilter = 'PENDIENTE'; // 'PENDIENTE' | 'PAGADO' | 'ALL'
    let fiadoMonthFilter = '';
    let fiadoFromDate = '';
    let fiadoToDate = '';
    let fiadoSearchQuery = '';
    const expandedFiadoCustomerKeys = new Set();

    // Estado para el modal de liquidación de fiado
    let currentLiquidarAccount = null;
    let selectedLiquidarMethod = 'CASH';

    function parseOrderDateCol(order) {
      const ts = order?.fecha_hora || order?.created_at;
      if (!ts) return { dateObj: null, ymd: '', ym: '', display: 'Sin fecha' };
      const raw = (typeof ts === 'string' && !ts.endsWith('Z') && !ts.includes('+') && !ts.includes('-', 10)) ? ts + 'Z' : ts;
      const d = new Date(raw);
      if (isNaN(d.getTime())) return { dateObj: null, ymd: '', ym: '', display: String(ts) };
      const ymd = d.toLocaleDateString('en-CA', { timeZone: 'America/Bogota' }); // YYYY-MM-DD
      const ym = ymd.slice(0, 7); // YYYY-MM
      const display = d.toLocaleString('es-CO', {
        timeZone: 'America/Bogota',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit'
      });
      return { dateObj: d, ymd, ym, display };
    }

    function classifyFiadoOrder(order) {
      if (!order || order.estado === 'CANCELADO') return null;
      const payments = Array.isArray(order.payments) ? order.payments : [];
      const notas = String(order.notas || '');
      const hasFiadoPayment = payments.some(pay => String(pay.method || '').toUpperCase() === 'FIADO');
      const paidMatch = notas.match(/\[FIADO_PAGADO:([^:\]]+):([^\]]+)\]/i);
      const isHistoricalFiadoPaid = Boolean(paidMatch);

      if (!hasFiadoPayment && !isHistoricalFiadoPaid) return null;

      return {
        isPendingFiado: hasFiadoPayment,
        isPaidFiado: !hasFiadoPayment && isHistoricalFiadoPaid,
        paidViaMethod: paidMatch ? paidMatch[1] : null,
        paidAtStr: paidMatch ? paidMatch[2] : null
      };
    }

    function buildOrderDishesSummary(order) {
      const detalles = Array.isArray(order.detalles) ? order.detalles : [];
      let totalItems = 0;
      const parts = [];
      for (const det of detalles) {
        const qty = Number(det.cantidad || 1);
        totalItems += qty;
        const name = det.plato?.nombre || det.nombre_plato || `Plato #${det.plato_id || ''}`;
        const obs = det.observaciones ? ` (${det.observaciones})` : '';
        parts.push(`${qty}x ${name}${obs}`);
      }
      if (parts.length === 0) {
        totalItems = 1;
        parts.push('Consumo registrado en POS');
      }
      return {
        description: parts.join(' + '),
        totalItems
      };
    }

    function buildFiadoCustomerAccounts() {
      // Mapa de clientes registrados en Neon por ID y por teléfono
      const clienteById = new Map();
      const clienteByPhone = new Map();
      for (const c of allNeonClientes) {
        if (c.id) clienteById.set(Number(c.id), c);
        if (c.telefono) clienteByPhone.set(String(c.telefono).trim(), c);
      }

      const accountsMap = new Map();

      for (const order of allHistoricalOrders) {
        const fiadoMeta = classifyFiadoOrder(order);
        if (!fiadoMeta) continue;

        // Filtro por Estado (Pendiente vs Pagado vs Todos)
        if (fiadoStatusFilter === 'PENDIENTE' && !fiadoMeta.isPendingFiado) continue;
        if (fiadoStatusFilter === 'PAGADO' && !fiadoMeta.isPaidFiado) continue;

        // Filtro por Mes o Rango de Fechas
        const dateInfo = parseOrderDateCol(order);
        if (fiadoMonthFilter && dateInfo.ym && dateInfo.ym !== fiadoMonthFilter) continue;
        if (fiadoFromDate && dateInfo.ymd && dateInfo.ymd < fiadoFromDate) continue;
        if (fiadoToDate && dateInfo.ymd && dateInfo.ymd > fiadoToDate) continue;

        // Identificar cliente
        const rawPhone = String(order.cliente_telefono || '').trim();
        const rawName = String(order.cliente_nombre || '').trim();
        const linkedCliente = (order.cliente_id && clienteById.get(Number(order.cliente_id)))
          || (rawPhone && clienteByPhone.get(rawPhone))
          || null;

        const custId = linkedCliente?.id || order.cliente_id || null;
        const custPhone = linkedCliente?.telefono || rawPhone || 'S/N';
        const custName = linkedCliente?.nombre || rawName || 'Cliente Fiado (Sin Nombre)';
        const custAddress = linkedCliente?.direccion || order.direccion || '';
        const custBarrio = linkedCliente?.barrio || order.barrio || '';

        const key = custId ? `ID_${custId}` : (custPhone !== 'S/N' ? `TEL_${custPhone}` : `NAME_${normDishText(custName)}`);

        let acc = accountsMap.get(key);
        if (!acc) {
          acc = {
            key,
            cliente_id: custId,
            nombre: custName,
            telefono: custPhone,
            direccion: custAddress,
            barrio: custBarrio,
            orders: [],
            totalAmount: 0,
            pendingAmount: 0,
            paidAmount: 0
          };
          accountsMap.set(key, acc);
        }

        const orderTotal = Number(order.total || 0);
        const dishInfo = buildOrderDishesSummary(order);

        acc.orders.push({
          id: order.id,
          codigo: order.codigo_factura || `#${order.id}`,
          fechaDisplay: dateInfo.display,
          ymd: dateInfo.ymd,
          description: dishInfo.description,
          totalItems: dishInfo.totalItems,
          amount: orderTotal,
          isPending: fiadoMeta.isPendingFiado,
          paidViaMethod: fiadoMeta.paidViaMethod,
          paidAtStr: fiadoMeta.paidAtStr
        });

        acc.totalAmount += orderTotal;
        if (fiadoMeta.isPendingFiado) acc.pendingAmount += orderTotal;
        else acc.paidAmount += orderTotal;
      }

      // Filtrar por buscador de nombre o teléfono
      const q = normDishText(fiadoSearchQuery);
      let list = Array.from(accountsMap.values());
      if (q) {
        list = list.filter(acc =>
          normDishText(acc.nombre).includes(q) ||
          normDishText(acc.telefono).includes(q) ||
          normDishText(acc.barrio).includes(q)
        );
      }

      // Ordenar por mayor saldo pendiente y luego por total
      list.sort((a, b) => b.pendingAmount - a.pendingAmount || b.totalAmount - a.totalAmount);
      return list;
    }

    function downloadFiadoExcel(account) {
      if (!account || !Array.isArray(account.orders) || account.orders.length === 0) return;

      const periodLabel = fiadoMonthFilter
        ? `Mes ${fiadoMonthFilter}`
        : (fiadoFromDate || fiadoToDate)
          ? `${fiadoFromDate || 'Inicio'} a ${fiadoToDate || 'Hoy'}`
          : 'Historial Acumulado';

      const totalAPagar = fiadoStatusFilter === 'PAGADO' ? account.paidAmount : (account.pendingAmount || account.totalAmount);
      const safeName = String(account.nombre || 'Cliente').replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ _-]/g, '').trim().replace(/\s+/g, '_');

      // Generar tabla HTML con codificación UTF-8 BOM compatible nativamente con Microsoft Excel (.xls)
      const rowsHtml = account.orders.map(o => `
        <tr>
          <td style="border:1px solid #cbd5e1; padding:6px 10px;">${o.fechaDisplay}</td>
          <td style="border:1px solid #cbd5e1; padding:6px 10px; font-weight:bold;">${o.codigo}</td>
          <td style="border:1px solid #cbd5e1; padding:6px 10px;">${o.description}</td>
          <td style="border:1px solid #cbd5e1; padding:6px 10px; text-align:center;">${o.totalItems}</td>
          <td style="border:1px solid #cbd5e1; padding:6px 10px; text-align:right; font-weight:bold;">${Math.round(o.amount)}</td>
        </tr>
      `).join('');

      const excelTemplate = `
        <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
        <head>
          <meta charset="UTF-8" />
          <!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Cuenta de Cobro</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->
        </head>
        <body style="font-family: Calibri, Arial, sans-serif; font-size: 11pt;">
          <table style="border-collapse: collapse; width: 100%;">
            <tr>
              <td colspan="5" style="background-color:#92400e; color:#ffffff; font-size:15pt; font-weight:bold; text-align:center; padding:12px;">
                RESTAURANTE SAN PARRILLA - CUENTA DE COBRO
              </td>
            </tr>
            <tr>
              <td colspan="2" style="padding:6px 10px; font-weight:bold; background:#fef3c7;">Cliente:</td>
              <td colspan="3" style="padding:6px 10px; font-weight:bold;">${account.nombre}</td>
            </tr>
            <tr>
              <td colspan="2" style="padding:6px 10px; font-weight:bold; background:#fef3c7;">Teléfono:</td>
              <td colspan="3" style="padding:6px 10px;">${account.telefono}</td>
            </tr>
            <tr>
              <td colspan="2" style="padding:6px 10px; font-weight:bold; background:#fef3c7;">Dirección / Barrio:</td>
              <td colspan="3" style="padding:6px 10px;">${[account.direccion, account.barrio].filter(Boolean).join(' - ') || 'Registrado en restaurante'}</td>
            </tr>
            <tr>
              <td colspan="2" style="padding:6px 10px; font-weight:bold; background:#fef3c7;">Periodo / Fechas:</td>
              <td colspan="3" style="padding:6px 10px;">${periodLabel} (Generado: ${new Date().toLocaleDateString('es-CO')})</td>
            </tr>
            <tr><td colspan="5"></td></tr>
            <thead>
              <tr style="background-color:#1e293b; color:#ffffff; font-weight:bold;">
                <th style="border:1px solid #334155; padding:8px 10px; text-align:left;">Fecha</th>
                <th style="border:1px solid #334155; padding:8px 10px; text-align:left;">Pedido</th>
                <th style="border:1px solid #334155; padding:8px 10px; text-align:left;">Descripción / Platos</th>
                <th style="border:1px solid #334155; padding:8px 10px; text-align:center;">Cantidad</th>
                <th style="border:1px solid #334155; padding:8px 10px; text-align:right;">Valor ($)</th>
              </tr>
            </thead>
            <tbody>
              ${rowsHtml}
            </tbody>
            <tfoot>
              <tr style="background-color:#fde68a; font-weight:bold; font-size:12pt;">
                <td colspan="3" style="border:2px solid #92400e; padding:10px; text-align:right;">TOTAL A PAGAR:</td>
                <td style="border:2px solid #92400e; padding:10px; text-align:center;">${account.orders.reduce((s, o) => s + o.totalItems, 0)} ítems</td>
                <td style="border:2px solid #92400e; padding:10px; text-align:right;">${fmtCOP(totalAPagar)}</td>
              </tr>
            </tfoot>
          </table>
        </body>
        </html>
      `;

      const blob = new Blob(['\uFEFF' + excelTemplate], { type: 'application/vnd.ms-excel;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Cuenta_Cobro_San_Parrilla_${safeName}_${periodLabel.replace(/\s+/g, '_')}.xls`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    function openLiquidarFiadoModal(account) {
      if (!account) return;
      const pendingOrders = account.orders.filter(o => o.isPending);
      if (pendingOrders.length === 0) {
        alert('Este cliente no tiene pedidos fiados pendientes de pago en el periodo seleccionado.');
        return;
      }
      currentLiquidarAccount = account;
      selectedLiquidarMethod = 'CASH';

      const modal = document.getElementById('modal-liquidar-fiado');
      const elCliente = document.getElementById('liquidar-modal-cliente');
      const elTel = document.getElementById('liquidar-modal-telefono');
      const elCant = document.getElementById('liquidar-modal-cantidad');
      const elTotal = document.getElementById('liquidar-modal-total');

      if (elCliente) elCliente.textContent = account.nombre;
      if (elTel) elTel.textContent = account.telefono;
      if (elCant) elCant.textContent = `${pendingOrders.length} pedido(s) pendiente(s)`;
      if (elTotal) elTotal.textContent = fmtCOP(account.pendingAmount);

      document.querySelectorAll('.liq-method-btn').forEach(btn => {
        const m = btn.getAttribute('data-liq-method');
        if (m === 'CASH') {
          btn.className = 'liq-method-btn active py-3 px-2 rounded-xl border-2 border-parrilla-gold bg-parrilla-gold text-white font-extrabold text-xs flex flex-col items-center gap-1 shadow-xs cursor-pointer';
        } else {
          btn.className = 'liq-method-btn py-3 px-2 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1 cursor-pointer';
        }
      });

      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function renderFiadoAccountsModule() {
      const container = document.getElementById('fiado-accounts-container');
      const kpiTotalEl = document.getElementById('fiado-kpi-total-pendiente');
      const kpiCountEl = document.getElementById('fiado-kpi-clientes-count');
      if (!container) return;

      const accounts = buildFiadoCustomerAccounts();
      const totalPendingAll = accounts.reduce((sum, a) => sum + a.pendingAmount, 0);

      if (kpiTotalEl) kpiTotalEl.textContent = fmtCOP(totalPendingAll);
      if (kpiCountEl) kpiCountEl.textContent = String(accounts.length);

      if (accounts.length === 0) {
        container.innerHTML = `
          <div class="py-10 px-4 text-center bg-parrilla-dark/40 rounded-xl border border-dashed border-parrilla-border">
            <p class="text-sm font-bold text-parrilla-ivory">No se encontraron cuentas de fiado con los filtros seleccionados</p>
            <p class="text-xs text-parrilla-muted mt-1">
              Cuando registres un pedido con método de pago <strong>📝 Fiado</strong> en <code>/pos</code>, aparecerá aquí automáticamente agrupado por cliente.
            </p>
          </div>
        `;
        return;
      }

      container.innerHTML = accounts.map((acc, idx) => {
        const isExpanded = expandedFiadoCustomerKeys.has(acc.key) || idx === 0;
        const pendingOrdersCount = acc.orders.filter(o => o.isPending).length;
        const displayBalance = fiadoStatusFilter === 'PAGADO' ? acc.paidAmount : (acc.pendingAmount || acc.totalAmount);

        return `
          <div class="bg-white rounded-2xl border ${acc.pendingAmount > 0 ? 'border-amber-300' : 'border-emerald-300'} shadow-sm overflow-hidden">
            <!-- Fila Resumen del Cliente (Clic para expandir) -->
            <div class="p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3 bg-gradient-to-r ${acc.pendingAmount > 0 ? 'from-amber-50/70 to-white' : 'from-emerald-50/60 to-white'}">
              <div
                class="flex items-start sm:items-center gap-3 cursor-pointer flex-1"
                data-toggle-fiado-key="${acc.key}"
              >
                <div class="w-10 h-10 rounded-xl ${acc.pendingAmount > 0 ? 'bg-amber-500 text-white' : 'bg-emerald-600 text-white'} flex items-center justify-center font-display font-black text-sm shrink-0 shadow-xs">
                  ${String(acc.nombre || 'C').slice(0, 2).toUpperCase()}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-display font-black text-base text-parrilla-ivory">${acc.nombre}</h3>
                    <span class="px-2 py-0.5 rounded-md bg-slate-100 border border-slate-300 font-mono font-bold text-xs text-parrilla-ivory">
                      📞 ${acc.telefono}
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold ${acc.pendingAmount > 0 ? 'bg-amber-100 text-amber-900 border border-amber-300' : 'bg-emerald-100 text-emerald-800 border border-emerald-300'}">
                      ${acc.orders.length} pedido(s) en el periodo
                    </span>
                  </div>
                  <p class="text-xs text-parrilla-muted mt-0.5">
                    ${[acc.direccion, acc.barrio].filter(Boolean).join(' • ') || 'Cliente registrado en directorio San Parrilla'}
                    <span class="ml-2 text-parrilla-gold font-bold underline">
                      ${isExpanded ? '▲ Ocultar detalle de consumo' : '▼ Ver detalle plato por plato'}
                    </span>
                  </p>
                </div>
              </div>

              <!-- Saldo Total Adeudado y Botones de Acción -->
              <div class="flex flex-wrap items-center justify-between lg:justify-end gap-3 pt-2 lg:pt-0 border-t lg:border-t-0 border-parrilla-border/60">
                <div class="text-left lg:text-right pr-2">
                  <span class="block text-[10px] font-extrabold uppercase ${acc.pendingAmount > 0 ? 'text-amber-800' : 'text-emerald-700'}">
                    ${acc.pendingAmount > 0 ? 'Saldo Total Adeudado' : 'Total Pagado / Liquidado'}
                  </span>
                  <span class="font-display font-black text-xl font-mono ${acc.pendingAmount > 0 ? 'text-red-600' : 'text-emerald-700'}">
                    ${fmtCOP(displayBalance)}
                  </span>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    data-excel-fiado-key="${acc.key}"
                    class="btn-fiado-excel px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs flex items-center gap-1.5 shadow-xs transition cursor-pointer"
                  >
                    <span>📥 Descargar Cuenta de Cobro (Excel .xlsx / .csv)</span>
                  </button>

                  ${pendingOrdersCount > 0 ? `
                    <button
                      type="button"
                      data-liquidar-fiado-key="${acc.key}"
                      class="btn-fiado-liquidar px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs flex items-center gap-1.5 shadow-xs transition cursor-pointer"
                    >
                      <span>✅ Marcar Cuenta como Pagada (Liquidar Fiado)</span>
                    </button>
                  ` : `
                    <span class="px-3 py-2 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-extrabold text-xs">
                      ✓ Cuenta al Día
                    </span>
                  `}
                </div>
              </div>
            </div>

            <!-- Tabla Detallada de Consumo del Cliente -->
            <div class="${isExpanded ? 'block' : 'hidden'} border-t border-parrilla-border bg-slate-50/60 p-4" data-fiado-detail-box="${acc.key}">
              <div class="overflow-x-auto rounded-xl border border-parrilla-border bg-white">
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr class="bg-slate-100 text-parrilla-muted uppercase text-[10px] font-extrabold border-b border-parrilla-border">
                      <th class="py-2.5 px-3">Fecha y Hora</th>
                      <th class="py-2.5 px-3">Código Pedido</th>
                      <th class="py-2.5 px-3">Detalle de Platos / Productos</th>
                      <th class="py-2.5 px-3 text-center">Cantidad Total de Ítems</th>
                      <th class="py-2.5 px-3 text-right">Monto del Pedido ($)</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-parrilla-border/60">
                    ${acc.orders.map(ord => `
                      <tr class="hover:bg-amber-50/40">
                        <td class="py-2.5 px-3 font-mono text-[11px] text-parrilla-ivory whitespace-nowrap">${ord.fechaDisplay}</td>
                        <td class="py-2.5 px-3 font-mono font-bold text-parrilla-gold whitespace-nowrap">
                          ${ord.codigo}
                          ${ord.isPending
                            ? '<span class="ml-1 px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 text-[9px] font-extrabold">FIADO</span>'
                            : `<span class="ml-1 px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[9px] font-extrabold">PAGADO (${ord.paidViaMethod || 'CAJA'})</span>`
                          }
                        </td>
                        <td class="py-2.5 px-3 text-parrilla-ivory font-medium">${ord.description}</td>
                        <td class="py-2.5 px-3 text-center font-mono font-bold text-parrilla-ivory">${ord.totalItems}</td>
                        <td class="py-2.5 px-3 text-right font-mono font-extrabold text-parrilla-ivory whitespace-nowrap">${fmtCOP(ord.amount)}</td>
                      </tr>
                    `).join('')}
                  </tbody>
                  <tfoot>
                    <tr class="bg-amber-100/90 border-t-2 border-amber-400 font-display font-black text-sm">
                      <td colspan="3" class="py-3 px-3 text-right text-amber-950 uppercase">TOTAL A PAGAR ($):</td>
                      <td class="py-3 px-3 text-center font-mono text-amber-950">
                        ${acc.orders.reduce((s, o) => s + o.totalItems, 0)} ítems
                      </td>
                      <td class="py-3 px-3 text-right font-mono text-base text-red-700">
                        ${fmtCOP(displayBalance)}
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Eventos para desplegar / ocultar detalle de cada cliente
      container.querySelectorAll('[data-toggle-fiado-key]').forEach(el => {
        el.addEventListener('click', () => {
          const key = el.getAttribute('data-toggle-fiado-key');
          if (!key) return;
          if (expandedFiadoCustomerKeys.has(key)) expandedFiadoCustomerKeys.delete(key);
          else expandedFiadoCustomerKeys.add(key);
          renderFiadoAccountsModule();
        });
      });

      // Eventos para descargar Cuenta de Cobro en Excel
      container.querySelectorAll('.btn-fiado-excel').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const key = btn.getAttribute('data-excel-fiado-key');
          const account = accounts.find(a => a.key === key);
          if (account) downloadFiadoExcel(account);
        });
      });

      // Eventos para abrir modal de Liquidar Fiado
      container.querySelectorAll('.btn-fiado-liquidar').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const key = btn.getAttribute('data-liquidar-fiado-key');
          const account = accounts.find(a => a.key === key);
          if (account) openLiquidarFiadoModal(account);
        });
      });
    }

    // Inicializar filtros de Cuentas por Cobrar
    document.querySelectorAll('.fiado-status-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        fiadoStatusFilter = btn.getAttribute('data-fiado-status') || 'PENDIENTE';
        document.querySelectorAll('.fiado-status-btn').forEach(b => {
          b.className = 'fiado-status-btn py-1.5 px-2 rounded-lg text-[11px] font-bold text-parrilla-ivory hover:text-parrilla-gold transition cursor-pointer';
        });
        btn.className = 'fiado-status-btn active py-1.5 px-2 rounded-lg text-[11px] font-extrabold bg-amber-500 text-white shadow-xs transition cursor-pointer';
        renderFiadoAccountsModule();
      });
    });

    const fiadoMonthEl = document.getElementById('fiado-filter-month');
    const fiadoFromEl = document.getElementById('fiado-filter-from');
    const fiadoToEl = document.getElementById('fiado-filter-to');
    const fiadoSearchEl = document.getElementById('fiado-search-input');
    const btnClearFiadoDates = document.getElementById('btn-fiado-clear-dates');

    if (fiadoMonthEl) {
      fiadoMonthEl.addEventListener('change', (e) => {
        // @ts-ignore
        fiadoMonthFilter = e.target.value || '';
        renderFiadoAccountsModule();
      });
    }
    if (fiadoFromEl) {
      fiadoFromEl.addEventListener('change', (e) => {
        // @ts-ignore
        fiadoFromDate = e.target.value || '';
        renderFiadoAccountsModule();
      });
    }
    if (fiadoToEl) {
      fiadoToEl.addEventListener('change', (e) => {
        // @ts-ignore
        fiadoToDate = e.target.value || '';
        renderFiadoAccountsModule();
      });
    }
    if (fiadoSearchEl) {
      fiadoSearchEl.addEventListener('input', (e) => {
        // @ts-ignore
        fiadoSearchQuery = e.target.value || '';
        renderFiadoAccountsModule();
      });
    }
    if (btnClearFiadoDates) {
      btnClearFiadoDates.addEventListener('click', () => {
        fiadoMonthFilter = '';
        fiadoFromDate = '';
        fiadoToDate = '';
        // @ts-ignore
        if (fiadoMonthEl) fiadoMonthEl.value = '';
        // @ts-ignore
        if (fiadoFromEl) fiadoFromEl.value = '';
        // @ts-ignore
        if (fiadoToEl) fiadoToEl.value = '';
        renderFiadoAccountsModule();
      });
    }

    // Eventos del modal Liquidar Fiado
    document.querySelectorAll('.liq-method-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedLiquidarMethod = btn.getAttribute('data-liq-method') || 'CASH';
        document.querySelectorAll('.liq-method-btn').forEach(b => {
          b.className = 'liq-method-btn py-3 px-2 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1 cursor-pointer';
        });
        btn.className = 'liq-method-btn active py-3 px-2 rounded-xl border-2 border-parrilla-gold bg-parrilla-gold text-white font-extrabold text-xs flex flex-col items-center gap-1 shadow-xs cursor-pointer';
      });
    });

    const closeLiquidarModal = () => {
      const modal = document.getElementById('modal-liquidar-fiado');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
      currentLiquidarAccount = null;
    };
    document.getElementById('btn-close-liquidar-modal')?.addEventListener('click', closeLiquidarModal);
    document.getElementById('btn-cancel-liquidar-modal')?.addEventListener('click', closeLiquidarModal);

    document.getElementById('btn-confirm-liquidar-fiado')?.addEventListener('click', async () => {
      if (!currentLiquidarAccount) return;
      const pendingOrderIds = currentLiquidarAccount.orders.filter(o => o.isPending).map(o => o.id);
      if (pendingOrderIds.length === 0) return;

      const btnConfirm = document.getElementById('btn-confirm-liquidar-fiado');
      if (btnConfirm) btnConfirm.textContent = 'Liquidando cuenta en Neon DB...';

      try {
        const res = await fetch('/api/clientes/liquidar-fiado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            cliente_id: currentLiquidarAccount.cliente_id || null,
            telefono: currentLiquidarAccount.telefono !== 'S/N' ? currentLiquidarAccount.telefono : null,
            cliente_nombre: currentLiquidarAccount.nombre,
            pedido_ids: pendingOrderIds,
            metodo_pago: selectedLiquidarMethod
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.detail || 'Error al liquidar cuenta');
        closeLiquidarModal();
        await loadLiveAdminMetrics();
      } catch (err) {
        alert('No se pudo liquidar la cuenta de fiado: ' + (err.message || err));
      } finally {
        if (btnConfirm) btnConfirm.textContent = '✅ Confirmar Pago y Liquidar Deuda';
      }
    });

    // Modal para crear / actualizar cliente en Neon desde Admin
    const openClienteModal = () => {
      const m = document.getElementById('modal-admin-cliente');
      if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    };
    const closeClienteModal = () => {
      const m = document.getElementById('modal-admin-cliente');
      if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    };
    document.getElementById('btn-new-fiado-customer')?.addEventListener('click', openClienteModal);
    document.getElementById('btn-close-cliente-modal')?.addEventListener('click', closeClienteModal);
    document.getElementById('btn-cancel-cliente-modal')?.addEventListener('click', closeClienteModal);

    document.getElementById('form-admin-cliente')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      // @ts-ignore
      const telefono = document.getElementById('admin-cust-phone')?.value?.trim() || '';
      // @ts-ignore
      const nombre = document.getElementById('admin-cust-name')?.value?.trim() || '';
      // @ts-ignore
      const direccion = document.getElementById('admin-cust-address')?.value?.trim() || '';
      // @ts-ignore
      const barrio = document.getElementById('admin-cust-barrio')?.value?.trim() || '';

      if (!telefono || !nombre) {
        alert('Ingresa el nombre y el número de teléfono del cliente.');
        return;
      }

      const btnSave = document.getElementById('btn-save-cliente-modal');
      if (btnSave) btnSave.textContent = 'Guardando...';
      try {
        const res = await fetch('/api/clientes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, telefono, direccion, barrio })
        });
        if (!res.ok) throw new Error('Error HTTP ' + res.status);
        closeClienteModal();
        // @ts-ignore
        document.getElementById('form-admin-cliente')?.reset();
        await loadLiveAdminMetrics();
      } catch (err) {
        alert('Error al guardar el cliente: ' + (err.message || err));
      } finally {
        if (btnSave) btnSave.textContent = '💾 Guardar Cliente';
      }
    });

    async function loadLiveAdminMetrics() {
      try {
        const [cajaRes, pedRes, dashRes, cliRes] = await Promise.all([
          fetch('/api/caja/active', { cache: 'no-store' }),
          fetch('/api/pedidos?limit=500', { cache: 'no-store' }),
          fetch('/api/pedidos/stats/dashboard', { cache: 'no-store' }).catch(() => null),
          fetch('/api/clientes', { cache: 'no-store' }).catch(() => null)
        ]);

        const caja = (cajaRes && cajaRes.ok) ? await cajaRes.json() : null;
        const pedidos = (pedRes && pedRes.ok) ? await pedRes.json() : [];
        const clientesData = (cliRes && cliRes.ok) ? await cliRes.json() : [];
        const listaPedidos = Array.isArray(pedidos) ? pedidos : [];

        allHistoricalOrders = listaPedidos;
        allNeonClientes = Array.isArray(clientesData) ? clientesData : [];
        renderFiadoAccountsModule();

        // Filtrar pedidos del turno activo de caja o del día de hoy en Colombia
        const hoyCol = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });
        const pedidosTurnoOHoy = listaPedidos.filter(p => {
          if (caja && caja.status === 'OPEN' && Array.isArray(p.payments)) {
            if (p.payments.some(pay => pay.cash_closure_id === caja.id)) return true;
          }
          const ts = p.fecha_hora || p.created_at;
          if (ts) {
            const raw = (typeof ts === 'string' && !ts.endsWith('Z') && !ts.includes('+') && !ts.includes('-', 10)) ? ts + 'Z' : ts;
            const d = new Date(raw);
            if (!isNaN(d.getTime())) {
              const fechaPed = d.toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });
              if (fechaPed === hoyCol) return true;
            }
          }
          return false;
        });

        allAuditOrders = pedidosTurnoOHoy;
        updateAuditTabsAndRender();

        if (dashRes && dashRes.ok) {
          const dashData = await dashRes.json();
          if (dashData && typeof dashData.todaySales === 'number') {
            renderLiveAdminMetrics(dashData);
            return;
          }
        }

        let cashSales = 0;
        let digitalSales = 0;
        const pedidosPagados = pedidosTurnoOHoy.filter(p => p.estado !== 'CANCELADO' && Array.isArray(p.payments) && p.payments.length > 0);

        if (caja && caja.status === 'OPEN') {
          cashSales = Number(caja.total_cash_sales || 0);
          digitalSales = Number(caja.total_nequi_sales || 0)
            + Number(caja.total_bancolombia_sales || 0)
            + Number(caja.total_daviplata_sales || 0)
            + Number(caja.total_card_sales || 0);
        } else {
          for (const p of pedidosPagados) {
            for (const pay of (p.payments || [])) {
              const m = String(pay.method).toUpperCase();
              if (m === 'FIADO') continue;
              if (m === 'CASH') cashSales += Number(pay.amount || 0);
              else digitalSales += Number(pay.amount || 0);
            }
          }
        }

        const todaySales = cashSales + digitalSales;
        const todayOrderCount = pedidosPagados.length;

        const phoneSet = new Set();
        for (const c of allNeonClientes) {
          if (c.telefono) phoneSet.add(String(c.telefono).trim());
        }
        for (const p of listaPedidos) {
          if (p.cliente_telefono && String(p.cliente_telefono).trim()) {
            phoneSet.add(String(p.cliente_telefono).trim());
          }
        }

        const dishMap = new Map();
        for (const p of pedidosPagados) {
          for (const det of (p.detalles || [])) {
            const pName = det.plato?.nombre || det.nombre_plato || 'Plato';
            const qty = Number(det.cantidad || 1);
            const rev = Number(det.precio_unitario || det.plato?.precio || 0) * qty;
            const cur = dishMap.get(pName) || { product_name: pName, sold_count: 0, total_revenue: 0 };
            cur.sold_count += qty;
            cur.total_revenue += rev;
            dishMap.set(pName, cur);
          }
        }

        const topDishes = Array.from(dishMap.values())
          .sort((a, b) => b.sold_count - a.sold_count || b.total_revenue - a.total_revenue)
          .slice(0, 8);

        renderLiveAdminMetrics({
          todaySales,
          cashSales,
          digitalSales,
          todayOrderCount,
          totalCustomers: phoneSet.size,
          topDishes
        });
      } catch (err) {
        console.error('Error cargando métricas y auditoría en vivo de /admin:', err);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadLiveSpecialsIntoAdmin();
      loadLivePlatosIntoAdmin();
      loadLiveAdminMetrics();
      setInterval(loadLiveAdminMetrics, 15000);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          loadLiveSpecialsIntoAdmin();
          loadLivePlatosIntoAdmin();
          loadLiveAdminMetrics();
        }
      });
    });
  </script>
</StaffLayout>
