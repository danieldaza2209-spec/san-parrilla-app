  <script>
    // Download Windows POS Launcher (.bat) with --kiosk-printing
    const btnLauncher = document.getElementById('btn-download-launcher');
    if (btnLauncher) {
      btnLauncher.addEventListener('click', () => {
        const posUrl = `${window.location.origin}/pos`;
        const batLines = [
          '@echo off',
          'REM ===============================================================',
          'REM  San Parrilla POS - Lanzador con impresion termica silenciosa',
          'REM ===============================================================',
          'set "POS_URL=' + posUrl + '"',
          'set "PROFILE_DIR=%LOCALAPPDATA%\\SanParrillaPOS"',
          '',
          'for %%P in (',
          '  "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe"',
          '  "%ProgramFiles(x86)%\\Google\\Chrome\\Application\\chrome.exe"',
          '  "%LOCALAPPDATA%\\Google\\Chrome\\Application\\chrome.exe"',
          '  "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe"',
          '  "%ProgramFiles%\\Microsoft\\Edge\\Application\\msedge.exe"',
          ') do (',
          '  if exist "%%~P" (',
          '    start "" "%%~P" --user-data-dir="%PROFILE_DIR%" --kiosk-printing --app="%POS_URL%"',
          '    exit /b 0',
          '  )',
          ')',
          'start "" "%POS_URL%"',
        ];
        const blob = new Blob([batLines.join('\r\n') + '\r\n'], { type: 'application/octet-stream' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'San Parrilla POS.bat';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      });
    }

    // Search dishes in grouped price blocks (wired in GESTOR DE PRECIOS section below)

    // =====================================================================
    // EDITOR DE ESPECIALES DEL DÍA (PERSISTENCIA NEON + SINCRONIZACIÓN EN VIVO)
    // =====================================================================
    const preset16500El = document.getElementById('specials-16500-preset');
    const dish1El = document.getElementById('specials-16500-dish1');
    const dish2El = document.getElementById('specials-16500-dish2');
    const presetArrozEl = document.getElementById('specials-arroz-preset');
    const nombreArrozEl = document.getElementById('specials-arroz-nombre');
    const precioArrozEl = document.getElementById('specials-arroz-precio');
    const etiquetaArrozEl = document.getElementById('specials-arroz-etiqueta');

    if (preset16500El && dish1El && dish2El) {
      preset16500El.addEventListener('change', (e) => {
        // @ts-ignore
        const val = e.target.value;
        if (val && val !== 'CUSTOM' && val.includes('|')) {
          const [d1, d2] = val.split('|');
          // @ts-ignore
          dish1El.value = d1 || '';
          // @ts-ignore
          dish2El.value = d2 || '';
        }
      });
    }

    if (presetArrozEl && nombreArrozEl) {
      presetArrozEl.addEventListener('change', (e) => {
        // @ts-ignore
        const val = e.target.value;
        if (val && val !== 'CUSTOM') {
          // @ts-ignore
          nombreArrozEl.value = val;
        } else {
          // @ts-ignore
          nombreArrozEl.focus();
        }
      });
    }

    function applySpecialsToForm(cfg) {
      if (!cfg) return;
      // @ts-ignore
      const sopaEl = document.getElementById('specials-sopa');
      // @ts-ignore
      const prinEl = document.getElementById('specials-principios');
      // @ts-ignore
      const acomEl = document.getElementById('specials-acompanamientos');

      const sopaVal = cfg.sopa_dia || cfg.sopa || '';
      if (sopaEl && sopaVal) sopaEl.value = sopaVal;

      if (prinEl && Array.isArray(cfg.principios)) {
        prinEl.value = cfg.principios.join(', ');
      }
      if (acomEl && Array.isArray(cfg.acompanamientos)) {
        acomEl.value = cfg.acompanamientos.join(', ');
      }

      if (Array.isArray(cfg.especiales_16500) && cfg.especiales_16500.length > 0) {
        // @ts-ignore
        if (dish1El) dish1El.value = cfg.especiales_16500[0] || '';
        // @ts-ignore
        if (dish2El) dish2El.value = cfg.especiales_16500[1] || '';
        const pairStr = `${cfg.especiales_16500[0] || ''}|${cfg.especiales_16500[1] || ''}`;
        if (preset16500El) {
          // @ts-ignore
          const hasOpt = Array.from(preset16500El.options).some(o => o.value === pairStr);
          // @ts-ignore
          preset16500El.value = hasOpt ? pairStr : 'CUSTOM';
        }
      }

      if (cfg.especial_arroz_nombre && nombreArrozEl) {
        // @ts-ignore
        nombreArrozEl.value = cfg.especial_arroz_nombre;
        if (presetArrozEl) {
          // @ts-ignore
          const hasOpt = Array.from(presetArrozEl.options).some(o => o.value === cfg.especial_arroz_nombre);
          // @ts-ignore
          presetArrozEl.value = hasOpt ? cfg.especial_arroz_nombre : 'CUSTOM';
        }
      }

      if (cfg.especial_arroz_precio && precioArrozEl) {
        // @ts-ignore
        precioArrozEl.value = String(cfg.especial_arroz_precio);
      }

      if (cfg.especial_arroz_etiqueta && etiquetaArrozEl) {
        // @ts-ignore
        const hasTag = Array.from(etiquetaArrozEl.options).some(o => o.value === cfg.especial_arroz_etiqueta);
        if (!hasTag) {
          const opt = document.createElement('option');
          opt.value = cfg.especial_arroz_etiqueta;
          opt.textContent = cfg.especial_arroz_etiqueta;
          etiquetaArrozEl.appendChild(opt);
        }
        // @ts-ignore
        etiquetaArrozEl.value = cfg.especial_arroz_etiqueta;
      }
    }

    async function loadLiveSpecialsIntoAdmin() {
      try {
        const res = await fetch('/api/especiales-dia', { cache: 'no-store' });
        if (res.ok) {
          const data = await res.json();
          if (data && (data.sopa_dia || data.sopa)) {
            applySpecialsToForm(data);
            try { localStorage.setItem('sp_daily_specials_v1', JSON.stringify(data)); } catch (_) {}
          }
        }
      } catch (err) {
        console.warn('Error cargando /api/especiales-dia en Admin:', err);
      }
    }

    // Save Daily Specials
    const formSpecials = document.getElementById('form-specials');
    if (formSpecials) {
      formSpecials.addEventListener('submit', async (e) => {
        e.preventDefault();
        // @ts-ignore
        const sopa = document.getElementById('specials-sopa').value.trim();
        // @ts-ignore
        const principios = document.getElementById('specials-principios').value.split(',').map(s => s.trim()).filter(Boolean);
        // @ts-ignore
        const acompanamientos = document.getElementById('specials-acompanamientos').value.split(',').map(s => s.trim()).filter(Boolean);
        // @ts-ignore
        const d1 = (dish1El?.value || '').trim();
        // @ts-ignore
        const d2 = (dish2El?.value || '').trim();
        const especiales_16500 = [d1, d2].filter(Boolean);
        // @ts-ignore
        const especial_arroz_nombre = (nombreArrozEl?.value || 'Arroz ranchero').trim();
        // @ts-ignore
        const especial_arroz_precio = Number(precioArrozEl?.value || 18000);
        // @ts-ignore
        const especial_arroz_etiqueta = (etiquetaArrozEl?.value || '⭐ SOLO POR HOY').trim();

        const btnSave = document.getElementById('btn-save-specials');
        if (btnSave) btnSave.textContent = 'Guardando en Neon DB...';

        const payload = {
          sopa,
          sopa_dia: sopa,
          principios,
          acompanamientos,
          especiales_16500,
          especiales_16500_etiqueta: '⭐ SOLO POR HOY',
          especial_arroz_nombre,
          especial_arroz_etiqueta,
          especial_arroz_precio
        };

        try {
          const res = await fetch('/api/especiales-dia', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          const savedSpecials = data.specials || payload;

          try {
            localStorage.setItem('sp_daily_specials_v1', JSON.stringify(savedSpecials));
            if (typeof BroadcastChannel !== 'undefined') {
              const bc = new BroadcastChannel('sp_specials_channel');
              bc.postMessage(savedSpecials);
              bc.close();
            }
          } catch (_) {}

          const feedback = document.getElementById('specials-save-feedback');
          if (feedback) {
            feedback.classList.remove('hidden');
            setTimeout(() => feedback.classList.add('hidden'), 6000);
          }
        } catch (err) {
          alert('Error al guardar especiales del día: ' + (err.message || err));
        } finally {
          if (btnSave) btnSave.textContent = '💾 Guardar Especiales del Día (Carta + POS)';
        }
      });
    }

    // =====================================================================
    // 3. GESTOR DE PRECIOS Y PLATOS AGOTADOS AGRUPADO POR BLOQUES EN VIVO
