---
export const prerender = true;
import StaffLayout from '../layouts/StaffLayout.astro';
import { getDashboardMetrics, getDailySpecials, getProducts, getCategories, fallbackCategories, initialProductList } from '../lib/db.js';

const metrics = getDashboardMetrics();
const specials = getDailySpecials();
const rawProducts = getProducts(false);
const products = (rawProducts && rawProducts.length > 0) ? rawProducts : initialProductList;
const rawCategories = getCategories();
const categories = (rawCategories && rawCategories.length > 0) ? rawCategories : fallbackCategories;

const formatPrice = (val) => {
  return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val || 0);
};
---

<StaffLayout title="Panel de Métricas & Menú | San Parrilla">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 flex flex-col no-print">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-parrilla-border pb-6 mb-8">
      <div>
        <span class="text-xs font-bold text-parrilla-gold uppercase tracking-widest">Inteligencia de Negocio & Control</span>
        <h1 class="font-display font-black text-3xl sm:text-4xl text-parrilla-ivory mt-1">Dashboard & Administración</h1>
      </div>

      <div class="flex items-center gap-3">
        <button id="btn-download-launcher" type="button" class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-parrilla-ivory font-bold text-xs px-4 py-2.5 rounded-xl border border-parrilla-border shadow-sm transition" title="Descarga el acceso directo de Windows que abre el POS e imprime sin ventanas">
          <i data-lucide="download" class="w-4 h-4"></i>
          <span>Lanzador PC de caja (.bat)</span>
        </button>
        <a href="/pos" class="inline-flex items-center gap-2 bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-sm transition">
          <i data-lucide="zap" class="w-4 h-4"></i>
          <span>Ir al POS</span>
        </a>
      </div>
    </div>

    <!-- 1. KPI CARDS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      
      <!-- Ventas Hoy -->
      <div class="bg-parrilla-surface rounded-2xl p-5 border border-parrilla-border shadow-lg">
        <div class="flex items-center justify-between text-parrilla-muted mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Ventas de Hoy</span>
          <i data-lucide="dollar-sign" class="w-5 h-5 text-parrilla-gold"></i>
        </div>
        <div id="admin-today-sales" class="font-display font-black text-3xl text-parrilla-gold">
          {formatPrice(metrics.todaySales)}
        </div>
        <span id="admin-sales-breakdown" class="text-[11px] text-parrilla-muted mt-1 block">
          Efectivo: {formatPrice(metrics.cashSales)} | Digital: {formatPrice(metrics.digitalSales)}
        </span>
      </div>

      <!-- Pedidos Hoy -->
      <div class="bg-parrilla-surface rounded-2xl p-5 border border-parrilla-border shadow-lg">
        <div class="flex items-center justify-between text-parrilla-muted mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Comandas Totales</span>
          <i data-lucide="shopping-cart" class="w-5 h-5 text-parrilla-accent"></i>
        </div>
        <div id="admin-order-count" class="font-display font-black text-3xl text-parrilla-ivory">
          {metrics.todayOrderCount}
        </div>
        <span class="text-[11px] text-parrilla-muted mt-1 block">Mesas y domicilios atendidos hoy</span>
      </div>

      <!-- Clientes en Base de Datos -->
      <div class="bg-parrilla-surface rounded-2xl p-5 border border-parrilla-border shadow-lg">
        <div class="flex items-center justify-between text-parrilla-muted mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Clientes Guardados</span>
          <i data-lucide="users" class="w-5 h-5 text-amber-400"></i>
        </div>
        <div id="admin-customers-count" class="font-display font-black text-3xl text-amber-400">
          {metrics.totalCustomers}
        </div>
        <span class="text-[11px] text-parrilla-muted mt-1 block">Teléfonos y direcciones para envíos</span>
      </div>

      <!-- Visitas al Menú QR -->
      <div class="bg-parrilla-surface rounded-2xl p-5 border border-parrilla-border shadow-lg">
        <div class="flex items-center justify-between text-parrilla-muted mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Escaneos QR Hoy</span>
          <i data-lucide="qr-code" class="w-5 h-5 text-blue-400"></i>
        </div>
        <div class="font-display font-black text-3xl text-blue-400">
          {metrics.todayViews}
        </div>
        <span class="text-[11px] text-parrilla-muted mt-1 block">Personas viendo la carta digital</span>
      </div>
    </div>

    <!-- 1.5 AUDITORÍA DE PEDIDOS DEL DÍA & MEDIOS DE PAGO -->
    <div class="bg-parrilla-surface rounded-2xl border border-parrilla-border p-6 shadow-xl mb-10">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 mb-5 border-b border-parrilla-border">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl">📋</span>
            <h2 class="font-display font-black text-xl sm:text-2xl text-parrilla-ivory">Auditoría de Pedidos del Día & Medios de Pago</h2>
          </div>
          <p class="text-xs text-parrilla-muted mt-1">
            Filtra ventas por medio de pago y corrige en 1 clic cualquier pedido mal cerrado (recalcula automáticamente el arqueo de Caja).
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <div class="relative w-full sm:w-64">
            <i data-lucide="search" class="w-4 h-4 text-parrilla-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input
              type="text"
              id="audit-search-input"
              placeholder="Buscar #SP, cliente, mesa, mensajero..."
              class="w-full pl-9 pr-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>
          <button
            type="button"
            id="btn-refresh-audit"
            class="inline-flex items-center gap-1.5 bg-white hover:bg-slate-50 text-parrilla-ivory font-bold text-xs px-3.5 py-2 rounded-xl border border-parrilla-border shadow-sm transition"
          >
            <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-parrilla-gold"></i>
            <span>Sincronizar</span>
          </button>
        </div>
      </div>

      <!-- Pestañas / Filtros por Medio de Pago con suma total al lado -->
      <div class="flex flex-wrap items-center gap-2 mb-5" id="audit-payment-tabs">
        <button
          type="button"
          data-filter="ALL"
          class="audit-tab-btn active px-3.5 py-2 rounded-xl font-bold text-xs border transition flex items-center gap-2 bg-parrilla-gold text-white border-parrilla-gold shadow-sm"
        >
          <span>Todos</span>
          <span id="tab-sum-ALL" class="px-2 py-0.5 rounded-lg bg-black/20 text-white font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="CASH"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-emerald-500 transition flex items-center gap-2"
        >
          <span>💵 Efectivo</span>
          <span id="tab-sum-CASH" class="px-2 py-0.5 rounded-lg bg-emerald-100 text-emerald-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="NEQUI"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-purple-500 transition flex items-center gap-2"
        >
          <span>🟣 Nequi</span>
          <span id="tab-sum-NEQUI" class="px-2 py-0.5 rounded-lg bg-purple-100 text-purple-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="BANCOLOMBIA"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-amber-500 transition flex items-center gap-2"
        >
          <span>🟡 Bancolombia</span>
          <span id="tab-sum-BANCOLOMBIA" class="px-2 py-0.5 rounded-lg bg-amber-100 text-amber-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="DAVIPLATA"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-rose-500 transition flex items-center gap-2"
        >
          <span>🔴 Daviplata</span>
          <span id="tab-sum-DAVIPLATA" class="px-2 py-0.5 rounded-lg bg-rose-100 text-rose-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="CARD"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-blue-500 transition flex items-center gap-2"
        >
          <span>💳 Datáfono / Tarjeta</span>
          <span id="tab-sum-CARD" class="px-2 py-0.5 rounded-lg bg-blue-100 text-blue-900 font-mono text-[11px]">$0</span>
        </button>
      </div>

      <!-- Banner de confirmación de cambio contable -->
      <div id="audit-toast" class="hidden mb-4 px-4 py-2.5 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs font-bold flex items-center justify-between">
        <span id="audit-toast-text">✓ Medio de pago actualizado y arqueo de caja recalculado al instante.</span>
        <a href="/caja" class="underline font-black hover:text-emerald-700">Ver en Caja →</a>
      </div>

      <!-- Tabla Interactiva de Pedidos del Día / Turno -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-parrilla-border text-parrilla-muted uppercase font-bold text-[11px]">
              <th class="py-3 px-2.5">Hora</th>
              <th class="py-3 px-2.5">Código</th>
              <th class="py-3 px-2.5">Tipo</th>
              <th class="py-3 px-2.5">Cliente / Mensajero</th>
              <th class="py-3 px-2.5">Platos</th>
              <th class="py-3 px-2.5 text-right">Total</th>
              <th class="py-3 px-2.5">Medio de Pago (1 Clic)</th>
              <th class="py-3 px-2.5 text-right">Acción</th>
            </tr>
          </thead>
          <tbody id="audit-orders-tbody" class="divide-y divide-parrilla-border/50">
            <tr>
              <td colspan="8" class="py-8 text-center text-parrilla-muted italic">
                Cargando pedidos del turno y día actual...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal de Edición / Detalle de Pedido en Admin -->
    <div id="modal-admin-edit-order" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-parrilla-surface border border-parrilla-border rounded-2xl max-w-lg w-full p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-parrilla-border">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-widest text-parrilla-gold">Auditoría Contable & Operativa</span>
            <h3 id="modal-edit-title" class="font-display font-black text-xl text-parrilla-ivory">Editar Pedido #SP-0</h3>
          </div>
          <button type="button" id="btn-close-edit-modal" class="text-parrilla-muted hover:text-parrilla-ivory p-1">✕</button>
        </div>

        <form id="form-admin-edit-order" class="space-y-4">
          <input type="hidden" id="edit-order-id" />

          <div>
            <label class="block text-xs font-bold uppercase text-parrilla-gold mb-1.5">Medio de Pago Contabilizado *</label>
            <select
              id="edit-order-method"
              class="w-full px-3.5 py-2.5 bg-parrilla-dark rounded-xl border border-parrilla-border text-sm font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
            >
              <option value="CASH">💵 Efectivo (Suma a Efectivo en Caja)</option>
              <option value="NEQUI">🟣 Nequi (Transferencia Digital)</option>
              <option value="BANCOLOMBIA">🟡 Bancolombia / QR / Ahorro a la Mano</option>
              <option value="DAVIPLATA">🔴 Daviplata (Transferencia Digital)</option>
              <option value="CARD">💳 Datáfono / Tarjeta</option>
            </select>
            <span class="text-[11px] text-parrilla-muted mt-1 block">
              Al cambiar el medio de pago, la sesión activa de Caja recalcula efectivo esperado y transferencias de inmediato.
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Cliente</label>
              <input
                type="text"
                id="edit-order-cliente"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Teléfono</label>
              <input
                type="text"
                id="edit-order-telefono"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Mesa / Dirección</label>
              <input
                type="text"
                id="edit-order-mesa"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">🛵 Mensajero (Domicilio)</label>
              <input
                type="text"
                id="edit-order-courier"
                placeholder="Sin asignar"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Costo Domicilio ($)</label>
              <input
                type="number"
                id="edit-order-delivery-fee"
                min="0"
                step="500"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Estado del Pedido</label>
              <select
                id="edit-order-estado"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
              >
                <option value="PAGADO">✅ PAGADO (Cobrado)</option>
                <option value="ENTREGADO">🛵 ENTREGADO (Cobrado)</option>
                <option value="EN_PREPARACION">🍳 EN PREPARACIÓN (Abierto)</option>
                <option value="EN_CAMINO">🛵 EN CAMINO (Abierto)</option>
                <option value="PENDIENTE">⏳ PENDIENTE (Abierto)</option>
                <option value="CANCELADO">🚫 ANULADO / CANCELADO</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Notas / Observaciones</label>
            <input
              type="text"
              id="edit-order-notas"
              class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>

          <div id="edit-order-dishes-summary" class="p-3 rounded-xl bg-parrilla-dark border border-parrilla-border text-xs text-parrilla-ivory space-y-1"></div>

          <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-parrilla-border">
            <button
              type="button"
              id="btn-cancel-edit-modal"
              class="px-4 py-2.5 rounded-xl border border-parrilla-border text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory"
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="btn-submit-edit-modal"
              class="px-5 py-2.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white text-xs font-black shadow-md transition"
            >
              💾 Guardar Cambios y Recalcular Caja
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 2. RANKING PLATOS TOP & EDITOR DE ESPECIALES -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
      
      <!-- Top Platos Vendidos (6 cols) -->
      <div class="lg:col-span-6 bg-parrilla-surface rounded-2xl border border-parrilla-border p-6 shadow-xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-parrilla-border">
          <div>
            <h2 class="font-display font-bold text-lg text-parrilla-ivory">Platos Más Vendidos</h2>
            <p class="text-xs text-parrilla-muted">Ranking en tiempo real de productos con mayor salida hoy / turno.</p>
          </div>
          <i data-lucide="flame" class="w-5 h-5 text-parrilla-gold"></i>
        </div>

        <div id="admin-top-dishes-container">
          {metrics.topDishes.length === 0 ? (
            <div class="py-10 text-center text-xs text-parrilla-muted italic">
              Aún no hay comandas registradas en este turno. Cobra pedidos en el POS para ver las estadísticas en vivo.
            </div>
          ) : (
            <div class="space-y-3">
              {metrics.topDishes.map((dish, idx) => (
                <div class="flex items-center justify-between p-3 rounded-xl bg-parrilla-dark border border-parrilla-border/60">
                  <div class="flex items-center gap-3">
                    <span class="w-7 h-7 rounded-lg bg-parrilla-gold/20 text-parrilla-gold flex items-center justify-center font-black text-xs font-display">
                      #{idx + 1}
                    </span>
                    <div>
                      <span class="font-bold text-sm text-parrilla-ivory block">{dish.product_name}</span>
                      <span class="text-xs text-parrilla-muted">{dish.sold_count} porciones vendidas</span>
                    </div>
                  </div>
                  <div class="font-display font-extrabold text-sm text-parrilla-gold">
                    {formatPrice(dish.total_revenue)}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Editor de Especiales del Día (6 cols) -->
      <div class="lg:col-span-6 bg-parrilla-surface rounded-2xl border border-parrilla-border p-6 shadow-xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-parrilla-border">
          <div>
            <h2 class="font-display font-bold text-lg text-parrilla-ivory">Editor de Especiales del Día</h2>
            <p class="text-xs text-parrilla-muted">Modifica la sopa y principios que se muestran en el menú digital.</p>
          </div>
          <i data-lucide="soup" class="w-5 h-5 text-amber-400"></i>
        </div>

        <form id="form-specials" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-parrilla-gold uppercase mb-1">Sopa del Día *</label>
            <input 
              type="text" 
              id="specials-sopa" 
              value={specials?.sopa || ''} 
              required
              class="w-full px-3.5 py-2.5 bg-parrilla-dark rounded-xl border border-parrilla-border text-sm text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-parrilla-gold uppercase mb-1">Principios (separados por coma) *</label>
            <input 
              type="text" 
              id="specials-principios" 
              value={specials?.principios?.join(', ') || ''} 
              required
              class="w-full px-3.5 py-2.5 bg-parrilla-dark rounded-xl border border-parrilla-border text-sm text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
            <span class="text-[10px] text-parrilla-muted mt-1 block">Ejemplo: Ensalada de atún, Garbanzos rancheros, Frijoles</span>
          </div>

          <div>
            <label class="block text-xs font-bold text-parrilla-gold uppercase mb-1">Acompañamientos (separados por coma) *</label>
            <input 
              type="text" 
              id="specials-acompanamientos" 
              value={specials?.acompanamientos?.join(', ') || ''} 
              required
              class="w-full px-3.5 py-2.5 bg-parrilla-dark rounded-xl border border-parrilla-border text-sm text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
            <span class="text-[10px] text-parrilla-muted mt-1 block">Ejemplo: Francesa casera, Torta de zanahoria, Tajadas maduras</span>
          </div>

          <button 
            type="submit" 
            id="btn-save-specials"
            class="w-full py-3 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-bold text-sm shadow-md transition active:scale-95"
          >
            Guardar Especiales del Día
          </button>
        </form>
      </div>

    </div>

    <!-- 3. GESTOR DE PRECIOS Y DISPONIBILIDAD DEL MENÚ -->
    <div class="bg-parrilla-surface rounded-2xl border border-parrilla-border p-6 shadow-xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-parrilla-border">
        <div>
          <h2 class="font-display font-bold text-xl text-parrilla-ivory">Gestor de Precios y Platos Agotados</h2>
          <p class="text-xs text-parrilla-muted">Actualiza precios o pausa platos agotados al instante sin tocar código.</p>
        </div>

        <div class="relative w-full sm:w-72">
          <i data-lucide="search" class="w-4 h-4 text-parrilla-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input 
            type="text" 
            id="admin-search-dish" 
            placeholder="Filtrar plato..." 
            class="w-full pl-9 pr-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
          />
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-parrilla-border text-parrilla-muted uppercase font-bold text-[11px]">
              <th class="py-3 px-3">Plato / Producto</th>
              <th class="py-3 px-3">Categoría</th>
              <th class="py-3 px-3">Precio Actual ($)</th>
              <th class="py-3 px-3 text-center">Estado / Disponible</th>
              <th class="py-3 px-3 text-right">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-parrilla-border/40" id="admin-table-body">
            {products.map(p => (
              <tr class="hover:bg-parrilla-dark/40 transition dish-row" data-name={p.name.toLowerCase()}>
                <td class="py-3 px-3 font-bold text-sm text-parrilla-ivory">
                  {p.name}
                </td>
                <td class="py-3 px-3 text-parrilla-muted">
                  {categories.find(c => c.id === p.category_id)?.name || p.category_id}
                </td>
                <td class="py-3 px-3">
                  <div class="flex items-center gap-2">
                    <span class="text-parrilla-gold font-bold font-mono text-sm">$</span>
                    <input 
                      type="number" 
                      class="price-input w-28 px-2 py-1 bg-parrilla-dark rounded-lg border border-parrilla-border text-sm font-mono text-parrilla-gold focus:border-parrilla-gold outline-none"
                      value={p.price}
                      data-id={p.id}
                    />
                  </div>
                </td>
                <td class="py-3 px-3 text-center">
                  <button 
                    type="button" 
                    class="btn-toggle-active px-3 py-1 rounded-full text-[11px] font-bold transition"
                    data-id={p.id}
                    data-active={p.is_active}
                    style={p.is_active ? 'background: rgba(76, 175, 80, 0.2); color: #4CAF50; border: 1px solid rgba(76, 175, 80, 0.4);' : 'background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4);'}
                  >
                    {p.is_active ? '✓ Activo' : '✕ Agotado (Pausado)'}
                  </button>
                </td>
                <td class="py-3 px-3 text-right">
                  <button 
                    type="button" 
                    class="btn-save-price bg-white hover:bg-parrilla-gold text-parrilla-ivory hover:text-white font-bold px-3 py-1.5 rounded-lg border border-parrilla-border hover:border-parrilla-gold shadow-sm transition text-xs"
                    data-id={p.id}
                  >
                    Actualizar
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Client JavaScript for Admin Actions -->
  <script>
    // Download Windows POS Launcher (.bat) with --kiosk-printing
    const btnLauncher = document.getElementById('btn-download-launcher');
    if (btnLauncher) {
      btnLauncher.addEventListener('click', () => {
        const posUrl = `${window.location.origin}/pos`;
        const batLines = [
          '@echo off',
          'REM ===============================================================',
          'REM  San Parrilla POS - Lanzador con impresion termica silenciosa',
          'REM ===============================================================',
          'set "POS_URL=' + posUrl + '"',
          'set "PROFILE_DIR=%LOCALAPPDATA%\\SanParrillaPOS"',
          '',
          'for %%P in (',
          '  "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe"',
          '  "%ProgramFiles(x86)%\\Google\\Chrome\\Application\\chrome.exe"',
          '  "%LOCALAPPDATA%\\Google\\Chrome\\Application\\chrome.exe"',
          '  "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe"',
          '  "%ProgramFiles%\\Microsoft\\Edge\\Application\\msedge.exe"',
          ') do (',
          '  if exist "%%~P" (',
          '    start "" "%%~P" --user-data-dir="%PROFILE_DIR%" --kiosk-printing --app="%POS_URL%"',
          '    exit /b 0',
          '  )',
          ')',
          'start "" "%POS_URL%"',
        ];
        const blob = new Blob([batLines.join('\r\n') + '\r\n'], { type: 'application/octet-stream' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'San Parrilla POS.bat';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      });
    }

    // Search dishes in table
    const searchDishInput = document.getElementById('admin-search-dish');
    const dishRows = document.querySelectorAll('.dish-row');

    if (searchDishInput) {
      searchDishInput.addEventListener('input', (e) => {
        // @ts-ignore
        const q = e.target.value.toLowerCase().trim();
        dishRows.forEach(row => {
          const name = row.getAttribute('data-name') || '';
          // @ts-ignore
          row.style.display = name.includes(q) ? 'table-row' : 'none';
        });
      });
    }

    // Save Daily Specials
    const formSpecials = document.getElementById('form-specials');
    if (formSpecials) {
      formSpecials.addEventListener('submit', async (e) => {
        e.preventDefault();
        // @ts-ignore
        const sopa = document.getElementById('specials-sopa').value.trim();
        // @ts-ignore
        const principios = document.getElementById('specials-principios').value.split(',').map(s => s.trim()).filter(Boolean);
        // @ts-ignore
        const acompanamientos = document.getElementById('specials-acompanamientos').value.split(',').map(s => s.trim()).filter(Boolean);

        const res = await fetch('/api/specials', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sopa, principios, acompanamientos })
        });
        const data = await res.json();
        if (data.success) {
          alert('Especiales del día actualizados correctamente.');
        } else {
          alert('Error: ' + data.error);
        }
      });
    }

    // Update Price buttons
    document.querySelectorAll('.btn-save-price').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        // @ts-ignore
        const input = document.querySelector(`.price-input[data-id="${id}"]`);
        // @ts-ignore
        const price = Number(input.value);

        const res = await fetch('/api/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update_price', id, price })
        });
        const data = await res.json();
        if (data.success) {
          btn.textContent = '✓ Guardado';
          setTimeout(() => { btn.textContent = 'Actualizar'; }, 1500);
        } else {
          alert('Error al guardar precio');
        }
      });
    });

    // Toggle Active / Agotado buttons
    document.querySelectorAll('.btn-toggle-active').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const currentActive = btn.getAttribute('data-active') === '1';
        const newActive = !currentActive;

        const res = await fetch('/api/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'toggle_active', id, is_active: newActive })
        });
        const data = await res.json();
        if (data.success) {
          btn.setAttribute('data-active', newActive ? '1' : '0');
          btn.textContent = newActive ? '✓ Activo' : '✕ Agotado (Pausado)';
          // @ts-ignore
          btn.style.cssText = newActive 
            ? 'background: rgba(76, 175, 80, 0.2); color: #4CAF50; border: 1px solid rgba(76, 175, 80, 0.4);' 
            : 'background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4);';
        } else {
          alert('Error al actualizar disponibilidad');
        }
      });
    });

    // =====================================================================
    // SINCRONIZACIÓN EN VIVO CON NEON DB, AUDITORÍA DE PEDIDOS & CAJA (/admin)
    // =====================================================================
    const fmtCOP = (val) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val || 0);

    let allAuditOrders = [];
    let currentPaymentFilter = 'ALL';
    let currentSearchQuery = '';

    const METHOD_LABELS = {
      CASH: '💵 Efectivo',
      NEQUI: '🟣 Nequi',
      BANCOLOMBIA: '🟡 Bancolombia',
      DAVIPLATA: '🔴 Daviplata',
      CARD: '💳 Datáfono / Tarjeta'
    };

    function getOrderPrimaryMethod(p) {
      if (Array.isArray(p.payments) && p.payments.length > 0) {
        return String(p.payments[p.payments.length - 1].method || 'CASH').toUpperCase();
      }
      return 'PENDIENTE';
    }

    function formatHoraBogota(isoStr) {
      if (!isoStr) return '--:--';
      const raw = (typeof isoStr === 'string' && !isoStr.endsWith('Z') && !isoStr.includes('+') && !isoStr.includes('-', 10))
        ? isoStr + 'Z'
        : isoStr;
      const d = new Date(raw);
      if (isNaN(d.getTime())) return '--:--';
      return d.toLocaleTimeString('es-CO', { timeZone: 'America/Bogota', hour: '2-digit', minute: '2-digit' });
    }

    function showAuditToast(msg) {
      const toast = document.getElementById('audit-toast');
      const text = document.getElementById('audit-toast-text');
      if (text && msg) text.textContent = msg;
      if (toast) {
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 6000);
      }
    }

    function updateAuditTabsAndRender() {
      const sums = {
        ALL: 0,
        CASH: 0,
        NEQUI: 0,
        BANCOLOMBIA: 0,
        DAVIPLATA: 0,
        CARD: 0
      };

      for (const p of allAuditOrders) {
        if (p.estado === 'CANCELADO') continue;
        if (Array.isArray(p.payments) && p.payments.length > 0) {
          for (const pay of p.payments) {
            const m = String(pay.method || 'CASH').toUpperCase();
            const amt = Number(pay.amount || p.total || 0);
            sums.ALL += amt;
            if (sums[m] !== undefined) sums[m] += amt;
          }
        }
      }

      Object.keys(sums).forEach(k => {
        const el = document.getElementById(`tab-sum-${k}`);
        if (el) el.textContent = fmtCOP(sums[k]);
      });

      const tbody = document.getElementById('audit-orders-tbody');
      if (!tbody) return;

      const filtered = allAuditOrders.filter(p => {
        const method = getOrderPrimaryMethod(p);
        if (currentPaymentFilter !== 'ALL') {
          const hasMethod = (Array.isArray(p.payments) && p.payments.some(pay => String(pay.method).toUpperCase() === currentPaymentFilter))
            || method === currentPaymentFilter;
          if (!hasMethod) return false;
        }
        if (currentSearchQuery) {
          const hay = [
            `#sp-${p.id}`,
            String(p.id),
            p.cliente_nombre || '',
            p.cliente_telefono || '',
            p.mesa || '',
            p.courier_name || '',
            p.tipo || '',
            method
          ].join(' ').toLowerCase();
          if (!hay.includes(currentSearchQuery)) return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-8 text-center text-parrilla-muted italic">
              No hay pedidos registrados para este filtro en el turno/día actual.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(p => {
        const hora = formatHoraBogota(p.fecha_hora || p.created_at);
        const method = getOrderPrimaryMethod(p);
        const isCancelled = p.estado === 'CANCELADO';
        const isPaid = p.estado === 'PAGADO' || p.estado === 'ENTREGADO' || (Array.isArray(p.payments) && p.payments.length > 0);

        let tipoBadge = '';
        if (p.tipo === 'MESA') {
          tipoBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-amber-100 text-amber-900 font-bold text-[11px]">🍽️ ${p.mesa || 'Mesa'}</span>`;
        } else if (p.tipo === 'DOMICILIO') {
          tipoBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-blue-100 text-blue-900 font-bold text-[11px]">🛵 Domicilio</span>`;
        } else {
          tipoBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-purple-100 text-purple-900 font-bold text-[11px]">🛍️ Para Llevar</span>`;
        }

        const estadoChip = isCancelled
          ? `<span class="ml-1 px-1.5 py-0.5 rounded bg-rose-100 text-rose-800 text-[10px] font-bold">ANULADO</span>`
          : isPaid
            ? `<span class="ml-1 px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold">PAGADO</span>`
            : `<span class="ml-1 px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 text-[10px] font-bold">${p.estado}</span>`;

        const platosStr = (p.detalles || []).map(d => {
          const n = d.plato?.nombre || d.nombre_plato || `Plato #${d.plato_id}`;
          return `${d.cantidad}x ${n}`;
        }).join(', ') || 'Sin detalles';

        const courierHtml = (p.tipo === 'DOMICILIO' && p.courier_name)
          ? `<span class="block text-[11px] font-bold text-blue-700 mt-0.5">🛵 Mensajero: ${p.courier_name}</span>`
          : (p.tipo === 'DOMICILIO' ? `<span class="block text-[10px] text-parrilla-muted mt-0.5">🛵 Sin mensajero asignado</span>` : '');

        const dirHtml = (p.tipo === 'DOMICILIO' && p.mesa)
          ? `<span class="block text-[10px] text-parrilla-muted truncate max-w-[200px]" title="${p.mesa}">📍 ${p.mesa}</span>`
          : '';

        return `
          <tr class="hover:bg-parrilla-dark/50 transition ${isCancelled ? 'opacity-50 line-through' : ''}">
            <td class="py-3 px-2.5 font-mono text-parrilla-muted whitespace-nowrap">${hora}</td>
            <td class="py-3 px-2.5 whitespace-nowrap">
              <span class="font-mono font-black text-parrilla-ivory">#SP-${p.id}</span>
              ${estadoChip}
            </td>
            <td class="py-3 px-2.5 whitespace-nowrap">${tipoBadge}</td>
            <td class="py-3 px-2.5">
              <div class="font-bold text-parrilla-ivory">${p.cliente_nombre || 'Cliente General'}</div>
              ${p.cliente_telefono ? `<span class="text-[11px] text-parrilla-muted font-mono">📞 ${p.cliente_telefono}</span>` : ''}
              ${dirHtml}
              ${courierHtml}
            </td>
            <td class="py-3 px-2.5 max-w-xs">
              <div class="text-xs text-parrilla-ivory line-clamp-2" title="${platosStr}">${platosStr}</div>
            </td>
            <td class="py-3 px-2.5 text-right font-display font-black text-sm text-parrilla-gold whitespace-nowrap">
              ${fmtCOP(p.total || 0)}
            </td>
            <td class="py-3 px-2.5 whitespace-nowrap">
              <select
                class="audit-inline-method-select px-2.5 py-1.5 rounded-xl border border-parrilla-border bg-white text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none shadow-sm cursor-pointer"
                data-order-id="${p.id}"
                ${isCancelled ? 'disabled' : ''}
              >
                ${!isPaid ? `<option value="PENDIENTE" selected>⏳ Pendiente de Cobro</option>` : ''}
                <option value="CASH" ${method === 'CASH' ? 'selected' : ''}>💵 Efectivo</option>
                <option value="NEQUI" ${method === 'NEQUI' ? 'selected' : ''}>🟣 Nequi</option>
                <option value="BANCOLOMBIA" ${method === 'BANCOLOMBIA' ? 'selected' : ''}>🟡 Bancolombia</option>
                <option value="DAVIPLATA" ${method === 'DAVIPLATA' ? 'selected' : ''}>🔴 Daviplata</option>
                <option value="CARD" ${method === 'CARD' ? 'selected' : ''}>💳 Datáfono / Tarjeta</option>
              </select>
            </td>
            <td class="py-3 px-2.5 text-right whitespace-nowrap">
              <button
                type="button"
                class="btn-open-edit-order inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-white hover:bg-parrilla-gold text-parrilla-ivory hover:text-white border border-parrilla-border font-bold text-xs shadow-sm transition"
                data-order-id="${p.id}"
              >
                ✏️ Editar
              </button>
            </td>
          </tr>
        `;
      }).join('');

      // Bind 1-click inline payment method selector
      tbody.querySelectorAll('.audit-inline-method-select').forEach(sel => {
        sel.addEventListener('change', async (e) => {
          // @ts-ignore
          const selectEl = e.target;
          const orderId = Number(selectEl.getAttribute('data-order-id'));
          const newMethod = selectEl.value;
          if (!orderId || newMethod === 'PENDIENTE') return;
          selectEl.disabled = true;
          try {
            await changeOrderPaymentMethodAndDetails(orderId, { payment_method: newMethod });
            showAuditToast(`✓ Pedido #SP-${orderId} actualizado a ${METHOD_LABELS[newMethod] || newMethod}. Arqueo de Caja recalculado.`);
          } catch (err) {
            alert('Error al cambiar medio de pago: ' + (err.message || err));
          } finally {
            selectEl.disabled = false;
            await loadLiveAdminMetrics();
          }
        });
      });

      // Bind Edit Modal buttons
      tbody.querySelectorAll('.btn-open-edit-order').forEach(btn => {
        btn.addEventListener('click', () => {
          const orderId = Number(btn.getAttribute('data-order-id'));
          openEditOrderModal(orderId);
        });
      });
    }

    async function changeOrderPaymentMethodAndDetails(orderId, payload) {
      // 1. Intentar PATCH /api/pedidos/{id}/payment-method
      const res = await fetch(`/api/pedidos/${orderId}/payment-method`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (res.ok) {
        return await res.json();
      }
      // 2. Fallback a POST /api/pedidos/{id}/approve si el backend aún está redesplegando
      const fallbackRes = await fetch(`/api/pedidos/${orderId}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ payment_method: payload.payment_method })
      });
      if (fallbackRes.ok) {
        return await fallbackRes.json();
      }
      const errData = await res.json().catch(() => ({}));
      throw new Error(errData.detail || errData.error || 'No se pudo actualizar el pedido');
    }

    function openEditOrderModal(orderId) {
      const order = allAuditOrders.find(o => Number(o.id) === Number(orderId));
      if (!order) return;

      const modal = document.getElementById('modal-admin-edit-order');
      const title = document.getElementById('modal-edit-title');
      // @ts-ignore
      const idInput = document.getElementById('edit-order-id');
      // @ts-ignore
      const methodSelect = document.getElementById('edit-order-method');
      // @ts-ignore
      const clienteInput = document.getElementById('edit-order-cliente');
      // @ts-ignore
      const telInput = document.getElementById('edit-order-telefono');
      // @ts-ignore
      const mesaInput = document.getElementById('edit-order-mesa');
      // @ts-ignore
      const courierInput = document.getElementById('edit-order-courier');
      // @ts-ignore
      const feeInput = document.getElementById('edit-order-delivery-fee');
      // @ts-ignore
      const estadoSelect = document.getElementById('edit-order-estado');
      // @ts-ignore
      const notasInput = document.getElementById('edit-order-notas');
      const dishesSummary = document.getElementById('edit-order-dishes-summary');

      if (title) title.textContent = `Editar Pedido #SP-${order.id} (${fmtCOP(order.total || 0)})`;
      if (idInput) idInput.value = String(order.id);
      const curMethod = getOrderPrimaryMethod(order);
      if (methodSelect) methodSelect.value = curMethod === 'PENDIENTE' ? 'CASH' : curMethod;
      if (clienteInput) clienteInput.value = order.cliente_nombre || '';
      if (telInput) telInput.value = order.cliente_telefono || '';
      if (mesaInput) mesaInput.value = order.mesa || '';
      if (courierInput) courierInput.value = order.courier_name || '';
      if (feeInput) feeInput.value = String(order.delivery_fee || 0);
      if (estadoSelect) estadoSelect.value = order.estado || 'PAGADO';
      if (notasInput) notasInput.value = order.notas || '';

      if (dishesSummary) {
        const itemsHtml = (order.detalles || []).map(d => {
          const n = d.plato?.nombre || d.nombre_plato || `Plato #${d.plato_id}`;
          return `<div class="flex justify-between"><span>${d.cantidad}x ${n}</span><span class="font-mono font-bold">${fmtCOP((d.precio_unitario || 0) * (d.cantidad || 1))}</span></div>`;
        }).join('');
        dishesSummary.innerHTML = `
          <div class="text-[10px] font-bold uppercase text-parrilla-gold mb-1">Detalle de Platos</div>
          ${itemsHtml || '<div class="text-parrilla-muted italic">Sin platos</div>'}
          <div class="flex justify-between pt-1.5 mt-1.5 border-t border-parrilla-border font-bold">
            <span>Total Pedido:</span>
            <span class="text-parrilla-gold font-mono">${fmtCOP(order.total || 0)}</span>
          </div>
        `;
      }

      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeEditOrderModal() {
      const modal = document.getElementById('modal-admin-edit-order');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    document.getElementById('btn-close-edit-modal')?.addEventListener('click', closeEditOrderModal);
    document.getElementById('btn-cancel-edit-modal')?.addEventListener('click', closeEditOrderModal);

    document.getElementById('form-admin-edit-order')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      // @ts-ignore
      const orderId = Number(document.getElementById('edit-order-id')?.value);
      // @ts-ignore
      const payment_method = document.getElementById('edit-order-method')?.value || 'CASH';
      // @ts-ignore
      const cliente_nombre = document.getElementById('edit-order-cliente')?.value?.trim() || '';
      // @ts-ignore
      const cliente_telefono = document.getElementById('edit-order-telefono')?.value?.trim() || '';
      // @ts-ignore
      const mesa = document.getElementById('edit-order-mesa')?.value?.trim() || '';
      // @ts-ignore
      const courier_name = document.getElementById('edit-order-courier')?.value?.trim() || '';
      // @ts-ignore
      const delivery_fee = Number(document.getElementById('edit-order-delivery-fee')?.value || 0);
      // @ts-ignore
      const estado = document.getElementById('edit-order-estado')?.value || 'PAGADO';
      // @ts-ignore
      const notas = document.getElementById('edit-order-notas')?.value?.trim() || '';

      const submitBtn = document.getElementById('btn-submit-edit-modal');
      if (submitBtn) submitBtn.textContent = 'Guardando...';

      try {
        await changeOrderPaymentMethodAndDetails(orderId, {
          payment_method,
          cliente_nombre,
          cliente_telefono,
          mesa,
          courier_name,
          delivery_fee,
          estado,
          notas
        });
        closeEditOrderModal();
        showAuditToast(`✓ Pedido #SP-${orderId} actualizado (${METHOD_LABELS[payment_method] || payment_method}) y Caja recalculada.`);
        await loadLiveAdminMetrics();
      } catch (err) {
        alert('Error al guardar cambios del pedido: ' + (err.message || err));
      } finally {
        if (submitBtn) submitBtn.textContent = '💾 Guardar Cambios y Recalcular Caja';
      }
    });

    // Filtros por pestaña de medio de pago
    document.querySelectorAll('.audit-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentPaymentFilter = btn.getAttribute('data-filter') || 'ALL';
        document.querySelectorAll('.audit-tab-btn').forEach(b => {
          b.classList.remove('bg-parrilla-gold', 'text-white', 'border-parrilla-gold', 'shadow-sm');
          b.classList.add('bg-parrilla-dark', 'text-parrilla-ivory', 'border-parrilla-border');
        });
        btn.classList.remove('bg-parrilla-dark', 'text-parrilla-ivory', 'border-parrilla-border');
        btn.classList.add('bg-parrilla-gold', 'text-white', 'border-parrilla-gold', 'shadow-sm');
        updateAuditTabsAndRender();
      });
    });

    document.getElementById('audit-search-input')?.addEventListener('input', (e) => {
      // @ts-ignore
      currentSearchQuery = (e.target.value || '').toLowerCase().trim();
      updateAuditTabsAndRender();
    });

    document.getElementById('btn-refresh-audit')?.addEventListener('click', () => {
      loadLiveAdminMetrics();
    });

    function renderLiveAdminMetrics(stats) {
      const salesEl = document.getElementById('admin-today-sales');
      const breakdownEl = document.getElementById('admin-sales-breakdown');
      const countEl = document.getElementById('admin-order-count');
      const custEl = document.getElementById('admin-customers-count');
      const topContainer = document.getElementById('admin-top-dishes-container');

      if (salesEl) salesEl.textContent = fmtCOP(stats.todaySales || 0);
      if (breakdownEl) {
        breakdownEl.textContent = `Efectivo: ${fmtCOP(stats.cashSales || 0)} | Digital/Tarjetas: ${fmtCOP(stats.digitalSales || 0)}`;
      }
      if (countEl) countEl.textContent = String(stats.todayOrderCount || 0);
      if (custEl && typeof stats.totalCustomers === 'number') {
        custEl.textContent = String(stats.totalCustomers);
      }

      if (topContainer) {
        const list = Array.isArray(stats.topDishes) ? stats.topDishes : [];
        if (list.length === 0) {
          topContainer.innerHTML = `
            <div class="py-10 text-center text-xs text-parrilla-muted italic">
              Aún no hay comandas pagadas en este turno. Cobra pedidos en el POS para ver las estadísticas reales.
            </div>
          `;
        } else {
          topContainer.innerHTML = `
            <div class="space-y-3">
              ${list.map((dish, idx) => `
                <div class="flex items-center justify-between p-3 rounded-xl bg-parrilla-dark border border-parrilla-border/60">
                  <div class="flex items-center gap-3">
                    <span class="w-7 h-7 rounded-lg bg-parrilla-gold/20 text-parrilla-gold flex items-center justify-center font-black text-xs font-display">
                      #${idx + 1}
                    </span>
                    <div>
                      <span class="font-bold text-sm text-parrilla-ivory block">${dish.product_name}</span>
                      <span class="text-xs text-parrilla-muted">${dish.sold_count} porción(es) vendida(s)</span>
                    </div>
                  </div>
                  <div class="font-display font-extrabold text-sm text-parrilla-gold">
                    ${fmtCOP(dish.total_revenue)}
                  </div>
                </div>
              `).join('')}
            </div>
          `;
        }
      }
    }

    async function loadLiveAdminMetrics() {
      try {
        const [cajaRes, pedRes, dashRes] = await Promise.all([
          fetch('/api/caja/active', { cache: 'no-store' }),
          fetch('/api/pedidos?limit=250', { cache: 'no-store' }),
          fetch('/api/pedidos/stats/dashboard', { cache: 'no-store' }).catch(() => null)
        ]);

        const caja = (cajaRes && cajaRes.ok) ? await cajaRes.json() : null;
        const pedidos = (pedRes && pedRes.ok) ? await pedRes.json() : [];
        const listaPedidos = Array.isArray(pedidos) ? pedidos : [];

        // Filtrar pedidos del turno activo de caja o del día de hoy en Colombia
        const hoyCol = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });
        const pedidosTurnoOHoy = listaPedidos.filter(p => {
          if (caja && caja.status === 'OPEN' && Array.isArray(p.payments)) {
            if (p.payments.some(pay => pay.cash_closure_id === caja.id)) return true;
          }
          const ts = p.fecha_hora || p.created_at;
          if (ts) {
            const raw = (typeof ts === 'string' && !ts.endsWith('Z') && !ts.includes('+') && !ts.includes('-', 10)) ? ts + 'Z' : ts;
            const d = new Date(raw);
            if (!isNaN(d.getTime())) {
              const fechaPed = d.toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });
              if (fechaPed === hoyCol) return true;
            }
          }
          return false;
        });

        allAuditOrders = pedidosTurnoOHoy;
        updateAuditTabsAndRender();

        if (dashRes && dashRes.ok) {
          const dashData = await dashRes.json();
          if (dashData && typeof dashData.todaySales === 'number') {
            renderLiveAdminMetrics(dashData);
            return;
          }
        }

        let cashSales = 0;
        let digitalSales = 0;
        const pedidosPagados = pedidosTurnoOHoy.filter(p => p.estado !== 'CANCELADO' && Array.isArray(p.payments) && p.payments.length > 0);

        if (caja && caja.status === 'OPEN') {
          cashSales = Number(caja.total_cash_sales || 0);
          digitalSales = Number(caja.total_nequi_sales || 0)
            + Number(caja.total_bancolombia_sales || 0)
            + Number(caja.total_daviplata_sales || 0)
            + Number(caja.total_card_sales || 0);
        } else {
          for (const p of pedidosPagados) {
            for (const pay of (p.payments || [])) {
              if (String(pay.method).toUpperCase() === 'CASH') cashSales += Number(pay.amount || 0);
              else digitalSales += Number(pay.amount || 0);
            }
          }
        }

        const todaySales = cashSales + digitalSales;
        const todayOrderCount = pedidosPagados.length;

        const phoneSet = new Set();
        for (const p of listaPedidos) {
          if (p.cliente_telefono && String(p.cliente_telefono).trim()) {
            phoneSet.add(String(p.cliente_telefono).trim());
          }
        }

        const dishMap = new Map();
        for (const p of pedidosPagados) {
          for (const det of (p.detalles || [])) {
            const pName = det.plato?.nombre || det.nombre_plato || 'Plato';
            const qty = Number(det.cantidad || 1);
            const rev = Number(det.precio_unitario || det.plato?.precio || 0) * qty;
            const cur = dishMap.get(pName) || { product_name: pName, sold_count: 0, total_revenue: 0 };
            cur.sold_count += qty;
            cur.total_revenue += rev;
            dishMap.set(pName, cur);
          }
        }

        const topDishes = Array.from(dishMap.values())
          .sort((a, b) => b.sold_count - a.sold_count || b.total_revenue - a.total_revenue)
          .slice(0, 8);

        renderLiveAdminMetrics({
          todaySales,
          cashSales,
          digitalSales,
          todayOrderCount,
          totalCustomers: phoneSet.size,
          topDishes
        });
      } catch (err) {
        console.error('Error cargando métricas y auditoría en vivo de /admin:', err);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadLiveAdminMetrics();
      setInterval(loadLiveAdminMetrics, 15000);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') loadLiveAdminMetrics();
      });
    });
  </script>
</StaffLayout>
