---
export const prerender = true;
import StaffLayout from '../layouts/StaffLayout.astro';
import { getDashboardMetrics, getDailySpecials, getProducts, getCategories, fallbackCategories, initialProductList } from '../lib/db.js';

const metrics = getDashboardMetrics();
const specials = getDailySpecials();
const rawProducts = getProducts(false);
const products = (rawProducts && rawProducts.length > 0) ? rawProducts : initialProductList;
const rawCategories = getCategories();
const categories = (rawCategories && rawCategories.length > 0) ? rawCategories : fallbackCategories;

const formatPrice = (val) => {
  return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val || 0);
};
---

<StaffLayout title="Panel de Métricas & Menú | San Parrilla">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 flex flex-col no-print">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-parrilla-border pb-6 mb-8">
      <div>
        <span class="text-xs font-bold text-parrilla-gold uppercase tracking-widest">Inteligencia de Negocio & Control</span>
        <h1 class="font-display font-black text-3xl sm:text-4xl text-parrilla-ivory mt-1">Dashboard & Administración</h1>
      </div>

      <div class="flex items-center gap-3">
        <button id="btn-download-launcher" type="button" class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-parrilla-ivory font-bold text-xs px-4 py-2.5 rounded-xl border border-parrilla-border shadow-sm transition" title="Descarga el acceso directo de Windows que abre el POS e imprime sin ventanas">
          <i data-lucide="download" class="w-4 h-4"></i>
          <span>Lanzador PC de caja (.bat)</span>
        </button>
        <a href="/pos" class="inline-flex items-center gap-2 bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-sm transition">
          <i data-lucide="zap" class="w-4 h-4"></i>
          <span>Ir al POS</span>
        </a>
      </div>
    </div>

    <!-- 1. KPI CARDS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      
      <!-- Ventas Hoy -->
      <div class="bg-parrilla-surface rounded-2xl p-5 border border-parrilla-border shadow-lg">
        <div class="flex items-center justify-between text-parrilla-muted mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Ventas de Hoy</span>
          <i data-lucide="dollar-sign" class="w-5 h-5 text-parrilla-gold"></i>
        </div>
        <div id="admin-today-sales" class="font-display font-black text-3xl text-parrilla-gold">
          {formatPrice(metrics.todaySales)}
        </div>
        <span id="admin-sales-breakdown" class="text-[11px] text-parrilla-muted mt-1 block">
          Efectivo: {formatPrice(metrics.cashSales)} | Digital: {formatPrice(metrics.digitalSales)}
        </span>
      </div>

      <!-- Pedidos Hoy -->
      <div class="bg-parrilla-surface rounded-2xl p-5 border border-parrilla-border shadow-lg">
        <div class="flex items-center justify-between text-parrilla-muted mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Comandas Totales</span>
          <i data-lucide="shopping-cart" class="w-5 h-5 text-parrilla-accent"></i>
        </div>
        <div id="admin-order-count" class="font-display font-black text-3xl text-parrilla-ivory">
          {metrics.todayOrderCount}
        </div>
        <span class="text-[11px] text-parrilla-muted mt-1 block">Mesas y domicilios atendidos hoy</span>
      </div>

      <!-- Clientes en Base de Datos -->
      <div class="bg-parrilla-surface rounded-2xl p-5 border border-parrilla-border shadow-lg">
        <div class="flex items-center justify-between text-parrilla-muted mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Clientes Guardados</span>
          <i data-lucide="users" class="w-5 h-5 text-amber-400"></i>
        </div>
        <div id="admin-customers-count" class="font-display font-black text-3xl text-amber-400">
          {metrics.totalCustomers}
        </div>
        <span class="text-[11px] text-parrilla-muted mt-1 block">Teléfonos y direcciones para envíos</span>
      </div>

      <!-- Visitas al Menú QR -->
      <div class="bg-parrilla-surface rounded-2xl p-5 border border-parrilla-border shadow-lg">
        <div class="flex items-center justify-between text-parrilla-muted mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider">Escaneos QR Hoy</span>
          <i data-lucide="qr-code" class="w-5 h-5 text-blue-400"></i>
        </div>
        <div class="font-display font-black text-3xl text-blue-400">
          {metrics.todayViews}
        </div>
        <span class="text-[11px] text-parrilla-muted mt-1 block">Personas viendo la carta digital</span>
      </div>
    </div>

    <!-- 1.5 AUDITORÍA DE PEDIDOS DEL DÍA & MEDIOS DE PAGO -->
    <div class="bg-parrilla-surface rounded-2xl border border-parrilla-border p-6 shadow-xl mb-10">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 mb-5 border-b border-parrilla-border">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl">📋</span>
            <h2 class="font-display font-black text-xl sm:text-2xl text-parrilla-ivory">Auditoría de Pedidos del Día & Medios de Pago</h2>
          </div>
          <p class="text-xs text-parrilla-muted mt-1">
            Filtra ventas por medio de pago y corrige en 1 clic cualquier pedido mal cerrado (recalcula automáticamente el arqueo de Caja).
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <div class="relative w-full sm:w-64">
            <i data-lucide="search" class="w-4 h-4 text-parrilla-muted absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input
              type="text"
              id="audit-search-input"
              placeholder="Buscar #SP, cliente, mesa, mensajero..."
              class="w-full pl-9 pr-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>
          <button
            type="button"
            id="btn-refresh-audit"
            class="inline-flex items-center gap-1.5 bg-white hover:bg-slate-50 text-parrilla-ivory font-bold text-xs px-3.5 py-2 rounded-xl border border-parrilla-border shadow-sm transition"
          >
            <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-parrilla-gold"></i>
            <span>Sincronizar</span>
          </button>
        </div>
      </div>

      <!-- Pestañas / Filtros por Medio de Pago con suma total al lado -->
      <div class="flex flex-wrap items-center gap-2 mb-5" id="audit-payment-tabs">
        <button
          type="button"
          data-filter="ALL"
          class="audit-tab-btn active px-3.5 py-2 rounded-xl font-bold text-xs border transition flex items-center gap-2 bg-parrilla-gold text-white border-parrilla-gold shadow-sm"
        >
          <span>Todos</span>
          <span id="tab-sum-ALL" class="px-2 py-0.5 rounded-lg bg-black/20 text-white font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="CASH"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-emerald-500 transition flex items-center gap-2"
        >
          <span>💵 Efectivo</span>
          <span id="tab-sum-CASH" class="px-2 py-0.5 rounded-lg bg-emerald-100 text-emerald-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="NEQUI"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-purple-500 transition flex items-center gap-2"
        >
          <span>🟣 Nequi</span>
          <span id="tab-sum-NEQUI" class="px-2 py-0.5 rounded-lg bg-purple-100 text-purple-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="BANCOLOMBIA"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-amber-500 transition flex items-center gap-2"
        >
          <span>🟡 Bancolombia</span>
          <span id="tab-sum-BANCOLOMBIA" class="px-2 py-0.5 rounded-lg bg-amber-100 text-amber-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="DAVIPLATA"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-rose-500 transition flex items-center gap-2"
        >
          <span>🔴 Daviplata</span>
          <span id="tab-sum-DAVIPLATA" class="px-2 py-0.5 rounded-lg bg-rose-100 text-rose-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="CARD"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-blue-500 transition flex items-center gap-2"
        >
          <span>💳 Datáfono / Tarjeta</span>
          <span id="tab-sum-CARD" class="px-2 py-0.5 rounded-lg bg-blue-100 text-blue-900 font-mono text-[11px]">$0</span>
        </button>

        <button
          type="button"
          data-filter="FIADO"
          class="audit-tab-btn px-3.5 py-2 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-amber-600 transition flex items-center gap-2"
        >
          <span>📝 Fiado</span>
          <span id="tab-sum-FIADO" class="px-2 py-0.5 rounded-lg bg-amber-200 text-amber-950 font-mono text-[11px]">$0</span>
        </button>
      </div>

      <!-- Segunda Fila de Filtros por Mensajero / Canal -->
      <div class="flex flex-wrap items-center gap-2 mb-5 pt-3 border-t border-parrilla-border/60">
        <span class="text-[11px] font-bold uppercase tracking-wider text-parrilla-muted mr-1">Filtrar Mensajero:</span>
        <div class="flex flex-wrap items-center gap-2" id="audit-courier-tabs">
          <button
            type="button"
            data-courier="ALL"
            class="audit-courier-btn active px-3 py-1.5 rounded-xl font-bold text-xs border transition flex items-center gap-1.5 bg-blue-600 text-white border-blue-600 shadow-sm"
          >
            <span>👥 Todos</span>
          </button>
          <button
            type="button"
            data-courier="MESA_LLEVAR"
            class="audit-courier-btn px-3 py-1.5 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-blue-500 transition flex items-center gap-1.5"
          >
            <span>🏠 Mesa / Para Llevar</span>
          </button>
          <button
            type="button"
            data-courier="Lucely"
            class="audit-courier-btn px-3 py-1.5 rounded-xl font-bold text-xs border border-parrilla-border bg-parrilla-dark text-parrilla-ivory hover:border-blue-500 transition flex items-center gap-1.5"
          >
            <span>🛵 Lucely</span>
          </button>
        </div>
        <button
          type="button"
          id="btn-admin-add-courier"
          class="px-2.5 py-1.5 rounded-xl border border-dashed border-parrilla-border text-[11px] font-bold text-parrilla-muted hover:text-parrilla-gold hover:border-parrilla-gold transition"
          title="Agregar nuevo mensajero a la lista"
        >
          + Agregar Mensajero
        </button>
      </div>

      <!-- Tarjeta de Liquidación del Mensajero (Courier Settlement) -->
      <div id="courier-settlement-card" class="hidden mb-5 p-4 rounded-2xl bg-gradient-to-r from-blue-50 via-white to-amber-50 border-2 border-blue-300 shadow-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-3 border-b border-blue-200">
          <div class="flex items-center gap-2">
            <span class="text-xl">🛵</span>
            <div>
              <h3 class="font-display font-black text-base text-parrilla-ivory">
                Liquidación de Mensajero: <span id="settlement-courier-name" class="text-blue-700">Lucely</span>
              </h3>
              <p class="text-[11px] text-parrilla-muted">Resumen exacto de domicilios entregados, efectivo recogido y fletes del turno</p>
            </div>
          </div>
          <span id="settlement-total-orders" class="px-3 py-1 rounded-full bg-blue-600 text-white font-display font-black text-xs self-start sm:self-center">
            0 domicilios
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          <div class="bg-white rounded-xl p-3 border border-parrilla-border shadow-sm">
            <span class="text-[10px] font-bold uppercase text-parrilla-muted block">Total Pedidos Llevados</span>
            <span id="settlement-count-box" class="font-display font-black text-lg text-parrilla-ivory mt-0.5 block">0 domicilios</span>
          </div>
          <div class="bg-white rounded-xl p-3 border border-emerald-300 shadow-sm">
            <span class="text-[10px] font-bold uppercase text-emerald-800 block">💵 Efectivo Recogido</span>
            <span id="settlement-cash" class="font-display font-black text-lg text-emerald-700 mt-0.5 block">$0</span>
          </div>
          <div class="bg-white rounded-xl p-3 border border-purple-300 shadow-sm">
            <span class="text-[10px] font-bold uppercase text-purple-800 block">🟣 Nequi / 🟡 Banco / 🔴 Davi</span>
            <span id="settlement-digital" class="font-display font-black text-lg text-purple-700 mt-0.5 block">$0</span>
          </div>
          <div class="bg-white rounded-xl p-3 border border-amber-300 shadow-sm">
            <span class="text-[10px] font-bold uppercase text-amber-900 block">📝 Fiados Entregados</span>
            <span id="settlement-fiado" class="font-display font-black text-lg text-amber-800 mt-0.5 block">$0</span>
          </div>
          <div class="bg-blue-600 text-white rounded-xl p-3 border border-blue-700 shadow-sm">
            <span class="text-[10px] font-bold uppercase text-blue-100 block">🛵 Total Fletes / Carreras</span>
            <span id="settlement-fees" class="font-display font-black text-lg text-white mt-0.5 block">$0</span>
          </div>
        </div>
      </div>

      <!-- Banner de confirmación de cambio contable -->
      <div id="audit-toast" class="hidden mb-4 px-4 py-2.5 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs font-bold flex items-center justify-between">
        <span id="audit-toast-text">✓ Medio de pago actualizado y arqueo de caja recalculado al instante.</span>
        <a href="/caja" class="underline font-black hover:text-emerald-700">Ver en Caja →</a>
      </div>

      <!-- Tabla Interactiva de Pedidos del Día / Turno -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-parrilla-border text-parrilla-muted uppercase font-bold text-[11px]">
              <th class="py-3 px-2.5">Hora</th>
              <th class="py-3 px-2.5">Código</th>
              <th class="py-3 px-2.5">Tipo</th>
              <th class="py-3 px-2.5">Cliente / Mensajero</th>
              <th class="py-3 px-2.5">Platos</th>
              <th class="py-3 px-2.5 text-right">Total</th>
              <th class="py-3 px-2.5">Medio de Pago (1 Clic)</th>
              <th class="py-3 px-2.5 text-right">Acción</th>
            </tr>
          </thead>
          <tbody id="audit-orders-tbody" class="divide-y divide-parrilla-border/50">
            <tr>
              <td colspan="8" class="py-8 text-center text-parrilla-muted italic">
                Cargando pedidos del turno y día actual...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal de Edición / Detalle de Pedido en Admin -->
    <div id="modal-admin-edit-order" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-parrilla-surface border border-parrilla-border rounded-2xl max-w-lg w-full p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-parrilla-border">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-widest text-parrilla-gold">Auditoría Contable & Operativa</span>
            <h3 id="modal-edit-title" class="font-display font-black text-xl text-parrilla-ivory">Editar Pedido #SP-0</h3>
          </div>
          <button type="button" id="btn-close-edit-modal" class="text-parrilla-muted hover:text-parrilla-ivory p-1">✕</button>
        </div>

        <form id="form-admin-edit-order" class="space-y-4">
          <input type="hidden" id="edit-order-id" />

          <div>
            <label class="block text-xs font-bold uppercase text-parrilla-gold mb-1.5">Medio de Pago Contabilizado *</label>
            <select
              id="edit-order-method"
              class="w-full px-3.5 py-2.5 bg-parrilla-dark rounded-xl border border-parrilla-border text-sm font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
            >
              <option value="CASH">💵 Efectivo (Suma a Efectivo en Caja)</option>
              <option value="NEQUI">🟣 Nequi (Transferencia Digital)</option>
              <option value="BANCOLOMBIA">🟡 Bancolombia / QR / Ahorro a la Mano</option>
              <option value="DAVIPLATA">🔴 Daviplata (Transferencia Digital)</option>
              <option value="CARD">💳 Datáfono / Tarjeta</option>
              <option value="FIADO">📝 Fiado / Crédito (Por Cobrar - No suma a Efectivo)</option>
            </select>
            <span class="text-[11px] text-parrilla-muted mt-1 block">
              Al cambiar el medio de pago, la sesión activa de Caja recalcula efectivo esperado y transferencias de inmediato.
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Cliente</label>
              <input
                type="text"
                id="edit-order-cliente"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Teléfono</label>
              <input
                type="text"
                id="edit-order-telefono"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Mesa / Dirección</label>
              <input
                type="text"
                id="edit-order-mesa"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">🛵 Mensajero (Domicilio)</label>
              <input
                type="text"
                id="edit-order-courier"
                placeholder="Sin asignar"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Costo Domicilio ($)</label>
              <input
                type="number"
                id="edit-order-delivery-fee"
                min="0"
                step="500"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Estado del Pedido</label>
              <select
                id="edit-order-estado"
                class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
              >
                <option value="PAGADO">✅ PAGADO (Cobrado)</option>
                <option value="ENTREGADO">🛵 ENTREGADO (Cobrado)</option>
                <option value="EN_PREPARACION">🍳 EN PREPARACIÓN (Abierto)</option>
                <option value="EN_CAMINO">🛵 EN CAMINO (Abierto)</option>
                <option value="PENDIENTE">⏳ PENDIENTE (Abierto)</option>
                <option value="CANCELADO">🚫 ANULADO / CANCELADO</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-parrilla-muted mb-1">Notas / Observaciones</label>
            <input
              type="text"
              id="edit-order-notas"
              class="w-full px-3 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>

          <div id="edit-order-dishes-summary" class="p-3 rounded-xl bg-parrilla-dark border border-parrilla-border text-xs text-parrilla-ivory space-y-1"></div>

          <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-parrilla-border">
            <button
              type="button"
              id="btn-cancel-edit-modal"
              class="px-4 py-2.5 rounded-xl border border-parrilla-border text-xs font-bold text-parrilla-muted hover:text-parrilla-ivory"
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="btn-submit-edit-modal"
              class="px-5 py-2.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white text-xs font-black shadow-md transition"
            >
              💾 Guardar Cambios y Recalcular Caja
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 2. RANKING PLATOS TOP & EDITOR DE ESPECIALES -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
      
      <!-- Top Platos Vendidos (6 cols) -->
      <div class="lg:col-span-6 bg-parrilla-surface rounded-2xl border border-parrilla-border p-6 shadow-xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-parrilla-border">
          <div>
            <h2 class="font-display font-bold text-lg text-parrilla-ivory">Platos Más Vendidos</h2>
            <p class="text-xs text-parrilla-muted">Ranking en tiempo real de productos con mayor salida hoy / turno.</p>
          </div>
          <i data-lucide="flame" class="w-5 h-5 text-parrilla-gold"></i>
        </div>

        <div id="admin-top-dishes-container">
          {metrics.topDishes.length === 0 ? (
            <div class="py-10 text-center text-xs text-parrilla-muted italic">
              Aún no hay comandas registradas en este turno. Cobra pedidos en el POS para ver las estadísticas en vivo.
            </div>
          ) : (
            <div class="space-y-3">
              {metrics.topDishes.map((dish, idx) => (
                <div class="flex items-center justify-between p-3 rounded-xl bg-parrilla-dark border border-parrilla-border/60">
                  <div class="flex items-center gap-3">
                    <span class="w-7 h-7 rounded-lg bg-parrilla-gold/20 text-parrilla-gold flex items-center justify-center font-black text-xs font-display">
                      #{idx + 1}
                    </span>
                    <div>
                      <span class="font-bold text-sm text-parrilla-ivory block">{dish.product_name}</span>
                      <span class="text-xs text-parrilla-muted">{dish.sold_count} porciones vendidas</span>
                    </div>
                  </div>
                  <div class="font-display font-extrabold text-sm text-parrilla-gold">
                    {formatPrice(dish.total_revenue)}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Editor de Especiales del Día (6 cols) -->
      <div class="lg:col-span-6 bg-parrilla-surface rounded-2xl border border-parrilla-border p-6 shadow-xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-parrilla-border">
          <div>
            <h2 class="font-display font-bold text-lg text-parrilla-ivory">Editor de Especiales del Día</h2>
            <p class="text-xs text-parrilla-muted">Sincroniza en tiempo real la sopa, principios y platos rotativos en la Carta Digital y el POS.</p>
          </div>
          <i data-lucide="soup" class="w-5 h-5 text-amber-400"></i>
        </div>

        <form id="form-specials" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-parrilla-gold uppercase mb-1">Sopa del Día *</label>
              <input 
                type="text" 
                id="specials-sopa" 
                value={specials?.sopa || ''} 
                required
                placeholder="Ej. Fideos, Sancocho de pescado, Ajiaco"
                class="w-full px-3.5 py-2.5 bg-parrilla-dark rounded-xl border border-parrilla-border text-sm font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
            </div>

            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-parrilla-gold uppercase mb-1">Principios (separados por coma) *</label>
              <input 
                type="text" 
                id="specials-principios" 
                value={specials?.principios?.join(', ') || ''} 
                required
                class="w-full px-3.5 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
              <span class="text-[10px] text-parrilla-muted mt-0.5 block">Ejemplo: Frijol, Garbanzos con pollo, Mazorca a la crema, Verduras calientes</span>
            </div>

            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-parrilla-gold uppercase mb-1">Acompañamientos (separados por coma) *</label>
              <input 
                type="text" 
                id="specials-acompanamientos" 
                value={specials?.acompanamientos?.join(', ') || ''} 
                required
                class="w-full px-3.5 py-2 bg-parrilla-dark rounded-xl border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
              />
              <span class="text-[10px] text-parrilla-muted mt-0.5 block">Ejemplo: Francesa casera, Torta de zanahoria, Tajadas maduras</span>
            </div>
          </div>

          <!-- BLOQUE A: Especiales Rotativos Caja $16.500 (★ SOLO POR HOY) -->
          <div class="p-3.5 rounded-xl bg-amber-50/70 border border-amber-300 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black uppercase text-amber-950">★ Especiales Rotativos Caja $16.500</span>
              <span class="px-2 py-0.5 rounded-md bg-amber-500 text-white font-bold text-[10px]">$16.500</span>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-amber-900 mb-1">Selector Rápido de Pareja Rotativa ($16.500)</label>
              <select
                id="specials-16500-preset"
                class="w-full px-3 py-2 bg-white rounded-xl border border-amber-300 text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
              >
                <option value="Albóndigas napolitanas|Desgranado de carne">Pareja 1: Albóndigas napolitanas + Desgranado de carne</option>
                <option value="Llanerita (lomo de cerdo y sobrebarriga)|Lomo de cerdo apanado">Pareja 2: Llanerita (lomo de cerdo y sobrebarriga) + Lomo de cerdo apanado</option>
                <option value="Lomo en salsa a la mostaza|Hígado al ajillo">Pareja 3: Lomo en salsa a la mostaza + Hígado al ajillo</option>
                <option value="CUSTOM">✏️ Personalizado (Escribir platos manualmente abajo)</option>
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div>
                <label class="block text-[10px] font-bold text-amber-900 uppercase mb-0.5">Plato Especial 1 ($16.500)</label>
                <input
                  type="text"
                  id="specials-16500-dish1"
                  value={specials?.especiales_16500?.[0] || 'Albóndigas napolitanas'}
                  placeholder="Ej. Albóndigas napolitanas"
                  class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-amber-300 text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
                />
              </div>
              <div>
                <label class="block text-[10px] font-bold text-amber-900 uppercase mb-0.5">Plato Especial 2 ($16.500)</label>
                <input
                  type="text"
                  id="specials-16500-dish2"
                  value={specials?.especiales_16500?.[1] || 'Desgranado de carne'}
                  placeholder="Ej. Desgranado de carne"
                  class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-amber-300 text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
                />
              </div>
            </div>
          </div>

          <!-- BLOQUE B: Especial Rotativo de Arroz / Pasta ($18.000 / $18.500) -->
          <div class="p-3.5 rounded-xl bg-orange-50/70 border border-orange-300 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black uppercase text-orange-950">★ Especial Rotativo de Arroz / Pasta</span>
              <span class="px-2 py-0.5 rounded-md bg-orange-600 text-white font-bold text-[10px]">$18.000 / $18.500</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div>
                <label class="block text-[10px] font-bold text-orange-900 uppercase mb-0.5">Plato Frecuente</label>
                <select
                  id="specials-arroz-preset"
                  class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-orange-300 text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
                >
                  <option value="Arroz ranchero">Arroz ranchero</option>
                  <option value="Arroz mixto">Arroz mixto</option>
                  <option value="Espagueti con pollo">Espagueti con pollo</option>
                  <option value="Arroz con pollo">Arroz con pollo</option>
                  <option value="Arroz paisa">Arroz paisa</option>
                  <option value="CUSTOM">✏️ Otro plato (Escribir al lado)</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-orange-900 uppercase mb-0.5">Nombre Mostrado en Carta y POS</label>
                <input
                  type="text"
                  id="specials-arroz-nombre"
                  value={specials?.especial_arroz_nombre || 'Arroz ranchero'}
                  placeholder="Ej. Arroz ranchero"
                  class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-orange-300 text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div>
                <label class="block text-[10px] font-bold text-orange-900 uppercase mb-0.5">Precio Caja Especial ($)</label>
                <select
                  id="specials-arroz-precio"
                  class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-orange-300 text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
                >
                  <option value="18000">$18.000</option>
                  <option value="18500">$18.500</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-orange-900 uppercase mb-0.5">Etiqueta Destacada</label>
                <select
                  id="specials-arroz-etiqueta"
                  class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-orange-300 text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
                >
                  <option value="⭐ SOLO POR HOY">⭐ SOLO POR HOY</option>
                  <option value="⭐ ESPECIAL DE HOY">⭐ ESPECIAL DE HOY</option>
                  <option value="⭐ SOLO LOS LUNES">⭐ SOLO LOS LUNES</option>
                  <option value="⭐ SOLO LOS MARTES">⭐ SOLO LOS MARTES</option>
                  <option value="⭐ SOLO LOS MIÉRCOLES">⭐ SOLO LOS MIÉRCOLES</option>
                  <option value="⭐ SOLO LOS JUEVES">⭐ SOLO LOS JUEVES</option>
                  <option value="⭐ SOLO LOS VIERNES">⭐ SOLO LOS VIERNES</option>
                  <option value="⭐ FIN DE SEMANA">⭐ FIN DE SEMANA</option>
                </select>
              </div>
            </div>
          </div>

          <div id="specials-save-feedback" class="hidden px-3 py-2 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs font-bold">
            ✓ Especiales del día guardados en Neon DB y sincronizados con `/` y `/pos`.
          </div>

          <button 
            type="submit" 
            id="btn-save-specials"
            class="w-full py-3 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-bold text-sm shadow-md transition active:scale-95"
          >
            💾 Guardar Especiales del Día (Carta + POS)
          </button>
        </form>
      </div>

    </div>

    <!-- 2.5 CUENTAS POR COBRAR (CLIENTES DE FIADO) & CUENTA DE COBRO MENSUAL -->
    <div id="section-cuentas-fiado" class="bg-parrilla-surface rounded-2xl border-2 border-amber-400/80 p-6 shadow-xl mb-10">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 mb-5 border-b border-parrilla-border">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-2xl">📒</span>
            <h2 class="font-display font-black text-xl sm:text-2xl text-parrilla-ivory">
              Cuentas por Cobrar (Clientes de Fiado) & Cuenta de Cobro Mensual
            </h2>
          </div>
          <p class="text-xs text-parrilla-muted mt-1">
            Controla el estado de cuenta de cada cliente de fiado, consulta el detalle plato por plato, descarga la Cuenta de Cobro en Excel a fin de mes y liquida la deuda cuando paguen.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <div class="px-3.5 py-2 rounded-xl bg-amber-50 border border-amber-300 text-right">
            <span class="block text-[10px] font-bold uppercase text-amber-800">Total Fiado Pendiente (Periodo)</span>
            <span id="fiado-kpi-total-pendiente" class="font-display font-black text-lg text-amber-900 font-mono">$0</span>
          </div>
          <div class="px-3.5 py-2 rounded-xl bg-slate-50 border border-parrilla-border text-right">
            <span class="block text-[10px] font-bold uppercase text-parrilla-muted">Clientes con Cuenta</span>
            <span id="fiado-kpi-clientes-count" class="font-display font-black text-lg text-parrilla-ivory font-mono">0</span>
          </div>
          <button
            type="button"
            id="btn-new-fiado-customer"
            class="px-3.5 py-2.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-bold text-xs shadow-sm transition cursor-pointer flex items-center gap-1.5"
          >
            <span>➕ Nuevo Cliente</span>
          </button>
        </div>
      </div>

      <!-- Filtros de Periodo / Mes, Estado (Pendiente vs Pagado) y Buscador de Cliente -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-5 bg-parrilla-dark/60 p-3.5 rounded-xl border border-parrilla-border">
        <!-- Estado: Pendiente de Pago vs Pagado -->
        <div class="md:col-span-4 flex flex-col gap-1">
          <label class="text-[10px] font-bold uppercase text-parrilla-muted">Estado de Cuenta</label>
          <div class="grid grid-cols-3 gap-1 bg-white p-1 rounded-xl border border-parrilla-border">
            <button
              type="button"
              data-fiado-status="PENDIENTE"
              class="fiado-status-btn active py-1.5 px-2 rounded-lg text-[11px] font-extrabold bg-amber-500 text-white shadow-xs transition cursor-pointer"
            >
              ⏳ Pendientes
            </button>
            <button
              type="button"
              data-fiado-status="PAGADO"
              class="fiado-status-btn py-1.5 px-2 rounded-lg text-[11px] font-bold text-parrilla-ivory hover:text-emerald-700 transition cursor-pointer"
            >
              ✅ Pagados
            </button>
            <button
              type="button"
              data-fiado-status="ALL"
              class="fiado-status-btn py-1.5 px-2 rounded-lg text-[11px] font-bold text-parrilla-ivory hover:text-parrilla-gold transition cursor-pointer"
            >
              📋 Todos
            </button>
          </div>
        </div>

        <!-- Mes o Rango de Fechas -->
        <div class="md:col-span-5 grid grid-cols-1 sm:grid-cols-3 gap-2">
          <div>
            <label class="block text-[10px] font-bold uppercase text-parrilla-muted mb-1">Mes (Cuenta Mensual)</label>
            <input
              type="month"
              id="fiado-filter-month"
              class="w-full px-2.5 py-1.5 bg-white rounded-lg border border-parrilla-border text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>
          <div>
            <label class="block text-[10px] font-bold uppercase text-parrilla-muted mb-1">Desde Fecha</label>
            <input
              type="date"
              id="fiado-filter-from"
              class="w-full px-2 py-1.5 bg-white rounded-lg border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>
          <div>
            <label class="block text-[10px] font-bold uppercase text-parrilla-muted mb-1">Hasta Fecha</label>
            <input
              type="date"
              id="fiado-filter-to"
              class="w-full px-2 py-1.5 bg-white rounded-lg border border-parrilla-border text-xs text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>
        </div>

        <!-- Buscador de Cliente -->
        <div class="md:col-span-3 flex flex-col gap-1">
          <div class="flex items-center justify-between">
            <label class="text-[10px] font-bold uppercase text-parrilla-muted">Buscar Cliente / Teléfono</label>
            <button type="button" id="btn-fiado-clear-dates" class="text-[10px] font-bold text-parrilla-gold hover:underline cursor-pointer">
              Ver todo el historial
            </button>
          </div>
          <div class="relative">
            <i data-lucide="search" class="w-3.5 h-3.5 text-parrilla-muted absolute left-2.5 top-1/2 -translate-y-1/2"></i>
            <input
              type="text"
              id="fiado-search-input"
              placeholder="Ej. Juan Pérez o 318..."
              class="w-full pl-8 pr-3 py-1.5 bg-white rounded-lg border border-parrilla-border text-xs font-semibold text-parrilla-ivory focus:border-parrilla-gold outline-none"
            />
          </div>
        </div>
      </div>

      <!-- Contenedor de Clientes de Fiado y su Detalle Desplegable -->
      <div id="fiado-accounts-container" class="space-y-3">
        <div class="py-8 text-center text-xs text-parrilla-muted italic">
          Cargando cuentas por cobrar desde Neon DB...
        </div>
      </div>
    </div>

    <!-- MODAL PARA LIQUIDAR CUENTA DE FIADO (MARCAR COMO PAGADA) -->
    <div id="modal-liquidar-fiado" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div class="bg-white rounded-2xl border border-parrilla-border shadow-2xl max-w-md w-full p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-parrilla-border pb-3">
          <div>
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 block">Liquidación de Cuenta Mensual</span>
            <h3 class="font-display font-black text-lg text-parrilla-ivory" id="liquidar-modal-title">✅ Marcar Cuenta como Pagada</h3>
          </div>
          <button type="button" id="btn-close-liquidar-modal" class="text-parrilla-muted hover:text-red-500 font-bold text-lg cursor-pointer">✕</button>
        </div>

        <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5 text-xs space-y-1">
          <div class="flex justify-between">
            <span class="text-amber-900 font-semibold">Cliente:</span>
            <span class="font-bold text-parrilla-ivory" id="liquidar-modal-cliente">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-amber-900 font-semibold">Teléfono:</span>
            <span class="font-mono font-bold text-parrilla-ivory" id="liquidar-modal-telefono">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-amber-900 font-semibold">Pedidos a liquidar:</span>
            <span class="font-bold text-parrilla-ivory" id="liquidar-modal-cantidad">0 pedidos</span>
          </div>
          <div class="flex justify-between pt-1.5 border-t border-amber-300 text-sm">
            <span class="font-black text-amber-950">SALDO TOTAL A PAGAR:</span>
            <span class="font-display font-black text-emerald-700 font-mono" id="liquidar-modal-total">$0</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-parrilla-gold mb-2">¿Con qué medio de pago canceló el cliente? *</label>
          <div class="grid grid-cols-3 gap-2">
            <button
              type="button"
              data-liq-method="CASH"
              class="liq-method-btn active py-3 px-2 rounded-xl border-2 border-parrilla-gold bg-parrilla-gold text-white font-extrabold text-xs flex flex-col items-center gap-1 shadow-xs cursor-pointer"
            >
              <span class="text-base">💵</span>
              <span>Efectivo</span>
            </button>
            <button
              type="button"
              data-liq-method="NEQUI"
              class="liq-method-btn py-3 px-2 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1 cursor-pointer"
            >
              <span class="text-base">🟣</span>
              <span>Nequi</span>
            </button>
            <button
              type="button"
              data-liq-method="BANCOLOMBIA"
              class="liq-method-btn py-3 px-2 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-xs flex flex-col items-center gap-1 cursor-pointer"
            >
              <span class="text-base">🟡</span>
              <span>Bancolombia</span>
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <button
            type="button"
            id="btn-cancel-liquidar-modal"
            class="px-4 py-2.5 rounded-xl border border-parrilla-border text-xs font-bold text-parrilla-muted hover:bg-slate-100 cursor-pointer"
          >
            Cancelar
          </button>
          <button
            type="button"
            id="btn-confirm-liquidar-fiado"
            class="flex-1 py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-display font-black text-xs shadow-md transition active:scale-95 cursor-pointer"
          >
            ✅ Confirmar Pago y Liquidar Deuda
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL PARA REGISTRAR / EDITAR CLIENTE EN EL DIRECTORIO NEON -->
    <div id="modal-admin-cliente" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div class="bg-white rounded-2xl border border-parrilla-border shadow-2xl max-w-md w-full p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-parrilla-border pb-3">
          <h3 class="font-display font-black text-lg text-parrilla-ivory">👤 Registrar / Actualizar Cliente en Neon</h3>
          <button type="button" id="btn-close-cliente-modal" class="text-parrilla-muted hover:text-red-500 font-bold text-lg cursor-pointer">✕</button>
        </div>
        <form id="form-admin-cliente" class="space-y-3">
          <div>
            <label class="block text-xs font-bold text-parrilla-ivory mb-1">Teléfono Celular *</label>
            <input type="tel" id="admin-cust-phone" required placeholder="Ej. 3183821787" class="w-full px-3 py-2 rounded-xl border border-parrilla-border text-xs font-mono font-bold" />
          </div>
          <div>
            <label class="block text-xs font-bold text-parrilla-ivory mb-1">Nombre Completo *</label>
            <input type="text" id="admin-cust-name" required placeholder="Nombre del cliente" class="w-full px-3 py-2 rounded-xl border border-parrilla-border text-xs font-bold" />
          </div>
          <div>
            <label class="block text-xs font-bold text-parrilla-ivory mb-1">Dirección de Entrega</label>
            <input type="text" id="admin-cust-address" placeholder="Calle / Carrera / Apto" class="w-full px-3 py-2 rounded-xl border border-parrilla-border text-xs" />
          </div>
          <div>
            <label class="block text-xs font-bold text-parrilla-ivory mb-1">Barrio / Indicaciones</label>
            <input type="text" id="admin-cust-barrio" placeholder="Barrio o referencia" class="w-full px-3 py-2 rounded-xl border border-parrilla-border text-xs" />
          </div>
