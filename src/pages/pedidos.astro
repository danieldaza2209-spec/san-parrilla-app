                  <span class="live-timer px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-orange-600 text-white font-mono" data-created="${openOrder.fecha_hora}">
                    ⏱️ ${elapsedStr}
                  </span>
                </div>

                <div class="mt-2 flex items-baseline justify-between">
                  <span class="font-mono text-[11px] font-bold text-orange-800">${escapeHtml(openOrder.codigo_pedido)}</span>
                  <span class="font-display font-black text-lg text-red-700 font-mono">${fmt(openOrder.total)}</span>
                </div>

                <div class="mt-1 text-[11px] font-bold text-orange-900">
                  🍽️ ${totalPlates} plato(s): <span class="font-normal text-orange-800 line-clamp-2">${escapeHtml(dishesPreview)}</span>
                </div>
              </div>

              <div class="pt-2 border-t border-orange-200/80 space-y-1.5">
                <div class="grid grid-cols-2 gap-1.5">
                  <a
                    href="/pos?mesa=${encodeURIComponent(tableName)}&pedido_id=${openOrder.id}"
                    class="py-1.5 px-2 rounded-lg bg-white hover:bg-orange-100 text-orange-900 border border-orange-300 text-[11px] font-extrabold text-center transition"
                    title="Ver o agregar más platos a esta mesa en el POS"
