---
export const prerender = true;
import StaffLayout from '../layouts/StaffLayout.astro';
---

<StaffLayout title="Tablero de Pedidos en Vivo | San Parrilla">
  <div class="max-w-[1600px] mx-auto px-3 sm:px-6 py-5 flex-1 flex flex-col space-y-8 no-print">

    <!-- HEADER & RESUMEN EN VIVO -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-parrilla-border pb-5">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-extrabold text-parrilla-gold uppercase tracking-widest">Centro de Operaciones en Tiempo Real</span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Sincronizado en vivo</span>
          </span>
        </div>
        <h1 class="font-display font-black text-2xl sm:text-3xl text-parrilla-ivory mt-1">
          📋 Control de 20 Mesas, Para Llevar y Domicilios
        </h1>
      </div>

      <!-- KPIs Rápidos y Botones de Acción -->
      <div class="flex flex-wrap items-center gap-2.5">
        <div class="px-3.5 py-2 rounded-xl bg-white border border-parrilla-border shadow-2xs flex items-center gap-2">
          <span class="text-xs font-bold text-parrilla-muted">🍽️ Mesas Ocupadas:</span>
          <span id="stat-occupied-tables" class="font-display font-black text-sm text-orange-600">0 / 20</span>
        </div>

        <div class="px-3.5 py-2 rounded-xl bg-white border border-parrilla-border shadow-2xs flex items-center gap-2">
          <span class="text-xs font-bold text-parrilla-muted">📦 Para Llevar:</span>
          <span id="stat-active-takeout" class="font-display font-black text-sm text-amber-600">0</span>
        </div>

        <div class="px-3.5 py-2 rounded-xl bg-white border border-parrilla-border shadow-2xs flex items-center gap-2">
          <span class="text-xs font-bold text-parrilla-muted">🛵 Domicilios Activos:</span>
          <span id="stat-active-delivery" class="font-display font-black text-sm text-emerald-600">0</span>
        </div>

        <button
          type="button"
          id="btn-refresh-board"
          class="px-3.5 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-parrilla-ivory border border-parrilla-border text-xs font-bold transition flex items-center gap-1.5 shadow-2xs cursor-pointer"
          title="Refrescar tablero ahora"
        >
          <i data-lucide="refresh-cw" class="w-4 h-4 text-parrilla-gold"></i>
          <span>Actualizar</span>
        </button>

        <a
          href="/pos"
          class="px-4 py-2.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-display font-black text-xs shadow-md transition flex items-center gap-1.5"
        >
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span>Nuevo Pedido en POS</span>
        </a>
      </div>
    </div>

    <!-- =====================================================================
         BLOQUE 1 (SUPERIOR): MAPA DE 20 MESAS (Mesa 1 a Mesa 20)
         ===================================================================== -->
    <section class="bg-white rounded-2xl border border-parrilla-border p-4 sm:p-6 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-parrilla-border pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-orange-100 text-parrilla-gold flex items-center justify-center font-bold">
            <i data-lucide="layout-grid" class="w-5 h-5"></i>
          </div>
          <div>
            <h2 class="font-display font-black text-lg sm:text-xl text-parrilla-ivory">
              1. Mapa en Vivo de 20 Mesas (Salón)
            </h2>
            <p class="text-xs text-parrilla-muted">
              Haz clic en una mesa libre para abrir comanda en el POS, o gestiona/cobra las mesas ocupadas.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-4 text-xs font-bold">
          <span class="inline-flex items-center gap-1.5 text-emerald-700">
            <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
            <span>Libre / Disponible</span>
          </span>
          <span class="inline-flex items-center gap-1.5 text-orange-700">
            <span class="w-3 h-3 rounded-full bg-orange-500 animate-pulse inline-block"></span>
            <span>Ocupada (Consumo Activo)</span>
          </span>
        </div>
      </div>

      <!-- Cuadrícula de 20 Mesas -->
      <div id="tables-grid-container" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-5 gap-3">
        <!-- Inyectado dinámicamente por JS (Mesa 1 ... Mesa 20) -->
      </div>
    </section>

    <!-- =====================================================================
         BLOQUE 2 (MEDIO): PEDIDOS PARA RECOGER / LLEVAR (PARA_LLEVAR)
         ===================================================================== -->
    <section class="bg-white rounded-2xl border border-parrilla-border p-4 sm:p-6 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-parrilla-border pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
            <i data-lucide="package" class="w-5 h-5"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-display font-black text-lg sm:text-xl text-parrilla-ivory">
                2. Pedidos Para Recoger / Llevar
              </h2>
              <span id="badge-count-takeout" class="px-2.5 py-0.5 rounded-full text-xs font-black bg-amber-100 text-amber-800 border border-amber-300">
                0 activos
              </span>
            </div>
            <p class="text-xs text-parrilla-muted">
              Pedidos empacados para recoger en mostrador con cronómetro en vivo.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <label class="inline-flex items-center gap-1.5 text-xs font-bold text-parrilla-muted cursor-pointer select-none">
            <input type="checkbox" id="chk-show-completed-takeout" class="rounded text-parrilla-gold focus:ring-0 cursor-pointer" />
            <span>Mostrar también entregados/pagados hoy</span>
          </label>
          <a
            href="/pos?tipo=para_llevar"
            class="px-3 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs transition flex items-center gap-1"
          >
            <span>+ Nuevo Para Llevar</span>
          </a>
        </div>
      </div>

      <div id="takeout-list-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
        <!-- Inyectado dinámicamente por JS -->
      </div>
    </section>

    <!-- =====================================================================
         BLOQUE 3 (INFERIOR): CENTRAL DE DOMICILIOS Y ASIGNACIÓN DE MENSAJEROS
         ===================================================================== -->
    <section class="bg-white rounded-2xl border border-parrilla-border p-4 sm:p-6 shadow-sm space-y-4">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-parrilla-border pb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
            <i data-lucide="bike" class="w-5 h-5"></i>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="font-display font-black text-lg sm:text-xl text-parrilla-ivory">
                3. Central de Domicilios y Asignación de Mensajeros
              </h2>
              <span id="badge-count-delivery" class="px-2.5 py-0.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-300">
                0 en curso
              </span>
            </div>
            <p class="text-xs text-parrilla-muted">
              Asigna domiciliario a cada pedido, controla el semáforo de tiempo e imprime la guía de entrega.
            </p>
          </div>
        </div>

        <!-- Controles de Mensajeros y Filtros -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Agregar Mensajero Rápido -->
          <div class="flex items-center gap-1 bg-slate-50 p-1 rounded-xl border border-parrilla-border">
            <input
              type="text"
              id="new-courier-input"
              placeholder="Nuevo mensajero (ej. Carlos)"
              class="px-2.5 py-1.5 bg-white rounded-lg border border-parrilla-border text-xs font-bold text-parrilla-ivory focus:border-parrilla-gold outline-none w-44"
            />
            <button
              type="button"
              id="btn-add-courier"
              class="px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition cursor-pointer whitespace-nowrap"
            >
              + Mensajero
            </button>
          </div>

          <label class="inline-flex items-center gap-1.5 text-xs font-bold text-parrilla-muted cursor-pointer select-none px-2">
            <input type="checkbox" id="chk-show-all-deliveries" checked class="rounded text-emerald-600 focus:ring-0 cursor-pointer" />
            <span>Ver todos los del día</span>
          </label>

          <a
            href="/pos?tipo=domicilio"
            class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition flex items-center gap-1 shadow-xs"
          >
            <span>🛵 + Nuevo Domicilio</span>
          </a>
        </div>
      </div>

      <!-- Resumen de Carreras por Mensajero Hoy -->
      <div id="couriers-summary-bar" class="flex flex-wrap items-center gap-2 bg-slate-50 p-3 rounded-xl border border-parrilla-border text-xs">
        <span class="font-extrabold text-parrilla-muted uppercase text-[11px]">🛵 Liquidación Mensajeros Hoy:</span>
        <div id="couriers-summary-pills" class="flex flex-wrap items-center gap-2">
          <!-- Inyectado por JS -->
        </div>
      </div>

      <!-- Leyenda Semáforo de Tiempos -->
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-parrilla-muted">
        <div class="flex items-center gap-3 font-bold">
          <span>Semáforo de Tiempo:</span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">🟢 &lt; 15 min (A tiempo)</span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200">🟡 15 - 30 min (Atención)</span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-red-50 text-red-700 border border-red-200">🔴 &gt; 30 min (Urgente)</span>
        </div>
      </div>

      <!-- Tarjetas de Domicilios -->
      <div id="deliveries-list-container" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <!-- Inyectado dinámicamente por JS -->
      </div>
    </section>

  </div>

  <!-- ==============================================================
       MODAL DE COBRO Y LIBERACIÓN DE PEDIDO (MESA / LLEVAR / DOMICILIO)
       ============================================================== -->
  <div id="modal-pay-order" class="no-print fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-2xl border-2 border-parrilla-gold/60 max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-parrilla-border pb-3">
        <div>
          <span id="pay-modal-badge" class="text-[10px] font-extrabold uppercase tracking-widest text-parrilla-gold block">Cobrar y Cerrar Cuenta</span>
          <h3 id="pay-modal-title" class="font-display font-black text-xl text-parrilla-ivory mt-0.5">Mesa 1 (#SP-000)</h3>
        </div>
        <button type="button" id="btn-pay-modal-close" class="text-parrilla-muted hover:text-parrilla-ivory cursor-pointer">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Resumen del Pedido -->
      <div class="bg-slate-50 p-3.5 rounded-xl border border-parrilla-border space-y-1.5 text-xs">
        <div id="pay-modal-items" class="max-h-32 overflow-y-auto divide-y divide-parrilla-border/40 pb-2 mb-1"></div>
        <div class="flex justify-between text-parrilla-muted">
          <span>Subtotal + Empaques:</span>
          <span id="pay-modal-subtotal" class="font-bold font-mono text-parrilla-ivory">$0</span>
        </div>
        <div class="flex justify-between text-parrilla-muted" id="pay-modal-delivery-row">
          <span>Costo Domicilio:</span>
          <span id="pay-modal-delivery" class="font-bold font-mono text-parrilla-accent">$0</span>
        </div>
        <div class="flex justify-between text-base font-black text-parrilla-gold border-t border-parrilla-border pt-1.5">
          <span>TOTAL A COBRAR:</span>
          <span id="pay-modal-total" class="font-display text-2xl font-mono">$0</span>
        </div>
      </div>

      <!-- Selección de Medio de Pago (5 opciones explícitas) -->
      <div class="space-y-2">
        <span class="block text-[11px] font-extrabold text-parrilla-muted uppercase">Medio de Pago:</span>
        <div class="grid grid-cols-3 sm:grid-cols-5 gap-1.5">
          <button type="button" class="board-pay-method-btn active py-2.5 px-1 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-[11px] flex flex-col items-center gap-1 shadow-xs cursor-pointer" data-method="CASH">
            <span>💵</span>
            <span>Efectivo</span>
          </button>
          <button type="button" class="board-pay-method-btn py-2.5 px-1 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-[11px] flex flex-col items-center gap-1 cursor-pointer" data-method="NEQUI">
            <span>🟣</span>
            <span>Nequi</span>
          </button>
          <button type="button" class="board-pay-method-btn py-2.5 px-1 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-[11px] flex flex-col items-center gap-1 cursor-pointer" data-method="BANCOLOMBIA">
            <span>🟡</span>
            <span>Bancolombia</span>
          </button>
          <button type="button" class="board-pay-method-btn py-2.5 px-1 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-[11px] flex flex-col items-center gap-1 cursor-pointer" data-method="DAVIPLATA">
            <span>🔴</span>
            <span>Daviplata</span>
          </button>
          <button type="button" class="board-pay-method-btn py-2.5 px-1 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-[11px] flex flex-col items-center gap-1 cursor-pointer" data-method="CARD">
            <span>💳</span>
            <span>Datáfono</span>
          </button>
        </div>
      </div>

      <!-- Calculadora de Vueltas (Efectivo) -->
      <div id="board-cash-calc-box" class="bg-slate-50 p-3 rounded-xl border border-parrilla-border flex items-center justify-between gap-3">
        <div class="flex-1">
          <label class="block text-[10px] font-bold text-parrilla-muted uppercase mb-1">Paga con ($):</label>
          <input
            type="number"
            id="board-cash-received"
            placeholder="Ej. 50000"
            step="1000"
            class="w-full px-3 py-1.5 bg-white rounded-lg border border-parrilla-border font-bold text-base font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
          />
        </div>
        <div class="flex-1 text-right">
          <span class="block text-[10px] font-bold text-parrilla-muted uppercase mb-1">Cambio / Vueltas:</span>
          <span id="board-cash-change" class="font-display font-black text-xl text-emerald-600 font-mono">$0</span>
        </div>
      </div>

      <!-- Checkbox Imprimir Recibo Cliente -->
      <label class="flex items-center gap-2 text-xs font-bold text-parrilla-ivory cursor-pointer select-none bg-slate-50 p-2.5 rounded-xl border border-parrilla-border">
        <input type="checkbox" id="chk-board-print-receipt" checked class="w-4 h-4 rounded text-parrilla-gold focus:ring-0 cursor-pointer" />
        <span>🧾 Imprimir Recibo / Cuenta al Confirmar Cobro</span>
      </label>

      <div class="flex items-center gap-2 pt-2">
        <button
          type="button"
          id="btn-pay-modal-cancel"
          class="py-3 px-4 rounded-xl border border-parrilla-border text-parrilla-muted hover:bg-slate-100 font-bold text-xs cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="button"
          id="btn-pay-modal-confirm"
          class="flex-1 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-display font-black text-xs sm:text-sm shadow-lg flex items-center justify-center gap-2 transition active:scale-95 cursor-pointer"
        >
          <i data-lucide="check-circle" class="w-4 h-4"></i>
          <span>Confirmar Cobro y Liberar</span>
        </button>
      </div>
    </div>
  </div>

  <!-- CONTENEDOR IMPRESIÓN TÉRMICA 80MM SAT Q22 -->
  <div id="printable-ticket" class="receipt-ticket hidden"></div>

  <script is:inline>
    const fmt = (val) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(val || 0);
    const escapeHtml = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const COURIERS_STORAGE_KEY = 'sp_couriers_list';
    const DEFAULT_COURIERS = ['Mensajero 1', 'Mensajero 2', 'Mensajero 3'];

    let allOrders = [];
    let activePayOrder = null;
    let selectedPayMethod = 'CASH';

    function getSavedCouriers() {
      try {
        const raw = localStorage.getItem(COURIERS_STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {}
      return [...DEFAULT_COURIERS];
    }

    function saveCouriersList(list) {
      try {
        localStorage.setItem(COURIERS_STORAGE_KEY, JSON.stringify(list));
      } catch (e) {}
    }

    // Agregar nuevo mensajero a la lista
    document.getElementById('btn-add-courier')?.addEventListener('click', () => {
      const inp = document.getElementById('new-courier-input');
      const name = (inp?.value || '').trim();
      if (!name) return;
      const list = getSavedCouriers();
      if (!list.some((c) => c.toLowerCase() === name.toLowerCase())) {
        list.push(name);
        saveCouriersList(list);
      }
      if (inp) inp.value = '';
      renderBoard();
    });

    // Calcula minutos transcurridos desde fecha_hora
    function getElapsedMinutes(isoDateStr) {
      if (!isoDateStr) return 0;
      const created = new Date(isoDateStr).getTime();
      if (isNaN(created)) return 0;
      return Math.max(0, Math.floor((Date.now() - created) / 60000));
    }

    function formatElapsed(isoDateStr) {
      const mins = getElapsedMinutes(isoDateStr);
      if (mins < 1) return 'Hace instantes';
      if (mins < 60) return `${mins} min`;
      const hrs = Math.floor(mins / 60);
      const rem = mins % 60;
      return `${hrs}h ${rem}m`;
    }

    // Extrae dirección limpia desde notas
    function extractAddress(order) {
      if (order.direccion) return order.direccion;
      const notas = String(order.notas || '');
      const m = notas.match(/Direcci[oó]n:\s*([^|]+)/i);
      if (m) return m[1].trim();
      return notas || 'Dirección no especificada';
    }

    function isOrderFromToday(order) {
      if (!order.fecha_hora) return false;
      const todayCol = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });
      const orderCol = new Date(order.fecha_hora).toLocaleDateString('en-CA', { timeZone: 'America/Bogota' });
      return todayCol === orderCol;
    }

    function isOrderOpen(order) {
      return ['PENDIENTE', 'EN_PREPARACION', 'EN_CAMINO', 'SERVIDO'].includes(order.estado);
    }

    function getPaymentBadge(order) {
      if (order.estado === 'PAGADO' || (order.payments && order.payments.length > 0)) {
        const methods = (order.payments || []).map((p) => {
          const map = { CASH: '💵 Efectivo', NEQUI: '🟣 Nequi', BANCOLOMBIA: '🟡 Bancolombia', DAVIPLATA: '🔴 Daviplata', CARD: '💳 Datáfono' };
          return map[p.method] || p.method;
        });
        const label = methods.length > 0 ? methods.join(' + ') : 'Pagado';
        return `<span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300">✅ Pagado (${escapeHtml(label)})</span>`;
      }
      return `<span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-800 border border-amber-300">⏳ Pendiente de Cobro</span>`;
    }

    async function fetchOrders() {
      try {
        const res = await fetch('/api/pedidos?limit=200', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();
        allOrders = Array.isArray(data) ? data : [];
        // Incluir en la lista de mensajeros cualquier courier_name que ya venga en BD
        const couriers = getSavedCouriers();
        let updated = false;
        for (const o of allOrders) {
          if (o.courier_name && !couriers.some((c) => c.toLowerCase() === o.courier_name.toLowerCase())) {
            couriers.push(o.courier_name);
            updated = true;
          }
        }
        if (updated) saveCouriersList(couriers);
        renderBoard();
      } catch (err) {
        console.error('Error cargando pedidos en vivo:', err);
      }
    }

    // =========================================================================
    // 1. RENDERIZAR BLOQUE SUPERIOR: MAPA DE 20 MESAS
    // =========================================================================
    function renderTablesGrid() {
      const container = document.getElementById('tables-grid-container');
      if (!container) return;

      // Buscar pedidos abiertos de tipo EN_MESA
      const openTableOrders = allOrders.filter(
        (o) => o.tipo === 'EN_MESA' && isOrderOpen(o)
      );

      let occupiedCount = 0;
      const cardsHtml = [];

      for (let i = 1; i <= 20; i++) {
        const tableName = `Mesa ${i}`;
        // Buscar si hay pedido abierto para esta mesa (ej. "Mesa 1" o "1")
        const openOrder = openTableOrders.find((o) => {
          const m = String(o.mesa || '').trim().toLowerCase();
          return m === tableName.toLowerCase() || m === String(i);
        });

        if (openOrder) {
          occupiedCount++;
          const totalPlates = (openOrder.detalles || []).reduce((acc, d) => acc + Number(d.cantidad || 1), 0);
          const elapsedStr = formatElapsed(openOrder.fecha_hora);
          const dishesPreview = (openOrder.detalles || [])
            .slice(0, 3)
            .map((d) => `${d.cantidad}x ${d.plato?.nombre || 'Plato'}`)
            .join(', ');

          cardsHtml.push(`
            <div class="rounded-2xl border-2 border-orange-500 bg-gradient-to-br from-orange-50 via-amber-50/70 to-red-50 p-3.5 shadow-md flex flex-col justify-between gap-2.5 transition">
              <div>
                <div class="flex items-center justify-between gap-1">
                  <span class="font-display font-black text-base text-orange-950 flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-orange-600 animate-ping"></span>
                    <span>${tableName}</span>
