              href="/pos?mesa=${encodeURIComponent(tableName)}"
              class="group rounded-2xl border border-emerald-200 bg-emerald-50/40 hover:bg-emerald-100/70 hover:border-emerald-400 p-3.5 transition flex flex-col justify-between min-h-[138px] shadow-2xs"
            >
              <div class="flex items-center justify-between">
                <span class="font-display font-black text-base text-parrilla-ivory group-hover:text-emerald-900">${tableName}</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                  Disponible
                </span>
