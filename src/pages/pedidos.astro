    // =========================================================================
    // 2. RENDERIZAR BLOQUE MEDIO: PARA LLEVAR (PARA_LLEVAR)
    // =========================================================================
    function renderTakeoutSection() {
      const container = document.getElementById('takeout-list-container');
      const badge = document.getElementById('badge-count-takeout');
      const statEl = document.getElementById('stat-active-takeout');
      const showCompleted = document.getElementById('chk-show-completed-takeout')?.checked ?? false;
      if (!container) return;

      const takeoutOrders = allOrders.filter((o) => {
        if (o.tipo !== 'PARA_LLEVAR' || o.estado === 'CANCELADO' || o.estado === 'BORRADOR_WEB') return false;
        if (isOrderOpen(o)) return true;
        if (showCompleted && isOrderFromToday(o)) return true;
        return false;
      });

      const activeCount = allOrders.filter((o) => o.tipo === 'PARA_LLEVAR' && isOrderOpen(o)).length;
      if (badge) badge.textContent = `${activeCount} activo(s)`;
      if (statEl) statEl.textContent = String(activeCount);

      if (takeoutOrders.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-8 text-center text-xs text-parrilla-muted bg-slate-50 rounded-xl border border-dashed border-parrilla-border">
            No hay pedidos Para Llevar pendientes en este momento.
          </div>
        `;
        return;
      }

      container.innerHTML = takeoutOrders.map((o) => {
        const isOpen = isOrderOpen(o);
        const elapsedStr = formatElapsed(o.fecha_hora);
        const itemsList = (o.detalles || []).map((d) => `
          <div class="flex justify-between text-xs py-1 border-b border-slate-100">
            <div>
              <span class="font-bold text-parrilla-ivory">${d.cantidad}x ${escapeHtml(d.plato?.nombre || 'Plato')}</span>
              ${d.notas_item ? `<span class="block text-[10px] text-parrilla-muted italic">${escapeHtml(d.notas_item)}</span>` : ''}
            </div>
            <span class="font-mono font-bold text-parrilla-ivory">${fmt(d.precio_unitario * d.cantidad)}</span>
          </div>
        `).join('');

        return `
          <div class="rounded-2xl border ${isOpen ? 'border-amber-400 bg-amber-50/30' : 'border-parrilla-border bg-slate-50/60'} p-4 shadow-xs flex flex-col justify-between gap-3">
            <div>
              <div class="flex items-center justify-between gap-2 pb-2 border-b border-parrilla-border">
                <div class="flex items-center gap-2">
                  <span class="font-mono font-black text-xs px-2 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-300">${escapeHtml(o.codigo_pedido)}</span>
                  <span class="font-display font-black text-sm text-parrilla-ivory">${escapeHtml(o.cliente_nombre || 'Para Llevar')}</span>
                </div>
                <span class="live-timer text-[11px] font-extrabold font-mono px-2 py-0.5 rounded-full bg-amber-600 text-white" data-created="${o.fecha_hora}">
                  ⏱️ Hace ${elapsedStr}
                </span>
              </div>

              <div class="my-2.5 flex items-center justify-between">
                ${getPaymentBadge(o)}
                ${o.packaging_fee > 0 ? `<span class="text-[11px] font-bold text-amber-800">📦 Empaques: ${fmt(o.packaging_fee)}</span>` : ''}
              </div>

              <div class="space-y-0.5 max-h-36 overflow-y-auto pr-1">
                ${itemsList}
              </div>
            </div>

            <div class="pt-3 border-t border-parrilla-border flex items-center justify-between gap-2">
              <div>
                <span class="text-[10px] font-bold text-parrilla-muted uppercase block">Total Pedido</span>
                <span class="font-display font-black text-lg text-parrilla-gold font-mono">${fmt(o.total)}</span>
              </div>

              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  class="btn-print-kitchen-board p-2 rounded-xl bg-white hover:bg-orange-50 text-orange-700 border border-parrilla-border text-xs font-bold transition cursor-pointer"
                  data-id="${o.id}"
                  title="Imprimir Comanda de Cocina"
                >
                  🍳
                </button>
                <button
                  type="button"
                  class="btn-print-customer-board p-2 rounded-xl bg-white hover:bg-slate-100 text-parrilla-ivory border border-parrilla-border text-xs font-bold transition cursor-pointer"
                  data-id="${o.id}"
                  title="Imprimir Recibo Cliente"
                >
                  🧾
                </button>
                ${
                  isOpen
                    ? `
                  <button
                    type="button"
                    class="btn-open-pay-modal px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-display font-black text-xs shadow-xs transition cursor-pointer"
                    data-id="${o.id}"
                  >
                    ✅ Entregar / Cobrar
                  </button>`
                    : `<span class="text-xs font-bold text-emerald-700 px-2">✓ Entregado</span>`
                }
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // =========================================================================
    // 3. RENDERIZAR BLOQUE INFERIOR: CENTRAL DE DOMICILIOS Y MENSAJEROS
    // =========================================================================
    function renderDeliveriesSection() {
      const container = document.getElementById('deliveries-list-container');
      const badge = document.getElementById('badge-count-delivery');
      const statEl = document.getElementById('stat-active-delivery');
      const pillsContainer = document.getElementById('couriers-summary-pills');
      const showAllToday = document.getElementById('chk-show-all-deliveries')?.checked ?? true;
      if (!container) return;

      const couriersList = getSavedCouriers();

      const deliveryOrders = allOrders.filter((o) => {
        if (o.tipo !== 'DOMICILIO' || o.estado === 'CANCELADO' || o.estado === 'BORRADOR_WEB') return false;
        if (isOrderOpen(o)) return true;
        if (showAllToday && isOrderFromToday(o)) return true;
        return false;
      });

      const activeDeliveries = allOrders.filter((o) => o.tipo === 'DOMICILIO' && isOrderOpen(o)).length;
      if (badge) badge.textContent = `${activeDeliveries} activo(s)`;
      if (statEl) statEl.textContent = String(activeDeliveries);

      // Calcular liquidación de domicilios del día por mensajero
      if (pillsContainer) {
        const todayDeliveries = allOrders.filter((o) => o.tipo === 'DOMICILIO' && o.estado !== 'CANCELADO' && isOrderFromToday(o));
        const courierStats = {};
        for (const d of todayDeliveries) {
          const cName = d.courier_name || 'Sin asignar';
          if (!courierStats[cName]) courierStats[cName] = { count: 0, fees: 0 };
          courierStats[cName].count += 1;
          courierStats[cName].fees += Number(d.delivery_fee || 0);
        }
        const entries = Object.entries(courierStats);
        if (entries.length === 0) {
          pillsContainer.innerHTML = `<span class="text-parrilla-muted italic">Sin domicilios registrados hoy</span>`;
        } else {
          pillsContainer.innerHTML = entries.map(([name, st]) => `
            <span class="px-2.5 py-1 rounded-lg bg-white border border-parrilla-border font-bold text-xs text-parrilla-ivory shadow-2xs">
              🛵 ${escapeHtml(name)}: <strong class="text-emerald-700">${st.count} envíos</strong> (${fmt(st.fees)})
            </span>
          `).join('');
        }
      }

      if (deliveryOrders.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-10 text-center text-xs text-parrilla-muted bg-slate-50 rounded-xl border border-dashed border-parrilla-border">
            No hay domicilios activos en este momento.
          </div>
        `;
        return;
      }

      container.innerHTML = deliveryOrders.map((o) => {
        const isOpen = isOrderOpen(o);
        const mins = getElapsedMinutes(o.fecha_hora);
        const elapsedStr = formatElapsed(o.fecha_hora);
        const addressStr = extractAddress(o);

        // Semáforo visual (<15m verde, 15-30m amarillo, >30m rojo)
        let semaphoreClass = 'bg-emerald-600 text-white';
        let cardBorderClass = isOpen ? 'border-emerald-400 bg-white' : 'border-parrilla-border bg-slate-50/70';
        let semaphoreIcon = '🟢';
        if (mins >= 30 && isOpen) {
          semaphoreClass = 'bg-red-600 text-white animate-pulse';
          cardBorderClass = 'border-2 border-red-500 bg-red-50/20';
          semaphoreIcon = '🔴';
        } else if (mins >= 15 && isOpen) {
          semaphoreClass = 'bg-amber-500 text-white';
          cardBorderClass = 'border-2 border-amber-400 bg-amber-50/20';
          semaphoreIcon = '🟡';
        }

        const courierOptionsHtml = [
          `<option value="">-- Sin Mensajero Asignado --</option>`,
          ...couriersList.map(
            (c) => `<option value="${escapeHtml(c)}" ${o.courier_name === c ? 'selected' : ''}>🛵 ${escapeHtml(c)}</option>`
          )
        ].join('');

        const itemsList = (o.detalles || []).map((d) => `
          <div class="flex justify-between text-xs py-1 border-b border-slate-100">
            <div>
              <span class="font-bold text-parrilla-ivory">${d.cantidad}x ${escapeHtml(d.plato?.nombre || 'Plato')}</span>
              ${d.notas_item ? `<span class="block text-[10px] text-parrilla-muted italic">${escapeHtml(d.notas_item)}</span>` : ''}
            </div>
            <span class="font-mono font-semibold text-parrilla-ivory">${fmt(d.precio_unitario * d.cantidad)}</span>
          </div>
        `).join('');

        return `
          <div class="rounded-2xl border ${cardBorderClass} p-4 shadow-sm flex flex-col justify-between gap-3 transition">
            <div class="space-y-2.5">
              <!-- Cabecera: Código + Semáforo Cronómetro -->
              <div class="flex items-center justify-between gap-2 pb-2 border-b border-parrilla-border">
                <div class="flex items-center gap-2">
                  <span class="font-mono font-black text-xs px-2 py-0.5 rounded bg-slate-100 text-parrilla-ivory border border-parrilla-border">
                    ${escapeHtml(o.codigo_pedido)}
                  </span>
                  ${getPaymentBadge(o)}
                </div>
                <span class="live-timer px-2.5 py-0.5 rounded-full text-[11px] font-extrabold font-mono ${semaphoreClass}" data-created="${o.fecha_hora}" data-semaphore="true">
                  ${semaphoreIcon} ⏱️ ${elapsedStr}
                </span>
              </div>

              <!-- Datos del Cliente y Dirección Destacada -->
              <div class="bg-slate-50 p-3 rounded-xl border border-parrilla-border space-y-1">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-display font-black text-sm text-parrilla-ivory">${escapeHtml(o.cliente_nombre || 'Cliente Domicilio')}</span>
                  <a href="tel:${escapeHtml(o.cliente_telefono || '')}" class="font-mono font-black text-xs text-emerald-700 hover:underline">
                    📞 ${escapeHtml(o.cliente_telefono || 'Sin tel')}
                  </a>
                </div>
                <div class="text-xs font-extrabold text-parrilla-gold leading-snug">
                  📍 ${escapeHtml(addressStr)}
                </div>
              </div>

              <!-- Selector de Mensajero en 1 Clic -->
              <div class="bg-emerald-50/60 p-2.5 rounded-xl border border-emerald-200">
                <label class="block text-[10px] font-extrabold uppercase text-emerald-900 mb-1">
                  🛵 Mensajero Asignado:
                </label>
                <select
                  class="courier-select w-full px-3 py-2 bg-white rounded-lg border border-emerald-300 text-xs font-extrabold text-parrilla-ivory focus:border-emerald-600 outline-none cursor-pointer"
                  data-id="${o.id}"
                >
                  ${courierOptionsHtml}
                </select>
              </div>

              <!-- Platos -->
              <div class="space-y-0.5 max-h-36 overflow-y-auto pr-1">
                ${itemsList}
              </div>
            </div>

            <!-- Totales y Botones Operativos -->
            <div class="pt-3 border-t border-parrilla-border space-y-2.5">
              <div class="flex items-center justify-between text-xs">
                <span class="text-parrilla-muted font-bold">
                  Envío: <strong class="text-emerald-700 font-mono">${fmt(o.delivery_fee || 0)}</strong>
                </span>
                <span class="font-display font-black text-lg text-parrilla-gold font-mono">
                  Total: ${fmt(o.total)}
                </span>
              </div>

              <div class="grid grid-cols-3 gap-1.5">
                <button
                  type="button"
                  class="btn-print-courier-board py-2 px-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 text-[11px] font-extrabold transition cursor-pointer flex items-center justify-center gap-1"
                  data-id="${o.id}"
                  title="Imprimir Guía de Mensajero 80mm"
                >
                  <span>🛵 Ticket</span>
                </button>

                <button
                  type="button"
                  class="btn-print-kitchen-board py-2 px-2 rounded-xl bg-orange-50 hover:bg-orange-100 text-orange-800 border border-orange-300 text-[11px] font-extrabold transition cursor-pointer flex items-center justify-center gap-1"
                  data-id="${o.id}"
                  title="Imprimir Comanda de Cocina 80mm"
                >
                  <span>🍳 Cocina</span>
                </button>

                ${
                  isOpen
                    ? `
                  <button
                    type="button"
                    class="btn-open-pay-modal py-2 px-2 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-display font-black text-[11px] shadow-xs transition cursor-pointer flex items-center justify-center gap-1"
                    data-id="${o.id}"
                  >
                    <span>💰 Cobrar</span>
                  </button>`
                    : `
                  <button
                    type="button"
                    class="btn-print-customer-board py-2 px-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-parrilla-ivory border border-parrilla-border text-[11px] font-bold transition cursor-pointer flex items-center justify-center gap-1"
                    data-id="${o.id}"
                  >
                    <span>🧾 Recibo</span>
                  </button>`
                }
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderBoard() {
      renderTablesGrid();
      renderTakeoutSection();
      renderDeliveriesSection();
      if (window.lucide) window.lucide.createIcons();
    }

    // Delegación de eventos en el tablero
    document.addEventListener('change', async (e) => {
      const sel = e.target.closest('.courier-select');
      if (sel) {
        const pedidoId = Number(sel.getAttribute('data-id'));
        const courierName = sel.value;
        sel.disabled = true;
        try {
          const res = await fetch(`/api/pedidos/${pedidoId}/assign-courier`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              courier_name: courierName || null,
              estado: courierName ? 'EN_CAMINO' : undefined
            })
          });
          if (res.ok) {
            const updated = await res.json();
            const idx = allOrders.findIndex((o) => o.id === pedidoId);
            if (idx !== -1) allOrders[idx] = updated;
            renderBoard();
          } else {
            alert('No se pudo asignar el mensajero. Intenta de nuevo.');
          }
        } catch (err) {
          alert('Error asignando mensajero: ' + err.message);
        } finally {
          sel.disabled = false;
        }
      }
    });

    document.getElementById('chk-show-completed-takeout')?.addEventListener('change', renderTakeoutSection);
    document.getElementById('chk-show-all-deliveries')?.addEventListener('change', renderDeliveriesSection);
    document.getElementById('btn-refresh-board')?.addEventListener('click', fetchOrders);

    // =========================================================================
    // MODAL DE COBRO Y LIBERACIÓN EN /pedidos
    // =========================================================================
    const modalPay = document.getElementById('modal-pay-order');
    const cashReceivedInp = document.getElementById('board-cash-received');
    const cashChangeEl = document.getElementById('board-cash-change');

    function openPayModal(order) {
      if (!order) return;
      activePayOrder = order;
      selectedPayMethod = 'CASH';

      document.getElementById('pay-modal-title').textContent = `${order.mesa || order.cliente_nombre || 'Pedido'} (${order.codigo_pedido})`;
      document.getElementById('pay-modal-subtotal').textContent = fmt((order.subtotal || 0) + (order.packaging_fee || 0));
      document.getElementById('pay-modal-delivery').textContent = fmt(order.delivery_fee || 0);
      document.getElementById('pay-modal-delivery-row').style.display = order.tipo === 'DOMICILIO' ? 'flex' : 'none';
      document.getElementById('pay-modal-total').textContent = fmt(order.total);

      const itemsContainer = document.getElementById('pay-modal-items');
      if (itemsContainer) {
        itemsContainer.innerHTML = (order.detalles || []).map((d) => `
          <div class="flex justify-between py-1 text-xs">
            <span class="font-bold text-parrilla-ivory">${d.cantidad}x ${escapeHtml(d.plato?.nombre || 'Plato')}</span>
            <span class="font-mono">${fmt(d.precio_unitario * d.cantidad)}</span>
          </div>
        `).join('');
      }

      document.querySelectorAll('.board-pay-method-btn').forEach((b) => {
        const isCash = b.getAttribute('data-method') === 'CASH';
        b.className = isCash
          ? 'board-pay-method-btn active py-2.5 px-1 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-[11px] flex flex-col items-center gap-1 shadow-xs cursor-pointer'
          : 'board-pay-method-btn py-2.5 px-1 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-[11px] flex flex-col items-center gap-1 cursor-pointer';
      });

      document.getElementById('board-cash-calc-box').style.display = 'flex';
      if (cashReceivedInp) cashReceivedInp.value = '';
      if (cashChangeEl) cashChangeEl.textContent = '$0';

      modalPay.classList.remove('hidden');
      modalPay.classList.add('flex');
    }

    function closePayModal() {
      modalPay.classList.add('hidden');
      modalPay.classList.remove('flex');
      activePayOrder = null;
    }

    document.getElementById('btn-pay-modal-close')?.addEventListener('click', closePayModal);
    document.getElementById('btn-pay-modal-cancel')?.addEventListener('click', closePayModal);

    document.querySelectorAll('.board-pay-method-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.board-pay-method-btn').forEach((b) => {
          b.className = 'board-pay-method-btn py-2.5 px-1 rounded-xl border border-parrilla-border bg-slate-50 hover:bg-slate-100 text-parrilla-ivory font-bold text-[11px] flex flex-col items-center gap-1 cursor-pointer';
        });
        btn.className = 'board-pay-method-btn active py-2.5 px-1 rounded-xl border border-parrilla-gold bg-parrilla-gold text-white font-bold text-[11px] flex flex-col items-center gap-1 shadow-xs cursor-pointer';
        selectedPayMethod = btn.getAttribute('data-method') || 'CASH';
        document.getElementById('board-cash-calc-box').style.display = selectedPayMethod === 'CASH' ? 'flex' : 'none';
      });
    });

    cashReceivedInp?.addEventListener('input', () => {
      if (!activePayOrder) return;
      const paid = Number(cashReceivedInp.value || 0);
      const diff = paid - Number(activePayOrder.total || 0);
      if (paid > 0) {
        cashChangeEl.textContent = diff >= 0 ? fmt(diff) : 'Faltan ' + fmt(Math.abs(diff));
      } else {
        cashChangeEl.textContent = '$0';
      }
    });

    document.getElementById('btn-pay-modal-confirm')?.addEventListener('click', async () => {
      if (!activePayOrder) return;
      const btn = document.getElementById('btn-pay-modal-confirm');
      btn.disabled = true;
      const origHtml = btn.innerHTML;
      btn.innerHTML = '<span>Procesando cobro...</span>';

      const paidCash = Number(cashReceivedInp?.value || 0);
      const total = Number(activePayOrder.total || 0);
      const change = (selectedPayMethod === 'CASH' && paidCash > total) ? (paidCash - total) : 0;

      try {
        const res = await fetch(`/api/caja/pay/${activePayOrder.id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            payments: [{
              method: selectedPayMethod,
              amount: total,
              change_given: change
            }]
          })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(data.detail || data.error || `Error HTTP ${res.status} al cobrar el pedido.`);
        }

        const wantReceipt = document.getElementById('chk-board-print-receipt')?.checked ?? true;
        const orderToPrint = data.id ? data : activePayOrder;
        closePayModal();
        await fetchOrders();

        if (wantReceipt) {
          printOrderTicket(orderToPrint, 'customer', selectedPayMethod, paidCash);
        }
      } catch (err) {
        alert('No se pudo cobrar: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    });

    // =========================================================================
    // IMPRESIÓN TÉRMICA 80MM DESDE /pedidos (COCINA, MENSAJERO, CLIENTE)
    // =========================================================================
    function printOrderTicket(order, type = 'customer', payMethodOverride = null, cashPaid = 0) {
      const printable = document.getElementById('printable-ticket');
      if (!printable || !order) return;

      const timeStr = new Date(order.fecha_hora || Date.now()).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
      const dateStr = new Date(order.fecha_hora || Date.now()).toLocaleDateString('es-CO');
      const codeStr = order.codigo_pedido || ('#' + order.id);
      const addrStr = extractAddress(order);
      const payMethod = payMethodOverride || (order.payments && order.payments[0]?.method) || (order.estado === 'PAGADO' ? 'PAGADO' : 'PENDIENTE / EFECTIVO');

      let html = '';
      if (type === 'kitchen') {
        const ubicacion = order.tipo === 'EN_MESA'
          ? (order.mesa || 'MESA')
          : (order.tipo === 'DOMICILIO' ? `🛵 DOMICILIO - ${order.cliente_nombre}` : `📦 PARA LLEVAR - ${order.cliente_nombre}`);

        const itemsHtml = (order.detalles || []).map((d) => `
          <div style="border-bottom: 1.5px dashed #000; padding: 2.5mm 0;">
            <div style="display: flex; align-items: flex-start; gap: 2.5mm;">
              <span style="font-size: 16pt; font-weight: 900; border: 1.5px solid #000; padding: 1mm 2mm;">${d.cantidad}X</span>
              <div>
                <div style="font-size: 13pt; font-weight: 900; text-transform: uppercase;">${escapeHtml(d.plato?.nombre || 'Plato')}</div>
                ${d.notas_item ? `<div style="font-size: 10pt; font-weight: bold; margin-top: 1mm;">└ ${escapeHtml(d.notas_item)}</div>` : ''}
              </div>
            </div>
          </div>
        `).join('');

        html = `
          <div style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 2mm;">
            <div style="border: 2px solid #000; padding: 1mm 3mm; font-size: 13pt; font-weight: 900; display: inline-block;">🍳 COMANDA DE COCINA</div>
            <div style="font-size: 13pt; font-weight: 900; margin-top: 1.5mm;">${escapeHtml(ubicacion)}</div>
            <div style="font-size: 9pt; font-family: monospace;">Orden: <strong>${escapeHtml(codeStr)}</strong> | Hora: <strong>${timeStr}</strong></div>
          </div>
          <div style="margin: 2mm 0;">${itemsHtml}</div>
        `;
      } else if (type === 'courier') {
        const isPaid = order.estado === 'PAGADO' && payMethod !== 'CASH';
        const itemsSummary = (order.detalles || []).map((d) => `
          <div style="font-size: 10pt; padding: 0.5mm 0;">• <strong>${d.cantidad}x</strong> ${escapeHtml(d.plato?.nombre || 'Plato')}</div>
        `).join('');

        html = `
          <div style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 2mm;">
            <h1 style="font-size: 15pt; font-weight: 900; margin: 0;">SAN PARRILLA</h1>
            <div style="border: 2px solid #000; padding: 1mm 3mm; font-size: 11pt; font-weight: 900; margin: 1mm 0; display: inline-block;">
              🛵 GUÍA DOMICILIO ${order.courier_name ? '• ' + escapeHtml(order.courier_name.toUpperCase()) : ''}
            </div>
            <div style="font-size: 9pt; font-family: monospace;">Pedido: <strong>${escapeHtml(codeStr)}</strong> | Hora: <strong>${timeStr}</strong></div>
          </div>
          <div style="border: 2px solid #000; padding: 2.5mm; margin: 2mm 0;">
            <div style="font-size: 9pt; font-weight: bold;">CLIENTE:</div>
            <div style="font-size: 13pt; font-weight: 900;">${escapeHtml(order.cliente_nombre || 'Cliente')}</div>
            <div style="font-size: 9pt; font-weight: bold; margin-top: 1.5mm;">TELÉFONO:</div>
            <div style="font-size: 16pt; font-weight: 900; font-family: monospace;">📞 ${escapeHtml(order.cliente_telefono || 'Sin tel')}</div>
            <div style="font-size: 9pt; font-weight: bold; margin-top: 1.5mm;">DIRECCIÓN:</div>
            <div style="font-size: 12pt; font-weight: 900;">📍 ${escapeHtml(addrStr)}</div>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 11pt; font-weight: 900; border-bottom: 1.5px dashed #000; padding: 1.5mm 0;">
            <span>FLETE MENSAJERO:</span>
            <span>${fmt(order.delivery_fee || 0)}</span>
          </div>
          <div style="margin: 2mm 0;">${itemsSummary}</div>
          <div style="border: 3px solid #000; padding: 2.5mm; text-align: center; margin-top: 2mm;">
            <div style="font-size: 12pt; font-weight: 900;">${isPaid ? '✅ PAGADO POR TRANSFERENCIA (NO COBRAR)' : '⚠️ COBRAR AL CLIENTE'}</div>
            <div style="font-size: 17pt; font-weight: 900; margin-top: 1mm;">TOTAL: ${fmt(order.total)}</div>
          </div>
        `;
      } else {
        const rows = (order.detalles || []).map((d) => `
          <tr style="border-bottom: 1px solid #ddd;">
            <td style="padding: 1.5mm 0; font-weight: 900;">${d.cantidad}</td>
            <td style="padding: 1.5mm 1mm; font-weight: bold;">${escapeHtml(d.plato?.nombre || 'Plato')}</td>
            <td style="padding: 1.5mm 0; text-align: right; font-weight: bold;">${fmt(d.precio_unitario * d.cantidad)}</td>
          </tr>
        `).join('');

        html = `
          <div style="text-align: center; border-bottom: 1.5px dashed #000; padding-bottom: 2mm;">
            <h1 style="font-size: 16pt; font-weight: 900; margin: 0;">SAN PARRILLA</h1>
            <p style="margin: 1mm 0; font-size: 9pt;">Fogón, Carbón & Sazón Casero</p>
            <div style="border: 2px solid #000; padding: 1mm 3mm; font-size: 11pt; font-weight: bold; display: inline-block; margin: 1.5mm 0;">
              ${escapeHtml(order.mesa || order.tipo)}
            </div>
            <div style="font-size: 8.5pt; font-family: monospace;">Pedido: <strong>${escapeHtml(codeStr)}</strong> | ${dateStr} ${timeStr}</div>
          </div>
          <table style="width: 100%; border-collapse: collapse; margin: 2mm 0; font-size: 9.5pt;">
            <thead>
              <tr style="border-bottom: 1px dashed #000;">
                <th style="text-align: left;">CANT</th>
                <th style="text-align: left;">PLATO</th>
                <th style="text-align: right;">TOTAL</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
          <div style="border-top: 1.5px dashed #000; padding-top: 2mm;">
            ${order.packaging_fee ? `<div style="display:flex;justify-content:space-between;font-size:10pt;"><span>Empaques:</span><span>${fmt(order.packaging_fee)}</span></div>` : ''}
            ${order.delivery_fee ? `<div style="display:flex;justify-content:space-between;font-size:10pt;"><span>Domicilio:</span><span>${fmt(order.delivery_fee)}</span></div>` : ''}
            <div style="display:flex;justify-content:space-between;font-size:14pt;font-weight:900;border-top:1.5px solid #000;border-bottom:2px solid #000;padding:1.5mm 0;margin:1.5mm 0;">
              <span>TOTAL:</span>
              <span>${fmt(order.total)}</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:10pt;font-weight:bold;">
              <span>ESTADO / PAGO:</span>
              <span>${escapeHtml(payMethod)}</span>
            </div>
          </div>
        `;
      }

      printable.innerHTML = html;
      printable.classList.remove('hidden');
      setTimeout(() => {
        window.print();
        setTimeout(() => printable.classList.add('hidden'), 900);
      }, 80);
    }

    document.addEventListener('click', (e) => {
      const payBtn = e.target.closest('.btn-open-pay-modal');
      if (payBtn) {
        const id = Number(payBtn.getAttribute('data-id'));
        const order = allOrders.find((o) => o.id === id);
        if (order) openPayModal(order);
        return;
      }

      const tablePrintBtn = e.target.closest('.btn-table-print');
      if (tablePrintBtn) {
        const id = Number(tablePrintBtn.getAttribute('data-id'));
        const order = allOrders.find((o) => o.id === id);
        if (order) printOrderTicket(order, 'customer');
        return;
      }

      const kitchenBtn = e.target.closest('.btn-print-kitchen-board');
      if (kitchenBtn) {
        const id = Number(kitchenBtn.getAttribute('data-id'));
        const order = allOrders.find((o) => o.id === id);
        if (order) printOrderTicket(order, 'kitchen');
        return;
      }

      const courierBtn = e.target.closest('.btn-print-courier-board');
      if (courierBtn) {
        const id = Number(courierBtn.getAttribute('data-id'));
        const order = allOrders.find((o) => o.id === id);
        if (order) printOrderTicket(order, 'courier');
        return;
      }

      const custBtn = e.target.closest('.btn-print-customer-board');
      if (custBtn) {
        const id = Number(custBtn.getAttribute('data-id'));
        const order = allOrders.find((o) => o.id === id);
        if (order) printOrderTicket(order, 'customer');
        return;
      }
    });

    // Actualizar cronómetros cada 15 segundos sin recargar toda la página y refrescar BD cada 10s
    setInterval(() => {
      document.querySelectorAll('.live-timer').forEach((el) => {
        const created = el.getAttribute('data-created');
        if (!created) return;
        const isSem = el.getAttribute('data-semaphore') === 'true';
        const mins = getElapsedMinutes(created);
        const text = formatElapsed(created);
        if (isSem) {
          const icon = mins >= 30 ? '🔴' : (mins >= 15 ? '🟡' : '🟢');
          el.textContent = `${icon} ⏱️ ${text}`;
        } else {
          el.textContent = `⏱️ ${text}`;
        }
      });
    }, 10000);

    document.addEventListener('DOMContentLoaded', () => {
      renderTablesGrid();
      fetchOrders();
      setInterval(fetchOrders, 10000);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') fetchOrders();
      });
    });
  </script>
</StaffLayout>
