---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SESSION_COOKIE, homeForRole, isAuthConfigured, verifySessionToken } from '../lib/auth.js';

// Si ya hay sesión válida, no mostrar el login: ir directo a su herramienta.
const token = Astro.cookies.get(SESSION_COOKIE)?.value;
const session = token ? verifySessionToken(token) : null;
if (session) return Astro.redirect(homeForRole(session.role));

const configured = isAuthConfigured();
const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9'];
---

<BaseLayout title="Acceso del personal | San Parrilla" noindex>
  <main class="flex-1 flex items-center justify-center px-4 py-10 bg-gradient-to-b from-slate-100/70 to-parrilla-dark">
    <div class="w-full max-w-sm">

      <div class="text-center mb-6">
        <img src="/logo.png" alt="San Parrilla" class="h-16 w-auto mx-auto rounded-full ring-2 ring-parrilla-gold/30 mb-3" />
        <h1 class="font-display font-black text-2xl text-parrilla-ivory">Acceso del personal</h1>
        <p class="text-xs text-parrilla-muted mt-1">Ingresa tu PIN para abrir tu herramienta de trabajo.</p>
      </div>

      <div class="bg-white rounded-2xl border border-parrilla-border shadow-xl p-5">
        {!configured && (
          <div class="mb-4 text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 rounded-xl p-3">
            El acceso aún no está configurado en el servidor. Avisa al administrador.
          </div>
        )}

        <form id="login-form" class="space-y-4" autocomplete="off">
          <div>
            <label for="pin" class="block text-xs font-bold text-parrilla-gold uppercase tracking-wider mb-1.5">PIN o contraseña</label>
            <input
              id="pin"
              name="pin"
              type="password"
              inputmode="numeric"
              autocomplete="current-password"
              maxlength="64"
              required
              disabled={!configured}
              class="w-full px-4 py-3 bg-white rounded-xl border border-parrilla-border text-center text-2xl tracking-[0.5em] font-bold font-mono text-parrilla-ivory focus:border-parrilla-gold outline-none"
              placeholder="••••"
            />
          </div>

          <div class="grid grid-cols-3 gap-2" id="keypad">
            {keys.map((k) => (
              <button type="button" data-key={k} class="py-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-xl font-bold text-parrilla-ivory border border-parrilla-border transition">{k}</button>
            ))}
            <button type="button" data-action="clear" class="py-3.5 rounded-xl bg-slate-100 hover:bg-red-50 active:scale-95 text-xs font-bold text-parrilla-muted hover:text-red-500 border border-parrilla-border transition">Borrar</button>
            <button type="button" data-key="0" class="py-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-xl font-bold text-parrilla-ivory border border-parrilla-border transition">0</button>
            <button type="button" data-action="back" class="py-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-lg font-bold text-parrilla-muted border border-parrilla-border transition" aria-label="Borrar último dígito">⌫</button>
          </div>

          <p id="login-error" class="hidden text-xs font-semibold text-red-600 bg-red-50 border border-red-200 rounded-xl p-2.5 text-center" role="alert"></p>

          <button
            id="login-submit"
            type="submit"
            disabled={!configured}
            class="w-full py-3.5 rounded-xl bg-parrilla-gold hover:bg-parrilla-goldLight text-white font-display font-black text-base shadow-md transition active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Entrar
          </button>
        </form>
      </div>

      <p class="text-center mt-5">
        <a href="/" class="text-xs font-medium text-parrilla-muted hover:text-parrilla-gold transition">← Volver a la carta</a>
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const pinInput = document.getElementById('pin') as HTMLInputElement | null;
    const errorBox = document.getElementById('login-error');
    const submitBtn = document.getElementById('login-submit') as HTMLButtonElement | null;

    const showError = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.classList.remove('hidden');
    };

    document.getElementById('keypad')?.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest('button');
      if (!btn || !pinInput) return;
      const key = btn.getAttribute('data-key');
      const action = btn.getAttribute('data-action');
      if (key !== null) pinInput.value += key;
      if (action === 'clear') pinInput.value = '';
      if (action === 'back') pinInput.value = pinInput.value.slice(0, -1);
      pinInput.focus();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!pinInput || !submitBtn) return;

      errorBox?.classList.add('hidden');
      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = 'Verificando...';

      try {
        const next = new URLSearchParams(window.location.search).get('next') || '';
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pin: pinInput.value, next }),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          window.location.href = data.redirect || '/pos';
          return;
        }
        showError(data.error || 'No se pudo iniciar sesión.');
        pinInput.value = '';
        pinInput.focus();
      } catch {
        showError('Sin conexión con el servidor. Revisa el internet e inténtalo de nuevo.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });

    pinInput?.focus();
  </script>
</BaseLayout>
