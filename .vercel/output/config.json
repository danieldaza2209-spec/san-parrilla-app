{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/caja/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/customers/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/orders/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/products/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/specials/?$",
			"dest": "_render"
		},
		{
			"src": "^/caja/?$",
			"dest": "_render"
		},
		{
			"src": "^/pos/?$",
			"dest": "_render"
		}
	]
}